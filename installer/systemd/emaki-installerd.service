[Unit]
Description=Emaki live ISO installer worker
ConditionPathExists=/run/archiso/bootmnt
After=systemd-udev-settle.service dbus.socket
Wants=dbus.socket

[Service]
Type=simple
User=root
ExecStart=/usr/bin/emaki-installerd
RuntimeDirectory=emaki-installer
RuntimeDirectoryMode=0750
UMask=0022
PrivateMounts=yes
Restart=on-failure
RestartSec=3
# Do not let stop/restart kill a formatting command before it can finish.
TimeoutStopSec=infinity
KillMode=mixed
# The guardian tries emaki-installer-restart.scope, then pins its memory.
# If adoption fails, installation stays available with inherited cgroup lifetime.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
