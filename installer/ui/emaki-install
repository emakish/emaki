# One installer process per session keeps the in-memory plan while its window is hidden or
# closed; running emaki-install again brings that window back.
set -eu
umask 077
ulimit -c 0
installer_package="$(dirname -- "$(readlink -f -- "$0")")/.."
translate() {
    local translated message="$1" argument index=0
    shift
    if translated=$(python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from emaki_installer.i18n import _; print(_(sys.argv[2]).format(*sys.argv[3:]))' "$installer_package" "$message" "$@" 2>/dev/null); then
        printf '%s\n' "$translated"
    else
        for argument in "$@"; do
            message=${message//\{$index\}/"$argument"}
            ((index += 1))
        done
        printf '%s\n' "$message"
    fi
}
: "${XDG_RUNTIME_DIR:?$(translate 'The installer needs a user runtime directory')}"
config=/usr/share/emaki-installer/ui/shell.qml
exec 9>"$XDG_RUNTIME_DIR/emaki-install.lock"
if ! flock -n 9; then
    # The first process may still be loading its QML; never launch a second one. Only the
    # function's own reply counts: `qs ipc` can exit 0 without calling anything.
    reply=''
    for _ in {1..50}; do
        if reply=$(qs ipc -p "$config" call installer present 2>&1) && [[ ${reply##*$'\n'} == presented ]]; then
            exit 0
        fi
        sleep 0.1
    done
    translate 'emaki-install: the running installer did not show its window:
{0}' "${reply:-$(translate '(no reply)')}" >&2
    exit 1
fi
export EMAKI_SHELL_SHADER_DIR=/usr/share/emaki/shell/shaders
# Without this, a Quickshell build with its crash handler opens a report window and re-executes
# qs in place instead of exiting.
export QS_DISABLE_CRASH_HANDLER=1
# Runtime translation is confined to this installer process.
export EMAKI_INSTALLER_UI=1
# This shell holds the lock for exactly the lifetime of qs. qs gets no fd 9, so processes it
# starts (helpers, a crash reporter) cannot keep the lock once it is gone.
qs -p "$config" 9>&-
