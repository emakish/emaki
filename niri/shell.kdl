// Emaki shell — extends default.kdl with layout settings for the shell bar.
// Include AFTER default.kdl. The struts below assume the shell reserves
// 8 + 36 + 8 = 52: with a different panel they would consume the gap to windows.

layout {
    // niri adds gaps after the panel's exclusive zone, so without compensation the gap
    // from islands to windows is 8 + gaps (10 with gaps 2), not the design's 8. struts.top = −gaps.
    // Initial personal output layouts carry fractional compensation (at 1.25,
    // top -2.4). On upgrades, the managed machine file retains a global strut
    // after these defaults, without claiming personal output blocks. Later personal
    // layout settings can override it; see docs/shell.md for mixed-scale limits.
    struts {
        top -2
    }
}

// Panel: the shell requests blur behind islands (blurRegion), and niri makes it xray
// (wallpaper): “Xray is automatically enabled by default if any other background effect (like
// blur) is active” (docs/wiki/Window-Effects.md 26.04). There is deliberately no `xray true`
// rule for the bar: a rule's xray is an independent effect covering the entire surface, and when
// the shell needs no blur (all islands draw their own glass, the bar is hidden), Quickshell sends
// an empty region as NULL, and niri paints wallpaper across the entire 84 px bar over windows (GOTCHAS).

// An expanded launcher over a window blurs the window itself (non-xray, experimental in niri 26.04).
layer-rule {
    match namespace="^emaki-(test-)?launcher$"
    background-effect {
        xray false
    }
}
