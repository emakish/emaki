// ═══════════════════════════════════════════════════════════════════════
//  Emaki — niri desktop defaults.
//
//  Zone 1, the package zone: this file belongs to the Emaki packages, and an
//  update replaces it whole. An edit here is lost without a warning.
//  Which file belongs to which zone: /usr/share/doc/emaki/ZONES.md
//
//  Your niri config is ~/.config/niri/config.kdl (zone 3, yours: the installer
//  may create it once, Emaki never writes it again). It includes machine settings:
//    include "/etc/emaki/niri.kdl"
//  That installer-owned file includes these defaults; upgraded machines may also
//  retain a global panel strut, overridable by your later layout settings.
//  Initial non-default monitor scales live in your file. Put changes below its
//  marked line, before those initial settings. Until your file exists,
//  /etc/niri/config.kdl (niri/system.kdl) includes this file instead.
//
//  Override, not remove. Your file wins where niri lets a later setting win: a
//  bind on the same keys, layout values such as gaps, the whole touchpad block,
//  the whole xkb block (your session then no longer follows the system keyboard
//  layouts). Login commands have personal off switches; see the zone map above.
//  It cannot remove a window rule, workspace or bind; a bind can only be replaced. For a
//  monitor, the first output block for its connector wins; Emaki ships none.
//  Put personal output blocks in the marked slot before initial installer blocks.
//
//  Zone 2 overrides are loaded after this configuration through a managed
//  session wrapper. Personal files are never rewritten by settings commands.
//
//  Rule: nothing here may depend on a specific machine —
//  no scale, monitor names, keyboard layouts, or home directory paths.
//  Those belong in the installer.
// ═══════════════════════════════════════════════════════════════════════

// Appearance: colors, borders, shadows, rounded corners, blur, animations.
// Generated from tokens.toml — do not edit by hand.
include "theme.kdl"

// Ask applications not to draw their own title bars: kitty and other clients
// supporting xdg-decoration leave decorations to the compositor. Without this,
// the terminal gets a title bar with a close button.
prefer-no-csd

// ── Autostart ──────────────────────────────────────────────────────────
// niri starts children asynchronously underneath its own fresh-login cover.
// The wallpaper wrapper starts immediately and claims one instance per compositor.
// niri always uses its normal configuration; no startup opacity rules are added.
// Wallpaper paths live in ~/.config/wpaperd/config.toml; the login-screen copy
// follows that file. wpaperctl set changes only the running session's wallpaper.
//   wpaperctl get <output>   show the current wallpaper
//   wpaperctl set <file>     change it in memory; update the config to publish it
spawn-at-startup "emaki-autostart" "wallpaper" "emaki-session-wallpaper"

// The Emaki shell shows notifications (see “Panel” below). mako is not autostarted:
// two notification servers cannot share a bus name — the first one takes it.

// Clipboard history stays in the login runtime, never the persistent cache.
// Retire only the old database once before recording. wl-paste in
// --watch mode passes CLIPBOARD_STATE=sensitive for entries marked by
// a password manager, and cliphist store skips those entries.
spawn-at-startup "emaki-autostart" "clipboard" "python3" "-B" "@EMAKI_DATADIR@/shell/helpers/clipboard_store.py" "--watch"

// Administrator password requests are handled by the Emaki shell.

// Mount USB drives on request; insertion must not mount behind the lock.
spawn-at-startup "emaki-autostart" "automount" "udiskie" "--no-automount"

// Panel, launcher, clock shade, dock, tray and notifications. The fork starts
// the shell on a private connection via fork-rules.kdl and supervises its lifetime.
// This service launch supplies the shell when no trusted supervisor is configured;
// its condition skips it whenever the compositor owns shell supervision.
// `emaki-shell restart` selects the running compositor's supervisor or legacy service.
// The trusted supervisor captures its environment at login; restart does not refresh it.
// After changing the login environment, sign out and back in. Later user-manager or
// activation-environment updates do not reach the trusted shell or the apps it launches.
//   emaki-shell call launcher status     current shell state
//   emaki-shell call dock status         pinned and running dock apps
spawn-at-startup "emaki-autostart" "shell" "systemctl" "--user" "start" "--no-block" "emaki-shell.service"
// Ctrl+Alt+Delete requests the trusted prompt mark through its binding in niri/fork-rules.kdl.
// Only a physical compositor binding can request the mark; it is not an IPC action.
spawn-at-startup "emaki-autostart" "sleep-guard" "systemctl" "--user" "start" "--no-block" "emaki-sleep-guard.service"

// The idle policy ships disabled; Settings can enable supported personal timers.
// The hardware trial of dimming, locking and screen blanking remains a release gate.
// It does not and will not suspend or hibernate.

// ── Layout behavior ────────────────────────────────────────────────────
layout {
    // Initial plain plate: niri can render before any cover client has mapped.
    background-color "#fff8f3"
    // Widths cycled by Super+R. niri picks the nearest width GREATER than the current
    // width, or the smallest if none is greater. Full width must therefore be
    // in the list: new windows open at full width, and without this entry the cycle
    // was incomplete — after leaving full width, the same key could not return to it.
    //   full width → one third → one half → two thirds → full width
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // New windows use the full screen width: on a laptop display, this is the only
    // comfortable size for working in a single window. Neighboring columns sit
    // offscreen; Super+arrow keys navigate them, and Super+R cycles the current
    // column's width when you need two windows side by side.
    default-column-width { proportion 1.0; }
}

// ── Workspaces ─────────────────────────────────────────────────────────
// Ten persistent workspaces instead of niri's dynamic defaults: named workspaces
// remain when empty and keep their config order, so Super+1…0 always
// goes to the same place. The bindings below address them by index — with
// persistent workspaces, the index matches the number and stays fixed.
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10"


// ── Environment ────────────────────────────────────────────────────────
// Without this, Qt applications cannot find qt6ct and lose the shared palette.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    XDG_MENU_PREFIX "emaki-"
}

cursor {
    xcursor-theme "Emaki"
    xcursor-size 24
}

// ── Input ──────────────────────────────────────────────────────────────
// Keyboard layouts are a system setting: /etc/vconsole.conf (XKBLAYOUT), served by
// systemd-localed. niri follows localed while no xkb section is set, so the login screen,
// the lock screen and the session share one list; Emaki writes no xkb section anywhere.
// A personal xkb section replaces that list for the session only. Its options must not
// contain grp:win_space_toggle: Super+Space switches layouts through switch-layout.
// Enabling both mechanisms makes them interfere — the shortcut fires twice and switches
// back to the original layout.
input {
    mod-key "Super"

    // The power button shuts down the machine. By default, niri intercepts it and
    // silently suspends the laptop; this line leaves it to the standard
    // systemd-logind behavior: a short press shuts down.
    disable-power-key-handling

    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
    }
}

// The terminal is translucent by default (the kitty theme: tokens.toml opacity.terminal), so
// blur goes underneath it. Applying opacity here too would multiply the two values and make it
// look muddy.
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// The Welcome window floats at its own size instead of opening as a full-width column.
// A stable app id keeps this rule independent of the displayed language.
window-rule {
    match app-id=r#"^org\.emaki\.welcome$"#
    // Older clients without per-window identity still use the English title.
    match app-id=r#"^org\.quickshell$"# title="^Welcome to Emaki$"
    open-floating true
}

// ── Miscellaneous ──────────────────────────────────────────────────────
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// Super+Tab and Super+` use niri's switcher, as before 0.9. An explicit binds block
// replaces all its default chords, leaving the Alt combinations exclusively to the
// shell's switcher below.
recent-windows {
    binds {
        Mod+Tab { next-window; }
        Mod+Shift+Tab { previous-window; }
        Mod+grave { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  KEY BINDINGS
//  The personal config includes this file and adds settings after it, so personal
//  bindings take precedence when keys overlap.
// ═══════════════════════════════════════════════════════════════════════
binds {
    // Deliberately small: each binding has a clear purpose. Add missing ones as needed
    // while using the system, rather than inheriting them from old configs.
    //
    // MAIN RULE. Arrow keys follow niri's spatial layout: columns run
    // horizontally, workspaces stack vertically.
    //   Super + arrow          move focus
    //   Super + Shift + arrow  move focus and take the window along
    // Shift always means “with the window”, including number keys.

    // ── Navigation ────────────────────────────────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    // Up and down: first move through windows in a column, then switch to
    // the next workspace. One key, no extra thought: just “down”.
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }

    // Super + Ctrl + Shift + arrow: the column goes to the neighbouring monitor.
    Mod+Ctrl+Shift+Left  hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up    hotkey-overlay-title="Move column to monitor above" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down  hotkey-overlay-title="Move column to monitor below" { move-column-to-monitor-down; }

    // ── Workspaces by number ───────────────────────────────────────────────
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // ── Launching ──────────────────────────────────────────────────────────
    // niri's overlay shows one key per action (the first titled one): Super+T; the shortcut
    // search lists both.
    Mod+T hotkey-overlay-title="Open terminal" { spawn "emaki-terminal"; }
    Mod+Return hotkey-overlay-title="Open terminal" { spawn "emaki-terminal"; }
    Mod+E hotkey-overlay-title="Open files" { spawn "dolphin"; }

    // Launcher. Do not bind Super alone: niri triggers that binding on ANY
    // combination with Super — open niri bug #605. Mod+D is niri's own default
    // and the common i3/sway/bspwm convention.
    Mod+D hotkey-overlay-title="Open launcher" { spawn "emaki-shell" "call" "launcher" "toggle"; }
    // Clock shade: notifications, calendar, music.
    Mod+N hotkey-overlay-title="Notifications, calendar and music" { spawn "emaki-shell" "call" "drawer" "toggle"; }

    // Shell surfaces: Super+Ctrl selects a system page; Tab/arrows move inside it.
    // Escape releases the shell focus back to the application.
    Mod+B hotkey-overlay-title="Focus top bar" { spawn "emaki-shell" "call" "keyboard" "open" "bar"; }
    Mod+J hotkey-overlay-title="Focus dock" { spawn "emaki-shell" "call" "keyboard" "open" "dock"; }
    Mod+Ctrl+N hotkey-overlay-title="Focus newest notification" { spawn "emaki-shell" "call" "drawer" "newest"; }
    Mod+Ctrl+S hotkey-overlay-title="Sound and app volume" { spawn "emaki-shell" "call" "system" "open" "sound"; }
    Mod+Ctrl+L hotkey-overlay-title="Brightness and night light" { spawn "emaki-shell" "call" "system" "open" "light"; }
    Mod+Ctrl+W hotkey-overlay-title="Wi-Fi and VPN" { spawn "emaki-shell" "call" "system" "open" "wifi"; }
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth" { spawn "emaki-shell" "call" "system" "open" "bt"; }
    Mod+Ctrl+P hotkey-overlay-title="Battery, profiles and session" { spawn "emaki-shell" "call" "system" "open" "power"; }
    Mod+Ctrl+K hotkey-overlay-title="Keyboard layouts" { spawn "emaki-shell" "call" "system" "open" "kb"; }
    Mod+Ctrl+T hotkey-overlay-title="Tray applications" { spawn "emaki-shell" "call" "system" "open" "tray"; }
    Mod+Ctrl+I hotkey-overlay-title="Privacy and capture activity" { spawn "emaki-shell" "call" "keyboard" "open" "privacy"; }
    Mod+Ctrl+H hotkey-overlay-title="Welcome to Emaki" { spawn "emaki-shell" "call" "welcome" "present"; }
    // RU emits period on the US slash key; niri keeps ASCII symbols in the active layout.
    Mod+Slash hotkey-overlay-title="Search keyboard shortcuts" { spawn "emaki-shell" "call" "keyboard" "open" "shortcuts"; }
    Mod+Period hotkey-overlay-title="Search keyboard shortcuts" { spawn "emaki-shell" "call" "keyboard" "open" "shortcuts"; }

    // Emergency terminal WITHOUT Super: if something intercepts Super,
    // this binding still works. The compositor finds the terminal through PATH.
    Ctrl+Alt+T hotkey-overlay-title="Open terminal (works without Super)" { spawn "kitty"; }

    // ── Windows and columns ────────────────────────────────────────────────
    // The window switcher (shell/WindowSwitcher.qml): a quick tap goes back to the previous
    // window; holding Alt shows pictures of all windows and releasing it switches. Without
    // a panel that answers, emaki-shell focuses the previous window itself. No repeat: a held
    // Tab would start a process per repeat; the arrow keys move inside the switcher.
    Alt+Tab repeat=false hotkey-overlay-title="Switch windows" { spawn "emaki-shell" "call" "switcher" "next"; }
    Alt+Shift+Tab repeat=false hotkey-overlay-title="Switch windows backwards" { spawn "emaki-shell" "call" "switcher" "previous"; }
    Alt+grave repeat=false hotkey-overlay-title="Switch windows of the same app" { spawn "emaki-shell" "call" "switcher" "app"; }
    Alt+Shift+grave repeat=false hotkey-overlay-title="Switch windows of the same app backwards" { spawn "emaki-shell" "call" "switcher" "appPrevious"; }
    // Super+Q first: niri's overlay shows the first titled key of an action.
    Mod+Q hotkey-overlay-title="Close window" { close-window; }
    Mod+C hotkey-overlay-title="Close window" { close-window; }
    Mod+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }   // one third → one half → two thirds
    // Narrower and wider by steps of a tenth of the screen (Equal is the key with "+").
    Mod+Minus hotkey-overlay-title="Make column narrower" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Make column wider" { set-column-width "+10%"; }
    Mod+M { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Float or tile window" { toggle-window-floating; }
    // Into the neighbouring column as a stack, or out of a stack into its own column.
    Mod+BracketLeft hotkey-overlay-title="Move window into or out of left column" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Move window into or out of right column" { consume-or-expel-window-right; }
    Mod+O repeat=false { toggle-overview; }

    // ── System ─────────────────────────────────────────────────────────────
    // Switch keyboard layouts with niri's native action.
    Mod+Space { switch-layout "next"; }

    // Clipboard history — the launcher's Clipboard mode (reads the cliphist database).
    // Without a shell: cliphist in fuzzel; Esc (nothing picked) leaves the clipboard alone.
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "emaki-shell call launcher open && emaki-shell call launcher mode Clipboard || { pick=$(cliphist -config-path /dev/null -db-path \"${XDG_RUNTIME_DIR:?}/emaki-cliphist.db\" list | fuzzel --config \"$(emaki-config-path fuzzel fuzzel.ini)\" --dmenu) && [ -n \"$pick\" ] && printf %s \"$pick\" | cliphist -config-path /dev/null -db-path \"${XDG_RUNTIME_DIR:?}/emaki-cliphist.db\" decode | wl-copy; }"; }

    // The lock supervisor serializes requests and confirms compositor coverage.
    // It runs independently of the shell and optional idle policy. Works when locked:
    // if the lockers crashed for good, niri keeps the session locked on its plain
    // background and accepts a new lock client, so Super+L brings a password field back.
    Mod+L allow-when-locked=true hotkey-overlay-title="Lock screen" { spawn "emaki-lock"; }

    // Power menu: lock, suspend, hibernate, log out, reboot, shut down.
    // Uses the same fuzzel in menu mode; irreversible actions require confirmation.
    // No direct logout binding: it used to end the desktop without asking.
    Mod+Escape hotkey-overlay-title="Power menu" { spawn "emaki-power"; }

    Mod+Shift+S hotkey-overlay-title="Take an interactive screenshot" { screenshot; }
    Print { screenshot; }
    // Emaki's picture/recording overlay, set to recording; pressed again it stops the recording.
    Mod+Alt+R hotkey-overlay-title="Record screen" { spawn "emaki-shell" "call" "capture" "record"; }

    // Show all key bindings on screen instead of digging through the config.
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Period { show-hotkey-overlay; }

    // ── Laptop keys ────────────────────────────────────────────────────────
    // Apple media F3/F4: KEY_SCALE/KEY_DASHBOARD become these XKB keysyms.
    XF86LaunchA repeat=false { toggle-overview; }
    XF86LaunchB repeat=false { spawn "emaki-shell" "call" "launcher" "toggle"; }
    // Select only the keyboard LED, never Caps Lock or another status light.
    XF86KbdBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=leds" "--device=*::kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=leds" "--device=*::kbd_backlight" "set" "10%-"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioMedia repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioStop  repeat=false { spawn "playerctl" "stop"; }
    // Keys change volume and brightness directly; the shell shows the on-screen indicator:
    // it detects any change itself (SystemService.qml). Steps of 5 %, maximum 100 %,
    // holding a key repeats the step. Brightness uses the same device as the shell slider.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
}

// ── Shell ──────────────────────────────────────────────────────────────
// Reserve space for the bar and blur behind islands/launcher. Included last:
// Base struts assume whole scale. The installer writes each session output scale and
// its fractional strut compensation to the target config (calculation in docs/shell.md).
include "shell.kdl"
include optional=true "sudo-key.kdl"
