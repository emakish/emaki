// Fork-only rules for “niri (Emaki)”. Included by fork.kdl and fork-system.kdl.
// Stock niri 26.04 does not recognize these nodes and would reject the entire config,
// so they live here instead of default.kdl.
//
// The shell's own screen capture excludes shell surfaces: the dock glass
// refracts what is underneath it, not itself. Other applications
// (screenshots, screen recording) see the shell as usual.
layer-rule {
    match namespace="^emaki-"
    hide-from-own-screencopy true
}

// The password card is excluded for every screenshot and recording client.
// Same-client glass exclusion alone does not protect external capture streams.
layer-rule {
    match namespace="^emaki-auth-prompt$"
    block-out-from "screen-capture"
}

// Authentication surfaces require the private Wayland connection created for this
// fixed shell command. Startup environment is captured once; IPC cannot replace it.
spawn-trusted-shell-at-startup "@EMAKI_BINDIR@/emaki-autostart" "shell" "@EMAKI_BINDIR@/emaki-shell"

// Repeat the optional revoke binding after personal fork settings too.
include optional=true "sudo-key.kdl"

binds {
    // The compositor proves the current authentication prompt on physical key input.
    Ctrl+Alt+Delete hotkey-overlay-title="Show that the password window is real" { show-trusted-prompt-mark; }
}
