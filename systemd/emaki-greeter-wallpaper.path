[Unit]
Description=Publish wallpaper changes for the Emaki login screen
PartOf=graphical-session.target
# The target wants this unit; ordering after it would create a dependency cycle.
ConditionUser=!root
ConditionPathIsDirectory=/var/lib/emaki-greeter/users/%u

[Path]
PathChanged=%h/.config/wpaperd/config.toml
# The look (theme, accent) the login screen shows for this account.
PathChanged=%h/.config/emaki/settings.toml
Unit=emaki-greeter-wallpaper.service

[Install]
WantedBy=graphical-session.target
