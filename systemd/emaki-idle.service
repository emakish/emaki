# Idle policy: dim, lock, screen off. Never suspend; see @EMAKI_BINDIR@/emaki-idle.
# Shipped inert. An explicit personal blanking or locking choice enables it.
# To switch it off for good: systemctl --user mask emaki-idle.
[Unit]
Description=Emaki idle policy (dim, lock, screen off)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionUser=!root
# The live session has no password: its "lock" opens on any text, and the
# installer must not be dimmed or blanked under a running installation.
ConditionPathIsDirectory=!/etc/emaki-live
# Only 0 disables rate limiting; a missing key means the manager default (5 in 10 s).
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=10
ExecStart=@EMAKI_BINDIR@/emaki-settings-power run
Restart=on-failure
# No restart heals these: 2 = emaki-idle refused its arguments or timings, 127 =
# swayidle is not installed, 255 = swayidle refused its arguments or the person's own
# swayidle config. swayidle 1.9 exits with -1 for nothing else: a compositor it cannot
# reach or use exits with -3 to -5, which is restarted.
RestartPreventExitStatus=2 127 255
# A flat delay: systemd's restart counter is never reset while the session lives
# (only a manual start, reset-failed or RESTART_RESET=1 do), so RestartSteps= would
# leave the session without its idle lock for the full maximum delay after a few exits.
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
