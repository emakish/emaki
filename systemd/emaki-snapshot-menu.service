[Unit]
Description=Repair a missing or stale snapshot boot menu
DefaultDependencies=no
After=multi-user.target emaki-boot-complete.service emaki-boot-refresh.service
Before=shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/boot /efi /.snapshots
ConditionPathExists=/boot/grub/grub.cfg

[Service]
Type=oneshot
ExecStart=/usr/bin/emaki-boot-refresh --repair-snapshots
TimeoutStartSec=5min
TimeoutStopSec=90s
UMask=0077

[Install]
WantedBy=multi-user.target
