[Unit]
Description=Accept an updated system after a usable login or desktop session
DefaultDependencies=no
After=multi-user.target greetd.service emaki-boot-refresh.service
Before=shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/efi /.snapshots /boot
ConditionPathExists=/efi/EFI/Emaki/update.json

[Service]
Type=oneshot
ExecStart=/usr/bin/emaki-update-boot accept
TimeoutStartSec=6min
UMask=0077

[Install]
WantedBy=multi-user.target
