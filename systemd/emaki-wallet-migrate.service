[Unit]
Description=Report saved password migration results
PartOf=graphical-session.target
After=niri.service niri-emaki.service emaki-wallet-start.service emaki-shell.service

[Service]
Type=oneshot
ExecStart=/usr/bin/emaki-wallet-migrate --automatic
TimeoutStartSec=500
Slice=session.slice
