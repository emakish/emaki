# Started explicitly by niri/default.kdl after the session environment is imported,
# just like emaki-shell.service. No global wants link into other desktops.
[Unit]
Description=Lock the Emaki session before sleep
PartOf=graphical-session.target
# Stop after the compositor: the guard holds the sleep delay while confirming
# shutdown. ExecCondition below rejects starts outside a graphical session without
# adding the After= ordering that Requisite would need.
Before=graphical-session.target niri-emaki.service niri.service
ConditionUser=!root
ConditionPathExists=!/etc/emaki-live/greetd.toml
StartLimitIntervalSec=0

[Service]
# A false condition skips the start without triggering Restart=always.
# Targets go straight from inactive to active (systemd target.c), and niri requests the guard after READY=1; `activating` is accepted only as a harmless extra.
ExecCondition=/bin/sh -c 'state=$$(systemctl --user show --property=ActiveState --value graphical-session.target) || exit 1; case "$$state" in active|activating) exit 0;; *) exit 1;; esac'
# The guard sends READY=1 once it holds logind's delay inhibitor, together with
# RESTART_RESET=1 (below). python3 is the main process, as NotifyAccess=main needs.
Type=notify
ExecStart=python3 -I @EMAKI_BINDIR@/emaki-sleep-guard
# always, not on-failure: the guard exits 0 on SIGTERM, so a `systemctl --user kill`
# would end it for good. A stop job (systemctl --user stop, the end of the session
# through PartOf=) is never restarted.
Restart=always
# One second after the end of a guard that held its inhibitor: its RESTART_RESET=1
# sets systemd's restart counter back to 0, which nothing else does while the
# session lives. A guard that keeps failing before that point backs off in five
# steps to one start every 30 s instead of one every second. No ExecStartPost=:
# with one, READY=1 would not make the service running in time for systemd to take
# the RESTART_RESET=1 of the same message.
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
TimeoutStopSec=20
# Failed sleep locks retry hyprlock, then terminate this session within logind's delay.
# Optional lid handling: Environment=EMAKI_SLEEP_LOCK_FAILURE=stay-awake
Slice=session.slice

[Install]
WantedBy=graphical-session.target
