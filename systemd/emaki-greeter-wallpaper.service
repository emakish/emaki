[Unit]
Description=Publish a private wallpaper copy for the Emaki login screen
PartOf=graphical-session.target
ConditionUser=!root
ConditionPathIsDirectory=/var/lib/emaki-greeter/users/%u

[Service]
Type=oneshot
ExecStart=python3 -B @EMAKI_DATADIR@/shell/helpers/publish-wallpaper.py
UMask=0027
NoNewPrivileges=yes
TimeoutStartSec=20
Slice=session.slice
