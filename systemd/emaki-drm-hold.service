[Unit]
Description=Retain non-master DRM descriptors across greeter and desktop sessions
Before=greetd.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/emaki-drm-hold
Restart=on-failure
RestartSec=5s
TimeoutStartSec=3s
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
