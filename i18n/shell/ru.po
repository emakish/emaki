msgstr "Слишком много записей часов"

msgid "Tray applications"
msgstr "Приложения системного лотка"

msgid "Turn this display on before changing its settings."
msgstr "Включите этот экран перед изменением его настроек."

msgid "Unavailable"
msgstr "Недоступно"

msgid "Unexpected startup argument."
msgstr "Неожиданный аргумент запуска."

msgid "Unknown clock command"
msgstr "Неизвестная команда часов"

msgid "Unknown power setting."
msgstr "Неизвестная настройка питания."

msgid "Unknown startup action."
