msgid "\nThe change could not be confirmed. Settings shows the current accounts."
msgstr "\nНе удалось подтвердить изменение. Настройки показывают текущие учётные записи."

msgid "### Steps to reproduce"
msgstr "### Шаги для воспроизведения"

msgid "### System"
msgstr "### Система"

msgid "### What I expected"
msgstr "### Ожидаемое поведение"

msgid "### What happened"
msgstr "### Что произошло"

msgid "1..4 distinct XKB layouts, comma-separated (us,ru); layout(variant) as the XKB rules list it"
msgstr "от 1 до 4 разных раскладок XKB через запятую (us,ru); layout(variant) как в списке правил XKB"

msgid "<!-- Nothing else was collected from your computer. Logs help, but add them only if you choose to: Settings > About can save a diagnostics file for you to review first. -->"
msgstr "<!-- Больше никаких данных с компьютера не собрано. Журналы помогают, но добавляйте их, только если сами захотите: в разделе «Настройки > О системе» можно сохранить файл диагностики и сначала просмотреть его. -->"

msgid "A previous display change needs recovery. Reopen Displays and try again."
msgstr "Предыдущее изменение экранов требует восстановления. Откройте страницу «Экраны» заново и повторите попытку."

msgid "A startup entry could not be read. Check its contents and try again."
msgstr "Не удалось прочитать запись автозапуска. Проверьте её содержимое и повторите попытку."

msgid "Alarm was not found"
msgstr "Будильник не найден"

msgid "An interrupted display change from an earlier session was discarded."
msgstr "Прерванное изменение экранов из прежнего сеанса отброшено."

msgid "An interrupted display change was reverted."
msgstr "Прерванное изменение экранов отменено."

msgid "An interrupted display reset was reverted."
msgstr "Прерванный сброс экранов отменён."

msgid "Another display change is waiting for confirmation."
msgstr "Другое изменение экранов ожидает подтверждения."

msgid "Apps could not be read or changed. Refresh the page and try again."
msgstr "Не удалось прочитать или изменить приложения. Обновите страницу и повторите попытку."

msgid "Automatic locking and blanking are unavailable because required session components are missing."
msgstr "Автоматическая блокировка и гашение экрана недоступны: отсутствуют необходимые компоненты сеанса."

msgid "Battery, profiles and session"
msgstr "Батарея, профили и сеанс"

msgid "Block devices"
msgstr "Блочные устройства"

msgid "Bluetooth"
msgstr "Bluetooth"

msgid "Brightness and night light"
msgstr "Яркость и ночной свет"

msgid "Browser"
msgstr "Браузер"

msgid "Choose None, Automatic or Manual proxy settings."
msgstr "Выберите настройки прокси: «Нет», «Автоматически» или «Вручную»."

msgid "Choose a charge limit from 50 to 100 percent."
msgstr "Выберите предел заряда от 50 до 100 процентов."

msgid "Choose a local VPN configuration file."
msgstr "Выберите локальный файл конфигурации VPN."

msgid "Choose a readable VPN configuration file."
msgstr "Выберите доступный для чтения файл конфигурации VPN."

msgid "Choose a saved connection."
msgstr "Выберите сохранённое соединение."

msgid "Choose a supported network settings action."
msgstr "Выберите поддерживаемое действие с настройками сети."

msgid "Choose a valid VPN type."
msgstr "Выберите допустимый тип VPN."

msgid "Choose a valid display setting."
msgstr "Выберите допустимую настройку экрана."

msgid "Choose a wallpaper"
msgstr "Выберите обои"

msgid "Choose one of the available delays."
msgstr "Выберите одну из доступных задержек."

msgid "Choose whether the app starts automatically."
msgstr "Выберите, запускать ли приложение автоматически."

msgid "Choose your picture"
msgstr "Выберите изображение"

msgid "Clipboard history"
msgstr "История буфера обмена"

msgid "Clock command is too large"
msgstr "Команда часов слишком велика"

msgid "Clock state directory must not be writable by others"
msgstr "Каталог состояния часов не должен быть доступен для записи другим пользователям"

msgid "Clock state is too large"
msgstr "Состояние часов слишком велико"

msgid "Clock tools are already running in another session."
msgstr "Часы уже открыты в другом сеансе."

msgid "Clock tools could not read or save their settings. Check access and available space."
msgstr "Часы не смогли прочитать или сохранить настройки. Проверьте доступ и свободное место."

msgid "Clock tools could not read that data. Please try again."
msgstr "Часы не смогли прочитать эти данные. Повторите попытку."

msgid "Close window"
msgstr "Закрыть окно"

msgid "Confirm password: "
msgstr "Подтвердите пароль: "

msgid "Connection changed."
msgstr "Соединение изменено."

msgid "Could not check the screen timers."
msgstr "Не удалось проверить таймеры экрана."

msgid "Cycle column widths"
msgstr "Переключить ширину столбца"

msgid "Disabled"
msgstr "Отключено"

msgid "Disabled displays are session-only and cannot be saved."
msgstr "Отключение экранов действует только в сеансе и не может быть сохранено."

msgid "Display information could not be read."
msgstr "Не удалось прочитать сведения об экранах."

msgid "Display settings changed elsewhere. Reopen Displays and try again."
msgstr "Настройки экранов изменены извне. Откройте страницу «Экраны» заново и повторите попытку."

msgid "Display settings could not be saved. Check the available space and try again."
msgstr "Не удалось сохранить настройки экранов. Проверьте свободное место и повторите попытку."

msgid "Emaki landscape"
msgstr "Пейзаж Emaki"

msgid "Emaki problem report"
msgstr "Отчёт о проблеме Emaki"

msgid "Enter a password without line breaks, tabs or other control characters (at most 1024 UTF-8 bytes)."
msgstr "Введите пароль без переводов строк, табуляций и других управляющих символов (не более 1024 байтов UTF-8)."

msgid "Enter a proxy address as host:port."
msgstr "Введите адрес прокси в виде host:port."

msgid "Enter an HTTP or HTTPS proxy configuration URL."
msgstr "Введите URL конфигурации прокси HTTP или HTTPS."

msgid "Enter between one and sixteen DNS server addresses."
msgstr "Введите от одного до шестнадцати адресов серверов DNS."

msgid "Enter valid DNS server addresses."
msgstr "Введите допустимые адреса серверов DNS."

msgid "Expected a clock command"
msgstr "Ожидалась команда часов"

msgid "Expected a whole number"
msgstr "Ожидалось целое число"

msgid "Expected true or false"
msgstr "Ожидалось true или false"

msgid "Failed system units"
msgstr "Системные юниты с ошибками"

msgid "Failed user units"
msgstr "Пользовательские юниты с ошибками"

msgid "Files"
msgstr "Файлы"

msgid "Float or tile window"
msgstr "Переключить плавающий или мозаичный режим окна"

msgid "Focus dock"
msgstr "Перевести фокус на док"

