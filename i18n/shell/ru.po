msgstr "Сделать интерактивный снимок экрана"

msgid "Terminal"
msgstr "Терминал"

msgid "Text editor"
msgstr "Текстовый редактор"

msgid "That resolution or refresh rate is not available on this display."
msgstr "Это разрешение или частота обновления недоступны на этом экране."

msgid "The account is ready."
msgstr "Учётная запись готова."

msgid "The account was not created."
msgstr "Учётная запись не создана."

msgid "The alarm limit is 64"
msgstr "Допускается не более 64 будильников"

msgid "The application entry is too large."
msgstr "Запись приложения слишком велика."

msgid "The confirmation time expired. The previous settings were restored."
msgstr "Время подтверждения истекло. Прежние настройки восстановлены."

msgid "The connected displays changed. Reopen Displays and try again."
msgstr "Подключённые экраны изменились. Откройте страницу «Экраны» заново и повторите попытку."

msgid "The display configuration could not be loaded."
msgstr "Не удалось загрузить конфигурацию экранов."

msgid "The display configuration reload was not confirmed."
msgstr "Повторная загрузка конфигурации экранов не подтверждена."

msgid "The display did not confirm the requested settings."
msgstr "Экран не подтвердил запрошенные настройки."

msgid "The display name is invalid."
msgstr "Недопустимое имя экрана."

msgid "The display request is invalid."
msgstr "Недопустимый запрос экрана."

msgid "The display request is too large."
msgstr "Запрос экрана слишком велик."

msgid "The display service could not apply the change."
msgstr "Служба экранов не смогла применить изменение."

msgid "The display service is unavailable."
msgstr "Служба экранов недоступна."

msgid "The display service returned an invalid response."
msgstr "Служба экранов вернула недопустимый ответ."

msgid "The display settings lock is not safe to use."
msgstr "Файл блокировки настроек экранов небезопасен для использования."

msgid "The idle policy stopped unexpectedly."
msgstr "Таймеры экрана неожиданно остановились."

msgid "The inherited configuration does not enable this display. Its settings were restored."
msgstr "Унаследованная конфигурация не включает этот экран. Его настройки восстановлены."

msgid "The installed application is unavailable."
msgstr "Установленное приложение недоступно."

msgid "The managed display directory is not safe to use."
msgstr "Каталог настроек экранов Emaki небезопасен для использования."

msgid "The managed display file is not safe to use."
msgstr "Файл настроек экранов Emaki небезопасен для использования."

msgid "The new display size would separate or overlap screens. Adjust their positions first."
msgstr "Новый размер экрана приведёт к разрыву или перекрытию экранов. Сначала измените их расположение."

msgid "The passwords do not match."
msgstr "Пароли не совпадают."

msgid "The pending display change cannot be recovered."
msgstr "Невозможно восстановить ожидающее изменение экранов."

msgid "The personal configuration directory is not owned by you."
msgstr "Личный каталог конфигурации принадлежит не вам."

msgid "The personal configuration directory must be absolute."
msgstr "Путь к личному каталогу конфигурации должен быть абсолютным."

msgid "The previous display settings could not be fully restored. Reconnect the display and try again."
msgstr "Не удалось полностью восстановить прежние настройки экранов. Подключите экран заново и повторите попытку."

msgid "The previous display settings have been restored."
msgstr "Прежние настройки экранов восстановлены."

msgid "The remaining display was turned back on."
msgstr "Оставшийся экран снова включён."

msgid "The saved lid setting is not valid."
msgstr "Сохранённая настройка крышки недопустима."

msgid "The saved power settings are not valid."
msgstr "Сохранённые настройки питания недопустимы."

msgid "The screen timers are not running. Apply a setting to try again."
msgstr "Таймеры экрана не работают. Примените настройку для повторной попытки."

msgid "The selected display is no longer connected."
msgstr "Выбранный экран больше не подключён."

msgid "The startup directory is not owned by you."
msgstr "Каталог автозапуска принадлежит не вам."

msgid "The startup entry is not a personal regular file."
msgstr "Запись автозапуска не является личным обычным файлом."

msgid "The startup entry is not an application."
msgstr "Запись автозапуска не является приложением."

msgid "The startup entry is too large."
msgstr "Запись автозапуска слишком велика."

msgid "The stopwatch has 100 laps; reset to record more"
msgstr "В секундомере уже 100 кругов; сбросьте его, чтобы записывать новые"

msgid "The system could not apply the power setting."
msgstr "Система не смогла применить настройку питания."

msgid "The world clock limit is 24"
msgstr "Допускается не более 24 мировых часов"

msgid "Their login wallet may still use the previous password."
msgstr "Хранилище паролей входа этого пользователя может всё ещё использовать прежний пароль."

msgid "There is no display change to keep."
msgstr "Нет изменения экранов для сохранения."

msgid "This VPN type needs its NetworkManager plugin."
msgstr "Для этого типа VPN нужен соответствующий модуль NetworkManager."

msgid "This app already has a personal startup entry. Check it before adding the app again."
msgstr "У приложения уже есть личная запись автозапуска. Проверьте её перед повторным добавлением."

msgid "This battery does not expose a charge limit."
msgstr "Эта батарея не предоставляет настройку предела заряда."

msgid "This connection is no longer available."
msgstr "Это соединение больше недоступно."

msgid "This display change applies until the session ends."
msgstr "Это изменение экранов действует до окончания сеанса."

msgid "This file has not been uploaded."
msgstr "Этот файл никуда не отправлялся."

msgid "Toggle fullscreen"
msgstr "Переключить полноэкранный режим"

msgid "Toggle overview"
msgstr "Открыть или закрыть обзор"

