msgstr "Comprobante no válido"

msgid "Invalid receipt file"
msgstr "Archivo de comprobante no válido"

msgid "Invalid receipt kind"
msgstr "Tipo de comprobante no válido"

msgid "Invalid removal result"
msgstr "Resultado de desinstalación no válido"

msgid "Invalid repository dependency"
msgstr "Dependencia de repositorio no válida"

msgid "Invalid repository name"
msgstr "Nombre de repositorio no válido"

msgid "Invalid request id"
msgstr "ID de solicitud no válido"

msgid "Invalid shelf"
msgstr "Estante no válido"

msgid "Invalid shelf item"
msgstr "Elemento de estante no válido"

msgid "Invalid shelf text"
msgstr "Texto de estante no válido"

