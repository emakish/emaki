msgstr "Недопустимый параметр обнаружения"

msgid "Invalid filters"
msgstr "Недопустимые фильтры"

msgid "Invalid installed package record"
msgstr "Недопустимая запись установленного пакета"

msgid "Invalid package database path"
msgstr "Недопустимый путь базы пакетов"

msgid "Invalid package filters"
msgstr "Недопустимые фильтры пакетов"

