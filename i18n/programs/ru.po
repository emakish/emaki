msgstr "Недопустимый ответ популярности"

msgid "Invalid preview token."
msgstr "Недопустимый токен предпросмотра."

msgid "Invalid program manager arguments."
msgstr "Недопустимые аргументы менеджера программ."

msgid "Invalid protocol version"
msgstr "Недопустимая версия протокола"

msgid "Invalid receipt"
msgstr "Недопустимая квитанция"

msgid "Invalid receipt file"
msgstr "Недопустимый файл квитанции"

msgid "Invalid receipt kind"
msgstr "Недопустимый тип квитанции"

msgid "Invalid removal result"
msgstr "Недопустимый результат удаления"

msgid "Invalid repository dependency"
msgstr "Недопустимая зависимость репозитория"

msgid "Invalid repository name"
msgstr "Недопустимое имя репозитория"

msgid "Invalid request id"
msgstr "Недопустимый идентификатор запроса"

msgid "Invalid shelf"
msgstr "Недопустимая подборка"

msgid "Invalid shelf item"
msgstr "Недопустимый элемент подборки"

msgid "Invalid shelf text"
msgstr "Недопустимый текст подборки"

msgid "Invalid shelf: a package twice"
msgstr "Недопустимая подборка: пакет указан дважды"

msgid "Invalid storefront"
msgstr "Недопустимая витрина"

msgid "Invalid storefront identities"
msgstr "Недопустимые идентификаторы витрины"

msgid "Invalid storefront row"
msgstr "Недопустимая строка витрины"

msgid "Invalid storefront text"
msgstr "Недопустимый текст витрины"

