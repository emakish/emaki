msgstr "ADVERTENCIA: falló el registro de GRUB en NVRAM; reintentando los archivos del proveedor sin NVRAM."

msgid "WARNING: GRUB menu title adjustment reported a problem; installation continues."
msgstr "ADVERTENCIA: el ajuste de los títulos del menú de GRUB informó un problema; la instalación continúa."

#, python-brace-format
msgid "WARNING: could not remove {value1}: {value2}"
msgstr "ADVERTENCIA: no se pudo quitar {value1}: {value2}"

msgid "WARNING: firmware startup order: "
msgstr "ADVERTENCIA: orden de arranque del firmware: "

