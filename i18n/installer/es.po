msgstr "Punto de montaje no compatible; /boot, /usr y la base de datos de pacman deben permanecer en la raíz."

msgid "Unsupported sector geometry."
msgstr "Geometría de sectores no compatible."

msgid "Unsupported system language."
msgstr "Idioma del sistema no compatible."

msgid "Update Emaki at the end: off."
msgstr "Actualizar Emaki al finalizar: desactivado."

msgid "Update Emaki at the end: when connected."
msgstr "Actualizar Emaki al finalizar: si hay conexión."

msgid "Update download stopped."
msgstr "Se detuvo la descarga de la actualización."

msgid "Use a simple top-level btrfs subvolume name."
msgstr "Usa un nombre de subvolumen btrfs simple de nivel superior."

msgid "Use at least 8 characters for the startup password."
msgstr "Usa al menos 8 caracteres para la contraseña de arranque."

msgid "Use only letters, digits and symbols of the English (US) keyboard."
msgstr "Usa solo letras, dígitos y símbolos del teclado en inglés (EE. UU.)."

msgid "Using a partition as swap requires formatting it."
msgstr "Usar una partición como swap requiere formatearla."

msgid "WARNING: Arch mirror ranking failed; the USB mirror list is retained: "
msgstr "ADVERTENCIA: falló la clasificación de servidores espejo de Arch; se conserva la lista de la memoria USB: "

