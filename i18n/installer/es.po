msgstr "Falta un archivo de destino necesario: {value1}."

#, python-brace-format
msgid "Restart scope adoption failed: {value1}. Continuing without verified isolation; the guardian may remain in the installer service cgroup."
msgstr "Falló la adopción del ámbito de reinicio: {value1}. Continuando sin aislamiento verificado; el supervisor puede permanecer en el cgroup del servicio del instalador."

