msgstr "Directiva de pacman sin conexión insegura: {value1}."

msgid "Unsafe runtime directory."
msgstr "Directorio de ejecución inseguro."

msgid "Unsafe temporary mountpoint."
msgstr "Punto de montaje temporal inseguro."

msgid "Unsupported NTFS sector or cluster geometry."
msgstr "Geometría de sectores o clústeres NTFS no compatible."

