msgstr "ADVERTENCIA: no se identificó ninguna salida DRM conectada; se omitió la escala personalizada."

msgid "WARNING: online update failed; the offline installation is retained: "
msgstr "ADVERTENCIA: falló la actualización en línea; se conserva la instalación sin conexión: "

#, python-brace-format
msgid "WARNING: optional unit {value1} is missing; skipped."
msgstr "ADVERTENCIA: falta la unidad opcional {value1}; se omitió."

msgid "WARNING: pacman is still running in the target; its lock is kept."
msgstr "ADVERTENCIA: pacman sigue ejecutándose en el destino; se conserva su bloqueo."

