msgid " (Rich software requires emaki-apps)"
msgstr " (La selección completa de software requiere emaki-apps)"

msgid " The Windows data partition passed post-shrink verification before loader installation. Disk changes have already been made. Do not retry installation. Save the installation log to another device and seek recovery help before changing this disk."
msgstr " La partición de datos de Windows pasó la verificación posterior a la reducción antes de instalar el cargador. Ya se hicieron cambios en el disco. No vuelvas a intentar la instalación. Guarda el registro de instalación en otro dispositivo y busca ayuda para la recuperación antes de modificar este disco."


msgid "(no reply)"
msgstr "(sin respuesta)"

msgid "--follow combines only with --plan --yes"
msgstr "--follow solo se combina con --plan --yes"

msgid "--plan with --follow requires --yes"
msgstr "--plan con --follow requiere --yes"

msgid "--yes requires --plan"
msgstr "--yes requiere --plan"

msgid "/efi must be an existing GPT EFI system partition with FAT32."
msgstr "/efi debe ser una partición del sistema EFI existente en GPT con FAT32."

msgid "/home cannot be FAT; choose ext4 or btrfs."
msgstr "/home no puede ser FAT; elige ext4 o btrfs."

msgid "/swap is reserved for hibernation."
msgstr "/swap está reservado para la hibernación."

msgid "64-bit UEFI is required."
msgstr "Se requiere UEFI de 64 bits."

msgid "; could not complete request."
msgstr "; no se pudo completar la solicitud."

msgid "; disk untouched: "
msgstr "; disco sin cambios: "

msgid "@swap is reserved for hibernation."
msgstr "@swap está reservado para la hibernación."

msgid "A deleted partition cannot be used."
msgstr "No se puede usar una partición eliminada."

msgid "A disk ID is required."
msgstr "Se requiere un ID de disco."

msgid "A kept partition changed its name. Nothing was formatted."
msgstr "Una partición conservada cambió de nombre. No se formateó nada."

msgid "A new partition lies outside the space this disk's partition table lets partitions use. The disk was not changed."
msgstr "Una partición nueva está fuera del espacio que la tabla de particiones de este disco permite usar. No se hicieron cambios en el disco."

msgid "A new partition must start and end on whole MiB inside the free space."
msgstr "Una partición nueva debe comenzar y terminar en límites de MiB enteros dentro del espacio libre."

msgid "A new partition overlaps another partition."
msgstr "Una partición nueva se superpone con otra partición."

msgid "A new partition table is made only on an empty disk; this disk holds data."
msgstr "Solo se crea una tabla de particiones nueva en un disco vacío; este disco contiene datos."

msgid "A new swap partition can only be used as swap."
msgstr "Una partición swap nueva solo se puede usar como swap."

msgid "A package download is incomplete; your disk has not been changed."
msgstr "La descarga de un paquete está incompleta; no se hicieron cambios en tu disco."

msgid "A partition is deleted twice."
msgstr "Una partición se elimina dos veces."

msgid "A partition to delete is not on the selected disk."
msgstr "Una partición que se va a eliminar no está en el disco seleccionado."

msgid "A repository override requires a test build in test mode."
msgstr "La sustitución del repositorio requiere una compilación de prueba en modo de prueba."

msgid "A safety check stopped the update. Resolve the reported problem before trying again."
msgstr "Una comprobación de seguridad detuvo la actualización. Resuelve el problema indicado antes de volver a intentarlo."

msgid "A selected XKB layout is not available on this ISO."
msgstr "Una distribución XKB seleccionada no está disponible en esta ISO."

msgid "A separate disk password is only used with that password choice."
msgstr "Una contraseña de disco independiente solo se usa con esa opción de contraseña."

msgid "A startup partition may only be mounted at /efi."
msgstr "Una partición de arranque solo se puede montar en /efi."

msgid "A swap partition cannot have other uses."
msgstr "Una partición swap no puede tener otros usos."

msgid "A swap partition needs at least 256 MiB."
msgstr "Una partición swap necesita al menos 256 MiB."

msgid "A swap partition takes the swap format."
msgstr "Una partición swap usa el formato swap."

msgid "A swapfile already exists at /swap/swapfile; move it before installing."
msgstr "Ya existe un archivo de intercambio en /swap/swapfile; muévelo antes de instalar."

#, python-brace-format
msgid "Account: {value1}; hostname: {value2}; timezone: {value3}."
msgstr "Cuenta: {value1}; nombre de la computadora: {value2}; zona horaria: {value3}."

msgid "Adding trusted package keys (pacman-key --populate)."
msgstr "Agregando claves de paquetes de confianza (pacman-key --populate)."

msgid "After the restart a blue screen asks you to confirm Emaki's key with a password shown at the end of the installation; you do this only once."
msgstr "Después de reiniciar, una pantalla azul te pedirá confirmar la clave de Emaki con una contraseña que se muestra al finalizar la instalación; solo debes hacerlo una vez."

msgid "Alongside can format only Emaki's newly created startup partition and root."
msgstr "La instalación junto a Windows solo puede formatear la partición de arranque y la raíz recién creadas de Emaki."

#, python-brace-format
msgid "Alongside installation on {path} ({model})."
msgstr "Instalación junto a Windows en {path} ({model})."

msgid "Alongside requires GPT."
msgstr "La instalación junto a Windows requiere GPT."

msgid "Alongside requires partition_id and integer shrink_bytes (bytes freed for Emaki)."
msgstr "La instalación junto a Windows requiere partition_id y un valor entero de shrink_bytes (bytes liberados para Emaki)."

msgid "Alongside: create Emaki's own EFI system partition and root only inside the freed Windows extent."
msgstr "Instalación junto a Windows: crear la partición del sistema EFI propia de Emaki y su raíz únicamente dentro del espacio liberado de Windows."

msgid "Alongside: dry-run the exact NTFS size; no disk writes yet."
msgstr "Instalación junto a Windows: simular el tamaño NTFS exacto; todavía no se escribe en el disco."

msgid "Alongside: shrink only the Windows GPT entry, preserving its start, GUID, type, name and attributes."
msgstr "Instalación junto a Windows: reducir solo la entrada GPT de Windows, conservando su inicio, GUID, tipo, nombre y atributos."

msgid "Alongside: shrink the Windows filesystem; answering y after the successful dry run."
msgstr "Instalación junto a Windows: reducir el sistema de archivos de Windows; responder «y» después de la simulación exitosa."

msgid "Alongside: verify resized NTFS geometry and read-only metadata. Windows chkdsk on first boot is expected; the dirty flag is preserved."
msgstr "Instalación junto a Windows: verificar la geometría NTFS redimensionada y los metadatos de solo lectura. Se espera que Windows ejecute chkdsk en el primer arranque; se conserva la marca de estado sucio."

msgid "An EFI system partition needs at least 512 MiB."
msgstr "Una partición del sistema EFI necesita al menos 512 MiB."

msgid "An encrypted swap partition needs formatting and an encrypted root, which keeps its key."
msgstr "Una partición swap cifrada debe formatearse y requiere una raíz cifrada que guarde su clave."

msgid "An installed file is in the way of this update. Resolve the file conflict before trying again."
msgstr "Un archivo instalado impide esta actualización. Resuelve el conflicto de archivos antes de volver a intentarlo."

msgid "An update step failed. Some packages may already have changed. Resolve the reported problem before updating again."
msgstr "Falló un paso de la actualización. Es posible que algunos paquetes ya hayan cambiado. Resuelve el problema indicado antes de volver a actualizar."

msgid "Another package operation may be running. Wait for it to finish before trying again."
msgstr "Es posible que haya otra operación de paquetes en curso. Espera a que termine antes de volver a intentarlo."

msgid "Assign exactly one root and one startup partition, plus optional data mounts."
msgstr "Asigna exactamente una raíz y una partición de arranque, además de los puntos de montaje de datos opcionales."

msgid "At least 32 GiB must be freed from Windows for Emaki."
msgstr "Se deben liberar al menos 32 GiB de Windows para Emaki."

msgid "Bounded termination requires a timeout, a positive budget and no stdin."
msgstr "La terminación acotada requiere un tiempo límite, un presupuesto positivo y ninguna entrada stdin."

#, python-brace-format
msgid "Btrfs mount options missing at {value1}."
msgstr "Faltan opciones de montaje de Btrfs en {value1}."

msgid "Btrfs needs separate /home, /var/log, package cache and /.snapshots mounts."
msgstr "Btrfs necesita montajes separados para /home, /var/log, la caché de paquetes y /.snapshots."

msgid "Btrfs root requires a separate snapshot subvolume on the root filesystem."
msgstr "La raíz Btrfs requiere un subvolumen de instantáneas separado en el sistema de archivos raíz."

#, python-brace-format
msgid "Building the startup image (mkinitcpio: {value1})."
msgstr "Creando la imagen de arranque (mkinitcpio: {value1})."

msgid "Cannot create the log there; choose a new filename on mounted removable media."
msgstr "No se puede crear el registro allí; elige un nombre de archivo nuevo en un medio extraíble montado."

msgid "Cannot determine RAM size for hibernation."
msgstr "No se puede determinar el tamaño de la RAM para la hibernación."

msgid "Cannot determine btrfs resume offset."
msgstr "No se puede determinar el desplazamiento de reanudación de btrfs."

msgid "Cannot determine ext4 resume offset."
msgstr "No se puede determinar el desplazamiento de reanudación de ext4."

msgid "Cannot determine the new account UID/GID."
msgstr "No se puede determinar el UID/GID de la cuenta nueva."

msgid "Cannot identify the live boot medium."
msgstr "No se puede identificar el medio de arranque en vivo."

msgid "Cannot identify the live boot medium; installation is refused."
msgstr "No se puede identificar el medio de arranque en vivo; se rechaza la instalación."

msgid "Cannot inspect existing btrfs subvolumes."
msgstr "No se pueden inspeccionar los subvolúmenes btrfs existentes."

msgid "Cannot load archinstall 4.5 and its dependencies: "
msgstr "No se pueden cargar archinstall 4.5 ni sus dependencias: "

msgid "Cannot read the Windows volume signature."
msgstr "No se puede leer la firma del volumen de Windows."

#, python-brace-format
msgid "Cannot read the signature of {value1}; it may be part of a multi-device set."
msgstr "No se puede leer la firma de {value1}; puede formar parte de un conjunto de varios dispositivos."

#, python-brace-format
msgid "Cannot run {value1}: {value2}."
msgstr "No se puede ejecutar {value1}: {value2}."

msgid "Cannot safely inspect the Windows hibernation file."
msgstr "No se puede inspeccionar de forma segura el archivo de hibernación de Windows."

msgid "Cannot verify NTFS, hibernation state or GPT metadata: "
msgstr "No se pueden verificar NTFS, el estado de hibernación o los metadatos GPT: "

#, python-brace-format
msgid "Cannot write {value1}: {value2}."
msgstr "No se puede escribir {value1}: {value2}."

msgid "Changing filesystem type requires format: true."
msgstr "Cambiar el tipo de sistema de archivos requiere format: true."

msgid "Checking available disk space (pacman)."
msgstr "Comprobando el espacio disponible en disco (pacman)."

msgid "Checking for conflicting files (pacman)."
msgstr "Buscando archivos en conflicto (pacman)."

msgid "Checking package compatibility (pacman)."
msgstr "Comprobando la compatibilidad de los paquetes (pacman)."

msgid "Checking package files (pacman)."
msgstr "Comprobando los archivos de paquetes (pacman)."

msgid "Checking trusted package keys (pacman)."
msgstr "Comprobando las claves de paquetes de confianza (pacman)."

msgid "Choose Rich or Minimal software."
msgstr "Elige la selección completa o mínima de software."

msgid "Choose a log file on removable media."
msgstr "Elige un archivo de registro en un medio extraíble."

msgid "Choose a time zone from the city list."
msgstr "Elige una zona horaria de la lista de ciudades."

msgid "Choose a whole-MiB Emaki size within the verified shrink bounds (at least 32 GiB)."
msgstr "Elige un tamaño de Emaki en MiB enteros dentro de los límites de reducción verificados (al menos 32 GiB)."

msgid "Choose btrfs or ext4."
msgstr "Elige btrfs o ext4."

msgid "Choose whether to encrypt the disk and which password to use."
msgstr "Elige si deseas cifrar el disco y qué contraseña usar."

msgid "Cleanup failed: "
msgstr "Falló la limpieza: "

msgid "Config must be an object."
msgstr "La configuración debe ser un objeto."

msgid "Confirm the reviewed disk plan and install."
msgstr "Confirma el plan de disco revisado e instala."

msgid "Connected"
msgstr "Conectado"

msgid "Connected, but the Wi-Fi settings could not be saved for installation. Connect again."
msgstr "Conectado, pero no se pudo guardar la configuración de Wi-Fi para la instalación. Vuelve a conectarte."

msgid "Connection timed out."
msgstr "Se agotó el tiempo de espera de la conexión."

msgid "Could not connect to this network."
msgstr "No se pudo conectar a esta red."

msgid "Could not connect. Check the password."
msgstr "No se pudo conectar. Revisa la contraseña."

msgid "Could not prepare to restart. Keep the USB stick connected and try again."
msgstr "No se pudo preparar el reinicio. Mantén la memoria USB conectada e inténtalo de nuevo."

msgid "Could not restart. Try again, or hold the power button to turn the computer off, then start it again. Your installation is safe."
msgstr "No se pudo reiniciar. Inténtalo de nuevo o mantén presionado el botón de encendido para apagar la computadora y vuelve a encenderla. Tu instalación está a salvo."

msgid "Could not save the Wi-Fi connection [NetworkManager]. Connect to that network again before installing."
msgstr "No se pudo guardar la conexión Wi-Fi [NetworkManager]. Vuelve a conectarte a esa red antes de instalar."

#, python-brace-format
msgid "Could not stop target process {value1}: {value2}"
msgstr "No se pudo detener el proceso de destino {value1}: {value2}"

msgid "Could not unmount all target filesystems; inspect the log before retrying."
msgstr "No se pudieron desmontar todos los sistemas de archivos de destino; revisa el registro antes de reintentar."

msgid "Create Emaki's own startup partition (1 GiB) and root in the freed space; Windows' startup partition is not changed."
msgstr "Crear la partición de arranque propia de Emaki (1 GiB) y su raíz en el espacio liberado; la partición de arranque de Windows no cambia."

#, python-brace-format
msgid "Create a new GPT partition table on {value1}; the disk is empty."
msgstr "Crear una tabla de particiones GPT nueva en {value1}; el disco está vacío."

msgid "Create the partitions for the new partition table."
msgstr "Crear las particiones para la tabla de particiones nueva."

msgid "Creating the package trust store (pacman-key --init)."
msgstr "Creando el almacén de confianza de paquetes (pacman-key --init)."

#, python-brace-format
msgid "DKMS module {value1}/{value2} for {value3} has no built modules."
msgstr "El módulo DKMS {value1}/{value2} para {value3} no tiene módulos compilados."

#, python-brace-format
msgid "DKMS module {value1}/{value2} for {value3} is not signed by the machine key: "
msgstr "El módulo DKMS {value1}/{value2} para {value3} no está firmado por la clave de la máquina: "

#, python-brace-format
msgid "Delete partition {value1} ({value2}): all its files are lost."
msgstr "Eliminar la partición {value1} ({value2}): se perderán todos sus archivos."

msgid "Deleted partitions lose all their files. Nothing on the disk changes until you press Install."
msgstr "Las particiones eliminadas perderán todos sus archivos. El disco no cambia hasta que presiones Instalar."

msgid "Destination is not on a mounted removable filesystem."
msgstr "El destino no está en un sistema de archivos extraíble montado."

msgid "Destination is not removable/USB media."
msgstr "El destino no es un medio extraíble/USB."

msgid "Destination mount changed during export."
msgstr "El montaje de destino cambió durante la exportación."

msgid "Destination must be block media."
msgstr "El destino debe ser un medio de bloques."

msgid "Destination must be under /run/media/live/."
msgstr "El destino debe estar bajo /run/media/live/."

#, python-brace-format
msgid "Device cannot be opened exclusively: {value1}."
msgstr "El dispositivo no se puede abrir de forma exclusiva: {value1}."

msgid "Disk identity or partition layout changed after the review."
msgstr "La identidad del disco o la distribución de particiones cambió después de la revisión."

msgid "Disk password must be nonempty and contain no control characters (line breaks, tabs)."
msgstr "La contraseña del disco no debe estar vacía ni contener caracteres de control (saltos de línea, tabulaciones)."

msgid "Display scale must be a number from 0.5 to 4."
msgstr "La escala de pantalla debe ser un número entre 0.5 y 4."

msgid "Display scales must be an object with at most 64 outputs."
msgstr "Las escalas de pantalla deben ser un objeto con un máximo de 64 salidas."

msgid "Duplicate fstab mountpoint."
msgstr "Punto de montaje duplicado en fstab."

msgid "Duplicate mountpoint."
msgstr "Punto de montaje duplicado."

msgid "Duplicate subvolume name."
msgstr "Nombre de subvolumen duplicado."

msgid "EFI loader is not a valid bounded file."
msgstr "El cargador EFI no es un archivo válido de tamaño acotado."

msgid "EFI loader path contains a symlink."
msgstr "La ruta del cargador EFI contiene un enlace simbólico."

msgid "Emaki could not confirm that the Windows disk is safe to shrink. Start Windows, let it check the disk if it asks, then choose Shut down (not Restart) and start from the USB stick again."
msgstr "Emaki no pudo confirmar que sea seguro reducir el disco de Windows. Inicia Windows, deja que compruebe el disco si lo solicita, elige Apagar (no Reiniciar) y vuelve a arrancar desde la memoria USB."

msgid "Emaki could not make itself the computer's default startup choice. If another system starts instead, choose Emaki in the firmware boot menu."
msgstr "Emaki no pudo establecerse como la opción de arranque predeterminada de la computadora. Si arranca otro sistema, elige Emaki en el menú de arranque del firmware."

msgid "Emaki could not make itself the computer's default startup choice. If another system starts instead, start the installation USB and use its GRUB console to load EFI/Emaki/grubx64.efi from this installation's startup partition."
msgstr "Emaki no pudo establecerse como la opción de arranque predeterminada de la computadora. Si arranca otro sistema, inicia desde la memoria USB de instalación y usa su consola GRUB para cargar EFI/Emaki/grubx64.efi desde la partición de arranque de esta instalación."

msgid "Emaki could not verify that the firmware starts the new installation first."
msgstr "Emaki no pudo verificar que el firmware arranque primero la instalación nueva."

msgid "Emaki installer protocol client (live ISO)."
msgstr "Cliente del protocolo del instalador de Emaki (ISO en vivo)."

msgid "Emaki needs one full update before you install apps; when online, use the terminal to update the whole system [pacman]."
msgstr "Emaki necesita una actualización completa antes de que instales aplicaciones; cuando tengas conexión, usa la terminal para actualizar todo el sistema [pacman]."

#, python-brace-format
msgid "Emaki needs two free GPT partition entries (its startup partition and its root); this disk has {value1}."
msgstr "Emaki necesita dos entradas libres de particiones GPT (su partición de arranque y su raíz); este disco tiene {value1}."

msgid "Emaki owns device discovery"
msgstr "Emaki se encarga de la detección de dispositivos"

msgid "Emaki requires archinstall distribution version 4.5."
msgstr "Emaki requiere la versión 4.5 del paquete archinstall."

msgid "Emaki's startup partition could not be verified from its saved partition identity. Nothing was changed."
msgstr "No se pudo verificar la partición de arranque de Emaki a partir de su identidad de partición guardada. No se hicieron cambios."

msgid "Emaki's startup partition is not a new one; disk untouched."
msgstr "La partición de arranque de Emaki no es nueva; disco sin cambios."

msgid "Encrypted root has no LUKS UUID."
msgstr "La raíz cifrada no tiene UUID de LUKS."

msgid "Encrypted-volume confirmations require a device path, encryption type and UUID."
msgstr "Las confirmaciones de volúmenes cifrados requieren una ruta de dispositivo, un tipo de cifrado y un UUID."

msgid "Encrypting root requires formatting it; existing files cannot be encrypted in place."
msgstr "Cifrar la raíz requiere formatearla; los archivos existentes no se pueden cifrar sin formatear."

msgid "Encryption: LUKS2 root, account password."
msgstr "Cifrado: raíz LUKS2, contraseña de la cuenta."

msgid "Encryption: LUKS2 root, separate disk password."
msgstr "Cifrado: raíz LUKS2, contraseña de disco independiente."

msgid "Encryption: off."
msgstr "Cifrado: desactivado."

msgid "Erase all partitions and create a new GPT partition table."
msgstr "Borrar todas las particiones y crear una tabla de particiones GPT nueva."

msgid "Erase disk"
msgstr "Borrar disco"

#, python-brace-format
msgid "Erase installation on {path} ({model})."
msgstr "Instalación borrando el disco {path} ({model})."

msgid "Every new partition needs a use: choose its mount point or swap, or remove it."
msgstr "Cada partición nueva necesita un uso: elige su punto de montaje o swap, o quítala."

msgid "Exactly one / and one /efi are required."
msgstr "Se requieren exactamente una partición / y una /efi."

msgid "Existing snapper root config points at a different subvolume."
msgstr "La configuración de raíz existente de snapper apunta a un subvolumen diferente."

msgid "Finding required packages (pacman)."
msgstr "Buscando los paquetes necesarios (pacman)."

msgid "Freed extent overlaps another partition."
msgstr "El espacio liberado se superpone con otra partición."

#, python-brace-format
msgid "Fresh Emaki {value1} install"
msgstr "Instalación nueva de Emaki {value1}"

msgid "GPT identity or geometry could not be verified."
msgstr "No se pudo verificar la identidad o la geometría GPT."

msgid "GPT validation failed; Windows will not be resized."
msgstr "Falló la validación GPT; no se cambiará el tamaño de Windows."

msgid "GRUB NVRAM registration failed and no removable loader could be installed."
msgstr "Falló el registro de GRUB en NVRAM y no se pudo instalar un cargador en la ruta de medios extraíbles."

#, python-brace-format
msgid "GRUB has no executable entry for {value1}."
msgstr "GRUB no tiene una entrada ejecutable para {value1}."

#, python-brace-format
msgid "GRUB loader {value1} does not carry the expected prefix; the unlock screen was not built."
msgstr "El cargador GRUB {value1} no contiene el prefijo esperado; no se creó la pantalla de desbloqueo."

msgid "GRUB's SBAT data is missing or unrecognized."
msgstr "Los datos SBAT de GRUB faltan o no se reconocen."

msgid "GRUB's SBAT data names no GRUB version."
msgstr "Los datos SBAT de GRUB no indican una versión de GRUB."

msgid "GRUB, linux + linux-lts; /boot inside root; zram with higher swap priority."
msgstr "GRUB, linux + linux-lts; /boot dentro de la raíz; zram con mayor prioridad de intercambio."

#, python-brace-format
msgid "Graphics controller (PCI {value1:04x}:"
msgstr "Controlador gráfico (PCI {value1:04x}:"

#, python-brace-format
msgid "Graphics driver packages (Nvidia): {packages}."
msgstr "Paquetes del controlador gráfico (Nvidia): {packages}."

msgid "Graphics hardware or driver availability changed; prepare a new installation plan."
msgstr "El hardware gráfico o la disponibilidad de los controladores cambió; prepara un plan de instalación nuevo."

msgid "Hibernation writes memory, including passwords, to the disk unencrypted."
msgstr "La hibernación escribe la memoria sin cifrar en el disco, incluidas las contraseñas."

msgid "Hibernation: off."
msgstr "Hibernación: desactivada."

msgid "Hostname must be one DNS label (1–63 characters)."
msgstr "El nombre de la computadora debe ser una etiqueta DNS (entre 1 y 63 caracteres)."

msgid "Implicit and explicit mounts overlap."
msgstr "Los montajes implícitos y explícitos se superponen."

msgid "Installation cancelled at a phase boundary; disk changes are not undone."
msgstr "Instalación cancelada al terminar una fase; los cambios del disco no se deshacen."

msgid "Installation complete; syncing and unmounting target filesystems."
msgstr "Instalación completada; sincronizando y desmontando los sistemas de archivos de destino."

#, python-brace-format
msgid "Installation failed: {value1}: {value2}"
msgstr "Falló la instalación: {value1}: {value2}"

msgid "Installer connection closed or sent an invalid frame."
msgstr "La conexión del instalador se cerró o envió una trama no válida."

#, python-brace-format
msgid "Installing a package (pacman: {value1})."
msgstr "Instalando un paquete (pacman: {value1})."

msgid "Installing alongside Windows is not available in this version."
msgstr "La instalación junto a Windows no está disponible en esta versión."

msgid "Installing next to Windows requires a GPT disk with an existing startup partition."
msgstr "La instalación junto a Windows requiere un disco GPT con una partición de arranque existente."

msgid "Installing next to Windows requires exactly one FAT32 startup partition."
msgstr "La instalación junto a Windows requiere exactamente una partición de arranque FAT32."

msgid "Installing next to Windows requires exactly one existing FAT32 startup partition on the selected disk."
msgstr "La instalación junto a Windows requiere exactamente una partición de arranque FAT32 existente en el disco seleccionado."

msgid "Invalid GPT GUID."
msgstr "GUID de GPT no válido."

msgid "Invalid GPT geometry or name."
msgstr "Geometría o nombre GPT no válido."

msgid "Invalid UTF-8 JSON."
msgstr "JSON UTF-8 no válido."

msgid "Invalid Wi-Fi connection ID."
msgstr "ID de conexión Wi-Fi no válido."

msgid "Invalid account."
msgstr "Cuenta no válida."

msgid "Invalid config values."
msgstr "Valores de configuración no válidos."

msgid "Invalid display output name."
msgstr "Nombre de salida de pantalla no válido."

msgid "Invalid filesystem or format flag."
msgstr "Sistema de archivos o indicador de formato no válido."

msgid "Invalid frame length."
msgstr "Longitud de trama no válida."

msgid "Invalid full name."
msgstr "Nombre completo no válido."

#, python-brace-format
msgid "Invalid memdisk name {value1}."
msgstr "Nombre de memdisk no válido: {value1}."

msgid "Invalid mode."
msgstr "Modo no válido."

msgid "Invalid mount row."
msgstr "Fila de montaje no válida."

msgid "Invalid new partition."
msgstr "Partición nueva no válida."

msgid "Invalid partition changes."
msgstr "Cambios de particiones no válidos."

msgid "Invalid plan confirmation."
msgstr "Confirmación del plan no válida."

msgid "Invalid repository URL."
msgstr "URL de repositorio no válida."

msgid "Invalid resume sequence."
msgstr "Secuencia de reanudación no válida."

msgid "Invalid target path."
