msgstr "Registro de arranque NTFS ilegible después del cambio de tamaño."

msgid "Unsafe log destination."
msgstr "Destino del registro inseguro."

msgid "Unsafe offline pacman directive: HookDir."
msgstr "Directiva de pacman sin conexión insegura: HookDir."

#, python-brace-format
