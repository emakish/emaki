msgstr "Ejecuta la reparación como root: sudo emaki-boot-repair"

#, python-brace-format
msgid "Running package setup step {value1} of {value2} (pacman: {value3})."
msgstr "Ejecutando el paso de configuración de paquetes {value1} de {value2} (pacman: {value3})."

msgid "STOP: NTFS resize did not confirm success. Partition table untouched; inspect Windows before retrying."
msgstr "ALTO: el cambio de tamaño NTFS no confirmó el éxito. Tabla de particiones sin cambios; inspecciona Windows antes de reintentar."

