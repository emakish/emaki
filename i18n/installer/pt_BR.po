msgstr "Hibernação: reservar {value1} bytes ({value2} GiB), igual à RAM."

#, python-brace-format
msgid "Keep partition {value1} ({value2}, {value3}, {value4}) and its files; use: {value5}. Emaki could not check its files; its fallback loader will not be changed."
msgstr "Manter partição {value1} ({value2}, {value3}, {value4}) e seus arquivos; uso: {value5}. O Emaki não conseguiu verificar os arquivos da partição; o carregador alternativo dela não será alterado."

#, python-brace-format
msgid "Keep partition {value1} ({value2}, {value3}, {value4}) and its files; use: {value5}. It holds another system's startup files; its fallback loader will not be changed."
msgstr "Manter partição {value1} ({value2}, {value3}, {value4}) e seus arquivos; uso: {value5}. A partição contém arquivos de inicialização de outro sistema; seu carregador alternativo não será alterado."

#, python-brace-format
msgid "Partition {value1}: format {value3}, {value4} GiB; {value5}."
msgstr "A partição {value1} ({value3}, {value4} GiB) será formatada; {value5}."

#, python-brace-format
msgid "Partition {value1}: preserve {value3}, {value4} GiB; {value5}."
msgstr "A partição {value1} ({value3}, {value4} GiB) será preservada; {value5}."

msgid "Portuguese"
msgstr "Português"

msgid "Portuguese (Brazil)"
msgstr "Português (Brasil)"

msgid "Russian"
msgstr "Russo"

msgid "Spanish"
msgstr "Espanhol"

msgid "Spanish (Latin American)"
msgstr "Espanhol (América Latina)"

#, python-brace-format
msgid "Windows keeps {value1} GB, Emaki gets {value2} GB; back up your files first."
msgstr "O Windows mantém {value1} GB, o Emaki recebe {value2} GB; faça backup dos seus arquivos primeiro."

#, python-brace-format
msgid "{value1} contains a locked encrypted Linux system (LUKS). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contém um sistema Linux criptografado e bloqueado (LUKS). O instalador não pode verificar seu conteúdo; ele pode pertencer a um conjunto de vários discos."

#, python-brace-format
msgid "{value1} contains a locked encrypted Windows drive (BitLocker). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contém uma unidade do Windows criptografada e bloqueada (BitLocker). O instalador não pode verificar seu conteúdo; ele pode pertencer a um conjunto de vários discos."

#, python-brace-format
msgid "{value1} contains a locked encrypted macOS disk (FileVault 2). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contém um disco do macOS criptografado e bloqueado (FileVault 2). O instalador não pode verificar seu conteúdo; ele pode pertencer a um conjunto de vários discos."

#, python-brace-format
msgid "{value1} contains a macOS disk (APFS). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contém um disco do macOS (APFS). O instalador não pode verificar seu conteúdo; ele pode pertencer a um conjunto de vários discos."

#, python-brace-format
msgid "{value1} is active [{value2}]. Close it [cryptsetup close], then try again."
msgstr "{value1} está ativo [{value2}]. Feche-o [cryptsetup close], depois tente novamente."

#, python-brace-format
msgid "{value1} is active [{value2}]. Deactivate it [lvchange -an], then try again."
msgstr "{value1} está ativo [{value2}]. Desative-o [lvchange -an], depois tente novamente."

#, python-brace-format
msgid "{value1} is active [{value2}]. Stop it [mdadm --stop], then try again."
msgstr "{value1} está ativo [{value2}]. Pare-o [mdadm --stop], depois tente novamente."

#, python-brace-format
msgid "{value1} is one of {value2} devices of a Btrfs filesystem; erasing it would damage the other devices."
msgstr "{value1} é um dos {value2} dispositivos de um sistema de arquivos Btrfs; apagá-lo danificaria os outros dispositivos."

#, python-brace-format
msgid "{value1} is one of {value2} devices of a RAID array; erasing it would damage the other devices."
msgstr "{value1} é um dos {value2} dispositivos de um array RAID; apagá-lo danificaria os outros dispositivos."

#, python-brace-format
msgid "{value1} is one of {value2} devices of an LVM volume group; erasing it would damage the other devices."
msgstr "{value1} é um dos {value2} dispositivos de um grupo de volumes LVM; apagá-lo danificaria os outros dispositivos."

#, python-brace-format
msgid "{value} GiB"
msgstr "{value} GiB"


#, python-brace-format
msgid "Create partition {value1}: {value2}, {value3}; use: {value5}."
msgstr "Criar partição {value1}: {value2}, {value3}; uso: {value5}."

#, python-brace-format
msgid "Create partition {value1}: {value2}, {value3}, encrypted (LUKS2); use: {value5}."
msgstr "Criar partição {value1}: {value2}, {value3}, criptografada (LUKS2); uso: {value5}."

#, python-brace-format
msgid "Format partition {value1} ({value2}, {value3}) as {value4}: its files are lost; use: {value6}."
msgstr "Formatar partição {value1} ({value2}, {value3}) como {value4}: seus arquivos serão perdidos; uso: {value6}."

#, python-brace-format
msgid "Format partition {value1} ({value2}, {value3}) as {value4}, encrypted (LUKS2): its files are lost; use: {value6}."
msgstr "Formatar partição {value1} ({value2}, {value3}) como {value4}, criptografada (LUKS2): seus arquivos serão perdidos; uso: {value6}."

msgid "A new partition needs at least 1 GiB."
msgstr "Uma nova partição precisa de pelo menos 1 GiB."

#, python-brace-format
msgid "Wi-Fi country left unset: timezone {timezone} has no country."
msgstr "O país do Wi-Fi não foi definido: o fuso horário {timezone} não tem um país associado."

#, python-brace-format
msgid "Removing the stale ZFS signature; backups: {value1}."
msgstr "Removendo a assinatura ZFS obsoleta; backups: {value1}."

msgid "The stale ZFS label could not be removed safely. Installation stopped before creating Emaki partitions; inspect the installation log."
msgstr "Não foi possível remover o rótulo ZFS obsoleto com segurança. A instalação foi interrompida antes de criar as partições do Emaki; consulte o registro de instalação."
