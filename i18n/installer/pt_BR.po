msgid " (Rich software requires emaki-apps)"
msgstr " (o software Completo exige emaki-apps)"

msgid " The Windows data partition passed post-shrink verification before loader installation. Disk changes have already been made. Do not retry installation. Save the installation log to another device and seek recovery help before changing this disk."
msgstr " A partição de dados do Windows passou na verificação após a redução, antes da instalação do carregador. Alterações no disco já foram feitas. Não tente instalar novamente. Salve o registro de instalação em outro dispositivo e procure ajuda para recuperação antes de alterar este disco."


msgid "(no reply)"
msgstr "(sem resposta)"

msgid "--follow combines only with --plan --yes"
msgstr "--follow só pode ser combinado com --plan --yes"

msgid "--plan with --follow requires --yes"
msgstr "--plan com --follow exige --yes"

msgid "--yes requires --plan"
msgstr "--yes exige --plan"

msgid "/efi must be an existing GPT EFI system partition with FAT32."
msgstr "/efi deve ser uma partição de sistema EFI GPT existente com FAT32."

msgid "/home cannot be FAT; choose ext4 or btrfs."
msgstr "/home não pode ser FAT; escolha ext4 ou btrfs."

msgid "/swap is reserved for hibernation."
msgstr "/swap está reservado para hibernação."

msgid "64-bit UEFI is required."
msgstr "É necessário UEFI de 64 bits."

msgid "; could not complete request."
msgstr "; não foi possível concluir a solicitação."

msgid "; disk untouched: "
msgstr "; disco intacto: "

msgid "@swap is reserved for hibernation."
msgstr "@swap está reservado para hibernação."

msgid "A deleted partition cannot be used."
msgstr "Uma partição excluída não pode ser usada."

msgid "A disk ID is required."
msgstr "É necessário um ID de disco."

msgid "A kept partition changed its name. Nothing was formatted."
msgstr "Uma partição mantida mudou de nome. Nada foi formatado."

msgid "A new partition lies outside the space this disk's partition table lets partitions use. The disk was not changed."
msgstr "Uma nova partição está fora do espaço permitido pela tabela de partições deste disco. O disco não foi alterado."

msgid "A new partition must start and end on whole MiB inside the free space."
msgstr "Uma nova partição deve começar e terminar em MiB inteiros dentro do espaço livre."

msgid "A new partition overlaps another partition."
msgstr "Uma nova partição se sobrepõe a outra partição."

msgid "A new partition table is made only on an empty disk; this disk holds data."
msgstr "Uma nova tabela de partições só é criada em um disco vazio; este disco contém dados."

msgid "A new swap partition can only be used as swap."
msgstr "Uma nova partição swap só pode ser usada como swap."

msgid "A package download is incomplete; your disk has not been changed."
msgstr "O download de um pacote está incompleto; seu disco não foi alterado."

msgid "A partition is deleted twice."
msgstr "Uma partição foi marcada para exclusão duas vezes."

msgid "A partition to delete is not on the selected disk."
msgstr "Uma partição a excluir não está no disco selecionado."

msgid "A repository override requires a test build in test mode."
msgstr "A substituição do repositório exige uma compilação de teste no modo de teste."

msgid "A safety check stopped the update. Resolve the reported problem before trying again."
msgstr "Uma verificação de segurança interrompeu a atualização. Resolva o problema informado antes de tentar novamente."

msgid "A selected XKB layout is not available on this ISO."
msgstr "Um layout XKB selecionado não está disponível nesta ISO."

msgid "A separate disk password is only used with that password choice."
msgstr "Uma senha de disco separada só é usada com essa opção de senha."

msgid "A startup partition may only be mounted at /efi."
msgstr "Uma partição de inicialização só pode ser montada em /efi."

msgid "A swap partition cannot have other uses."
msgstr "Uma partição swap não pode ter outros usos."

msgid "A swap partition needs at least 256 MiB."
msgstr "Uma partição swap precisa de pelo menos 256 MiB."

msgid "A swap partition takes the swap format."
msgstr "Uma partição swap usa o formato swap."

msgid "A swapfile already exists at /swap/swapfile; move it before installing."
msgstr "Já existe um arquivo swap em /swap/swapfile; mova-o antes de instalar."

#, python-brace-format
msgid "Account: {value1}; hostname: {value2}; timezone: {value3}."
msgstr "Conta: {value1}; nome do computador: {value2}; fuso horário: {value3}."

msgid "Adding trusted package keys (pacman-key --populate)."
msgstr "Adicionando chaves de pacotes confiáveis (pacman-key --populate)."

msgid "After the restart a blue screen asks you to confirm Emaki's key with a password shown at the end of the installation; you do this only once."
msgstr "Após reiniciar, uma tela azul solicita a confirmação da chave do Emaki com uma senha exibida ao final da instalação; isso só precisa ser feito uma vez."

msgid "Alongside can format only Emaki's newly created startup partition and root."
msgstr "A instalação ao lado só pode formatar a partição de inicialização e a raiz recém-criadas do Emaki."

#, python-brace-format
msgid "Alongside installation on {path} ({model})."
msgstr "Instalação ao lado do Windows em {path} ({model})."

msgid "Alongside requires GPT."
msgstr "A instalação ao lado exige GPT."

msgid "Alongside requires partition_id and integer shrink_bytes (bytes freed for Emaki)."
msgstr "A instalação ao lado exige partition_id e shrink_bytes inteiro (bytes liberados para o Emaki)."

msgid "Alongside: create Emaki's own EFI system partition and root only inside the freed Windows extent."
msgstr "Instalação ao lado: criar a partição de sistema EFI e a raiz próprias do Emaki apenas dentro do espaço liberado do Windows."

msgid "Alongside: dry-run the exact NTFS size; no disk writes yet."
msgstr "Instalação ao lado: simular o tamanho NTFS exato; ainda sem gravações no disco."

msgid "Alongside: shrink only the Windows GPT entry, preserving its start, GUID, type, name and attributes."
msgstr "Instalação ao lado: reduzir apenas a entrada GPT do Windows, preservando seu início, GUID, tipo, nome e atributos."

msgid "Alongside: shrink the Windows filesystem; answering y after the successful dry run."
msgstr "Instalação ao lado: reduzir o sistema de arquivos do Windows; responder y após a simulação bem-sucedida."

msgid "Alongside: verify resized NTFS geometry and read-only metadata. Windows chkdsk on first boot is expected; the dirty flag is preserved."
msgstr "Instalação ao lado: verificar a geometria NTFS redimensionada e os metadados somente para leitura. Espera-se que o Windows execute chkdsk na primeira inicialização; a marca de volume sujo é preservada."

msgid "An EFI system partition needs at least 512 MiB."
msgstr "Uma partição de sistema EFI precisa de pelo menos 512 MiB."

msgid "An encrypted swap partition needs formatting and an encrypted root, which keeps its key."
msgstr "Uma partição swap criptografada exige formatação e uma raiz criptografada, que armazena a chave dela."

msgid "An installed file is in the way of this update. Resolve the file conflict before trying again."
msgstr "Um arquivo instalado impede esta atualização. Resolva o conflito de arquivos antes de tentar novamente."

msgid "An update step failed. Some packages may already have changed. Resolve the reported problem before updating again."
msgstr "Uma etapa da atualização falhou. Alguns pacotes podem já ter sido alterados. Resolva o problema informado antes de atualizar novamente."

msgid "Another package operation may be running. Wait for it to finish before trying again."
msgstr "Outra operação de pacotes pode estar em andamento. Aguarde a conclusão antes de tentar novamente."

msgid "Assign exactly one root and one startup partition, plus optional data mounts."
msgstr "Atribua exatamente uma raiz e uma partição de inicialização, além de montagens de dados opcionais."

msgid "At least 32 GiB must be freed from Windows for Emaki."
msgstr "É necessário liberar pelo menos 32 GiB do Windows para o Emaki."

msgid "Bounded termination requires a timeout, a positive budget and no stdin."
msgstr "O encerramento limitado exige um tempo limite, um prazo positivo e nenhuma entrada stdin."

#, python-brace-format
msgid "Btrfs mount options missing at {value1}."
msgstr "Faltam opções de montagem btrfs em {value1}."

msgid "Btrfs needs separate /home, /var/log, package cache and /.snapshots mounts."
msgstr "O btrfs exige montagens separadas para /home, /var/log, cache de pacotes e /.snapshots."

msgid "Btrfs root requires a separate snapshot subvolume on the root filesystem."
msgstr "A raiz btrfs exige um subvolume separado para snapshots no sistema de arquivos raiz."

#, python-brace-format
msgid "Building the startup image (mkinitcpio: {value1})."
msgstr "Criando a imagem de inicialização (mkinitcpio: {value1})."

msgid "Cannot create the log there; choose a new filename on mounted removable media."
msgstr "Não é possível criar o registro nesse local; escolha um novo nome de arquivo em uma mídia removível montada."

msgid "Cannot determine RAM size for hibernation."
msgstr "Não é possível determinar o tamanho da RAM para hibernação."

msgid "Cannot determine btrfs resume offset."
msgstr "Não é possível determinar o deslocamento de retomada do btrfs."

msgid "Cannot determine ext4 resume offset."
msgstr "Não é possível determinar o deslocamento de retomada do ext4."

msgid "Cannot determine the new account UID/GID."
msgstr "Não é possível determinar o UID/GID da nova conta."

msgid "Cannot identify the live boot medium."
msgstr "Não é possível identificar a mídia de inicialização live."

msgid "Cannot identify the live boot medium; installation is refused."
msgstr "Não é possível identificar a mídia de inicialização live; a instalação foi recusada."

msgid "Cannot inspect existing btrfs subvolumes."
msgstr "Não é possível inspecionar os subvolumes btrfs existentes."

msgid "Cannot load archinstall 4.5 and its dependencies: "
msgstr "Não é possível carregar o archinstall 4.5 e suas dependências: "

msgid "Cannot read the Windows volume signature."
msgstr "Não é possível ler a assinatura do volume do Windows."

#, python-brace-format
msgid "Cannot read the signature of {value1}; it may be part of a multi-device set."
msgstr "Não é possível ler a assinatura de {value1}; ele pode fazer parte de um conjunto com vários dispositivos."

#, python-brace-format
msgid "Cannot run {value1}: {value2}."
msgstr "Não é possível executar {value1}: {value2}."

msgid "Cannot safely inspect the Windows hibernation file."
msgstr "Não é possível inspecionar com segurança o arquivo de hibernação do Windows."

msgid "Cannot verify NTFS, hibernation state or GPT metadata: "
msgstr "Não é possível verificar NTFS, estado de hibernação ou metadados GPT: "

#, python-brace-format
msgid "Cannot write {value1}: {value2}."
msgstr "Não é possível gravar {value1}: {value2}."

msgid "Changing filesystem type requires format: true."
msgstr "Alterar o tipo de sistema de arquivos exige format: true."

msgid "Checking available disk space (pacman)."
msgstr "Verificando o espaço disponível em disco (pacman)."

msgid "Checking for conflicting files (pacman)."
msgstr "Verificando conflitos de arquivos (pacman)."

msgid "Checking package compatibility (pacman)."
msgstr "Verificando a compatibilidade dos pacotes (pacman)."

msgid "Checking package files (pacman)."
msgstr "Verificando os arquivos dos pacotes (pacman)."

msgid "Checking trusted package keys (pacman)."
msgstr "Verificando as chaves confiáveis dos pacotes (pacman)."

msgid "Choose Rich or Minimal software."
msgstr "Escolha o software Completo ou Mínimo."

msgid "Choose a log file on removable media."
msgstr "Escolha um arquivo de registro em uma mídia removível."

msgid "Choose a time zone from the city list."
msgstr "Escolha um fuso horário na lista de cidades."

msgid "Choose a whole-MiB Emaki size within the verified shrink bounds (at least 32 GiB)."
msgstr "Escolha um tamanho para o Emaki em MiB inteiros dentro dos limites de redução verificados (pelo menos 32 GiB)."

msgid "Choose btrfs or ext4."
msgstr "Escolha btrfs ou ext4."

msgid "Choose whether to encrypt the disk and which password to use."
msgstr "Escolha se deseja criptografar o disco e qual senha usar."

msgid "Cleanup failed: "
msgstr "A limpeza falhou: "

msgid "Config must be an object."
msgstr "A configuração deve ser um objeto."

msgid "Confirm the reviewed disk plan and install."
msgstr "Confirme o plano de disco revisado e instale."

msgid "Connected"
msgstr "Conectado"

msgid "Connected, but the Wi-Fi settings could not be saved for installation. Connect again."
msgstr "Conectado, mas não foi possível salvar as configurações de Wi-Fi para a instalação. Conecte-se novamente."

msgid "Connection timed out."
msgstr "O tempo de conexão esgotou."

msgid "Could not connect to this network."
msgstr "Não foi possível conectar a esta rede."

msgid "Could not connect. Check the password."
msgstr "Não foi possível conectar. Confira a senha."

msgid "Could not prepare to restart. Keep the USB stick connected and try again."
msgstr "Não foi possível preparar a reinicialização. Mantenha o pendrive conectado e tente novamente."

msgid "Could not restart. Try again, or hold the power button to turn the computer off, then start it again. Your installation is safe."
msgstr "Não foi possível reiniciar. Tente novamente ou mantenha o botão de energia pressionado para desligar o computador e ligue-o novamente. Sua instalação está segura."

msgid "Could not save the Wi-Fi connection [NetworkManager]. Connect to that network again before installing."
msgstr "Não foi possível salvar a conexão Wi-Fi [NetworkManager]. Conecte-se a essa rede novamente antes de instalar."

#, python-brace-format
msgid "Could not stop target process {value1}: {value2}"
msgstr "Não foi possível parar o processo de destino {value1}: {value2}"

msgid "Could not unmount all target filesystems; inspect the log before retrying."
msgstr "Não foi possível desmontar todos os sistemas de arquivos de destino; inspecione o registro antes de tentar novamente."

msgid "Create Emaki's own startup partition (1 GiB) and root in the freed space; Windows' startup partition is not changed."
msgstr "Criar a partição de inicialização (1 GiB) e a raiz próprias do Emaki no espaço liberado; a partição de inicialização do Windows não será alterada."

#, python-brace-format
msgid "Create a new GPT partition table on {value1}; the disk is empty."
msgstr "Criar uma nova tabela de partições GPT em {value1}; o disco está vazio."

msgid "Create the partitions for the new partition table."
msgstr "Crie as partições para a nova tabela de partições."

msgid "Creating the package trust store (pacman-key --init)."
msgstr "Criando o armazenamento de chaves confiáveis dos pacotes (pacman-key --init)."

#, python-brace-format
msgid "DKMS module {value1}/{value2} for {value3} has no built modules."
msgstr "O módulo DKMS {value1}/{value2} para {value3} não tem módulos compilados."

#, python-brace-format
msgid "DKMS module {value1}/{value2} for {value3} is not signed by the machine key: "
msgstr "O módulo DKMS {value1}/{value2} para {value3} não está assinado pela chave da máquina: "

#, python-brace-format
msgid "Delete partition {value1} ({value2}): all its files are lost."
msgstr "Excluir partição {value1} ({value2}): todos os seus arquivos serão perdidos."

msgid "Deleted partitions lose all their files. Nothing on the disk changes until you press Install."
msgstr "As partições excluídas perdem todos os arquivos. Nada no disco muda até você pressionar Instalar."

msgid "Destination is not on a mounted removable filesystem."
msgstr "O destino não está em um sistema de arquivos removível montado."

msgid "Destination is not removable/USB media."
msgstr "O destino não é uma mídia removível/USB."

msgid "Destination mount changed during export."
msgstr "A montagem de destino mudou durante a exportação."

msgid "Destination must be block media."
msgstr "O destino deve ser uma mídia de blocos."

msgid "Destination must be under /run/media/live/."
msgstr "O destino deve estar em /run/media/live/."

#, python-brace-format
msgid "Device cannot be opened exclusively: {value1}."
msgstr "Não é possível abrir o dispositivo com exclusividade: {value1}."

msgid "Disk identity or partition layout changed after the review."
msgstr "A identidade do disco ou a disposição das partições mudou após a revisão."

msgid "Disk password must be nonempty and contain no control characters (line breaks, tabs)."
msgstr "A senha do disco não pode estar vazia nem conter caracteres de controle (quebras de linha, tabulações)."

msgid "Display scale must be a number from 0.5 to 4."
msgstr "A escala da tela deve ser um número de 0.5 a 4."

msgid "Display scales must be an object with at most 64 outputs."
msgstr "As escalas das telas devem ser um objeto com no máximo 64 saídas."

msgid "Duplicate fstab mountpoint."
msgstr "Ponto de montagem duplicado no fstab."

msgid "Duplicate mountpoint."
msgstr "Ponto de montagem duplicado."

msgid "Duplicate subvolume name."
msgstr "Nome de subvolume duplicado."

msgid "EFI loader is not a valid bounded file."
msgstr "O carregador EFI não é um arquivo válido de tamanho limitado."

msgid "EFI loader path contains a symlink."
msgstr "O caminho do carregador EFI contém um link simbólico."

msgid "Emaki could not confirm that the Windows disk is safe to shrink. Start Windows, let it check the disk if it asks, then choose Shut down (not Restart) and start from the USB stick again."
msgstr "O Emaki não conseguiu confirmar que é seguro reduzir o disco do Windows. Inicie o Windows, permita que ele verifique o disco se solicitado, escolha Desligar (não Reiniciar) e inicie pelo pendrive novamente."

msgid "Emaki could not make itself the computer's default startup choice. If another system starts instead, choose Emaki in the firmware boot menu."
msgstr "O Emaki não conseguiu se definir como opção padrão de inicialização do computador. Se outro sistema iniciar, escolha Emaki no menu de inicialização do firmware."

msgid "Emaki could not make itself the computer's default startup choice. If another system starts instead, start the installation USB and use its GRUB console to load EFI/Emaki/grubx64.efi from this installation's startup partition."
msgstr "O Emaki não conseguiu se definir como opção padrão de inicialização do computador. Se outro sistema iniciar, inicie pelo USB de instalação e use o console GRUB dele para carregar EFI/Emaki/grubx64.efi da partição de inicialização desta instalação."

msgid "Emaki could not verify that the firmware starts the new installation first."
msgstr "O Emaki não conseguiu verificar se o firmware inicia a nova instalação primeiro."

msgid "Emaki installer protocol client (live ISO)."
msgstr "Cliente do protocolo do instalador do Emaki (ISO live)."

msgid "Emaki needs one full update before you install apps; when online, use the terminal to update the whole system [pacman]."
msgstr "O Emaki precisa de uma atualização completa antes de você instalar aplicativos; quando estiver conectado, use o terminal para atualizar todo o sistema [pacman]."

#, python-brace-format
msgid "Emaki needs two free GPT partition entries (its startup partition and its root); this disk has {value1}."
msgstr "O Emaki precisa de duas entradas GPT livres (sua partição de inicialização e sua raiz); este disco tem {value1}."

msgid "Emaki owns device discovery"
msgstr "O Emaki gerencia a descoberta de dispositivos"

msgid "Emaki requires archinstall distribution version 4.5."
msgstr "O Emaki exige a versão 4.5 da distribuição archinstall."

msgid "Emaki's startup partition could not be verified from its saved partition identity. Nothing was changed."
msgstr "Não foi possível verificar a partição de inicialização do Emaki pela identidade de partição salva. Nada foi alterado."

msgid "Emaki's startup partition is not a new one; disk untouched."
msgstr "A partição de inicialização do Emaki não é nova; disco intacto."

msgid "Encrypted root has no LUKS UUID."
msgstr "A raiz criptografada não tem UUID LUKS."

msgid "Encrypted-volume confirmations require a device path, encryption type and UUID."
msgstr "Confirmações de volumes criptografados exigem um caminho de dispositivo, tipo de criptografia e UUID."

msgid "Encrypting root requires formatting it; existing files cannot be encrypted in place."
msgstr "Criptografar a raiz exige formatá-la; arquivos existentes não podem ser criptografados no local."

msgid "Encryption: LUKS2 root, account password."
msgstr "Criptografia: raiz LUKS2, senha da conta."

msgid "Encryption: LUKS2 root, separate disk password."
msgstr "Criptografia: raiz LUKS2, senha separada do disco."

msgid "Encryption: off."
msgstr "Criptografia: desativada."

msgid "Erase all partitions and create a new GPT partition table."
msgstr "Apagar todas as partições e criar uma nova tabela de partições GPT."

msgid "Erase disk"
msgstr "Apagar disco"

#, python-brace-format
msgid "Erase installation on {path} ({model})."
msgstr "Apagar o disco {path} ({model}) e instalar."

msgid "Every new partition needs a use: choose its mount point or swap, or remove it."
msgstr "Cada nova partição precisa de uma finalidade: escolha seu ponto de montagem ou swap, ou remova-a."

msgid "Exactly one / and one /efi are required."
msgstr "É necessário exatamente um / e um /efi."

msgid "Existing snapper root config points at a different subvolume."
msgstr "A configuração existente da raiz no snapper aponta para outro subvolume."

msgid "Finding required packages (pacman)."
msgstr "Localizando os pacotes necessários (pacman)."

msgid "Freed extent overlaps another partition."
msgstr "O espaço liberado se sobrepõe a outra partição."

#, python-brace-format
msgid "Fresh Emaki {value1} install"
msgstr "Nova instalação do Emaki {value1}"

msgid "GPT identity or geometry could not be verified."
msgstr "Não foi possível verificar a identidade ou a geometria GPT."

msgid "GPT validation failed; Windows will not be resized."
msgstr "A validação GPT falhou; o Windows não será redimensionado."

msgid "GRUB NVRAM registration failed and no removable loader could be installed."
msgstr "O registro do GRUB na NVRAM falhou e não foi possível instalar um carregador removível."

#, python-brace-format
msgid "GRUB has no executable entry for {value1}."
msgstr "O GRUB não tem uma entrada executável para {value1}."

#, python-brace-format
msgid "GRUB loader {value1} does not carry the expected prefix; the unlock screen was not built."
msgstr "O carregador GRUB {value1} não contém o prefixo esperado; a tela de desbloqueio não foi criada."

msgid "GRUB's SBAT data is missing or unrecognized."
msgstr "Os dados SBAT do GRUB estão ausentes ou não foram reconhecidos."

msgid "GRUB's SBAT data names no GRUB version."
msgstr "Os dados SBAT do GRUB não indicam uma versão do GRUB."

msgid "GRUB, linux + linux-lts; /boot inside root; zram with higher swap priority."
msgstr "GRUB, linux + linux-lts; /boot dentro da raiz; zram com prioridade de swap maior."

#, python-brace-format
msgid "Graphics controller (PCI {value1:04x}:"
msgstr "Controlador gráfico (PCI {value1:04x}:"

#, python-brace-format
msgid "Graphics driver packages (Nvidia): {packages}."
msgstr "Pacotes de drivers gráficos (Nvidia): {packages}."

msgid "Graphics hardware or driver availability changed; prepare a new installation plan."
msgstr "O hardware gráfico ou a disponibilidade de drivers mudou; prepare um novo plano de instalação."

msgid "Hibernation writes memory, including passwords, to the disk unencrypted."
msgstr "A hibernação grava a memória, incluindo senhas, no disco sem criptografia."

msgid "Hibernation: off."
msgstr "Hibernação: desativada."

msgid "Hostname must be one DNS label (1–63 characters)."
msgstr "O nome do computador deve ser um único rótulo DNS (de 1 a 63 caracteres)."

msgid "Implicit and explicit mounts overlap."
msgstr "Montagens implícitas e explícitas se sobrepõem."

msgid "Installation cancelled at a phase boundary; disk changes are not undone."
msgstr "Instalação cancelada ao final de uma etapa; as alterações no disco não foram desfeitas."

msgid "Installation complete; syncing and unmounting target filesystems."
msgstr "Instalação concluída; sincronizando e desmontando os sistemas de arquivos de destino."

#, python-brace-format
msgid "Installation failed: {value1}: {value2}"
msgstr "A instalação falhou: {value1}: {value2}"

msgid "Installer connection closed or sent an invalid frame."
msgstr "A conexão com o instalador foi fechada ou enviou um quadro inválido."

#, python-brace-format
msgid "Installing a package (pacman: {value1})."
msgstr "Instalando um pacote (pacman: {value1})."

msgid "Installing alongside Windows is not available in this version."
msgstr "A instalação ao lado do Windows não está disponível nesta versão."

msgid "Installing next to Windows requires a GPT disk with an existing startup partition."
msgstr "A instalação ao lado do Windows exige um disco GPT com uma partição de inicialização existente."

msgid "Installing next to Windows requires exactly one FAT32 startup partition."
msgstr "A instalação ao lado do Windows exige exatamente uma partição de inicialização FAT32."

msgid "Installing next to Windows requires exactly one existing FAT32 startup partition on the selected disk."
msgstr "A instalação ao lado do Windows exige exatamente uma partição de inicialização FAT32 existente no disco selecionado."

msgid "Invalid GPT GUID."
msgstr "GUID GPT inválido."

msgid "Invalid GPT geometry or name."
msgstr "Geometria ou nome GPT inválido."

msgid "Invalid UTF-8 JSON."
msgstr "JSON UTF-8 inválido."

msgid "Invalid Wi-Fi connection ID."
msgstr "ID de conexão Wi-Fi inválido."

msgid "Invalid account."
msgstr "Conta inválida."

msgid "Invalid config values."
msgstr "Valores de configuração inválidos."

msgid "Invalid display output name."
msgstr "Nome de saída de tela inválido."

msgid "Invalid filesystem or format flag."
msgstr "Sistema de arquivos ou sinalizador de formatação inválido."

msgid "Invalid frame length."
msgstr "Comprimento de quadro inválido."

msgid "Invalid full name."
msgstr "Nome completo inválido."

#, python-brace-format
msgid "Invalid memdisk name {value1}."
msgstr "Nome de memdisk inválido: {value1}."

msgid "Invalid mode."
msgstr "Modo inválido."

msgid "Invalid mount row."
msgstr "Linha de montagem inválida."

msgid "Invalid new partition."
msgstr "Nova partição inválida."

msgid "Invalid partition changes."
msgstr "Alterações de partição inválidas."

msgid "Invalid plan confirmation."
msgstr "Confirmação de plano inválida."

msgid "Invalid repository URL."
msgstr "URL de repositório inválida."

msgid "Invalid resume sequence."
msgstr "Sequência de retomada inválida."

msgid "Invalid target path."
msgstr "Caminho de destino inválido."

msgid "Invalid time zone data."
