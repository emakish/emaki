msgstr "Перезапуск недоступен."

msgid "Refusing process cleanup of the live root."
msgstr "Отказ от очистки процессов корня временного сеанса."

msgid "Removed the stale pacman lock; no pacman runs in the target."
msgstr "Устаревшая блокировка pacman удалена; в целевой системе pacman не работает."

#, python-brace-format
msgid "Repairing the installed Emaki on {root} with the startup partition {esp}."
msgstr "Восстановление установленного Emaki на {root} с загрузочным разделом {esp}."

msgid "Repeated partition rows need distinct subvolumes and identical format flags."
msgstr "Повторные строки раздела требуют разных подтомов и одинаковых флагов форматирования."

msgid "Repository URL must be HTTPS, without credentials or fragments."
msgstr "URL репозитория должен использовать HTTPS, без учётных данных и фрагментов."

msgid "Request failed: "
msgstr "Ошибка запроса: "

msgid "Requests need a string type and a nonempty ID (at most 128 characters)."
msgstr "Запросам нужны строковый тип и непустой идентификатор (не более 128 символов)."

#, python-brace-format
msgid "Required target file missing: {value1}."
msgstr "Отсутствует необходимый целевой файл: {value1}."

#, python-brace-format
msgid "Restart scope adoption failed: {value1}. Continuing without verified isolation; the guardian may remain in the installer service cgroup."
msgstr "Не удалось включить перезапуск в область: {value1}. Продолжение без проверенной изоляции; наблюдатель может остаться в cgroup службы установщика."

msgid "Resume a known job, including a completed job."
msgstr "Возобновить известное задание, включая завершённое."

msgid "Rich — desktop apps, office, email, media and utilities."
msgstr "Полный — приложения рабочего стола, офис, почта, мультимедиа и утилиты."

msgid "Root encryption is chosen on the Encryption step (the plan encryption)."
msgstr "Шифрование корневого раздела выбирается на шаге «Шифрование» (шифрование плана)."

msgid "Root must be btrfs or ext4."
msgstr "Корневой раздел должен быть в btrfs или ext4."

msgid "Root needs 20 GiB plus the RAM-sized hibernation file and encryption header."
msgstr "Корневому разделу нужно 20 GiB плюс файл гибернации размером с ОЗУ и заголовок шифрования."

msgid "Root partition must be at least 20 GiB."
msgstr "Корневой раздел должен быть не менее 20 GiB."

msgid "Run the repair as root: sudo emaki-boot-repair"
msgstr "Запустите восстановление от root: sudo emaki-boot-repair"

#, python-brace-format
msgid "Running package setup step {value1} of {value2} (pacman: {value3})."
msgstr "Выполнение этапа настройки пакетов {value1} из {value2} (pacman: {value3})."

msgid "STOP: NTFS resize did not confirm success. Partition table untouched; inspect Windows before retrying."
msgstr "СТОП: успешное изменение размера NTFS не подтверждено. Таблица разделов не затронута; прежде чем повторять, проверьте Windows."

msgid "STOP: Windows GPT metadata differs after shrink. No Emaki root was created."
msgstr "СТОП: метаданные GPT Windows отличаются после уменьшения. Корневой раздел Emaki не создан."

msgid "STOP: Windows was resized but the post-shrink NTFS check failed. No Emaki root was created or formatted. Do not retry the installer; boot Windows for a consistency check and inspect the installation log."
msgstr "СТОП: размер Windows изменён, но проверка NTFS после уменьшения не пройдена. Корневой раздел Emaki не создан и не отформатирован. Не запускайте установщик повторно; загрузите Windows для проверки целостности и изучите журнал установки."

msgid "STOP: an existing partition changed unexpectedly; formatting refused."
msgstr "СТОП: существующий раздел неожиданно изменился; форматирование отклонено."

msgid "STOP: changing the partition table failed after it had begun, so the disk may have been changed. Nothing was formatted; inspect the disk and the installation log before trying again."
msgstr "СТОП: изменение таблицы разделов завершилось ошибкой после начала, поэтому диск мог измениться. Ничего не отформатировано; проверьте диск и журнал установки перед повтором."

msgid "STOP: preserved GPT metadata changed. No Emaki root was created."
msgstr "СТОП: сохраняемые метаданные GPT изменились. Корневой раздел Emaki не создан."

msgid "STOP: the partition table differs from the reviewed changes after writing. Nothing was formatted; inspect the disk and the installation log."
msgstr "СТОП: после записи таблица разделов отличается от проверенных изменений. Ничего не отформатировано; проверьте диск и журнал установки."

msgid "STOP: unexpected partition table after shrinking Windows."
msgstr "СТОП: неожиданная таблица разделов после уменьшения раздела Windows."

#, python-brace-format
msgid "STOP: {value1} differs from the approved freed extent; formatting refused."
msgstr "СТОП: {value1} отличается от утверждённой освобождённой области; форматирование отклонено."

msgid "Scale must be null or a number from 0.5 to 4."
msgstr "Масштаб должен быть null или числом от 0,5 до 4."

msgid "Secure Boot is on, but this computer does not trust the Microsoft certificate Emaki starts with. In your firmware settings, turn on the third-party certificate option (often \"Allow Microsoft 3rd Party UEFI CA\") or turn Secure Boot off, then start the USB again. No disk has been changed."
msgstr "Secure Boot включён, но компьютер не доверяет сертификату Microsoft, с которым запускается Emaki. В настройках прошивки включите разрешение сторонних сертификатов (часто «Allow Microsoft 3rd Party UEFI CA») или выключите Secure Boot и снова загрузитесь с USB. Ни один диск не изменён."

#, python-brace-format
msgid "Secure Boot on a kept startup partition: it has {value1} bytes free, this installation and later boot updates need {value2}."
msgstr "Secure Boot на сохраняемом загрузочном разделе: свободно {value1} байтов, этой установке и последующим обновлениям загрузки нужно {value2}."

msgid "Secure Boot: on; the firmware trusts the Microsoft UEFI CA 2011 and 2023."
msgstr "Secure Boot: включён; прошивка доверяет Microsoft UEFI CA 2011 и 2023."

msgid "Secure Boot: on; the firmware trusts the Microsoft UEFI CA 2011 only."
msgstr "Secure Boot: включён; прошивка доверяет только Microsoft UEFI CA 2011."

msgid "Secure Boot: on; the firmware trusts the Microsoft UEFI CA 2023 only."
msgstr "Secure Boot: включён; прошивка доверяет только Microsoft UEFI CA 2023."

msgid "Secure Boot: removing the firmware entries of an earlier Emaki boot slot on this disk: "
msgstr "Secure Boot: удаление записей прошивки прежнего загрузочного слота Emaki на этом диске: "

msgid "Secure Boot: the machine key waits for confirmation in MokManager at the next start."
msgstr "Secure Boot: ключ компьютера ожидает подтверждения в MokManager при следующем запуске."

msgid "Selected Windows NTFS partition is not on this disk."
msgstr "Выбранный раздел Windows NTFS находится не на этом диске."

msgid "Selected disk no longer exists."
msgstr "Выбранный диск больше не существует."

msgid "Shrink the Windows filesystem and its partition end only; preserve its start, GUID, type, name and files."
msgstr "Уменьшить файловую систему Windows и сдвинуть только конец её раздела; начало, GUID, тип, имя и файлы раздела сохраняются."

#, python-brace-format
msgid "Shutdown ramfs preparation failed or was skipped: {value1}"
msgstr "Подготовка ramfs для выключения не удалась или пропущена: {value1}"

msgid "Socket path is not a socket."
msgstr "Путь сокета не является сокетом."

msgid "Software: "
msgstr "Программы: "

msgid "Some packages need different versions of each other. Wait for matching packages, then try the full update again."
msgstr "Некоторым пакетам нужны другие версии других пакетов, которых ещё нет в репозиториях. Дождитесь совместимых версий и повторите полное обновление."

msgid "Start the computer from the Emaki installation USB and run sudo emaki-boot-repair there."
msgstr "Загрузите компьютер с установочного USB Emaki и выполните там sudo emaki-boot-repair."

#, python-brace-format
msgid "Stopping target process {value1}: {value2}"
msgstr "Остановка целевого процесса {value1}: {value2}"

msgid "Subvolume name is a symlink."
msgstr "Имя подтома является символической ссылкой."

msgid "Supply one to four distinct XKB layouts."
msgstr "Укажите от одной до четырёх разных раскладок XKB."

msgid "Swapfile size or resume offset is invalid."
msgstr "Недопустимый размер файла подкачки или смещение возобновления."

msgid "Target pacman.conf is missing standard Arch repositories."
msgstr "В целевом pacman.conf отсутствуют стандартные репозитории Arch."

msgid "Target root is a symlink."
msgstr "Целевой корень является символической ссылкой."

#, python-brace-format
msgid "Target symlink refused: {value1}."
msgstr "Целевая символическая ссылка отклонена: {value1}."

#, python-brace-format
msgid "Target {value1} has unsafe directory permissions."
msgstr "У цели {value1} небезопасные права доступа к каталогу."

msgid "Test mode requires /etc/emaki-test/authorized_keys."
msgstr "Тестовый режим требует /etc/emaki-test/authorized_keys."

msgid "The GRUB early config must be printable ASCII."
msgstr "Ранняя конфигурация GRUB должна состоять из печатных символов ASCII."

msgid "The GRUB image command names no single output."
msgstr "Команда создания образа GRUB не задаёт единственный выходной файл."

msgid "The GRUB unlock-screen assets are invalid: "
msgstr "Недопустимые ресурсы экрана разблокировки GRUB: "

msgid "The GRUB unlock-screen font is missing from this ISO."
msgstr "Шрифт экрана разблокировки GRUB отсутствует на этом ISO."

msgid "The GRUB unlock-screen font is not a PFF2 font."
msgstr "Шрифт экрана разблокировки GRUB не является шрифтом PFF2."

msgid "The GRUB version for SBAT is invalid."
msgstr "Недопустимая версия GRUB для SBAT."

msgid "The ISO XKB layout inventory is unavailable."
msgstr "Список раскладок XKB ISO недоступен."

msgid "The Secure Boot key could not be mounted read-only, so nothing was changed."
msgstr "Не удалось смонтировать ключ Secure Boot только для чтения, поэтому ничего не изменено."

msgid "The Secure Boot setting changed after the review; prepare a new installation plan."
msgstr "Настройка Secure Boot изменилась после обзора; подготовьте новый план установки."

msgid "The Windows part of this disk is set up in a way Emaki cannot safely shrink."
msgstr "Часть диска с Windows устроена так, что Emaki не может безопасно уменьшить её раздел."

msgid "The Windows partition does not start on a 1 MiB boundary; this layout is unsupported."
msgstr "Раздел Windows начинается не на границе 1 MiB; такое расположение не поддерживается."

msgid "The Windows partition is mounted, held, or in use. Unmount it before trying again."
msgstr "Раздел Windows смонтирован или занят. Размонтируйте его и повторите попытку."

msgid "The Windows partition or its disk is mounted, held, or in use."
msgstr "Раздел Windows или его диск смонтирован или занят."

msgid "The automatic clock setting could not be restored (network time). Check the date and time in the live session, then try again. Your disk has not been changed."
msgstr "Не удалось восстановить автоматическую настройку часов (сетевое время). Проверьте дату и время во временном сеансе и повторите попытку. Диск не изменён."

msgid "The available packages do not yet match this Emaki release. Wait for matching packages, then try the full update again. Do not force this update."
msgstr "Доступные пакеты ещё не соответствуют этому выпуску Emaki. Дождитесь совместимых пакетов и повторите полное обновление. Не выполняйте обновление принудительно."

#, python-brace-format
msgid "The boot slot a could not be written: {value1}"
msgstr "Не удалось записать загрузочный слот «a»: {value1}"

msgid "The computer clock could not be corrected. Set the date and time in the live session, then try again. Your disk has not been changed."
msgstr "Не удалось исправить часы компьютера. Установите дату и время во временном сеансе и повторите попытку. Диск не изменён."

msgid "The computer clock is still incorrect. Set the date and time in the live session, then try again. Your disk has not been changed."
msgstr "Часы компьютера всё ещё неверны. Установите дату и время во временном сеансе и повторите попытку. Диск не изменён."

msgid "The computer clock was corrected for this live session so package signatures can be checked."
msgstr "Часы компьютера исправлены для временного сеанса, чтобы можно было проверить подписи пакетов."

msgid "The current time could not be checked online. If package signatures fail, check the date and time in the live session."
msgstr "Не удалось проверить текущее время в интернете. При ошибках подписей пакетов проверьте дату и время во временном сеансе."

msgid "The default (first) layout must type Latin letters; a non-Latin layout can be second."
msgstr "Основная (первая) раскладка должна вводить латинские буквы; нелатинская может быть второй."

msgid "The disk could not be read. Installation stopped."
msgstr "Не удалось прочитать диск. Установка остановлена."

msgid "The disk does not hold a GPT partition table."
msgstr "На диске нет таблицы разделов GPT."

#, python-brace-format
msgid "The disk inspection stopped because {target} could not be unmounted: {error}. No more disks were inspected."
msgstr "Проверка дисков остановилась: не удалось размонтировать {target}: {error}. Другие диски не проверялись."

msgid "The disk is busy. Close its files and unmount its volumes [umount], then try again."
msgstr "Диск занят. Закройте его файлы и размонтируйте тома [umount], затем повторите попытку."

msgid "The disk is no longer empty. The disk was not changed; start a new review."
msgstr "Диск больше не пуст. Диск не изменён; начните новый обзор."

msgid "The disk is read-only or is the live boot medium."
msgstr "Диск доступен только для чтения или является загрузочным носителем."

msgid "The disk is still being read. Try again in a moment."
msgstr "Чтение диска ещё идёт. Повторите попытку чуть позже."

msgid "The disk must be at least 24 GiB."
msgstr "Диск должен быть не менее 24 GiB."

msgid "The disk sector size changed. Installation stopped."
msgstr "Размер сектора диска изменился. Установка остановлена."

msgid "The disk sector size changed. The disk was not changed; start a new review."
msgstr "Размер сектора диска изменился. Диск не изменён; начните новый обзор."

msgid "The disk sector size could not be read. The disk was not changed."
msgstr "Не удалось прочитать размер сектора диска. Диск не изменён."

msgid "The disk sequence number could not be read. Installation stopped."
msgstr "Не удалось прочитать порядковый номер диска. Установка остановлена."

msgid "The disk sequence number is unknown. Installation stopped."
msgstr "Порядковый номер диска неизвестен. Установка остановлена."

msgid "The disk was read again and its partition table changed after installation stopped. Close the installer and inspect the disk before starting a new review."
msgstr "Диск прочитан заново, и его таблица разделов изменилась после остановки установки. Закройте установщик и проверьте диск перед новым обзором."

msgid "The disk was replaced after the review. Installation stopped."
msgstr "Диск заменён после обзора. Установка остановлена."

msgid "The disk's startup files could not be checked safely, so Emaki stopped."
msgstr "Не удалось безопасно проверить загрузочные файлы диска, поэтому Emaki остановился."

#, python-brace-format
msgid "The disk's startup partition is too full for Secure Boot updates: Emaki needs about {need} MB free there (it has {free} MB). Making it bigger needs a backup and a disk tool. Do not delete Windows startup files."
msgstr "Загрузочный раздел диска слишком заполнен для обновлений Secure Boot: Emaki нужно около {need} MB свободного места (есть {free} MB). Для увеличения раздела нужны резервная копия и инструмент работы с дисками. Не удаляйте загрузочные файлы Windows."

msgid "The disk's startup partitions could not be identified safely, so Emaki stopped."
msgstr "Не удалось безопасно определить загрузочные разделы диска, поэтому Emaki остановился."

msgid "The downloaded package repository could not be prepared; your disk has not been changed."
msgstr "Не удалось подготовить загруженный репозиторий пакетов; диск не изменён."

#, python-brace-format
msgid "The encrypted partition {value1} could not be identified."
msgstr "Не удалось определить зашифрованный раздел {value1}."

msgid "The encrypted system partition could not be identified."
msgstr "Не удалось определить зашифрованный системный раздел."

msgid "The firmware could not save a startup entry (NVRAM/efibootmgr). Emaki installed the standard fallback loader (EFI/BOOT/BOOTX64.EFI). If needed, choose this disk in your firmware boot menu."
msgstr "Прошивка не смогла сохранить загрузочную запись (NVRAM/efibootmgr). Emaki установил стандартный резервный загрузчик (EFI/BOOT/BOOTX64.EFI). При необходимости выберите этот диск в меню загрузки прошивки."

msgid "The firmware entry for Emaki could not be activated."
msgstr "Не удалось активировать запись Emaki в прошивке."

msgid "The firmware entry for Emaki is not first after removing the unsigned one."
msgstr "Запись Emaki в прошивке не стала первой после удаления неподписанной."

msgid "The firmware signature database is malformed."
msgstr "База подписей прошивки имеет неверный формат."

msgid "The firmware signature database is truncated."
msgstr "База подписей прошивки обрезана."

msgid "The firmware signature setting could not be read (Secure Boot). Restart into your firmware settings, turn Secure Boot off, then start the USB again. No disk has been changed."
msgstr "Не удалось прочитать настройку проверки подписей прошивки (Secure Boot). Перезапустите компьютер, войдите в настройки прошивки, выключите Secure Boot и снова загрузитесь с USB. Ни один диск не изменён."

msgid "The firmware startup entries could not be read, so the startup copies were not replaced."
msgstr "Не удалось прочитать загрузочные записи в прошивке, поэтому загрузочные копии не заменены."

msgid "The firmware still starts an earlier Emaki startup copy on this disk, so the startup copies were not replaced."
msgstr "Прошивка всё ещё запускает прежнюю загрузочную копию Emaki на этом диске, поэтому загрузочные копии не заменены."

#, python-brace-format
msgid "The firmware variable {value1} is unreadable."
msgstr "Переменная прошивки {value1} нечитаема."

msgid "The formatted partition could not be identified."
msgstr "Не удалось определить отформатированный раздел."

msgid "The free space Secure Boot updates need on the disk's startup partition could not be checked."
msgstr "Не удалось проверить свободное место для обновлений Secure Boot на загрузочном разделе диска."

msgid "The grub package has no kernel.img or moddep.lst for x86_64-efi."
msgstr "В пакете grub нет kernel.img или moddep.lst для x86_64-efi."

msgid "The grub package lacks the modules "
msgstr "В пакете grub отсутствуют модули "

msgid "The installation files are missing. Connect to the internet and try again (Ventoy or copytoram). Your disk has not been changed."
msgstr "Установочные файлы отсутствуют. Подключитесь к интернету и повторите попытку (Ventoy или copytoram). Диск не изменён."

msgid "The installation files are missing. Connect to the internet before installing (Ventoy or copytoram)."
msgstr "Установочные файлы отсутствуют. Подключитесь к интернету перед установкой (Ventoy или copytoram)."

msgid "The installation files could not be downloaded and checked. Check the internet connection and free space in the live session, then try again; your disk has not been changed. "
msgstr "Не удалось загрузить и проверить установочные файлы. Проверьте интернет и свободное место во временном сеансе, затем повторите попытку; диск не изменён. "

msgid "The installation files were not found on the live medium. Packages will be downloaded and checked before your disk is changed. Keep the internet connection active (Ventoy or copytoram)."
msgstr "Установочные файлы не найдены на загрузочном носителе. Пакеты будут загружены и проверены до изменения диска. Сохраняйте подключение к интернету (Ventoy или copytoram)."

msgid "The installation log cannot be saved while the installer is stopping."
msgstr "Нельзя сохранить журнал установки во время остановки установщика."

msgid "The installed Emaki is too old for this repair. Nothing was changed."
msgstr "Установленный Emaki слишком стар для этого восстановления. Ничего не изменено."

#, python-brace-format
msgid "The installed directory {path} is not a safe directory. The repair stopped."
msgstr "Установленный каталог {path} небезопасен. Восстановление остановлено."

msgid "The installed system will include the Intel storage driver (vmd) so this disk can start."
msgstr "Установленная система будет включать драйвер хранилища Intel (vmd), чтобы этот диск мог загружаться."

msgid "The installer is busy or stopping. Wait before trying again."
msgstr "Установщик занят или останавливается. Подождите немного и повторите попытку."

#, python-brace-format
msgid "The installer mapping {value1} is already in use."
msgstr "Отображение установщика {value1} уже используется."

msgid "The installer needs a user runtime directory"
msgstr "Установщику нужен пользовательский каталог среды выполнения"

msgid "The installer root mapping is already in use."
msgstr "Отображение корня установщика уже используется."

msgid "The live Arch mirrorlist is missing."
msgstr "Список зеркал Arch временного сеанса отсутствует."

msgid "The live ISO boot mount is missing."
msgstr "Точка монтирования загрузки ISO отсутствует."

msgid "The live boot medium cannot be a target."
msgstr "Загрузочный носитель не может быть целевым диском."

#, python-brace-format
msgid "The login name check could not read a package ({value1}; bsdtar). The disk has not been changed."
msgstr "Не удалось проверить имя пользователя: не читается пакет ({value1}; bsdtar). Диск не изменён."

msgid "The machine certificate has no single subject name."
msgstr "У сертификата компьютера нет единственного имени субъекта."

msgid "The machine key label is invalid."
msgstr "Недопустимая метка ключа компьютера."

#, python-brace-format
msgid "The menu face {value1} is not a regular file."
msgstr "Гарнитура меню {value1} не является обычным файлом."

msgid "The new firmware entry for Emaki is not listed."
