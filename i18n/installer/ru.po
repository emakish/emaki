msgstr "ПРЕДУПРЕЖДЕНИЕ: повторная установка GRUB поставщика не удалась; пробуем резервный загрузчик."

#, python-brace-format
msgid "WARNING: {value1}/{value2} on the EFI partition holds other files; they were kept."
msgstr "ПРЕДУПРЕЖДЕНИЕ: {value1}/{value2} на разделе EFI содержит другие файлы; они сохранены."

#, python-brace-format
msgid "Warning: {target} could not be unmounted: {error}"
msgstr "Предупреждение: не удалось размонтировать {target}: {error}"

