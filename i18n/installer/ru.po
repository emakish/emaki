msgstr "Не удалось выполнить запрос. Подробности в журнале установки."

msgid "The restart service could not start."
msgstr "Служба перезапуска не смогла запуститься."

msgid "The root partition and the partitions marked encrypted are encrypted. The startup partition and the other partitions stay unencrypted."
msgstr "Корневой раздел и разделы с отметкой шифрования зашифрованы. Загрузочный и остальные разделы остаются незашифрованными."

msgid "The root partition is encrypted. The startup partition and any separate data partitions stay unencrypted."
msgstr "Корневой раздел зашифрован. Загрузочный и отдельные разделы данных остаются незашифрованными."

msgid "The shutdown ramfs is unavailable."
msgstr "ramfs для выключения недоступна."

msgid "The signed GRUB image does not carry its early config and memdisk."
msgstr "Подписанный образ GRUB не содержит ранней конфигурации и memdisk."

#, python-brace-format
msgid "The startup copy {value1} could not be read back after it was written."
msgstr "Не удалось прочитать загрузочную копию {value1} после записи."

