msgid "Keep partition {value1} ({value2}, {value3}, {value4}) and its files; use: {value5}."
msgstr "Partition {value1} ({value2}, {value3}, {value4}) und ihre Dateien behalten; Verwendung: {value5}."

msgid "Kernel partition size differs after resize."
msgstr "Die Partitionsgröße im Kernel weicht nach der Größenänderung ab."

msgid "Keyboard trial is available only in the live Emaki session."
msgstr "Tastaturtests sind nur in der Emaki-Live-Sitzung verfügbar."

#, python-brace-format
