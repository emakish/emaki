#, python-brace-format
msgid "Windows keeps {value1} GB, Emaki gets {value2} GB; back up your files first."
msgstr "Windows garde {value1} Go, Emaki reçoit {value2} Go ; sauvegardez d’abord vos fichiers."

#, python-brace-format
msgid "{value1} contains a locked encrypted Linux system (LUKS). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contient un système Linux chiffré et verrouillé (LUKS). Le programme d’installation ne peut pas en vérifier le contenu ; il peut appartenir à un ensemble de plusieurs disques."

#, python-brace-format
msgid "{value1} contains a locked encrypted Windows drive (BitLocker). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contient un lecteur Windows chiffré et verrouillé (BitLocker). Le programme d’installation ne peut pas en vérifier le contenu ; il peut appartenir à un ensemble de plusieurs disques."

#, python-brace-format
msgid "{value1} contains a locked encrypted macOS disk (FileVault 2). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contient un disque macOS chiffré et verrouillé (FileVault 2). Le programme d’installation ne peut pas en vérifier le contenu ; il peut appartenir à un ensemble de plusieurs disques."

#, python-brace-format
msgid "{value1} contains a macOS disk (APFS). The installer cannot check its contents; they may belong to a set of several disks."
msgstr "{value1} contient un disque macOS (APFS). Le programme d’installation ne peut pas en vérifier le contenu ; il peut appartenir à un ensemble de plusieurs disques."

#, python-brace-format
msgid "{value1} is active [{value2}]. Close it [cryptsetup close], then try again."
msgstr "{value1} est actif [{value2}]. Fermez-le [cryptsetup close], puis réessayez."

#, python-brace-format
msgid "{value1} is active [{value2}]. Deactivate it [lvchange -an], then try again."
msgstr "{value1} est actif [{value2}]. Désactivez-le [lvchange -an], puis réessayez."

#, python-brace-format
msgid "{value1} is active [{value2}]. Stop it [mdadm --stop], then try again."
msgstr "{value1} est actif [{value2}]. Arrêtez-le [mdadm --stop], puis réessayez."

#, python-brace-format
msgid "{value1} is one of {value2} devices of a Btrfs filesystem; erasing it would damage the other devices."
msgstr "{value1} est l’un des {value2} périphériques du système de fichiers Btrfs ; l’effacer endommagerait les autres périphériques."

#, python-brace-format
msgid "{value1} is one of {value2} devices of a RAID array; erasing it would damage the other devices."
msgstr "{value1} est l’un des {value2} périphériques de l’ensemble RAID ; l’effacer endommagerait les autres périphériques."

#, python-brace-format
msgid "{value1} is one of {value2} devices of an LVM volume group; erasing it would damage the other devices."
msgstr "{value1} est l’un des {value2} périphériques du groupe de volumes LVM ; l’effacer endommagerait les autres périphériques."

#, python-brace-format
msgid "{value} GiB"
msgstr "{value} Gio"


#, python-brace-format
msgid "Create partition {value1}: {value2}, {value3}; use: {value5}."
msgstr "Créer la partition {value1} : {value2}, {value3} ; usage : {value5}."

#, python-brace-format
msgid "Create partition {value1}: {value2}, {value3}, encrypted (LUKS2); use: {value5}."
msgstr "Créer la partition {value1} : {value2}, {value3}, chiffrée (LUKS2) ; usage : {value5}."

#, python-brace-format
msgid "Format partition {value1} ({value2}, {value3}) as {value4}: its files are lost; use: {value6}."
msgstr "Formater la partition {value1} ({value2}, {value3}) en {value4} : ses fichiers sont perdus ; usage : {value6}."

#, python-brace-format
msgid "Format partition {value1} ({value2}, {value3}) as {value4}, encrypted (LUKS2): its files are lost; use: {value6}."
msgstr "Formater la partition {value1} ({value2}, {value3}) en {value4}, chiffrée (LUKS2) : ses fichiers sont perdus ; usage : {value6}."

msgid "A new partition needs at least 1 GiB."
msgstr "Une nouvelle partition nécessite au moins 1 Gio."

#, python-brace-format
msgid "Wi-Fi country left unset: timezone {timezone} has no country."
msgstr "Le pays du Wi-Fi reste indéfini : aucun pays n’est associé au fuseau horaire {timezone}."

#, python-brace-format
msgid "Removing the stale ZFS signature; backups: {value1}."
msgstr "Suppression de la signature ZFS obsolète ; sauvegardes : {value1}."

msgid "The stale ZFS label could not be removed safely. Installation stopped before creating Emaki partitions; inspect the installation log."
msgstr "L’étiquette ZFS obsolète n’a pas pu être supprimée en toute sécurité. L’installation s’est arrêtée avant la création des partitions Emaki ; consultez le journal d’installation."
