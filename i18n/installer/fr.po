#, python-brace-format
msgid "Hibernation: reserve {value1} bytes ({value2} GiB), equal to RAM."
msgstr "Hibernation : réserver {value1} octets ({value2} Gio), soit la taille de la RAM."

#, python-brace-format
msgid "Keep partition {value1} ({value2}, {value3}, {value4}) and its files; use: {value5}. Emaki could not check its files; its fallback loader will not be changed."
msgstr "Conserver la partition {value1} ({value2}, {value3}, {value4}) et ses fichiers ; usage : {value5}. Emaki n’a pas pu vérifier les fichiers de la partition ; son chargeur de secours ne sera pas modifié."

#, python-brace-format
msgid "Keep partition {value1} ({value2}, {value3}, {value4}) and its files; use: {value5}. It holds another system's startup files; its fallback loader will not be changed."
msgstr "Conserver la partition {value1} ({value2}, {value3}, {value4}) et ses fichiers ; usage : {value5}. La partition contient les fichiers de démarrage d’un autre système ; son chargeur de secours ne sera pas modifié."

#, python-brace-format
msgid "Partition {value1}: format {value3}, {value4} GiB; {value5}."
msgstr "La partition {value1} ({value3}, {value4} Gio) sera formatée ; {value5}."

#, python-brace-format
msgid "Partition {value1}: preserve {value3}, {value4} GiB; {value5}."
msgstr "La partition {value1} ({value3}, {value4} Gio) sera conservée ; {value5}."

