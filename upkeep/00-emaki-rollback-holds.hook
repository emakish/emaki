[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Checking packages held after rollback (pacman)
When = PreTransaction
Exec = /bin/sh -c 'test -s /var/lib/emaki/rollback-holds.json || { cat > /dev/null; exit 0; }; /usr/share/libalpm/scripts/emaki-rollback-holds check; test $? -ne 3'
NeedsTargets
AbortOnFail
