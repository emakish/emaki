[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Checking space retained by root snapshots
When = PreTransaction
Exec = @PREFIX@/share/libalpm/scripts/emaki-update-space
NeedsTargets
AbortOnFail
