"""Refresh managed Arch mirrors while retaining local changes and usable fallbacks."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

# Frozen bytes copied by the 0.2.0 installer from its released ISO.
ISO_020_SHA256 = 'aa4a31472efa3dd682d4d256dd9702c3cbdb9d4a1176119fed37ea80885c5b20'

OPTIONS = ['--protocol', 'https', '--latest', '10', '--sort', 'rate',
           '--connection-timeout', '3', '--download-timeout', '3']


def digest(content):
    return hashlib.sha256(content).hexdigest() + '\n'


def safe_file(path):
    return not any(part.is_symlink() for part in (path, *path.parents))


def usable(content, minimum=3):
    try:
        text = content.decode('utf-8')
    except UnicodeError:
        return False
    servers = [line.strip() for line in text.splitlines()
               if line.strip() and not line.lstrip().startswith('#')]
    return (len({line.partition('=')[2].strip() for line in servers}) >= minimum
            and all(re.fullmatch(r'Server\s*=\s*https://\S+', line)
                    and '$repo' in line and '$arch' in line for line in servers))


def installer_list(content):
    """Recognize the released ISO list or the exact online installation command."""
    if hashlib.sha256(content).hexdigest() == ISO_020_SHA256:
        return True
    # Older installations accepted even one successful HTTPS mirror.
    if not usable(content, minimum=1):
        return False
    text = content.decode('utf-8')
    invocation = r'# With:\s+reflector ' + re.escape(' '.join(OPTIONS))
    invocation += r' --save /tmp/emaki-mirrors-[A-Za-z0-9_-]+/mirrorlist\s*'
    return ('Arch Linux mirrorlist generated by Reflector' in text
            and any(re.fullmatch(invocation, line) for line in text.splitlines()))


def replace(path, content, mode):
    descriptor, temporary = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(content)
            os.fchmod(stream.fileno(), mode)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def refresh(root=Path('/'), run=subprocess.run, record=False):
    mirrors = root / 'etc/pacman.d/mirrorlist'
    state = root / 'var/lib/emaki/mirror-refresh/sha256'
    if not safe_file(mirrors) or not safe_file(state) or not mirrors.is_file():
        return
    original = mirrors.read_bytes()
    expected = digest(original)
    if record:
        # Called only immediately after the installer has written the mirrorlist.
        state.parent.mkdir(parents=True, exist_ok=True)
        replace(state, expected.encode(), 0o600)
        return
    if state.exists():
        if state.read_text() != expected:
            return
    elif not installer_list(original):
        # Unknown lists may encode deliberate local choices. Never enroll them.
        return
    state.parent.mkdir(parents=True, exist_ok=True)
    # Record adoption before the network operation; failed probes retain ownership.
    if not state.exists():
        replace(state, expected.encode(), 0o600)
    with tempfile.TemporaryDirectory(prefix='probe-', dir=state.parent) as directory:
        output = Path(directory) / 'mirrorlist'
        run(['reflector', *OPTIONS, '--save', str(output)], check=True, timeout=60)
        content = output.read_bytes()
        if not usable(content):
            raise ValueError('Mirror refresh returned no usable HTTPS list [reflector].')
        # Preserve a manual change made while reflector was probing.
        if not safe_file(mirrors) or mirrors.read_bytes() != original:
            return
        replace(mirrors, content, mirrors.stat().st_mode & 0o777)
        # If interrupted here, a stale digest safely stops the next refresh.
        replace(state, digest(content).encode(), 0o600)


def main():
    if sys.argv[1:] not in ([], ['--record']):
        return 2
    try:
        refresh(record=sys.argv[1:] == ['--record'])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Arch mirror refresh could not finish [reflector].', file=sys.stderr)
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
