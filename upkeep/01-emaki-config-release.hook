[Trigger]
Type = Package
Operation = Upgrade
Target = emaki-config

[Action]
Description = Preserving Emaki configuration for package replacement...
When = PreTransaction
Exec = /usr/share/libalpm/scripts/emaki-system-migrate --release
AbortOnFail
