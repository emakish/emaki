[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = emaki-config
Target = emaki-apps

[Action]
Description = Migrate installed system defaults [Emaki]
When = PostTransaction
Exec = /usr/share/libalpm/scripts/emaki-system-migrate --transaction
