[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = emaki-config

[Action]
Description = Restore packaged rollback protection (pacman)
When = PostTransaction
Exec = /usr/share/libalpm/scripts/emaki-rollback-holds takeover
