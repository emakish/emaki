set -eu
umask 077
ulimit -c 0
paths_file="$(dirname -- "$(readlink -f -- "$0")")/../scripts/paths"
if [[ ! -f $paths_file ]]; then
    paths_file='@EMAKI_LIBEXECDIR@/paths'
fi
source "$paths_file"

translate() {
    local translated message="$1" argument index=0
    shift
    if translated=$("$EMAKI_PYTHON" -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from emaki_i18n import translation; print(translation(sys.argv[2]).gettext(sys.argv[3]).format(*sys.argv[4:]))' "$(dirname -- "$paths_file")" programs "$message" "$@" 2>/dev/null); then
        printf '%s\n' "$translated"
    else
        for argument in "$@"; do
            message=${message//\{$index\}/"$argument"}
            ((index += 1))
        done
        printf '%s\n' "$message"
    fi
}
manager_action=present
export EMAKI_MANAGER_PAGE=browse
if (( $# )); then
    if (( $# == 1 )) && [[ $1 == --status || $1 == --check ]]; then
        exec "$EMAKI_LIBEXECDIR/update-manager-backend" "$1"
    fi
    if (( $# == 1 )) && [[ $1 == --updates ]]; then
        manager_action=presentUpdates
        export EMAKI_MANAGER_PAGE=updates
    else
        translate 'Usage: emaki-update-manager [--status|--check|--updates]' >&2
        exit 2
    fi
fi
if (( EUID == 0 )); then
    translate 'Open Programs & Updates as a regular user.' >&2
    exit 1
fi
: "${XDG_RUNTIME_DIR:?$(translate 'Programs & Updates needs a user runtime directory')}"
config="$EMAKI_PREFIX/share/emaki-update-manager/ui/shell.qml"
exec 9>"$XDG_RUNTIME_DIR/emaki-update-manager.lock"
if ! flock -n 9; then
    reply=''
    for _ in {1..50}; do
        if reply=$(qs ipc -p "$config" call updates "$manager_action" 2>&1) && [[ ${reply##*$'\n'} == presented ]]; then
            exit 0
        fi
        # The previous updates-only window has only the original presentation method.
        if [[ $manager_action == presentUpdates ]] && reply=$(qs ipc -p "$config" call updates present 2>&1) && [[ ${reply##*$'\n'} == presented ]]; then
            exit 0
        fi
        sleep 0.1
    done
    translate 'The Programs & Updates window could not be shown: {0}' "${reply:-$(translate '(no reply)')}" >&2
    exit 1
fi
# Without this, a Quickshell build with its crash handler opens a report window and re-executes
# qs in place instead of exiting.
export QS_DISABLE_CRASH_HANDLER=1
export EMAKI_SHELL_SHADER_DIR="$EMAKI_DATADIR/shell/shaders"
qs -p "$config" 9>&-
