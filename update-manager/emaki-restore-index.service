[Unit]
Description=Refresh the public system restore point inventory
ConditionPathIsDirectory=/.snapshots

[Service]
Type=oneshot
ExecStart=@EMAKI_LIBEXECDIR@/emaki-update-restore refresh-index
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
