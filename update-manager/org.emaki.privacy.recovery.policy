<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Emaki</vendor>
  <action id="org.emaki.privacy.recovery">
    <description>[PLACEHOLDER] Read recovery status</description>
    <message>[PLACEHOLDER] Read the snapshot and boot menu status.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@EMAKI_LIBEXECDIR@/emaki-privacy-recovery</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">status</annotate>
  </action>
</policyconfig>
