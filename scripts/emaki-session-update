#!/usr/bin/python3 -IB
# Copyright (C) 2026 Artur Yakymenko
# SPDX-License-Identifier: GPL-3.0-or-later
"""Mark desktop upgrades and notify local graphical sessions, without restarting them."""

import os
import json
from pathlib import Path
import pwd
import subprocess
import sys
import time
import uuid

sys.path.insert(0, '/usr/libexec/emaki')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_session_state as state

MARKER = Path('/run/emaki-session-update')
LOGINCTL = '/usr/bin/loginctl'
SUMMARY = 'Sign out and sign in again to finish updating the desktop.'
BODY = 'Save your work first [Emaki].'


def mark_update(path=MARKER):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    try:
        token = uuid.uuid4().hex
        value = json.dumps(dict(root=state.root_id(), boot=state.boot_id(), transaction=token)).encode()
        os.ftruncate(fd, 0)
        os.write(fd, value)
    finally:
        os.close(fd)
    return token


def graphical_users():
    result = subprocess.run([LOGINCTL, 'list-sessions', '--no-legend', '--no-pager'],
                            capture_output=True, text=True, check=True, timeout=5)
    users = set()
    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        session = fields[0]
        if not session.isalnum():
            continue
        try:
            info = subprocess.run(
                [LOGINCTL, 'show-session', session, '--no-pager',
                 '-p', 'User', '-p', 'Remote', '-p', 'Type', '-p', 'Class', '-p', 'State'],
                capture_output=True, text=True, check=True, timeout=5)
            props = dict(row.split('=', 1) for row in info.stdout.splitlines() if '=' in row)
            uid = int(props.get('User', '-1'))
            if (uid > 0 and props.get('Remote') == 'no'
                    and props.get('Type') in ('wayland', 'x11')
                    and props.get('Class') == 'user'
                    and props.get('State') in ('active', 'online')):
                users.add(uid)
        except (ValueError, OSError, subprocess.SubprocessError):
            continue
    return sorted(users)


def send_notification():
    # This interpreter starts only after the parent drops all user/group privileges.
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    connection = Gio.DBusConnection.new_for_address_sync(
        'unix:path=/run/user/' + str(os.getuid()) + '/bus',
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    connection.call_sync(
        'org.freedesktop.Notifications', '/org/freedesktop/Notifications',
        'org.freedesktop.Notifications', 'Notify',
        GLib.Variant('(susssasa{sv}i)', (
            'Desktop update', 0, '', SUMMARY, BODY, [],
            {'urgency': GLib.Variant('y', 2), 'resident': GLib.Variant('b', True)}, 0)),
        None, Gio.DBusCallFlags.NO_AUTO_START, 3000, None)


def notify_user(uid):
    user = pwd.getpwuid(uid)
    subprocess.run(
        ['/usr/bin/python3', '-I', '-B', str(Path(__file__).resolve()), '--notify'],
        user=uid, group=user.pw_gid, extra_groups=[], cwd='/',
        env={'PATH': '/usr/bin', 'LANG': 'C.UTF-8'},
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        check=False, timeout=5)


def deliver(token):
    # The last hook still runs inside pacman. Wait in a detached process so it
    # can return, complete later admin hooks and release the package database.
    deadline = time.monotonic() + 86400
    while state.transaction_running():
        if time.monotonic() >= deadline:
            return 0
        time.sleep(1)
    if state.foreign_root() or state.LIVE.exists() or state.marker_value(MARKER) != token:
        return 0
    try:
        users = graphical_users()
    except (OSError, subprocess.SubprocessError):
        return 0
    for uid in users:
        # A subsequent transaction may have started during recipient discovery.
        if state.transaction_running() or state.marker_value(MARKER) != token:
            return 0
        try:
            notify_user(uid)
        except (KeyError, OSError, subprocess.SubprocessError):
            continue
    return 0


def main():
    if sys.argv[1:] == ['--notify']:
        if os.getuid() == 0:
            return 1
        try:
            send_notification()
        except Exception:
            return 1
        return 0
    if os.geteuid() != 0:
        return 1
    if state.foreign_root() or state.LIVE.exists():
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == '--after-transaction':
        return deliver(sys.argv[2])
    if sys.argv[1:]:
        return 1
    token = mark_update()
    # No user bus is contacted from inside the transaction or a foreign root.
    try:
        subprocess.Popen(['/usr/bin/python3', '-I', '-B', str(Path(__file__).resolve()),
                          '--after-transaction', token], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, close_fds=True, cwd='/',
                         env={'PATH': '/usr/bin', 'LANG': 'C.UTF-8'})
    except (OSError, subprocess.SubprocessError):
        pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
