#!/usr/bin/env python3
"""Generate fetch artwork and palette from the canonical wordmark and tokens."""
import argparse
import io
import json
from pathlib import Path
import runpy
import sys
import tomllib

from PIL import Image

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
TARGET = ROOT / 'fetch'


def generate():
    source = runpy.run_path(str(ROOT / 'scripts/build-lock-wordmark'))
    _, width, height, pixels = source['generate_pixels']()
    colors = [tuple(bytes.fromhex(color[1:])) for color in source['HOT']]
    image = Image.new('RGBA', (width, height))
    for x, y, _letter, _neighbours, color in pixels:
        image.putpixel((x, y), (*colors[color], 255))
    png = io.BytesIO()
    image.resize((width * 2, height * 2), Image.Resampling.NEAREST).save(png, format='PNG')
    # One character spans two square pixels. The 50 × 12 raster fits beside specs.
    small = image.resize((width // 4, height // 4), Image.Resampling.NEAREST)
    rows = []
    for y in range(0, small.height, 2):
        row = ''
        for x in range(small.width):
            top, bottom = small.getpixel((x, y)), small.getpixel((x, y + 1))
            if top[3] and bottom[3]:
                row += f'\033[38;2;{top[0]};{top[1]};{top[2]}m\033[48;2;{bottom[0]};{bottom[1]};{bottom[2]}m▀'
            elif top[3] or bottom[3]:
                color = top if top[3] else bottom
                row += f'\033[49m\033[38;2;{color[0]};{color[1]};{color[2]}m' + ('▀' if top[3] else '▄')
            else:
                row += '\033[49m '
        rows.append(row + '\033[0m')
    tokens = tomllib.loads((ROOT / 'tokens.toml').read_text())
    warm = [tokens['ansi']['red'], tokens['color']['accent'], tokens['ansi']['yellow']]
    modules = []
    for i, (kind, key) in enumerate([
        ('os', 'OS'), ('host', 'Host'), ('kernel', 'Kernel'), ('uptime', 'Uptime'),
        ('packages', 'Packages'), ('shell', 'Shell'), ('wm', 'WM'), ('terminal', 'Terminal'),
        ('cpu', 'CPU'), ('gpu', 'GPU'), ('memory', 'Memory'), ('disk', 'Disk'),
        ('battery', 'Battery'), ('locale', 'Locale'),
    ]):
        module = {'type': kind, 'key': key, 'keyColor': '#' + warm[i % len(warm)]}
        if kind == 'os':
            # Emaki and its release version (DECISIONS: versions are shown in emaki fetch),
            # from /usr/lib/emaki-release; a preview off Emaki prints just "Emaki".
            module = {'type': 'command', 'key': key, 'keyColor': module['keyColor'],
                      'text': 'if [ -r /usr/lib/emaki-release ]; then . /usr/lib/emaki-release; '
                              'if [ -f /etc/emaki-live/greetd.toml ]; then '
                              'echo "Emaki${VERSION:+ $VERSION}${LABEL:+ $LABEL}"; else '
                              'channel=$(emaki-update-channel 2>/dev/null) || channel=unknown; '
                              'case "$channel" in stable|testing|custom|mixed|disabled) ;; *) channel=unknown ;; esac; '
                              'echo "Emaki${VERSION:+ $VERSION}${LABEL:+ $LABEL} [channel: $channel]"; '
                              'fi; else echo Emaki; fi'}
        elif kind == 'disk':
            module['folders'] = '/'
        modules.append(module)
    config = {
        'logo': {'type': 'none', 'padding': {'top': 3, 'right': 3}},
        'display': {'color': {'output': '#' + tokens['color']['text']}, 'percent': {'type': 1}},
        'modules': modules,
    }
    return {'wordmark.png': png.getvalue(), 'wordmark.txt': ('\n'.join(rows) + '\n').encode(),
            'details.jsonc': (json.dumps(config, indent=2) + '\n').encode()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    for name, content in generate().items():
        path = TARGET / name
        if args.check:
            if not path.is_file() or path.read_bytes() != content:
                parser.exit(1, f'{path.relative_to(ROOT)} is stale; run python3 scripts/build-fetch\n')
        else:
            TARGET.mkdir(exist_ok=True)
            path.write_bytes(content)
    print('PASS: fetch assets match wordmark and tokens' if args.check else 'Generated fetch assets')


if __name__ == '__main__':
    main()
