#!/usr/bin/python3 -IB
# Copyright (C) 2026 Artur Yakymenko
# SPDX-License-Identifier: GPL-3.0-or-later
"""Hold logind's sleep and lid inhibitors until the invoking transaction exits."""
import os
from pathlib import Path
import select
import subprocess
import sys

sys.path.insert(0, '/usr/libexec/emaki')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_session_state as state


def acquire():
    # Use the existing runtime's D-Bus FD support. Owning the descriptor directly
    # means even SIGKILL releases it; there is no second keeper process to leak.
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    reply, fd_list = bus.call_with_unix_fd_list_sync(
        'org.freedesktop.login1', '/org/freedesktop/login1',
        'org.freedesktop.login1.Manager', 'Inhibit',
        GLib.Variant('(ssss)', ('sleep:handle-lid-switch', 'Emaki packages',
                               'A package transaction is running', 'block')),
        GLib.VariantType('(h)'), Gio.DBusCallFlags.NONE, 5000, None, None)
    descriptors = fd_list.steal_fds()
    try:
        index, = reply.unpack()
        if not 0 <= index < len(descriptors):
            raise ValueError('invalid inhibitor descriptor')
        descriptor = descriptors.pop(index)
        os.set_inheritable(descriptor, False)
        return descriptor
    finally:
        for descriptor in descriptors:
            os.close(descriptor)


def hold(owner, ready):
    descriptor = None
    try:
        if select.select([owner], [], [], 0)[0]:
            return 1
        descriptor = acquire()
        # Pacman can die while the bus call is pending. Never report readiness
        # for a transaction that has already ended.
        if select.select([owner], [], [], 0)[0]:
            return 1
        os.write(ready, b'1')
        os.close(ready)
        ready = None
        select.select([owner], [], [])
        return 0
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if ready is not None:
            os.close(ready)
        os.close(owner)


def start(pid):
    # A pidfd identifies this exact process, survives reparenting, and becomes
    # readable even for an unreaped zombie. A reused PID cannot retain the lock.
    owner = os.pidfd_open(pid)
    try:
        # Startup may have reparented this hook to init or a subreaper. Validate
        # after opening the pidfd; its readiness check also covers PID reuse.
        if pid <= 1 or os.readlink(f'/proc/{pid}/exe') != '/usr/bin/pacman':
            raise RuntimeError('the invoking package transaction has ended')
    except (OSError, RuntimeError):
        os.close(owner)
        raise
    reader, writer = os.pipe()
    process = None
    accepted = False
    try:
        process = subprocess.Popen(
            ['/usr/bin/python3', '-I', '-B', str(Path(__file__).resolve()),
             '--hold', str(owner), str(writer)],
            pass_fds=(owner, writer), start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, cwd='/',
            env={'PATH': '/usr/bin', 'LC_ALL': 'C'})
        os.close(writer)
        writer = None
        accepted = bool(select.select([reader], [], [], 10)[0]
                        and os.read(reader, 1) == b'1')
        if not accepted:
            raise RuntimeError('sleep protection did not start')
        return process
    finally:
        os.close(reader)
        os.close(owner)
        if writer is not None:
            os.close(writer)
        if process is not None and not accepted:
            process.kill()
            process.wait()


def main():
    if len(sys.argv) == 4 and sys.argv[1] == '--hold':
        return hold(int(sys.argv[2]), int(sys.argv[3]))
    if len(sys.argv) != 1:
        return 1
    # libalpm invokes hooks directly, inside the transaction's root. Installer
    # and recovery chroots must not take an inhibitor on the host's logind.
    if state.foreign_root():
        return 0
    try:
        start(os.getppid())
        return 0
    except (OSError, RuntimeError):
        print('The package transaction could not prevent sleep. '
              'Continuing without sleep protection.', file=sys.stderr)
        return 0


if __name__ == '__main__':
    sys.exit(main())
