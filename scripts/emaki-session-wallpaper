"""Start the default wallpaper once per compositor, without waiting for login decoration."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import stat
import re
import tomllib
import sys
import subprocess
import time



def claim_file(environment):
    runtime = Path(environment.get('XDG_RUNTIME_DIR', ''))
    if not runtime.is_absolute() or '..' in runtime.parts or os.geteuid() == 0:
        raise ValueError('private runtime required')
    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for name in runtime.parts[1:]:
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        info = os.fstat(directory)
        if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ValueError('unsafe runtime')
        # Values identify the compositor without connecting to either socket.
        identity = (environment.get('NIRI_SOCKET', '') + '\0'
                    + environment.get('WAYLAND_DISPLAY', '')).encode()
        name = 'emaki-wallpaper-' + hashlib.sha256(identity).hexdigest() + '.lock'
        descriptor = os.open(name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                             0o600, dir_fd=directory)
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or info.st_size > 1):
            os.close(descriptor)
            raise ValueError('unsafe wallpaper claim')
        return descriptor
    finally:
        os.close(directory)


def wallpaper_arguments(environment):
    """Use the selected generated wallpaper without changing personal configuration."""
    config = Path(environment.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    source = config / 'emaki/settings.toml'
    if not source.exists():
        return ['wpaperd']
    with source.open('rb') as stream:
        raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError('settings too large')
    settings = tomllib.loads(raw.decode())
    wallpaper = settings.get('appearance', {}).get('wallpaper')
    if not wallpaper:
        return ['wpaperd']
    generation = settings.get('generation', '')
    if (settings.get('schema_version') != 1 or not isinstance(generation, str)
            or len(generation) >= 100 or not re.fullmatch(r'g-[0-9a-fA-F]+-[0-9a-fA-F]+-[0-9a-fA-F]+', generation)
            or not isinstance(wallpaper, str) or not Path(wallpaper).is_absolute()):
        raise ValueError('invalid managed wallpaper')
    state = Path(environment.get('XDG_STATE_HOME') or Path.home() / '.local/state')
    selected = state / 'emaki/generations' / generation / 'wpaperd.toml'
    with selected.open('rb') as stream:
        raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError('generated wallpaper too large')
    rendered = tomllib.loads(raw.decode())
    if rendered.get('default', {}).get('path') != wallpaper:
        raise ValueError('managed wallpaper differs')
    return ['wpaperd', '--config', str(selected)]


def compositor_draws_wallpaper(environment):
    """Wait briefly for the ring; image, stock niri and failed assets need wpaperd."""
    if not environment.get('NIRI_SOCKET'):
        return False
    deadline = time.monotonic() + 5
    while True:
        try:
            result = subprocess.run(['niri-emaki', 'msg', '--json', 'emaki-wallpaper'],
                                    env=environment, capture_output=True, timeout=.25)
            if result.returncode or len(result.stdout) > 65536:
                return False
            status = json.loads(result.stdout)
            if status.get('mode') != 'ring':
                return False
            if status.get('load_state') == 'ready':
                return True
            if status.get('load_state') != 'loading' or time.monotonic() >= deadline:
                return False
        except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
            return False
        time.sleep(.1)


def daemon_answers(environment):
    """A daemon started by hand or by a dead claim's owner still serves this display."""
    try:
        return not subprocess.run(['wpaperctl', 'get-all', '-j'], env=environment,
                                  stdin=subprocess.DEVNULL, capture_output=True, timeout=1).returncode
    except subprocess.TimeoutExpired:
        return True  # A hung daemon still owns the display; never start a second one.
    except (OSError, subprocess.SubprocessError):
        return False


def spawn(environment):
    """Start the daemon as the compositor's child, so a restart of the asking service
    (the shell or the login-wallpaper watcher) cannot take it down."""
    command = ['emaki-session-wallpaper', '--force']
    if environment.get('NIRI_SOCKET'):
        try:
            result = subprocess.run(['niri-emaki', 'msg', 'action', 'spawn', '--', *command],
                                    env=environment, stdin=subprocess.DEVNULL,
                                    capture_output=True, timeout=1)
            if not result.returncode:
                return 0
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        subprocess.Popen(command, env=environment, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        print('emaki-session-wallpaper: startup unavailable', file=sys.stderr)
        return 1
    return 0


def main(force=False):
    environment = dict(os.environ)
    descriptor = None
    if not force and compositor_draws_wallpaper(environment):
        return 0
    try:
        try:
            arguments = wallpaper_arguments(environment)
        except (OSError, ValueError, TypeError, AttributeError):
            print('emaki-session-wallpaper: managed wallpaper unavailable; using default',
                  file=sys.stderr)
            arguments = ['wpaperd']
        descriptor = claim_file(environment)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        # The free lock means the claimed daemon is gone; a forced start replaces it
        # unless another daemon (a manual one) still answers.
        if os.read(descriptor, 1) and not (force and not daemon_answers(environment)):
            return 0
        # Keep both the persistent once-only claim and the live advisory lock.
        # Explicit manual wpaperd remains available outside this default wrapper.
        os.lseek(descriptor, 0, os.SEEK_SET)
        os.write(descriptor, b'1')
        os.set_inheritable(descriptor, True)
        try:
            os.execvpe('wpaperd', arguments, environment)
        except OSError:
            os.ftruncate(descriptor, 0)  # A failed exec may be retried.
            raise
    except (OSError, ValueError):
        print('emaki-session-wallpaper: startup unavailable', file=sys.stderr)
        return 1
    finally:
        if descriptor is not None:
            os.close(descriptor)
    return 0


if __name__ == '__main__':
    if sys.argv[1:] == ['--spawn']:
        raise SystemExit(spawn(dict(os.environ)))
    raise SystemExit(main(force=sys.argv[1:] == ['--force']))
