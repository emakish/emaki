"""Read one saved wireless password after the policy's administrator authentication."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

sys.path.insert(0, '@EMAKI_LIBEXECDIR@')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_paths

UUID = re.compile(r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}')
ENV = {'PATH': emaki_paths.TRUSTED_PATH, 'LC_ALL': 'C'}


def read_password(uuid, run=subprocess.run):
    if not isinstance(uuid, str) or UUID.fullmatch(uuid) is None:
        return {'state': 'invalid_connection'}
    def field(name, secret=False):
        command = ['nmcli', '--wait', '5', '--escape', 'no']
        if secret:
            command.append('--show-secrets')
        command += ['--get-values', name, 'connection', 'show', 'uuid', uuid]
        return run(command, capture_output=True, text=True, check=True,
                   timeout=8, env=ENV).stdout.rstrip('\n')
    try:
        if field('connection.type') != '802-11-wireless':
            return {'state': 'invalid_connection'}
        if field('802-11-wireless-security.key-mgmt') not in ('wpa-psk', 'sae'):
            return {'state': 'password_unavailable'}
        password = field('802-11-wireless-security.psk', True)
        if not password or len(password) > 256:
            return {'state': 'password_unavailable'}
        return {'state': 'ready', 'password': password}
    except (OSError, subprocess.SubprocessError, UnicodeError):
        return {'state': 'password_unavailable'}


def main():
    if os.geteuid() != 0 or not os.environ.get('PKEXEC_UID', '').isdigit():
        result = {'state': 'authentication_required'}
    elif len(sys.argv) != 3 or sys.argv[1] != 'show':
        result = {'state': 'invalid_request'}
    else:
        result = read_password(sys.argv[2])
    print(json.dumps(dict(schema_version=1, **result)))
    return 0 if result['state'] == 'ready' else 1


if __name__ == '__main__':
    sys.exit(main())
