"""Build-time terminal adapter; runtime EMAKI_TERMINAL may override it."""
import argparse
import json
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('--terminal',default='kitty');a=p.parse_args()
if not a.terminal or '\x00' in a.terminal: p.error('invalid terminal')
f=Path(__file__).resolve().parent.parent/'shell/ShellTools.qml'
f.write_text('// Copyright (C) 2026 Artur Yakymenko\n// SPDX-License-Identifier: GPL-3.0-or-later\n// Generated by scripts/render-shell-tools; command names resolve through PATH.\npragma Singleton\nimport QtQuick\nQtObject {\n    readonly property string terminal: '+json.dumps(a.terminal)+'\n}\n')
