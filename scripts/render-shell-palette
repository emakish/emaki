#!/usr/bin/env python3
"""Generate only the shell palette from tokens.toml; --check never writes."""
import argparse
import json
from pathlib import Path
import tomllib

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
tokens = tomllib.loads((root / 'tokens.toml').read_text())
lines = ['// Generated by scripts/render-shell-palette from tokens.toml.',
         'pragma Singleton', '', 'import QtQuick', '', 'QtObject {']
for name, key in [('background', 'background'), ('surface', 'surface'),
                  ('surfaceHigh', 'surface_high'), ('text', 'text'),
                  ('muted', 'text_muted'), ('accent', 'accent'),
                  ('accentText', 'on_accent'), ('shadow', 'shadow'),
                  ('critical', 'critical')]:
    lines.append(f'    readonly property color {name}: "#{tokens["color"][key]}"')
lines += [f'    readonly property string uiFont: {json.dumps(tokens["font"]["ui"])}', '}', '']
content = '\n'.join(lines)
path = root / 'shell/ShellPalette.qml'
if args.check:
    if not path.exists() or path.read_text() != content:
        parser.exit(1, 'shell/ShellPalette.qml is stale; run python scripts/render-shell-palette\n')
    print('shell palette matches tokens.toml')
else:
    path.write_text(content)
