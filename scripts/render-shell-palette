"""Generate the shell palette and app icon from tokens.toml; --check never writes."""
import argparse
import json
from pathlib import Path
import tomllib

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
tokens = tomllib.loads((root / 'tokens.toml').read_text())

def camel(name):
    head, *tail = name.split('_')
    return head + ''.join(word.title() for word in tail)

def color(value):
    if isinstance(value, list):
        return 'Qt.rgba(' + ', '.join(str(v) for v in value) + ')'
    return json.dumps('#' + value)

lines = ['// Copyright (C) 2026 Artur Yakymenko',
         '// SPDX-License-Identifier: GPL-3.0-or-later',
         '// Generated by scripts/render-shell-palette from tokens.toml.',
         'pragma Singleton', '', 'import QtQuick', '', 'QtObject {',
         '    readonly property bool dark: Appearance.dark']
for name, key in [('background', 'background'), ('surface', 'surface'),
                  ('surfaceHigh', 'surface_high'), ('text', 'text'),
                  ('muted', 'text_muted'), ('shadow', 'shadow'), ('critical', 'critical')]:
    lines.append(f'    readonly property color {name}: {color(tokens["color"][key])}')
for key, value in tokens['shell_light'].items():
    other = tokens['shell_dark'][key]
    if key == 'track_regular_accent':
        vector = ', '.join(str(v) for v in value[:3])
        lines.append(f'    readonly property vector3d {camel(key)}: Qt.vector3d({vector})')
        continue
    expression = color(value) if other == value else f'dark ? {color(other)} : {color(value)}'
    lines.append(f'    readonly property color {camel(key)}: {expression}')
# Preserve the original shader's six-decimal input without duplicating the accent.
track = ', '.join(str(round(int(tokens['accents']['orange']['base'][i:i+2], 16) / 255, 6)) for i in (0, 2, 4))
lines.append(f'    readonly property vector3d trackAccent: Qt.vector3d({track})')
rows = [dict(id=key, **{k: v if k == 'name' else '#'+v for k,v in values.items()})
        for key,values in tokens['accents'].items()]
default = tokens['defaults']['accent']
assert default in tokens['accents'], default
# Appearance.qml repeats the default as its fallback; an unknown saved name falls back here.
# Laid out as qmlformat prints it: tests/test-shell.py compares every shell file with qmlformat.
lines += [f'    readonly property string defaultAccent: {json.dumps(default)}',
          '    readonly property var accents: ' + json.dumps(rows, indent=4).replace('\n', '\n    '),
          '    readonly property var chosenAccent: accents.find(entry => entry.id === Appearance.accent) || accents.find(entry => entry.id === defaultAccent)']
for name,key in [('accent','base'),('accentText','text'),('accentOnLight','on_light'),('accentOnDark','on_dark'),('accentSoft','soft'),('accentStrong','strong'),('accentShade','shade'),('accentDeep','deep'),('accentHover','hover'),('polkitAccent','polkit'),('polkitFocus','focus'),('settingsAvatarStart','avatar_start'),('settingsAvatarEnd','avatar_end')]:
    lines.append(f'    readonly property color {name}: chosenAccent.{key}')
lines += ['    readonly property color settingsDisplaySelected: dark ? accentDeep : chosenAccent.display_selected',
          '    readonly property color accentForeground: dark ? accentOnDark : accentOnLight',
          '    readonly property color accentDeepForeground: dark ? accentOnDark : accentDeep',
          '    readonly property color accentHoverForeground: dark ? accentOnDark : accentHover']
lines += [f'    readonly property string uiFont: {json.dumps(tokens["font"]["ui"])}', '}', '']
content = '\n'.join(lines)
outputs = {'shell/ShellPalette.qml': content}
# Emaki's own app icons in the default accent; the shell draws them live in the chosen one.
for template, target in (('programs-updates.svg', 'update-manager/emaki-programs-updates.svg'),
                         ('welcome.svg', 'art/icons/emaki-welcome.svg')):
    icon = (root / 'scripts/templates' / template).read_text()
    for key in ('base', 'strong', 'soft', 'shade'):
        icon = icon.replace('@ACCENT_' + key.upper() + '@', '#' + tokens['accents'][default][key])
    outputs[target] = icon.replace('@ICON_INK@', '#' + tokens['shell_light']['manager_icon_ink'])
for name, rendered in outputs.items():
    path = root / name
    if args.check:
        if not path.exists() or path.read_text() != rendered:
            parser.exit(1, name + ' is stale; run python scripts/render-shell-palette\n')
    else:
        path.write_text(rendered)
if args.check:
    print('shell palette and app icon match tokens.toml')
