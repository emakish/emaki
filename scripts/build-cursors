"""Build the white and dark Emaki Xcursor themes from art/cursor/ (requires Pillow).

Every CSS and legacy X cursor name points at one of the 14 drawn shapes."""
import argparse
import os
from pathlib import Path
import runpy
import struct
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
THEMES = {'Emaki-White': 'white', 'Emaki-Dark': 'dark'}
# Native-sized square canvases keep every nominal size distinct for niri's frame selection.
ROUNDED_SIZES = (24, 30, 32, 36, 42, 45, 48, 60, 64, 72, 75, 96)
STATIC_DELAY = 50

ALIASES = {
    'default': 'left_ptr arrow top_left_arrow left_arrow context-menu help question_arrow whats_this '
               'alias link copy dnd-ask dnd-copy dnd-link zoom-in zoom-out',
    'pointer': 'hand2 hand1 hand pointing_hand',
    'text': 'xterm ibeam vertical-text',
    'wait': 'watch',
    'progress': 'left_ptr_watch half-busy',
    'not-allowed': 'no-drop crossed_circle forbidden circle dnd-no-drop dnd-none',
    'crosshair': 'cell cross plus tcross cross_reverse diamond_cross',
    'move': 'all-scroll all-resize fleur size_all dnd-move',
    'grab': 'openhand',
    'grabbing': 'closedhand',
    'ew-resize': 'col-resize e-resize w-resize right_side left_side h_double_arrow sb_h_double_arrow size_hor split_h',
    'ns-resize': 'row-resize n-resize s-resize top_side bottom_side v_double_arrow sb_v_double_arrow size_ver split_v',
    'nwse-resize': 'nw-resize se-resize top_left_corner bottom_right_corner bd_double_arrow size_fdiag',
    'nesw-resize': 'ne-resize sw-resize top_right_corner bottom_left_corner fd_double_arrow size_bdiag',
}

def xcursor(art, name, variant):
    """Xcursor file: header, table of contents, then one image chunk per size and frame."""
    count = art['frames'](name)
    delay = art['FRAME_MS'] if count > 1 else STATIC_DELAY
    chunks = []
    for nominal in ROUNDED_SIZES:
        for frame in range(count):
            raster, xhot, yhot = art['render'](name, nominal, variant, frame)
            w, h = raster.size
            rgba = raster.tobytes()
            argb = [(a << 24) | ((r*a+127)//255 << 16) | ((g*a+127)//255 << 8) | (b*a+127)//255
                    for r, g, b, a in zip(rgba[::4], rgba[1::4], rgba[2::4], rgba[3::4])]
            pixels = struct.pack(f'<{w*h}I', *argb)
            chunks.append((nominal, struct.pack('<9I', 36, 0xFFFD0002, nominal, 1, w, h, xhot, yhot, delay) + pixels))
    position = 16 + 12 * len(chunks)
    toc, body = b'', b''
    for nominal, chunk in chunks:
        toc += struct.pack('<3I', 0xFFFD0002, nominal, position + len(body))
        body += chunk
    return struct.pack('<4s3I', b'Xcur', 16, 0x10000, len(chunks)) + toc + body


def generate(theme='Emaki-White'):
    """{relative path: bytes} for files, {relative path: target} for symlinks."""
    variant = THEMES[theme]
    art = runpy.run_path(str(ROOT / 'art/cursor/rounded.py'))
    index = f'[Icon Theme]\nName={theme}\nComment=Emaki rounded {variant} cursors\n'
    files = {'index.theme': index.encode()}
    links = {}
    for name, others in ALIASES.items():
        files[f'cursors/{name}'] = xcursor(art, name, variant)
        for other in others.split():
            links[f'cursors/{other}'] = name
    assert set(ALIASES) == set(art['HOTSPOTS']), 'every drawn cursor needs an ALIASES entry'
    assert not set(links) & set(files), 'an alias shadows a drawn cursor'
    return files, links


def on_disk(theme):
    files, links = {}, {}
    for path in sorted(theme.rglob('*')):
        rel = path.relative_to(theme).as_posix()
        if path.is_symlink():
            links[rel] = os.readlink(path)
        elif path.is_file():
            files[rel] = path.read_bytes()
    return files, links


# Pillow's antialiasing may move between releases; the package check runs with whatever Pillow
# the build host has. One supersampled sub-pixel flipping at an edge moves a pixel by about 7
# levels (255 / 36), so rounded themes compare names, links, headers, the table of contents and
# hotspots exactly, and pixel channels within PIXEL_TOLERANCE each and PIXEL_MEAN on average per
# file: edge drift passes, a redrawn shape or a new palette does not.
PIXEL_TOLERANCE = 24
PIXEL_MEAN = 2.0


def chunks(data):
    """(file header and table of contents bytes, [(chunk header fields, pixel bytes)])."""
    count = struct.unpack_from('<4s3I', data)[3]
    out = []
    for i in range(count):
        position = struct.unpack_from('<3I', data, 16 + 12 * i)[2]
        fields = struct.unpack_from('<9I', data, position)
        out.append((fields, data[position + 36:position + 36 + 4 * fields[4] * fields[5]]))
    return data[:16 + 12 * count], out


def matches(theme, expected, actual):
    """True when a checked-in theme equals a fresh build (rounded: within the pixel tolerance)."""
    if expected == actual:
        return expected == actual
    (want_files, want_links), (have_files, have_links) = expected, actual
    if want_links != have_links or set(want_files) != set(have_files):
        return False
    for rel, want in want_files.items():
        have = have_files[rel]
        if not rel.startswith('cursors/'):
            if want != have:
                return False
            continue
        want_head, want_chunks = chunks(want)
        # Check the complete structure before following offsets from the disk file.
        # A truncated file or damaged table is stale, not a decoder exception.
        if len(want) != len(have) or have[:len(want_head)] != want_head:
            return False
        _, have_chunks = chunks(have)
        total = count = 0
        for (want_fields, want_px), (have_fields, have_px) in zip(want_chunks, have_chunks):
            if want_fields != have_fields:
                return False
            # Tolerance must never admit invalid premultiplied ARGB pixels.
            if any(max(have_px[i:i + 3]) > have_px[i + 3]
                   for i in range(0, len(have_px), 4)):
                return False
            for a, b in zip(want_px, have_px):
                if abs(a - b) > PIXEL_TOLERANCE:
                    return False
                total += abs(a - b)
            count += len(want_px)
        if total > PIXEL_MEAN * count:
            return False
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='fail if a checked-in theme is stale')
    parser.add_argument('--theme', choices=THEMES, help='build or check only this theme (default: all)')
    args = parser.parse_args()
    for name in [args.theme] if args.theme else THEMES:
        theme = ROOT / 'cursors' / name
        files, links = generate(name)
        if args.check:
            if not matches(name, (files, links), on_disk(theme)):
                sys.exit(f'cursors/{name} is stale: run python3 scripts/build-cursors')
            print(f'cursors/{name} is current ({len(files) - 1} cursors, {len(links)} aliases)')
            continue
        if theme.exists():
            for path in sorted(theme.rglob('*'), reverse=True):
                path.unlink() if path.is_symlink() or path.is_file() else path.rmdir()
        for rel, data in files.items():
            (theme / rel).parent.mkdir(parents=True, exist_ok=True)
            (theme / rel).write_bytes(data)
        for rel, target in links.items():
            (theme / rel).symlink_to(target)
        print(f'wrote {theme.relative_to(ROOT)}: {len(files) - 1} cursors, {len(links)} aliases')


if __name__ == '__main__':
    main()
