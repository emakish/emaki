#!/bin/bash
# Resolve the source checkout through symlinks; installed wrappers use the build path.
emaki_script=$(readlink -f -- "$0")
emaki_paths="${emaki_script%/*}/paths"
[ -r "$emaki_paths" ] || emaki_paths='@EMAKI_LIBEXECDIR@/paths'
# shellcheck source=scripts/paths
. "$emaki_paths"
unset emaki_script emaki_paths
# A successful greetd acknowledgement is recorded before compositor teardown.
# Qt may _exit(255) on Wayland disconnect; that is not a greeter failure.
if [[ ${1:-} == --success ]]; then
    if [[ -n ${EMAKI_GREETER_SUCCESS_FILE:-} ]]; then
        printf 'accepted\n' > "$EMAKI_GREETER_SUCCESS_FILE" || true
    fi
    exec "${EMAKI_GREETER_COMPOSITOR:-niri}" msg action quit --skip-confirmation
fi
if command -v systemd-cat >/dev/null 2>&1; then
    exec > >(systemd-cat -t emaki-greeter >/dev/null 2>&1 || cat >/dev/null 2>&1) 2>&1
else
    exec >/dev/null 2>&1
fi
ulimit -c 0
umask 077
# This data layer hides the stock session only in the recovery greeter's chooser.
# The primary greeter still reads the stock entry for automatic session recovery.
run_regreet() {
    XDG_DATA_DIRS="$EMAKI_DATADIR/greetd/data:${XDG_DATA_DIRS:-$EMAKI_XDG_DATA_DIRS_DEFAULT}" regreet
}
if ! EMAKI_GREETER_SUCCESS_FILE=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/emaki-greeter-success.XXXXXXXX"); then
    unset EMAKI_GREETER_SUCCESS_FILE
    qs -p "$EMAKI_DATADIR/shell/greeter.qml" || run_regreet
    "${EMAKI_GREETER_COMPOSITOR:-niri}" msg action quit --skip-confirmation
    exit $?
fi
export EMAKI_GREETER_SUCCESS_FILE
trap 'rm -f "$EMAKI_GREETER_SUCCESS_FILE"' EXIT
qs -p "$EMAKI_DATADIR/shell/greeter.qml"
result=$?
if [[ -s $EMAKI_GREETER_SUCCESS_FILE ]]; then
    exit 0
fi
if ((result != 0)); then
    run_regreet
fi
"${EMAKI_GREETER_COMPOSITOR:-niri}" msg action quit --skip-confirmation
