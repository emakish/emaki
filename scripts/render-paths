#!/usr/bin/env python3
# Copyright (C) 2026 Artur Yakymenko
# SPDX-License-Identifier: GPL-3.0-or-later
"""Render the shared install paths and substitute only recorded package files."""
import argparse
import json
from pathlib import Path
import re
import shlex
import sys

ROOT = Path(__file__).resolve().parent.parent
HEADER = 'Copyright (C) 2026 Artur Yakymenko\nSPDX-License-Identifier: GPL-3.0-or-later\n'


# Other packages' files and system defaults. They stay where the host installs them
# when Emaki's prefix moves; the Makefile passes the same values to the core build.
SYSTEM = {
    'XKB_RULES': '/usr/share/X11/xkb/rules/evdev.lst',
    'PAM_KWALLET_INIT': '/usr/lib/pam_kwallet_init',
    'POLKIT_AGENT': '/usr/lib/polkit-kde-authentication-agent-1',
    'XDG_DATA_DIRS_DEFAULT': '/usr/local/share:/usr/share',
    'TRUSTED_PATH': '/usr/bin',
}


def paths(prefix='/usr', datadir=None, libexecdir=None, system=None):
    prefix = str(Path(prefix))
    values = {
        'PREFIX': prefix,
        'DATADIR': datadir or prefix + '/share/emaki',
        'LIBEXECDIR': libexecdir or prefix + '/libexec/emaki',
        'LIBDIR': prefix + '/lib/emaki',
        'BINDIR': prefix + '/bin',
    }
    values.update({key: (system or {}).get(key) or value for key, value in SYSTEM.items()})
    for name, value in values.items():
        # These paths also appear in unit, PAM and kdl syntax. Fail before writing
        # rather than silently producing a different command or invalid config.
        if not value.startswith('/') or re.search(r'''[\s"'`$\\;|&<>]''', value):
            raise ValueError(f'{name} must be an absolute path without shell metacharacters or whitespace')
    return values


def write(path, text):
    # Explicit modes, like `install -Dm644`: the greeter and session users read these
    # modules whatever umask the installing shell had.
    for directory in reversed(path.parents):
        if not directory.exists():
            directory.mkdir()
            directory.chmod(0o755)
    if not path.exists() or path.read_text() != text:
        path.write_text(text)
    path.chmod(0o644)


def modules(values):
    python = ''.join('# ' + line + '\n' for line in HEADER.splitlines())
    python += '# Generated by make paths; change install directories in the Makefile.\n'
    python += ''.join(f'{key} = {value!r}\n' for key, value in values.items())
    shell = ''.join('# ' + line + '\n' for line in HEADER.splitlines())
    shell += '# Generated by make paths; source this file before using install paths.\n'
    shell += ''.join(f'EMAKI_{key}={shlex.quote(value)}\n' for key, value in values.items())
    names = {'PREFIX': 'prefix', 'DATADIR': 'dataDir', 'LIBEXECDIR': 'libexecDir',
             'LIBDIR': 'libDir', 'BINDIR': 'binDir', 'XKB_RULES': 'xkbRules',
             'XDG_DATA_DIRS_DEFAULT': 'xdgDataDirsDefault'}
    qml = ''.join('// ' + line + '\n' for line in HEADER.splitlines())
    qml += 'pragma Singleton\n\nimport QtQuick\nimport Quickshell\n\nQtObject {\n'
    qml += ''.join(f'    readonly property string {name}: {json.dumps(values[key])}\n'
                   for key, name in names.items())
    qml += '    readonly property string python: Quickshell.env("EMAKI_PYTHON") || "python3"\n}\n'
    return python, shell, qml


def replacements(values):
    # Longest first: the update window is a sibling of Emaki's data directory.
    return {
        '/usr/share/emaki-update-manager': values['PREFIX'] + '/share/emaki-update-manager',
        '/usr/share/emaki': values['DATADIR'],
        '/usr/libexec/emaki': values['LIBEXECDIR'],
        '/usr/lib/emaki': values['LIBDIR'],
        '/usr/bin/emaki': values['BINDIR'] + '/emaki',
        '/usr/bin/niri-emaki-session': values['BINDIR'] + '/niri-emaki-session',
        '/usr/share/doc/emaki': values['PREFIX'] + '/share/doc/emaki',
        '/usr/share/libalpm/scripts/emaki': values['PREFIX'] + '/share/libalpm/scripts/emaki',
    }


def substitute(text, values):
    mapping = replacements(values)
    mapping.update({'@EMAKI_' + key + '@': value for key, value in values.items()})
    # Optional payload installation can render an existing stage again. Protect
    # destinations nested below a default path from gaining the suffix twice.
    mapping.update({value: value for value in mapping.values() if value not in mapping})
    return re.sub('|'.join(re.escape(key) for key in sorted(mapping, key=len, reverse=True)),
                  lambda match: mapping[match[0]], text)


def destination(path, values):
    # The committed inventory describes the default payload; /etc and vendor PAM
    # locations deliberately keep the host library's discovery contract.
    if path.startswith('/usr/share/emaki/'):
        return values['DATADIR'] + path[len('/usr/share/emaki'):]
    if path.startswith('/usr/libexec/emaki/'):
        return values['LIBEXECDIR'] + path[len('/usr/libexec/emaki'):]
    if path.startswith('/usr/') and not path.startswith(('/usr/lib/pam.d/', '/usr/lib/initcpio/')):
        return values['PREFIX'] + path[len('/usr'):]
    return path


def render_source(root, values):
    python, shell, qml = modules(values)
    write(root / 'scripts/emaki_paths.py', python)
    write(root / 'shell/helpers/emaki_paths.py', python)
    write(root / 'scripts/paths', shell)
    write(root / 'shell/Platform.qml', qml)


def render_install(root, values, inventory):
    for relative in inventory.read_text().splitlines():
        path = root / destination(relative, values).lstrip('/')
        if path.is_symlink() or not path.is_file():
            continue
        try:
            text = path.read_text()
        except UnicodeError:
            continue
        if '\0' in text:
            continue
        rendered = substitute(text, values)
        if rendered != text:
            path.write_text(rendered)
    python, shell, qml = modules(values)
    data = root / values['DATADIR'].lstrip('/')
    libexec = root / values['LIBEXECDIR'].lstrip('/')
    write(libexec / 'emaki_paths.py', python)
    write(libexec / 'paths', shell)
    # Helpers travel with a retained shell generation and use its matching paths.
    write(data / 'shell/helpers/emaki_paths.py', python)
    write(data / 'shell/Platform.qml', qml)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prefix', default='/usr')
    parser.add_argument('--datadir')
    parser.add_argument('--libexecdir')
    for key in SYSTEM:
        parser.add_argument('--' + key.lower().replace('_', '-'), dest=key)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--source', type=Path)
    group.add_argument('--install', type=Path)
    group.add_argument('--text', type=Path)
    parser.add_argument('--inventory', type=Path, default=ROOT / 'packaging/emaki-config/expected-files.list')
    args = parser.parse_args()
    values = paths(args.prefix, args.datadir, args.libexecdir, {key: getattr(args, key) for key in SYSTEM})
    if args.source:
        render_source(args.source, values)
    elif args.install:
        render_install(args.install, values, args.inventory)
    else:
        sys.stdout.write(substitute(args.text.read_text(), values))


if __name__ == '__main__':
    main()
