#!/usr/bin/env python3
"""Generate the lock's 48 physical pixel wordmark from the approved vector geometry."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'art/logo'))
from wordmark import wordmark  # noqa: E402

GROUPS = [0] * 4 + [1] * 4 + [2] * 4 + [3] * 3 + [4, 5]
HOT = ['#b01e78', '#ec2a55', '#ff6a2a', '#ffb62e']
BAYER = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]]
TARGET = ROOT / 'shell/LockWordmarkData.js'


def generate_pixels():
    """Canonical lock/greeter pixels, also used by the boot splash."""
    path, width = wordmark()
    polygons = []
    for part in re.findall(r'M([^Z]+)Z', path):
        coordinates = [float(value) for value in re.findall(r'-?\d+(?:\.\d+)?', part)]
        polygons.append(list(zip(coordinates[::2], coordinates[1::2])))
    if len(polygons) != len(GROUPS):
        raise ValueError('The canonical wordmark polygon groups changed; review letter labels')

    def group_at(x, y):
        for group, polygon in zip(GROUPS, polygons):
            inside = False
            for (x1, y1), (x2, y2) in zip(polygon, polygon[1:] + polygon[:1]):
                if (y1 > y) != (y2 > y) and x < x1 + (y - y1) * (x2 - x1) / (y2 - y1):
                    inside = not inside
            if inside:
                return group
        return None

    w, h = int(width * 2) + 2, 48
    grid = [[group_at((x + .5) / 2, (y + .5) / 2) for x in range(w)] for y in range(h)]

    def filled(x, y):
        return 0 <= x < w and 0 <= y < h and grid[y][x] is not None

    pixels = []
    for y in range(h):
        for x in range(w):
            if grid[y][x] is None:
                continue
            neighbours = sum(not filled(x + dx, y + dy) for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)))
            u = max(0, min(1, x / w * .8 + (1 - y / h) * .2)) * 3
            base = min(int(u), 2)
            color = base + int(u - base > (BAYER[y % 4][x % 4] + .5) / 16)
            pixels.append([x, y, grid[y][x], neighbours, color])
    return path, w, h, pixels


def generate():
    path, w, h, pixels = generate_pixels()
    compact = lambda value: json.dumps(value, separators=(',', ':'))
    source_hash = hashlib.sha256(path.encode()).hexdigest()
    header = ('.pragma library\n'
              '// Generated by scripts/build-lock-wordmark from art/logo/wordmark.py; do not edit.\n'
              '// Pixels: [x, y, letter (E/m/a/k/i/dot), empty neighbours, Hot colour index].\n'
              f'var SOURCE_SHA256 = "{source_hash}";\n'
              f'var W = {w};\nvar H = {h};\n'
              f'var HOT = {compact(HOT)};\nvar BAYER = {compact(BAYER)};\n')
    rows = [','.join(compact(p) for p in pixels if p[1] == y) for y in range(h)]
    return header + 'var PIXELS = [\n' + ',\n'.join('    ' + row for row in rows if row) + '\n];\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='fail if checked-in pixels are stale')
    args = parser.parse_args()
    output = generate()
    if args.check:
        if not TARGET.is_file() or TARGET.read_text() != output:
            parser.exit(1, 'LockWordmarkData.js is stale; run python3 scripts/build-lock-wordmark\n')
        print('PASS: checked-in lock wordmark matches canonical geometry and Hot colours')
    else:
        TARGET.write_text(output)
        print('Generated shell/LockWordmarkData.js')


if __name__ == '__main__':
    main()
