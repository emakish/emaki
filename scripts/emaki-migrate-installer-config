"""Remove the old installer's duplicate layout toggle from untouched templates."""
import errno
import os
from pathlib import Path
import pwd
import re
import secrets
import stat
import subprocess
import sys

LINE = b'            options "grp:win_space_toggle"\n'
ORIGINAL = re.compile(
    rb'include "/usr/share/emaki/niri/default.kdl"\n\ninput \{\n'
    rb'    keyboard \{\n        xkb \{\n'
    rb'            layout "[a-z]+(?:,[a-z]+)*"\n'
    rb'(?:            variant "[a-z,]+"\n)?'
    + re.escape(LINE) + rb'        \}\n    \}\n\}\n'
    rb'(?:\noutput "[A-Za-z0-9_.:-]+" \{\n    scale [0-9]+(?:\.[0-9]+)?\n\}\n)*')
STAMP = Path('/var/lib/emaki-installer/migrations/layout-toggle-v1')


def migrate(home):
    """Run as the account, using no-follow descriptors for every path component."""
    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    temporary = None
    try:
        path = Path(home) / '.config/niri'
        if not path.is_absolute() or '..' in path.parts:
            return
        for component in path.parts[1:]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        fd = os.open('config.kdl', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        with os.fdopen(fd, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
                return
            original = stream.read(65537)
        if len(original) > 65536 or not ORIGINAL.fullmatch(original):
            return
        temporary = '.emaki-layout-' + secrets.token_hex(12)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     stat.S_IMODE(info.st_mode), dir_fd=directory)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(original.replace(LINE, b'', 1))
            stream.flush()
            os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
            os.fsync(stream.fileno())
        current = os.stat('config.kdl', dir_fd=directory, follow_symlinks=False)
        if (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns) != (
                current.st_dev, current.st_ino, current.st_mtime_ns, current.st_ctime_ns):
            return
        os.rename(temporary, 'config.kdl', src_dir_fd=directory, dst_dir_fd=directory)
        temporary = None
        os.fsync(directory)
    except OSError as error:
        if error.errno not in (errno.ENOENT, errno.ENOTDIR, errno.EACCES, errno.ELOOP):
            raise
    finally:
        if temporary:
            os.unlink(temporary, dir_fd=directory)
        os.close(directory)


def main():
    if len(sys.argv) == 3 and sys.argv[1] == '--home':
        migrate(sys.argv[2])
        return
    if os.geteuid() != 0:
        raise SystemExit(1)
    if STAMP.exists():
        return
    for account in pwd.getpwall():
        if 1000 <= account.pw_uid < 65534 and account.pw_dir.startswith('/home/'):
            subprocess.run(['/usr/bin/python3', '-I', __file__, '--home', account.pw_dir],
                           user=account.pw_uid, group=account.pw_gid, extra_groups=[], check=True)
    STAMP.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    STAMP.write_text('1\n')


if __name__ == '__main__':
    main()
