"""Hold logind's sleep delay until a locker confirms this session is locked.

Retry with hyprlock inside logind's reported delay budget. If neither locker
confirms, request termination of this graphical session before releasing the
inhibitor. A persistent Emaki flag explains the closure at the next login.
The optional stay-awake lid policy locks before asking logind to suspend;
all PrepareForSleep requests use the same fallback and termination path.
Transaction lid closures keep the session alive even if both lockers fail.
"""
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time

import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib

LOGIN_NAME = 'org.freedesktop.login1'
LOGIN_PATH = '/org/freedesktop/login1'
LOGIN_INTERFACE = 'org.freedesktop.login1.Manager'
SESSION_INTERFACE = 'org.freedesktop.login1.Session'
USER_PATH = '/org/freedesktop/login1/user/self'
USER_INTERFACE = 'org.freedesktop.login1.User'
# Leave time for fallback confirmation and session termination.
ACTION_LOCK_TIMEOUT = 12
ACTION_TIMEOUT = 5
END_SESSION_TIMEOUT = 2
POLL_INTERVAL = 0.05
FAILURE_POLICIES = ('end-session', 'stay-awake')
DEFAULT_FAILURE_POLICY = 'end-session'
LOGINCTL = 'loginctl'
LOCK = 'emaki-lock'
SYSTEMCTL = 'systemctl'
BOOT_ID = '/proc/sys/kernel/random/boot_id'


def log(message):
    print('emaki-sleep-guard: ' + message, file=sys.stderr, flush=True)


def failure_policy(environ):
    value = environ.get('EMAKI_SLEEP_LOCK_FAILURE', DEFAULT_FAILURE_POLICY)
    if value in FAILURE_POLICIES:
        return value
    log(f'unknown EMAKI_SLEEP_LOCK_FAILURE value; using {DEFAULT_FAILURE_POLICY}')
    return DEFAULT_FAILURE_POLICY


def session_path(proxy, environ, user_display):
    """Object path of this graphical session, or None when logind knows none."""
    session = environ.get('XDG_SESSION_ID')
    if session:
        path, = proxy.call_sync('GetSession', GLib.Variant('(s)', (session,)),
                                Gio.DBusCallFlags.NONE, 5000, None).unpack()
    else:
        # A user service has XDG_SESSION_ID only when the session imported it.
        session, path = user_display()
    if not session:
        return None
    connection = proxy.get_connection()

    def property_value(name):
        value, = connection.call_sync(
            LOGIN_NAME, path, 'org.freedesktop.DBus.Properties', 'Get',
            GLib.Variant('(ss)', (SESSION_INTERFACE, name)), GLib.VariantType('(v)'),
            Gio.DBusCallFlags.NONE, 5000, None).unpack()
        return value

    if property_value('Type') != 'wayland' or property_value('User')[0] != os.getuid():
        raise ValueError('The graphical session must be a Wayland session of this user [logind].')
    return path


def subscribe_lock(connection, path, callback):
    # Only Lock is subscribed. Unlock never reaches this process.
    return connection.signal_subscribe(
        LOGIN_NAME, SESSION_INTERFACE, 'Lock', path, None, Gio.DBusSignalFlags.NONE,
        lambda _connection, _sender, _path, _interface, name, _parameters: callback(name))


def run(argv, timeout, quiet=False, capture=False):
    """Run one command; the result is 'ok', or a logged failure word."""
    if timeout <= 0:
        return 'failed'
    try:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, close_fds=True,
                                timeout=timeout, check=False, capture_output=capture)
        if result.returncode == 0:
            return 'ok'
        if not quiet:
            log(f'{argv[0]} failed (exit {result.returncode})')
    except subprocess.TimeoutExpired:
        if not quiet:
            log(f'{argv[0]} timed out after {timeout} seconds')
    except OSError as error:
        if not quiet:
            log(f'could not start {argv[0]}: {error}')
    return 'failed'


def notify_ready():
    """Tell systemd (Type=notify) that the delay inhibitor is held, in one message with
    RESTART_RESET=1: systemd sets its restart counter back to 0, so RestartSteps= slows down
    only a guard that keeps failing before this point. systemd 262 takes RESTART_RESET=1 only
    from a running service, and the READY=1 of the same message makes it one. sd_notify(3)
    without libsystemd; the variable is removed, as sd_notify's unset_environment does, so
    the commands the guard runs do not inherit it. Nothing to do outside systemd."""
    address = os.environ.pop('NOTIFY_SOCKET', '')
    if not address:
        return
    if address.startswith('@'):
        address = '\0' + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as peer:
            peer.connect(address)
            peer.sendall(b'READY=1\nRESTART_RESET=1')
    except OSError as error:
        log(f'could not notify systemd: {error}')


def session_identity(environ):
    """This boot and this niri: what tells a later session from the one that ended."""
    try:
        boot = Path(BOOT_ID).read_text().strip()
    except OSError:
        boot = ''
    return boot, environ.get('NIRI_SOCKET', '')


class SleepGuard:
    def __init__(self, proxy, policy=DEFAULT_FAILURE_POLICY, environ=os.environ):
        self.proxy = proxy
        self.policy = policy
        self.environ = environ
        self.inhibitor = None
        self.lid_inhibitor = None
        self.sleeping = False
        self.session_id = environ.get('XDG_SESSION_ID', '')
        self.lock_timeout = ACTION_LOCK_TIMEOUT
        self.delay_window = 0.0
        self.release_margin = 0.0
        self.window_end = 0.0

    def inhibit(self, what, mode, why):
        reply, fd_list = self.proxy.call_with_unix_fd_list_sync(
            'Inhibit', GLib.Variant('(ssss)', (what, 'Emaki session', why, mode)),
            Gio.DBusCallFlags.NONE, 5000, None, None)
        # The reply contains an index, not a descriptor. Steal the received fds:
        # leaving a second copy in Gio's list would keep the inhibitor alive.
        descriptors = fd_list.steal_fds()
        try:
            index, = reply.unpack()
            if not 0 <= index < len(descriptors):
                raise ValueError('invalid inhibitor descriptor index')
            descriptor = descriptors[index]
            os.set_inheritable(descriptor, False)
            return descriptors.pop(index)
        finally:
            for descriptor in descriptors:
                os.close(descriptor)

    def acquire(self):
        delay = self.proxy.get_cached_property('InhibitDelayMaxUSec')
        if delay is None or type(delay.unpack()) is not int or delay.unpack() <= 0:
            raise ValueError('Sleep delay must be greater than zero [logind].')
        self.delay_window = delay.unpack() / 1_000_000
        if self.inhibitor is None:
            self.inhibitor = self.inhibit('sleep', 'delay', 'Lock the session before sleep')
        if self.policy == 'stay-awake' and self.lid_inhibitor is None:
            # logind then does nothing at lid close; lid_closed() acts instead.
            self.lid_inhibitor = self.inhibit('handle-lid-switch', 'block',
                                              'Lock before sleeping on lid close')

    def release(self):
        if self.inhibitor is not None:
            descriptor, self.inhibitor = self.inhibitor, None
            os.close(descriptor)

    def release_lid(self):
        if self.lid_inhibitor is not None:
            descriptor, self.lid_inhibitor = self.lid_inhibitor, None
            os.close(descriptor)

    def runtime_flag(self):
        return Path(self.environ.get('XDG_RUNTIME_DIR', '/tmp')) / 'emaki-sleep-lock-failed'

    def state_flag(self):
        state = self.environ.get('XDG_STATE_HOME') or os.path.join(self.environ.get('HOME', '/'), '.local/state')
        return Path(state) / 'emaki' / 'sleep-lock-failed'

    @staticmethod
    def write_flag(path, text):
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
        except OSError as error:
            log(f'could not write the notice flag: {error}')

    def flag(self, name=None):
        """Leave the policy name where the shell looks for its one-time notice."""
        name = name or self.policy
        if name == 'end-session':
            # Only when the session has ended: the next one shows it, a shell restarted
            # in this one does not.
            self.flag_next_session(name)
        else:
            self.write_flag(self.runtime_flag(), name + '\n')

    def flag_next_session(self, name):
        """The flag in the state directory, which outlives the session. It names this boot
        and this niri, so only a shell of a later session shows it. Returns its text."""
        boot, niri = session_identity(self.environ)
        text = f'{name}\nboot={boot}\nniri={niri}\n'
        self.write_flag(self.state_flag(), text)
        return text

    def session_signal(self, name):
        if name != 'Lock':
            return
        if run([LOCK], self.lock_timeout) != 'ok':
            log('lock requested by logind was not confirmed')

    def remaining(self):
        return max(0.0, self.window_end - self.release_margin - time.monotonic())

    def end_session(self):
        # A premature exit must never leave a claim that termination succeeded.
        self.flag_next_session('end-session-failed')
        ended = False
        try:
            log('Screen lock failed before sleep; closing this session [loginctl].')
            if not self.session_id:
                raise ValueError('No graphical session ID is available [loginctl].')
            terminated = run([LOGINCTL, 'terminate-session', self.session_id],
                             self.remaining() * 0.25) == 'ok'
            # The login scope only contains the session wrapper. Its normal cleanup
            # never runs after logind kills it; stop the user session units explicitly.
            # Do not wait for the target job: it also stops this guard.
            shutdown = run([SYSTEMCTL, '--user', 'start', '--no-block',
                            '--job-mode=replace-irreversibly', 'niri-shutdown.target'],
                           self.remaining() * 0.25) == 'ok'
            gone = self.wait_for_session_exit()
            if terminated and shutdown and gone:
                ended = True
                self.flag_next_session('end-session')
                return True
            log('Session closure before sleep could not be confirmed.')
            return False
        finally:
            # A surviving shell watches runtime flags. Do not defer its warning to
            # another login; the provisional state flag only covers interrupted teardown.
            if not ended:
                self.flag('end-session-failed')
            stale = self.runtime_flag() if ended else self.state_flag()
            try:
                stale.unlink(missing_ok=True)
            except OSError as error:
                log(f'could not remove the notice flag: {error}')

    def wait_for_session_exit(self):
        """Observe both supported compositors: either can own this session."""
        while self.remaining() > 0:
            try:
                result = subprocess.run(
                    [SYSTEMCTL, '--user', 'show', '--property=ActiveState', '--value',
                     'niri-emaki.service', 'niri.service', 'graphical-session.target'],
                    stdin=subprocess.DEVNULL, close_fds=True, capture_output=True,
                    text=True, timeout=self.remaining(), check=False)
                states = result.stdout.split()
                if (result.returncode == 0 and len(states) == 3
                        and all(state in ('inactive', 'failed') for state in states)):
                    return True
            except (subprocess.TimeoutExpired, OSError) as error:
                log(f'could not check session closure: {error}')
                return False
            time.sleep(min(POLL_INTERVAL, self.remaining()))
        return False

    def prepare_for_sleep(self, sleeping):
        if not sleeping:
            self.sleeping = False
            self.acquire()
            return
        if self.sleeping:
            return
        self.sleeping = True
        try:
            if not self.lock_before_deadline():
                self.end_session()
        finally:
            # logind will sleep at its deadline even if a command failed or hung.
            self.release()

    def lock_before_deadline(self):
        self.window_end = time.monotonic() + self.delay_window
        self.release_margin = min(0.25, self.delay_window * 0.05)
        usable = self.remaining()
        termination_reserve = min(END_SESSION_TIMEOUT, usable * 0.25)
        # Only the readiness client is in this service's cgroup. Its timeout
        # leaves the supervisor alive so it can accept the fallback request.
        if run([LOCK, '--wait'], min(ACTION_LOCK_TIMEOUT, usable * 0.60), quiet=True) == 'ok':
            return True
        if run([LOCK, '--fallback', '--wait'],
               self.remaining() - termination_reserve, quiet=True) == 'ok':
            log('Primary screen lock was not confirmed; hyprlock fallback succeeded.')
            return True
        # A fallback can confirm just as its readiness client times out.
        if run([LOCK, 'status'], min(0.2, self.remaining() * 0.1),
               quiet=True, capture=True) == 'ok':
            return True
        return False

    def transaction_inhibits_lid(self):
        try:
            entries, = self.proxy.call_sync(
                'ListInhibitors', None, Gio.DBusCallFlags.NONE, 5000, None).unpack()
            return any(who == 'Emaki packages' and uid == 0 and mode == 'block'
                       and {'sleep', 'handle-lid-switch'} <= set(what.split(':'))
                       for what, who, _why, mode, uid, _pid in entries)
        except (GLib.Error, OSError, ValueError) as error:
            log(f'could not inspect transaction sleep protection: {error}')
            return False

    def lid_closed(self, closed, docked=None):
        """Lock blocked transaction lids; otherwise apply the stay-awake policy."""
        if not closed or self.sleeping:
            return
        if docked is None:
            # Docked has no change signal, so the proxy cache may be stale.
            try:
                docked, = self.proxy.get_connection().call_sync(
                    LOGIN_NAME, LOGIN_PATH, 'org.freedesktop.DBus.Properties', 'Get',
                    GLib.Variant('(ss)', (LOGIN_INTERFACE, 'Docked')), GLib.VariantType('(v)'),
                    Gio.DBusCallFlags.NONE, 5000, None).unpack()
            except (GLib.Error, OSError, ValueError) as error:
                log(f'could not read docked state: {error}')
                docked = False
        if docked:
            return
        if self.transaction_inhibits_lid():
            # This trusted system-bus query only requests locking. Keep our delay
            # descriptor: there is no sleep/wake pair while packages block sleep.
            if not self.lock_before_deadline():
                log('warning: lid closed and the screen is not locked; staying awake')
                self.flag_next_session('stay-awake')
            return
        if self.policy != 'stay-awake':
            return
        if run([LOCK, '--wait'], self.lock_timeout) == 'ok':
            run([SYSTEMCTL, 'suspend'], ACTION_TIMEOUT)
        else:
            log('warning: lid closed and the screen is not locked; staying awake')
            self.flag()


def main():
    if Path("/etc/emaki-live/greetd.toml").is_file():
        return 0
    loop = GLib.MainLoop()
    guard = None
    failed = False

    def fail(message):
        nonlocal failed
        failed = True
        log(message)
        loop.quit()

    def on_signal(_proxy, _sender, name, parameters):
        if name == 'PrepareForSleep':
            try:
                sleeping, = parameters.unpack()
                guard.prepare_for_sleep(sleeping)
            except (GLib.Error, OSError, ValueError) as error:
                fail(f'sleep inhibitor failed: {error}')

    def on_properties_changed(proxy, changed, _invalidated):
        if 'LidClosed' in changed.keys():
            guard.lid_closed(changed['LidClosed'])

    def on_owner_changed(proxy, _property):
        if not proxy.get_name_owner():
            # All logind locks are lost on daemon restart. Let systemd restart
            # this service and obtain a new proxy and descriptor.
            fail('logind disappeared; restarting the guard')

    def stop():
        loop.quit()
        return GLib.SOURCE_REMOVE

    try:
        proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
            LOGIN_NAME, LOGIN_PATH, LOGIN_INTERFACE, None)
        guard = SleepGuard(proxy, failure_policy(os.environ))
        proxy.connect('g-signal', on_signal)
        proxy.connect('g-properties-changed', on_properties_changed)
        proxy.connect('notify::g-name-owner', on_owner_changed)
        connection = proxy.get_connection()

        def user_display():
            value, = connection.call_sync(
                LOGIN_NAME, USER_PATH, 'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', (USER_INTERFACE, 'Display')), GLib.VariantType('(v)'),
                Gio.DBusCallFlags.NONE, 5000, None).unpack()
            return value

        # Lookup can block or fail; hold logind's delay throughout it.
        guard.acquire()
        path = session_path(proxy, os.environ, user_display)
        if path is None:
            raise ValueError('No graphical session was found [logind].')
        session, = connection.call_sync(
            LOGIN_NAME, path, 'org.freedesktop.DBus.Properties', 'Get',
            GLib.Variant('(ss)', (SESSION_INTERFACE, 'Id')), GLib.VariantType('(v)'),
            Gio.DBusCallFlags.NONE, 5000, None).unpack()
        if not session:
            raise ValueError('No graphical session ID was returned [logind].')
        guard.session_id = session
        subscribe_lock(connection, path, guard.session_signal)
        notify_ready()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
        # Cover startup during an already-announced sleep, as well as future signals.
        preparing = proxy.get_cached_property('PreparingForSleep')
        if preparing is not None and preparing.unpack():
            guard.prepare_for_sleep(True)
        loop.run()
    except (GLib.Error, OSError, ValueError) as error:
        log(f'startup failed: {error}')
        return 1
    finally:
        if guard is not None:
            guard.release()
            guard.release_lid()
    return int(failed)


if __name__ == '__main__':
    raise SystemExit(main())
