"""Start the panel, route IPC, or recover the supervised shell."""
import os
import sys

# Restore CLOEXEC before importing helpers or starting any subprocess. Presence,
# including an invalid empty value, identifies a compositor-owned launch.
if 'WAYLAND_SOCKET' in os.environ:
    try:
        os.set_inheritable(int(os.environ['WAYLAND_SOCKET']), False)
        from pathlib import Path
        import runpy
        import stat

        helper = Path('@EMAKI_BINDIR@/emaki-shell-trusted')
        if not helper.is_absolute():
            raise ValueError('the trusted helper install path was not rendered')
        # Reject links as well as writable ancestors: a root-owned link can
        # otherwise cross a writable directory before reaching a safe endpoint.
        for component in (*reversed(helper.parents), helper):
            metadata = component.lstat()
            if (metadata.st_uid != 0 or metadata.st_mode & 0o022
                    or stat.S_ISLNK(metadata.st_mode)):
                raise ValueError(f'unsafe trusted helper path: {component}')
        sys.argv[0] = str(helper)
        runpy.run_path(str(helper), run_name='__main__')
    except (OSError, ValueError) as error:
        print(f'Trusted shell: {error}', file=sys.stderr)
        sys.exit(1)
    sys.exit(0)

from pathlib import Path
import re
import resource
import shutil
import subprocess

sys.path.insert(0, '@EMAKI_LIBEXECDIR@')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_paths

# A source checkout uses the generated build configuration too. Inherited PATH
# never chooses the programs used to start or recover the shell.
os.environ['PATH'] = ('@EMAKI_TRUSTED_PATH@' if not '@EMAKI_TRUSTED_PATH@'.startswith('@')
                      else emaki_paths.TRUSTED_PATH)
BASE = Path(__file__).resolve().parent
HEALTH = str(BASE / 'emaki-shell-health')
SESSION_FILES = str(BASE / 'emaki-session-files')
TRUSTED_HELPER = str(BASE / 'emaki-shell-trusted')
PACKAGED = str(Path(emaki_paths.DATADIR) / 'shell')


def run(arguments, **kwargs):
    try:
        return subprocess.run(arguments, **kwargs)
    except OSError as error:
        print(f'{arguments[0]}: {error}', file=sys.stderr)
        return subprocess.CompletedProcess(arguments, 127, stdout='')


def capture(arguments, **kwargs):
    result = run(arguments, stdout=subprocess.PIPE, text=True, **kwargs)
    return result.returncode, (result.stdout or '').rstrip('\n')


def execute(arguments):
    try:
        os.execvp(arguments[0], arguments)
    except OSError as error:
        print(f'{arguments[0]}: {error}', file=sys.stderr)
        return 127


def main():
    os.environ['EMAKI_LIVE_SESSION'] = str(int(Path('/etc/emaki-live/greetd.toml').is_file()))
    shell = os.environ.get('EMAKI_SHELL_DIR') or PACKAGED
    args = sys.argv[1:]
    if args[:1] == ['call']:
        runtime = Path(os.environ.get('XDG_RUNTIME_DIR') or '/nonexistent')
        if (runtime / 'emaki-shell-health/packaged').exists():
            shell = PACKAGED
        status, shell = capture([SESSION_FILES, 'active', shell])
        if status:
            return 75
        call = ['qs', '-p', shell, 'ipc', 'call', *args[1:]]
        if args[1:] == ['launcher', 'toggle']:
            if run(call).returncode == 0:
                return 0
            _, config = capture(['emaki-config-path', 'fuzzel', 'fuzzel.ini'])
            return execute(['fuzzel', '--config', config])
        return execute(call)
    if args[:1] == ['recover']:
        run([HEALTH, 'report'])
        run(['emaki-qt-check'])
        print('The Emaki panel stopped. Press Enter to restart it.', flush=True)
        if not sys.stdin.readline():
            return 0
        args = ['restart']
    if args[:1] == ['restart']:
        status = run([TRUSTED_HELPER, 'restart']).returncode
        if status != 69:
            return status
        status = run(['systemctl', '--user', 'reset-failed', 'emaki-shell.service']).returncode
        return status or execute(['systemctl', '--user', 'restart', 'emaki-shell.service'])

    status, selected = capture([HEALTH, 'record', shell])
    shell = PACKAGED if status else selected
    for attempt in range(2):
        status, diagnostic = capture(['emaki-qt-check'], stderr=subprocess.STDOUT)
        if not status:
            break
        print(diagnostic, file=sys.stderr)
        if attempt == 1:
            try:
                subprocess.Popen(['kitty', '--title', 'Emaki panel compatibility warning',
                                  'sh', '-c', 'printf "%s\\n" "$1"; '
                                  'printf "\\nThe panel will still start. Press Enter to close this warning.\\n"; '
                                  'IFS= read -r reply', 'emaki-qt-warning', diagnostic])
            except OSError:
                pass
    env = os.environ
    env['EMAKI_SHELL_ORIGINAL_MALLOC_CONF'] = ('1' + env['MALLOC_CONF']
                                            if 'MALLOC_CONF' in env else '0')
    env['MALLOC_CONF'] = env.get('MALLOC_CONF') or 'thp:never'
    env['EMAKI_BIN'] = env.get('EMAKI_BIN') or shutil.which('emaki') or 'emaki'
    for key in ('EMAKI_SESSION_GENERATION', 'EMAKI_SESSION_SOURCE', 'EMAKI_SESSION_WATCHER'):
        env.pop(key, None)
    if env.get('XDG_RUNTIME_DIR') and Path(shell).is_dir() and Path(env['EMAKI_BIN']).is_file():
        source_shell = shell
        env['EMAKI_SESSION_SOURCE'] = source_shell
        env['EMAKI_SESSION_WATCHER'] = SESSION_FILES
        status, captured = capture([SESSION_FILES, 'prepare', shell, env['EMAKI_BIN'],
                                    env.get('EMAKI_SHELL_PROCESS_ID') or str(os.getpid())])
        if status:
            print('Desktop files could not be captured. Starting the panel with installed files [Emaki].',
                  file=sys.stderr)
        else:
            shell = captured
        if shell != source_shell:
            env['EMAKI_BIN'] = str(Path(shell).parent / 'emaki')
            env['EMAKI_SESSION_GENERATION'] = str(Path(shell).parent)
        run([HEALTH, 'record', source_shell, shell], stdout=subprocess.DEVNULL)
    for key, default in (('EMAKI_SHELL_BORDER', 'soft'), ('EMAKI_SHELL_NOTIFICATIONS', '1'),
                         ('EMAKI_SHELL_TRAY', '1')):
        env[key] = env.get(key) or default
    for key in ('EMAKI_SESSION_START', 'EMAKI_SESSION_SKIP_INTRO'):
        env.pop(key, None)
    if env.get('EMAKI_LOGIN_HANDOFF'):
        _, token = capture(['timeout', '--kill-after=.2s', '1s', sys.executable, '-I', '-B',
                            str(Path(shell) / 'helpers/session-start.py'), 'shell-token'],
                           stderr=subprocess.DEVNULL)
        if re.fullmatch('[0-9a-f]{32}', token):
            env['EMAKI_SESSION_START'] = token
            env['EMAKI_SESSION_SKIP_INTRO'] = '1'
    env.pop('EMAKI_LOGIN_HANDOFF', None)
    env['QS_DISABLE_CRASH_HANDLER'] = '1'
    for key in ('WAYLAND_DEBUG', 'QML_IMPORT_TRACE', 'QV4_SHOW_BYTECODE', 'QV4_FORCE_INTERPRETER'):
        env.pop(key, None)
    env['QML_IMPORT_PATH'] = shell
    env['QT_LOGGING_RULES'] = '*.debug=false'
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    return execute(['qs', '-n', '-p', shell])


if __name__ == '__main__':
    sys.exit(main())
