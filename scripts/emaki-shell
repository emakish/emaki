#!/bin/sh
# Resolve the source checkout through symlinks; installed wrappers use the build path.
emaki_script=$(readlink -f -- "$0")
emaki_paths="${emaki_script%/*}/paths"
[ -r "$emaki_paths" ] || emaki_paths='@EMAKI_LIBEXECDIR@/paths'
# shellcheck source=scripts/paths
. "$emaki_paths"
unset emaki_script emaki_paths
# Emaki shell: bar, launcher, clock shade with notifications, right island, dock.
# Quickshell (QML from the packaged shell) on top of the `emaki` core.
#
#   emaki-shell                     start (used by niri autostart)
#   emaki-shell call <target> <…>   tell the running shell: launcher toggle,
#                                   launcher mode Clipboard, drawer toggle, dock status …
#   emaki-shell restart             restart the service (after make install)
#
# Environment variables can override these distribution defaults.
# The shell writes nothing to ~/.config; its state lives in ~/.local/state/emaki/*.json.
set -eu

# The ISO owns this marker; an installed desktop never inherits a live flag.
EMAKI_LIVE_SESSION=0
[ ! -f /etc/emaki-live/greetd.toml ] || EMAKI_LIVE_SESSION=1
export EMAKI_LIVE_SESSION
shell="${EMAKI_SHELL_DIR:-$EMAKI_DATADIR/shell}"
case "$0" in
    */*) health="${0%/*}/emaki-shell-health"; session_files="${0%/*}/emaki-session-files" ;;
    *) health=emaki-shell-health; session_files=emaki-session-files ;;
esac

if [ "${1:-}" = "call" ]; then
    [ ! -e "${XDG_RUNTIME_DIR:-/nonexistent}/emaki-shell-health/packaged" ] || shell="$EMAKI_DATADIR/shell"
    shell=$("$session_files" active "$shell") || exit 75
    shift
    if [ "$#" -eq 2 ] && [ "$1" = "launcher" ] && [ "$2" = "toggle" ]; then
        qs -p "$shell" ipc call "$@" && exit 0
        exec fuzzel --config "$(emaki-config-path fuzzel fuzzel.ini)"
    fi
    exec qs -p "$shell" ipc call "$@"
fi
if [ "${1:-}" = "recover" ]; then
    "$health" report || :

    emaki-qt-check || true
    printf '%s\n' 'The Emaki panel stopped. Press Enter to restart it.'
    IFS= read -r reply || exit 0
    systemctl --user reset-failed emaki-shell.service
    exec systemctl --user restart emaki-shell.service
fi
if [ "${1:-}" = "restart" ]; then
    systemctl --user reset-failed emaki-shell.service
    exec systemctl --user restart emaki-shell.service
fi

# Record the actual service selection: its private environment may differ from
# the failure handler's. IPC and subsequent starts honor the same recovery marker.
shell=$("$health" record "$shell") || shell="$EMAKI_DATADIR/shell"

# Metadata can be absent on older packages; even a version mismatch is not proof
# of a crash. Confirm a failure once: a bounded package query can time out while
# live media is cold. Keep both failed attempts in the service journal, and show
# the captured confirmation rather than running a third, possibly successful check.
if ! qt_diagnostic=$(emaki-qt-check 2>&1); then
    printf '%s\n' "$qt_diagnostic" >&2
    if ! qt_diagnostic=$(emaki-qt-check 2>&1); then
        printf '%s\n' "$qt_diagnostic" >&2
        kitty --title 'Emaki panel compatibility warning' sh -c '
            printf "%s\n" "$1"
            printf "\nThe panel will still start. Press Enter to close this warning.\n"
            IFS= read -r reply
        ' emaki-qt-warning "$qt_diagnostic" &
    fi
fi
unset qt_diagnostic

# Keep the session value for application launches: 0 means absent, 1 prefixes
# the original value (including empty). Never accept an inherited stale marker.
if [ "${MALLOC_CONF+x}" = x ]; then
    export EMAKI_SHELL_ORIGINAL_MALLOC_CONF="1$MALLOC_CONF"
else
    export EMAKI_SHELL_ORIGINAL_MALLOC_CONF=0
fi
# qs links jemalloc. Honor user tuning; default only this shell, not its apps.
export MALLOC_CONF="${MALLOC_CONF:-thp:never}"

export EMAKI_BIN="${EMAKI_BIN:-$(command -v emaki || printf emaki)}"
unset EMAKI_SESSION_GENERATION EMAKI_SESSION_SOURCE EMAKI_SESSION_WATCHER
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$shell" ] && [ -f "$EMAKI_BIN" ]; then
    source_shell=$shell
    export EMAKI_SESSION_SOURCE="$source_shell" EMAKI_SESSION_WATCHER="$session_files"
    if ! shell=$("$session_files" prepare "$shell" "$EMAKI_BIN" "$$"); then
        printf '%s\n' 'Desktop files could not be captured. Starting the panel with installed files [Emaki].' >&2
        shell=$source_shell
    fi
    if [ "$shell" != "$source_shell" ]; then
        export EMAKI_BIN="${shell%/shell}/emaki"
        export EMAKI_SESSION_GENERATION="${shell%/shell}"
    fi
    "$health" record "$source_shell" "$shell" >/dev/null || :
fi
export EMAKI_SHELL_BORDER="${EMAKI_SHELL_BORDER:-soft}"
# The shell owns the notification server and tray (mako and waybar are no longer autostarted).
export EMAKI_SHELL_NOTIFICATIONS="${EMAKI_SHELL_NOTIFICATIONS:-1}"
export EMAKI_SHELL_TRAY="${EMAKI_SHELL_TRAY:-1}"
# -n: do not start a second instance of the same configuration.
# Optional decoration cannot prevent qs starting, even with a broken helper file.
unset EMAKI_SESSION_START EMAKI_SESSION_SKIP_INTRO
startup_token=
if [ -n "${EMAKI_LOGIN_HANDOFF:-}" ]; then
    startup_token=$(timeout --kill-after=.2s 1s python3 -I -B "$shell/helpers/session-start.py" shell-token 2>/dev/null) || startup_token=
fi
case "$startup_token" in
    ''|*[!0-9a-f]*) ;;
    *) if [ "${#startup_token}" -eq 32 ]; then
        export EMAKI_SESSION_START="$startup_token" EMAKI_SESSION_SKIP_INTRO=1
    fi ;;
esac
unset EMAKI_LOGIN_HANDOFF startup_token
# Without this, Quickshell's crash handler opens a report window and re-executes qs in
# place, so systemd never sees the crash (Restart=on-failure and the start limit).
export QS_DISABLE_CRASH_HANDLER=1
exec qs -n -p "$shell"
