"""Keep QML, lazy components, helpers and the core from one installed generation.

Whether a system transaction is running and whether the desktop changed since login come only
from the desktop state command (`emaki-session-update state`), never from the package manager.
"""
import ctypes
import hashlib
import json
import os
from pathlib import Path
import select
import shutil
import struct
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, '@EMAKI_LIBEXECDIR@')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_session_state as state
import emaki_paths

os.environ['PATH'] = emaki_paths.TRUSTED_PATH

SCHEMA = 1
STATE_SCHEMA = 1
STATE = 'emaki-session-update'
START_WAIT = 2
RUNTIMES = Path('/run/user')
# The observer's poll while the state is not settled, and how it waits for an update's writes to pause.
POLL = 5
SETTLE, SETTLE_LIMIT = 0.5, 5
# How often an idle observer compares the watched files' stat with the last check (see Changes).
SAFETY = 60


def query_state(request='state'):
    # Beside an installed or development copy of this script, else by name: a captured
    # generation keeps asking the installed command, which describes the system now.
    beside = Path(__file__).resolve().with_name(STATE)
    command = str(beside) if os.access(beside, os.X_OK) else STATE
    return subprocess.run([command, request], stdin=subprocess.DEVNULL, capture_output=True,
                          text=True, timeout=10, check=True).stdout


def state_sources():
    """The files whose change can change the state answer, or None when the command cannot say."""
    try:
        value = json.loads(query_state('sources'))
        if value['schema'] == STATE_SCHEMA and all(isinstance(path, str) for path in value['paths']):
            return [Path(path) for path in value['paths']]
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        pass
    return None


def backend():
    """The desktop state, validated: {busy, desktop, update}. Raises when there is no answer."""
    value = json.loads(query_state())
    update = value['update']
    if (value['schema'] != STATE_SCHEMA or not isinstance(value['busy'], bool)
            or not isinstance(value['desktop'], str)
            or not (update is None or isinstance(update['id'], str) and isinstance(update['action'], str))):
        raise ValueError('The desktop state answer is not understood.')
    return value


def answer():
    """The desktop state, or None while the state command gives no usable answer."""
    try:
        return backend()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return None


def busy(value):
    return value is not None and value['busy']


def installed(value):
    """What a session compares with its login: the desktop identity and the last update needing it."""
    if value is None:
        return None
    seen = dict(desktop=value['desktop'])
    update = value['update']
    if update is not None and update['action'] != 'none':
        seen['transaction'] = update['id']
    return seen


def differs(before, now):
    """Whether the desktop moved since `before`: another desktop identity, or an update needing a
    new session recorded after it. A record that was lost or became unreadable is not an update."""
    return (before.get('baseline-incomplete', False) or now['desktop'] != before['desktop']
            or 'transaction' in now and now['transaction'] != before.get('transaction'))


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    return value.hexdigest()


def tree_files(path):
    return (file for file in sorted(path.rglob('*')) if file.is_file()
            and '__pycache__' not in file.parts and file.suffix not in ('.pyc', '.pyo'))


def tree(path):
    return {str(file.relative_to(path)): digest(file) for file in tree_files(path)}


def mark(path):
    """What stat says about the file behind `path`, symlinks followed: a changed file or target has
    another inode, size, mtime or ctime. None when it cannot be read."""
    try:
        value = path.stat()
    except OSError:
        return None
    return value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns


def identity(source):
    # A compositor's socket name changes on a new login; shell restarts retain it.
    session = os.environ.get('NIRI_SOCKET') or os.environ.get('WAYLAND_DISPLAY', 'offscreen')
    return hashlib.sha256((session + '\0' + str(source)).encode()).hexdigest()[:24]


def runtime(source, create=True):
    base = Path(os.environ.get('XDG_RUNTIME_DIR', str(RUNTIMES / str(os.getuid())))) / 'emaki-session-files' / identity(source)
    if create:
        base.mkdir(mode=0o700, parents=True, exist_ok=True)
    return base


def write_json(path, value):
    temporary = path.with_suffix('.new')
    temporary.write_text(json.dumps(value, sort_keys=True))
    temporary.replace(path)


def record_active(source, shell, pid):
    value = dict(source=str(source), shell=str(shell), pid=pid, start=state.process_start(pid))
    write_json(runtime(source) / 'active.json', value)
    write_json(runtime(source).parent / 'current.json', value)


def remember(baseline, value):
    # The first answered observation of this login. Without any answer there is nothing to
    # compare yet; the watcher records the first settled answer instead (see `recorded`).
    if baseline.exists() or value is None:
        return
    before = installed(value)
    if value['busy']:
        # Files may already be replaced: a first observation inside a running
        # transaction cannot establish what the compositor originally loaded.
        before['baseline-incomplete'] = True
    write_json(baseline, before)


def prepare(source, binary, wait=False, pid=None):
    source, binary = source.absolute(), binary.absolute()
    pid = os.getpid() if pid is None else pid
    base = runtime(source)
    # Record the compositor's first observed state even when capture cannot finish.
    # In particular, waiting for a transaction must not move this baseline forward.
    baseline = base / 'session.json'
    value = answer()
    remember(baseline, value)
    deadline = time.monotonic() + (START_WAIT if wait else 0)
    while busy(value):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            print('A system update is running. Starting the panel with installed files [Emaki].',
                  file=sys.stderr, flush=True)
            record_active(source, source, pid)
            return source
        time.sleep(min(0.1, remaining))
        value = answer()
    before = installed(value)
    files, core = tree(source), digest(binary)
    version = hashlib.sha256(json.dumps([SCHEMA, files, core, digest(Path(__file__)),
                                        digest(Path(state.__file__)), digest(Path(emaki_paths.__file__))],
                                       sort_keys=True).encode()).hexdigest()
    target = base / version
    if not target.exists():
        stage = Path(tempfile.mkdtemp(prefix='preparing-', dir=base))
        try:
            shutil.copytree(source, stage / 'shell', ignore=shutil.ignore_patterns('__pycache__', '*.pyc', '*.pyo'))
            shutil.copy2(binary, stage / 'emaki')
            shutil.copy2(Path(__file__), stage / 'watch.py')
            shutil.copy2(Path(state.__file__), stage / 'emaki_session_state.py')
            shutil.copy2(Path(emaki_paths.__file__), stage / 'emaki_paths.py')
            if tree(stage / 'shell') != files or digest(stage / 'emaki') != core:
                raise RuntimeError('Desktop files changed while the panel was starting [Emaki].')
            write_json(stage / 'generation.json', dict(schema=SCHEMA, source=str(source), binary=str(binary),
                       files=files, core=core, version=version))
            stage.rename(target)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
    after = answer()
    remember(baseline, after)
    # Without an answer on either side only the file digests can prove a stable capture.
    moved = before is not None and after is not None and differs(before, installed(after))
    if busy(after) or moved or tree(source) != files or digest(binary) != core:
        raise RuntimeError('Desktop files changed while the panel was starting [Emaki].')
    record_active(source, target / 'shell', pid)
    return target / 'shell'


def active(source):
    try:
        # SSH and text consoles have no compositor socket. A per-user record
        # names the selected panel and rejects exits and PID reuse.
        local = bool(os.environ.get('NIRI_SOCKET'))
        base = runtime(source, create=False)
        record = base / 'active.json' if local else base.parent / 'current.json'
        value = json.loads(record.read_text())
        selected = Path(value['shell'])
        if ((not local or value['source'] == str(source)) and selected.is_dir() and value['start'] is not None
                and state.process_start(value['pid']) == value['start']):
            return selected
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return source


def settled():
    """The desktop state when nothing is being installed, else None: no answer, no notice."""
    value = answer()
    return None if state.LIVE.exists() or value is None or value['busy'] else value


def recorded(baseline, value):
    """The login baseline, or None when it is missing or unreadable. An unknown start is no
    evidence of an update: the settled answer `value` becomes the baseline for later polls."""
    try:
        before = json.loads(baseline.read_text())
        if (isinstance(before, dict) and isinstance(before.get('desktop'), str)
                and isinstance(before.get('transaction', ''), str)):
            return before
    except (OSError, ValueError):
        pass
    try:
        baseline.unlink(missing_ok=True)
        remember(baseline, value)
    except OSError:
        pass
    return None


def compare(generation):
    """(stale, complete): the notice is due, and the check saw a settled desktop throughout.
    An incomplete check (a transaction ran, or no answer) proves nothing about later answers."""
    value = settled()
    if value is None:
        return False, False
    record = json.loads((generation / 'generation.json').read_text())
    if record['schema'] != SCHEMA:
        return True, True
    baseline = (runtime(Path(record['source']), create=False) if record.get('trusted')
                else generation.parent) / 'session.json'
    before = recorded(baseline, value)
    # Changed files are proof on their own, with or without a baseline.
    stale = (before is not None and differs(before, installed(value))
             or tree(Path(record['source'])) != record['files']
             or digest(Path(record['binary'])) != record['core'])
    return confirmed(stale)


def compare_installed(source):
    value = settled()
    if value is None:
        return False, False
    before = recorded(runtime(source, create=False) / 'session.json', value)
    stale = before is not None and differs(before, installed(value))
    return confirmed(stale)


def confirmed(stale):
    """A stale answer counts only if the desktop is still settled after the comparison."""
    if not stale:
        return False, True
    after = settled() is not None
    return after, after


def changed(generation):
    return compare(generation)[0]


def changed_installed(source):
    return compare_installed(source)[0]


class Changes:
    """inotify on every file an update writes; `active` is False when one of them cannot be watched.

    A file is watched through its directory, filtered by its name, so a replaced or recreated
    file is seen too; a directory is also watched itself; a tree is watched directory by directory.
    A watched directory that is moved or deleted counts whatever its filter, so the watches follow
    the path, not the old directory; watches left from an earlier arm are removed and ignored.
    A file that is a symlink is also watched at its final target.

    inotify cannot see everything: a moved or replaced ancestor above the watched directories, an
    intermediate symlink pointed elsewhere, or a tree file that links outside the tree. So every
    SAFETY seconds an idle wait compares, in process, the stat of each watched file and tree file
    with the marks taken before the last check (`note`), and counts a difference as an event.
    """
    IN_ATTRIB, IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO = 0x4, 0x8, 0x40, 0x80
    IN_CREATE, IN_DELETE, IN_DELETE_SELF, IN_MOVE_SELF = 0x100, 0x200, 0x400, 0x800
    IN_Q_OVERFLOW, IN_IGNORED = 0x4000, 0x8000
    MASK = (IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE
            | IN_DELETE_SELF | IN_MOVE_SELF)
    HEADER = struct.Struct('iIII')

    def __init__(self, files, trees=()):
        self.files, self.trees, self.filters, self.fd, self.seen = files, list(trees), {}, -1, None
        try:
            self.libc = ctypes.CDLL(None, use_errno=True)
            self.fd = self.libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
        except (OSError, AttributeError):
            pass
        self.active = files is not None and self.fd >= 0 and self.arm()

    def add(self, path, name=None):
        wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), self.MASK)
        if wd < 0:
            return False
        names = self.filters.get(wd, set())
        self.filters[wd] = None if name is None or names is None else names | {name}
        return True

    def arm(self):
        old = set(self.filters)
        self.filters.clear()
        armed = True
        for path in self.files:
            armed = self.add(path.parent, path.name) and armed
            if path.is_dir():
                armed = self.add(path) and armed
            target = path.resolve()
            if target != path:
                # A dangling target is left to the safety check.
                self.add(target.parent, target.name)
        for tree in self.trees:
            self.add(tree.parent, tree.name)
            for folder in [tree, *sorted(folder for folder in tree.rglob('*') if folder.is_dir())]:
                armed = self.add(folder) and armed
        for wd in old - set(self.filters):
            self.libc.inotify_rm_watch(self.fd, wd)
        return armed

    def relevant(self):
        try:
            data = os.read(self.fd, 65536)
        except BlockingIOError:
            return False
        found, offset = False, 0
        while offset + self.HEADER.size <= len(data):
            wd, mask, _cookie, length = self.HEADER.unpack_from(data, offset)
            name = data[offset + self.HEADER.size:offset + self.HEADER.size + length].rstrip(b'\0')
            offset += self.HEADER.size + length
            if mask & self.IN_Q_OVERFLOW:
                found = True
            elif wd in self.filters:
                names = self.filters[wd]
                found = found or bool(mask & (self.IN_IGNORED | self.IN_DELETE_SELF | self.IN_MOVE_SELF)) \
                    or names is None or os.fsdecode(name) in names
        return found

    def marks(self):
        if self.files is None:
            return None
        return ([mark(path) for path in self.files],
                [{str(file.relative_to(tree)): mark(file) for file in tree_files(tree)} for tree in self.trees])

    def note(self):
        """Take the marks the safety check compares with; called before each check."""
        self.seen = self.marks()

    def wait(self, timeout):
        """Until a watched file changed and writes paused, or `timeout` seconds (None: no limit)."""
        if not self.active:
            time.sleep(POLL)
            # A watched directory may be back (or was only being replaced): try the watches again.
            if self.fd >= 0 and self.files is not None:
                while select.select([self.fd], [], [], 0)[0]:
                    self.relevant()
                self.active = self.arm()
            return
        deadline = None if timeout is None else time.monotonic() + timeout
        # By the clock, not by quiet: filtered-out events must not postpone the safety check.
        safety = time.monotonic() + SAFETY
        while True:
            now = time.monotonic()
            if deadline is not None and deadline <= now:
                return
            if safety <= now:
                if self.seen is not None and self.marks() != self.seen:
                    break
                safety = now + SAFETY
            remaining = safety - now if deadline is None else min(deadline, safety) - now
            if select.select([self.fd], [], [], remaining)[0] and self.relevant():
                break
        # One update writes many files: ask once it paused, at most SETTLE_LIMIT later.
        limit = time.monotonic() + SETTLE_LIMIT
        while time.monotonic() < limit and select.select([self.fd], [], [], SETTLE)[0]:
            self.relevant()
        self.active = self.arm()

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1


def watched(generation, installed_source):
    """What an update can change for this observer: (files, trees), files None when unknown."""
    files = state_sources()
    if installed_source or files is None:
        return files, ()
    record = json.loads((generation / 'generation.json').read_text())
    return files + [Path(record['binary'])], (Path(record['source']),)


def watch(generation, installed_source=False):
    # Waits on the files an update writes instead of asking every five seconds. The state is
    # still polled after a check that did not see it settled throughout (a transaction ran, or
    # no answer): the end of a transaction found only by its process, or an answer that failed
    # once, writes nothing, and the update itself may already be on disk with its events read.
    # Without inotify (or a state command that cannot name its files) the poll is all there is.
    # Behind inotify, a stat comparison every SAFETY seconds catches what it cannot see.
    try:
        events = Changes(*watched(generation, installed_source))
    except (OSError, ValueError, KeyError, TypeError):
        events = Changes(None)
    try:
        while True:
            events.note()
            try:
                stale, complete = compare_installed(generation) if installed_source else compare(generation)
            except (OSError, ValueError, KeyError):
                stale, complete = settled() is not None, False
            if stale:
                print(json.dumps(dict(schema=SCHEMA, restart=True)), flush=True)
                return
            events.wait(None if events.active and complete else POLL)
    finally:
        events.close()


def main():
    command = sys.argv[1]
    if command == 'prepare':
        print(prepare(Path(sys.argv[2]), Path(sys.argv[3]), wait=True,
                      pid=int(sys.argv[4]) if len(sys.argv) > 4 else os.getppid()))
    elif command == 'trusted-record':
        source = Path(sys.argv[2])
        remember(runtime(source) / 'session.json', answer())
        record_active(source, Path(sys.argv[3]), int(sys.argv[4]))
    elif command == 'active':
        print(active(Path(sys.argv[2]).absolute()))
    elif command == 'watch':
        watch(Path(sys.argv[2]))
    elif command == 'watch-installed':
        watch(Path(sys.argv[2]).absolute(), installed_source=True)
    else:
        raise ValueError('Unknown session files command.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(75)
