#!/usr/bin/python3 -IB
# Copyright (C) 2026 Artur Yakymenko
# SPDX-License-Identifier: GPL-3.0-or-later
"""Keep QML, lazy components, helpers and the core from one installed generation.

Whether a system transaction is running and whether the desktop changed since login come only
from the desktop state command (`emaki-session-update state`), never from the package manager.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, '@EMAKI_LIBEXECDIR@')
sys.path.insert(0, str(Path(__file__).resolve().parent))
import emaki_session_state as state

SCHEMA = 1
STATE_SCHEMA = 1
STATE = 'emaki-session-update'
START_WAIT = 2
RUNTIMES = Path('/run/user')


def query_state():
    # Beside an installed or development copy of this script, else by name: a captured
    # generation keeps asking the installed command, which describes the system now.
    beside = Path(__file__).resolve().with_name(STATE)
    command = str(beside) if os.access(beside, os.X_OK) else STATE
    return subprocess.run([command, 'state'], stdin=subprocess.DEVNULL, capture_output=True,
                          text=True, timeout=10, check=True).stdout


def backend():
    """The desktop state, validated: {busy, desktop, update}. Raises when there is no answer."""
    value = json.loads(query_state())
    update = value['update']
    if (value['schema'] != STATE_SCHEMA or not isinstance(value['busy'], bool)
            or not isinstance(value['desktop'], str)
            or not (update is None or isinstance(update['id'], str) and isinstance(update['action'], str))):
        raise ValueError('The desktop state answer is not understood.')
    return value


def answer():
    """The desktop state, or None while the state command gives no usable answer."""
    try:
        return backend()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return None


def busy(value):
    return value is not None and value['busy']


def installed(value):
    """What a session compares with its login: the desktop identity and the last update needing it."""
    if value is None:
        return None
    seen = dict(desktop=value['desktop'])
    update = value['update']
    if update is not None and update['action'] != 'none':
        seen['transaction'] = update['id']
    return seen


def differs(before, now):
    """Whether the desktop moved since `before`: another desktop identity, or an update needing a
    new session recorded after it. A record that was lost or became unreadable is not an update."""
    return (before.get('baseline-incomplete', False) or now['desktop'] != before['desktop']
            or 'transaction' in now and now['transaction'] != before.get('transaction'))


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    return value.hexdigest()


def tree(path):
    return {str(file.relative_to(path)): digest(file)
            for file in sorted(path.rglob('*')) if file.is_file()
            and '__pycache__' not in file.parts and file.suffix not in ('.pyc', '.pyo')}


def identity(source):
    # A compositor's socket name changes on a new login; shell restarts retain it.
    session = os.environ.get('NIRI_SOCKET') or os.environ.get('WAYLAND_DISPLAY', 'offscreen')
    return hashlib.sha256((session + '\0' + str(source)).encode()).hexdigest()[:24]


def runtime(source, create=True):
    base = Path(os.environ.get('XDG_RUNTIME_DIR', str(RUNTIMES / str(os.getuid())))) / 'emaki-session-files' / identity(source)
    if create:
        base.mkdir(mode=0o700, parents=True, exist_ok=True)
    return base


def write_json(path, value):
    temporary = path.with_suffix('.new')
    temporary.write_text(json.dumps(value, sort_keys=True))
    temporary.replace(path)


def record_active(source, shell, pid):
    value = dict(source=str(source), shell=str(shell), pid=pid, start=state.process_start(pid))
    write_json(runtime(source) / 'active.json', value)
    write_json(runtime(source).parent / 'current.json', value)


def remember(baseline, value):
    # The first answered observation of this login. Without any answer there is nothing to
    # compare yet; the watcher records the first settled answer instead (see `recorded`).
    if baseline.exists() or value is None:
        return
    before = installed(value)
    if value['busy']:
        # Files may already be replaced: a first observation inside a running
        # transaction cannot establish what the compositor originally loaded.
        before['baseline-incomplete'] = True
    write_json(baseline, before)


def prepare(source, binary, wait=False, pid=None):
    source, binary = source.absolute(), binary.absolute()
    pid = os.getpid() if pid is None else pid
    base = runtime(source)
    # Record the compositor's first observed state even when capture cannot finish.
    # In particular, waiting for a transaction must not move this baseline forward.
    baseline = base / 'session.json'
    value = answer()
    remember(baseline, value)
    deadline = time.monotonic() + (START_WAIT if wait else 0)
    while busy(value):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            print('A system update is running. Starting the panel with installed files [Emaki].',
                  file=sys.stderr, flush=True)
            record_active(source, source, pid)
            return source
        time.sleep(min(0.1, remaining))
        value = answer()
    before = installed(value)
    files, core = tree(source), digest(binary)
    version = hashlib.sha256(json.dumps([SCHEMA, files, core, digest(Path(__file__)),
                                        digest(Path(state.__file__))], sort_keys=True).encode()).hexdigest()
    target = base / version
    if not target.exists():
        stage = Path(tempfile.mkdtemp(prefix='preparing-', dir=base))
        try:
            shutil.copytree(source, stage / 'shell', ignore=shutil.ignore_patterns('__pycache__', '*.pyc', '*.pyo'))
            shutil.copy2(binary, stage / 'emaki')
            shutil.copy2(Path(__file__), stage / 'watch.py')
            shutil.copy2(Path(state.__file__), stage / 'emaki_session_state.py')
            if tree(stage / 'shell') != files or digest(stage / 'emaki') != core:
                raise RuntimeError('Desktop files changed while the panel was starting [Emaki].')
            write_json(stage / 'generation.json', dict(schema=SCHEMA, source=str(source), binary=str(binary),
                       files=files, core=core, version=version))
            stage.rename(target)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
    after = answer()
    remember(baseline, after)
    # Without an answer on either side only the file digests can prove a stable capture.
    moved = before is not None and after is not None and differs(before, installed(after))
    if busy(after) or moved or tree(source) != files or digest(binary) != core:
        raise RuntimeError('Desktop files changed while the panel was starting [Emaki].')
    record_active(source, target / 'shell', pid)
    return target / 'shell'


def active(source):
    try:
        # SSH and text consoles have no compositor socket. A per-user record
        # names the selected panel and rejects exits and PID reuse.
        local = bool(os.environ.get('NIRI_SOCKET'))
        base = runtime(source, create=False)
        record = base / 'active.json' if local else base.parent / 'current.json'
        value = json.loads(record.read_text())
        selected = Path(value['shell'])
        if ((not local or value['source'] == str(source)) and selected.is_dir() and value['start'] is not None
                and state.process_start(value['pid']) == value['start']):
            return selected
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return source


def settled():
    """The desktop state when nothing is being installed, else None: no answer, no notice."""
    value = answer()
    return None if state.LIVE.exists() or value is None or value['busy'] else value


def recorded(baseline, value):
    """The login baseline, or None when it is missing or unreadable. An unknown start is no
    evidence of an update: the settled answer `value` becomes the baseline for later polls."""
    try:
        before = json.loads(baseline.read_text())
        if (isinstance(before, dict) and isinstance(before.get('desktop'), str)
                and isinstance(before.get('transaction', ''), str)):
            return before
    except (OSError, ValueError):
        pass
    try:
        baseline.unlink(missing_ok=True)
        remember(baseline, value)
    except OSError:
        pass
    return None


def changed(generation):
    value = settled()
    if value is None:
        return False
    record = json.loads((generation / 'generation.json').read_text())
    if record['schema'] != SCHEMA:
        return True
    before = recorded(generation.parent / 'session.json', value)
    # Changed files are proof on their own, with or without a baseline.
    stale = (before is not None and differs(before, installed(value))
             or tree(Path(record['source'])) != record['files']
             or digest(Path(record['binary'])) != record['core'])
    return stale and settled() is not None


def changed_installed(source):
    value = settled()
    if value is None:
        return False
    before = recorded(runtime(source, create=False) / 'session.json', value)
    stale = before is not None and differs(before, installed(value))
    return stale and settled() is not None


def watch(generation, installed_source=False):
    while True:
        try:
            stale = changed_installed(generation) if installed_source else changed(generation)
        except (OSError, ValueError, KeyError):
            stale = settled() is not None
        if stale:
            print(json.dumps(dict(schema=SCHEMA, restart=True)), flush=True)
            return
        time.sleep(5)


def main():
    command = sys.argv[1]
    if command == 'prepare':
        print(prepare(Path(sys.argv[2]), Path(sys.argv[3]), wait=True,
                      pid=int(sys.argv[4]) if len(sys.argv) > 4 else os.getppid()))
    elif command == 'active':
        print(active(Path(sys.argv[2]).absolute()))
    elif command == 'watch':
        watch(Path(sys.argv[2]))
    elif command == 'watch-installed':
        watch(Path(sys.argv[2]).absolute(), installed_source=True)
    else:
        raise ValueError('Unknown session files command.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(75)
