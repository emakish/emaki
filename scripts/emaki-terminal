"""Open the managed terminal, optionally running an argv after --."""
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import stat
import subprocess
import tempfile
import sys
import tomllib

DEFAULT_TERMINAL = 'kitty'


def selected_terminal():
    root = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    if not root.is_absolute():
        raise ValueError('invalid configuration directory')
    path = root / 'emaki/settings.toml'
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'rb') as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            raise ValueError('unsafe settings file')
        raw = source.read(65537)
    if len(raw) > 65536:
        raise ValueError('settings file too large')
    data = tomllib.loads(raw.decode('utf-8'))
    if type(data.get('schema_version')) is not int or data['schema_version'] != 1:
        raise ValueError('unsupported settings schema')
    defaults = data.get('defaults', {})
    if not isinstance(defaults, dict):
        raise ValueError('invalid defaults')
    ident = defaults.get('terminal')
    if ident is not None and (not isinstance(ident, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+\.desktop', ident)):
        raise ValueError('invalid terminal desktop ID')
    return ident


def command_argv(app):
    """Expand supported desktop field codes without invoking a command shell."""
    result = []
    for word in shlex.split(app.get_commandline() or ''):
        if word in ('%f', '%F', '%u', '%U'):
            continue
        if word == '%i':
            icon = app.get_string('Icon')
            if icon:
                result.extend(['--icon', icon])
            continue
        if word == '%c':
            result.append(app.get_name())
            continue
        if word == '%k':
            result.append(app.get_filename())
            continue
        if '%' in word.replace('%%', ''):
            raise ValueError('unsupported terminal field code')
        result.append(word.replace('%%', '%'))
    if not result:
        raise ValueError('terminal command is missing')
    return result


def password_prompt(receipt):
    """Keep the password program's result visible without reading its input."""
    try:
        code = subprocess.run(['passwd'], check=False).returncode
    except OSError:
        code = 127
    result = 'Password changed.' if code == 0 else 'Password not changed.'
    print('\n' + result, flush=True)
    if code == 0:
        print('Your login wallet may still use your previous password. Update its password separately.', flush=True)
    try:
        fd = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'w') as output:
            output.write(str(code))
    except OSError:
        pass  # A detached terminal may outlive the receipt directory.
    try:
        input('Press Enter to close this window. ')
    except (EOFError, KeyboardInterrupt):
        pass
    return code


def change_password():
    # The receipt records only an exit status, never password input or program output.
    with tempfile.TemporaryDirectory(prefix='emaki-password-') as temporary:
        receipt = Path(temporary) / 'result'
        try:
            subprocess.run(['emaki-terminal', '--', str(Path(__file__).resolve()),
                            '--password-prompt', str(receipt)], check=False,
                           stdout=sys.stderr)
            code = int(receipt.read_text())
            message = 'Password changed.' if code == 0 else 'Password not changed.'
            status = 'changed' if code == 0 else 'unchanged'
        except (OSError, ValueError):
            status = 'unconfirmed'
            message = 'The password change could not be confirmed. Check the password window.'
        print(json.dumps({'schema_version': 1, 'status': status, 'message': message}))


def main(argv):
    if argv == ['--default', '--json']:
        print(json.dumps({'executable': DEFAULT_TERMINAL}))
        return
    if argv == ['--change-password', '--json']:
        return change_password()
    if len(argv) == 2 and argv[0] == '--password-prompt':
        raise SystemExit(password_prompt(argv[1]))
    check = len(argv) == 2 and argv[0] in ('--check', '--check-terminal')
    if argv and argv[0] != '--' and not check:
        raise ValueError('usage: emaki-terminal [-- command arguments...]')
    command = argv[1:] if argv else []
    ident = argv[1] if check else selected_terminal()
    if ident is not None and not re.fullmatch(r'[A-Za-z0-9_.-]+\.desktop', ident):
        raise ValueError('invalid desktop ID')
    if ident is None:
        os.execvp(DEFAULT_TERMINAL, [DEFAULT_TERMINAL] + (['-e'] + command if command else []))
        return
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio
    app = Gio.DesktopAppInfo.new(ident)
    executable = app.get_executable() if app is not None else None
    if app is None or not executable or not shutil.which(executable):
        if check:
            raise ValueError('desktop entry or executable is unavailable')
        os.execvp(DEFAULT_TERMINAL, [DEFAULT_TERMINAL] + (['-e'] + command if command else []))
        return
    if check and argv[0] == '--check':
        return
    if 'TerminalEmulator' not in (app.get_categories() or '').split(';'):
        raise ValueError('terminal desktop entry is unavailable')
    if check:
        command_argv(app)
        return
    if not command:
        if not app.launch([], None):
            raise ValueError('terminal launch failed')
    else:
        args = command_argv(app) + ['-e'] + command
        os.execvp(args[0], args)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except Exception as error:
        print('emaki-terminal: ' + str(error), file=sys.stderr)
        sys.exit(1)
