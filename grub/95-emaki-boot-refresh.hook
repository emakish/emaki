[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = emaki-config
Target = grub
Target = grub-btrfs
Target = linux
Target = linux-lts

[Trigger]
Operation = Remove
Type = Package
Target = linux
Target = linux-lts
Target = grub-btrfs

[Action]
Description = Refreshing the Emaki boot loader and menu
When = PostTransaction
Exec = /usr/bin/emaki-boot-refresh --hook
