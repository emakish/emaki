[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Protecting the next start with the pre-update snapshot
When = PreTransaction
Exec = /usr/bin/emaki-update-boot mark
