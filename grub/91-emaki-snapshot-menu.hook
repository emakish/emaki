[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub-btrfs
Target = emaki-config

[Action]
Description = Selecting bootable entries in the snapshot menu
When = PostTransaction
Exec = /usr/share/libalpm/scripts/emaki-snapshot-menu
