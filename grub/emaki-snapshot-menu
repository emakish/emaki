"""Make snapshot menus start with bootable entries."""

import argparse
from datetime import datetime
import importlib.util
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile


# The supported generator calls this renderer before validating and publishing
# its menu, including updates made directly by the snapshot watcher.
SETTING = 'GRUB_BTRFS_SCRIPT_CHECK="emaki-snapshot-menu-check"'
STAGING = '.emaki-snapshots'
STAGING_SETTING = 'GRUB_BTRFS_GBTRFS_DIRNAME="/boot/grub/.emaki-snapshots"'
SCRIPT_CHECK = '/usr/bin/grub-script-check'
HEADER = re.compile(r"menuentry '\|((?:\s*(?:Date|Snapshot|Type|Description)\s*\|)+)' \{ echo \}\n")
OUTER = re.compile(r"submenu '(\|[^']*)' \{\n")
TITLE = re.compile(r"    submenu '(\|[^']*)' \{ echo \}\n")
# A snapshot block as GRUB_BTRFS_TITLE_FORMAT=("date" "snapshot" "type" "description")
# writes it, the setting boot/defaults/grub-btrfs.conf pins.
BLOCK = re.compile(r"submenu '\| *(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) *\| *(\S+) *\| *([^|']*?) *\|([^']*)\|' \{\n")
# A boot row inside a snapshot: kernel & initramfs, or kernel & initramfs & microcode.
KERNEL = re.compile(r"(    menuentry )'  vmlinuz-(linux|linux-lts) & initramfs-\2(-fallback)?\.img(?: & [^']*)?'")
# Hourly snapshots past the newest few only lengthen the list; every other kind stays.
AUTOMATIC_KEPT = 5
COMMAND_SHOWN = 24
TITLES = {'linux': 'Emaki', 'linux-lts': 'Emaki (LTS kernel)'}
MONTHS = ('Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec')
# The boot library's Secure Boot module, shared with the installer and the boot refresh.
SECUREBOOT = Path('/usr/lib/emaki/boot/emaki_boot/secureboot.py')
# A snapshot's kernel as the menu names it, and where the running system mounts it.
SNAPSHOT_KERNEL = re.compile(r'^\s*linux(?:efi)?\s+"?/(?:@snapshots|\.snapshots)/([0-9]+)/snapshot'
                             r'(/boot/vmlinuz-[A-Za-z0-9._-]+)"?(?:\s|$)')
NO_SIGNED_SNAPSHOT = "# No snapshot has a kernel signed with this machine's key.\n"


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def publish_staged(menu):
    """Publish checked bytes before the generator replaces its private copy."""
    if menu.name != 'grub-btrfs.new' or menu.parent.name != STAGING:
        return
    if menu.parent.is_symlink() or menu.parent.parent.is_symlink():
        raise ValueError(f'{menu.parent}: expected a real directory')
    target = menu.parent.parent / 'grub-btrfs.cfg'
    if target.is_symlink() or (target.exists() and not target.is_file()):
        raise ValueError(f'{target}: expected a regular file')
    descriptor, temporary = tempfile.mkstemp(prefix=target.name + '.emaki-publish-', dir=target.parent)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(menu.read_bytes())
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fsync(stream.fileno())
        os.replace(temporary, target)
        sync_directory(target.parent)
        # GRUB cannot replay the Btrfs tree log; commit the renamed file too.
        subprocess.run(['sync', '-f', str(target)], check=True)
    finally:
        Path(temporary).unlink(missing_ok=True)


def replace_file(path, original, replacement, validate=False):
    """Preserve file permissions and replace atomically; never follow links."""
    mode = path.lstat().st_mode
    if not stat.S_ISREG(mode):
        raise ValueError(f'{path}: expected a regular file')
    if path.read_text() != original:
        raise ValueError(f'{path}: changed during repair')
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + '.emaki.', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(replacement)
            stream.flush()
            os.fchmod(stream.fileno(), stat.S_IMODE(mode))
            os.fsync(stream.fileno())
        if validate and subprocess.run([SCRIPT_CHECK, temporary], check=False).returncode:
            raise ValueError('The snapshot menu failed its syntax check (grub-script-check).')
        os.replace(temporary, path)
        sync_directory(path.parent)
        if validate:
            subprocess.run(['sync', '-f', str(path)], check=True)
    finally:
        Path(temporary).unlink(missing_ok=True)


def plain_title(date, kind, description):
    """The date and a plain description instead of upstream's table row."""
    moment = datetime.strptime(date, '%Y-%m-%d %H:%M:%S')
    when = f'{moment.day} {MONTHS[moment.month - 1]} {moment.year}, {moment:%H:%M}'
    description = ' '.join(description.split())
    if kind in ('pre', 'post') and len(description) > COMMAND_SHOWN:
        # snap-pac records the whole pacman command line; long ones only widen the menu.
        description = description[:COMMAND_SHOWN - 1].rstrip() + '…'
    if kind == 'single' and description == 'timeline':
        what = 'automatic'
    elif kind == 'single' and description.startswith('Fresh Emaki '):
        what = 'fresh install'
    elif kind == 'pre':
        what = 'before update · ' + description if description not in ('', 'N/A') else 'before update'
    elif kind == 'post':
        what = 'after update · ' + description if description not in ('', 'N/A') else 'after update'
    else:
        what = description if description not in ('', 'N/A') else 'saved by hand'
    return f'{when} · {what}'


def retitle(text):
    """Plain snapshot titles, newest first, with only the newest automatic ones.

    Works only on menus whose every top-level block is an upstream snapshot row; anything
    else (a custom format, an already retitled menu) is returned unchanged. Boot commands
    are kept byte for byte; only the title lines change.
    """
    lines = text.splitlines(keepends=True)
    blocks, outside, index = [], [], 0
    while index < len(lines):
        line = lines[index]
        if line.startswith('submenu '):
            match = BLOCK.fullmatch(line)
            if not match:
                return text
            end = next((number for number in range(index + 1, len(lines)) if lines[number] == '}\n'), None)
            if end is None:
                return text
            blocks.append((match, lines[index + 1:end]))
            index = end + 1
            continue
        if line.strip():
            if not blocks:
                return text
            outside.append(line)
        index += 1
    if not blocks:
        return text
    blocks.sort(key=lambda block: block[0][1], reverse=True)
    automatic = 0
    result = []
    for match, body in blocks:
        date, kind, description = match[1], match[3].strip(), match[4].strip()
        if kind == 'single' and description == 'timeline':
            automatic += 1
            if automatic > AUTOMATIC_KEPT:
                continue
        result.append(f"submenu '{plain_title(date, kind, description)}' {{\n")
        # Boot rows: the ordinary initramfs first, the fallback ones after; anything else first.
        other, entries, current = [], [], None
        for row in body:
            if current is None and row.startswith('    menuentry '):
                current = [row]
            elif current is not None:
                current.append(row)
                if row == '    }\n':
                    entries.append(current)
                    current = None
            elif row.strip():
                other.append(row)
        if current is not None:
            return text
        ranked = []
        for position, rows in enumerate(entries):
            entry = KERNEL.match(rows[0])
            rank = (2, 0)
            if entry:
                title = TITLES[entry[2]]
                if entry[3]:
                    title = title[:-1] + ', all drivers)' if title.endswith(')') else title + ' (all drivers)'
                rows = [f"{entry[1]}'{title}'" + rows[0][entry.end():], *rows[1:]]
                rank = (1 if entry[3] else 0, list(TITLES).index(entry[2]))
            ranked.append((rank, position, rows))
        result += other
        for _, _, rows in sorted(ranked, key=lambda item: item[:2]):
            result += rows
        result.append('}\n')
    return ''.join(result + outside)


def kernel_signature_check(root=Path('/')):
    """None when this machine does not sign its boot files; else path -> signed by its key.

    With Secure Boot GRUB refuses a kernel the machine key did not sign, so such snapshot
    rows would only end in an error. Each kernel is asked once.
    """
    if not SECUREBOOT.is_file():
        # Without the boot library's Secure Boot module the menu stays as generated.
        return None
    spec = importlib.util.spec_from_file_location('emaki_secureboot', SECUREBOOT)
    secureboot = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(secureboot)
    if not secureboot.enabled(root):
        return None
    state = Path(root) / secureboot.STATE.relative_to('/')
    answers = {}

    def run(argv, input=None):
        return subprocess.run(argv, input=input, check=True, capture_output=True, text=True,
                              env={'PATH': os.defpath, 'LC_ALL': 'C'}).stdout

    def signed(number, kernel):
        path = Path(root) / '.snapshots' / number / 'snapshot' / kernel.lstrip('/')
        if path not in answers:
            answers[path] = path.is_file() and secureboot.signed(run, path, state)
        return answers[path]
    return signed


def signed_only(text, signed):
    """Drop snapshot rows whose kernel the machine key did not sign, and emptied snapshots.

    A row whose kernel line names no snapshot kernel is kept: it cannot be checked here. So is
    a submenu laid out differently from grub-btrfs (another indent, a nested menu): unchecked.
    """
    lines = text.splitlines(keepends=True)
    result, index, kept = [], 0, 0
    while index < len(lines):
        line = lines[index]
        end = next((number for number in range(index + 1, len(lines)) if lines[number] == '}\n'), None)
        if not line.startswith('submenu ') or end is None:
            result.append(line)
            index += 1
            continue
        body, rows, current, familiar = [], 0, None, True
        for row in lines[index + 1:end]:
            if current is None and row.startswith('    menuentry '):
                current = [row]
            elif current is not None:
                current.append(row)
                if row == '    }\n':
                    kernels = [match for match in map(SNAPSHOT_KERNEL.match, current) if match]
                    if not kernels or all(signed(match[1], match[2]) for match in kernels):
                        body += current
                        rows += 1
                    current = None
            else:
                body.append(row)
                if re.match(r'\s*(?:menuentry|submenu)\s', row) and not TITLE.fullmatch(row):
                    familiar = False
        if current is not None:
            return text
        if not familiar:
            result += lines[index:end + 1]
            kept += 1
        elif rows:
            result += [line, *body, '}\n']
            kept += 1
        index = end + 1
    if not kept and any(line.startswith('submenu ') for line in lines):
        result.append(NO_SIGNED_SNAPSHOT)
    return ''.join(result)


def render(text, signed=None):
    """Remove only the v4.14 heading forms and give snapshots plain titles.

    signed (from kernel_signature_check) drops the snapshot rows GRUB would refuse.
    """
    if signed is not None:
        text = signed_only(text, signed)
    lines = text.splitlines(keepends=True)
    result = []
    outer_title = None
    for index, line in enumerate(lines):
        if HEADER.fullmatch(line):
            continue
        title = TITLE.fullmatch(line)
        if title and outer_title is not None:
            if ''.join(title[1].split()) == ''.join(outer_title.split()):
                outer_title = None
                # A submenu must retain one command when no matching kernel
                # and initramfs produced a boot entry in this snapshot.
                following = []
                for candidate in lines[index + 1:]:
                    if candidate == '}\n':
                        break
                    following.append(candidate)
                if any(candidate.startswith('    menuentry ') for candidate in following):
                    continue
        outer = OUTER.fullmatch(line)
        outer_title = outer[1] if outer else None
        result.append(line)
    return retitle(''.join(result))


def repair_menu(menu, signed=None):
    if menu.is_symlink():
        raise ValueError(f'{menu}: expected a regular file')
    if menu.is_file():
        text = menu.read_text()
        replacement = render(text, signed)
        if replacement != text:
            replace_file(menu, text, replacement, validate=True)


def repair(generator, menu, defaults, signed=None):
    # Do not modify the generator or any other file owned by grub-btrfs.
    if not generator.exists():
        return
    if generator.is_symlink() or not generator.is_file():
        raise ValueError(f'{generator}: expected a regular file')
    if defaults.is_symlink() or not defaults.is_file():
        raise ValueError(f'{defaults}: expected a regular file')
    stage = menu.parent / STAGING
    if stage.is_symlink():
        raise ValueError(f'{stage}: expected a real directory')
    stage.mkdir(parents=True, exist_ok=True)
    sync_directory(stage.parent)
    text = defaults.read_text()
    settings = [setting for setting in (SETTING, STAGING_SETTING) if setting not in text.splitlines()]
    if settings:
        replace_file(defaults, text, text.rstrip('\n') + '\n' + '\n'.join(settings) + '\n')
    repair_menu(menu, signed)
    # Retire interrupted writes from before staging and either temporary prefix.
    leftovers = [menu.with_name('grub-btrfs.cfg.bkp'), menu.with_name('grub-btrfs.new')]
    leftovers.extend(menu.parent.glob('grub-btrfs.cfg.emaki.*'))
    leftovers.extend(menu.parent.glob('grub-btrfs.cfg.emaki-publish-*'))
    removed = False
    for leftover in leftovers:
        try:
            mode = leftover.lstat().st_mode
        except FileNotFoundError:
            continue
        if stat.S_ISREG(mode):
            leftover.unlink()
            removed = True
    if removed:
        sync_directory(menu.parent)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--generator', type=Path, default=Path('/etc/grub.d/41_snapshots-btrfs'))
    parser.add_argument('--menu', type=Path, default=Path('/boot/grub/grub-btrfs.cfg'))
    parser.add_argument('--defaults', type=Path, default=Path('/etc/default/grub'))
    parser.add_argument('--check', type=Path, metavar='MENU')
    args = parser.parse_args()
    try:
        signed = kernel_signature_check()
        if args.check is not None:
            repair_menu(args.check, signed)
            result = subprocess.run([SCRIPT_CHECK, str(args.check)], check=False).returncode
            if result == 0:
                publish_staged(args.check)
            return result
        repair(args.generator, args.menu, args.defaults, signed)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f'emaki-snapshot-menu: {error}\n')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
