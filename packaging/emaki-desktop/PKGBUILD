# shellcheck shell=bash
# makepkg consumes the metadata and supplies srcdir/pkgdir.
# shellcheck disable=SC2034,SC2154
# Desktop applications and the password-only lock PAM service. Runtime helpers
# and their dependencies are also declared by emaki-config for standalone use.
pkgname=emaki-desktop
pkgver=0.4.1
pkgrel=1
pkgdesc='Emaki desktop applications, dependencies and lock PAM configuration'
arch=('any')
url='https://github.com/emakish/emaki'
license=('GPL-3.0-or-later')
install=emaki-desktop.install
backup=('etc/pam.d/emaki-lock')
source=('emaki-lock.pam')
sha256sums=('43c3e514896042888cbaa613ac807c64045a23ba24d5df04ac40e8c9ea965371')
depends=(
    'emaki-config' 'niri-emaki>=26.04-12' 'quickshell-emaki' 'niri'
    'python' 'python-gobject' 'python-pillow' 'gtk3'
    'wpaperd' 'wl-clipboard' 'cliphist' 'polkit-kde-agent' 'udiskie'
    'kitty' 'fastfetch>=2.68.1' 'imagemagick'
    'xwayland-satellite'        # X11 apps (Steam, Wine): niri starts it on demand.
    'hyprlock'                  # Recovery fallback for the Emaki locker.
    'playerctl' 'fuzzel' 'qt6ct'
    # The upstream name, which xdg-desktop-portal-gnome-emaki provides: 0.1.0/0.1.1 keep Arch's
    # portal (their [emaki] comes after [extra], so pacman never offers the fork's replaces=).
    'xdg-desktop-portal-gnome' 'xdg-desktop-portal-gtk'
    'brightnessctl' 'power-profiles-daemon' 'networkmanager' 'upower' 'blueman' 'bluez'
    'pipewire' 'wireplumber' 'pipewire-pulse' 'wlsunset'
    # Same hardware support as the live USB: Intel SOF sound, Marvell Wi-Fi,
    # Vulkan and VA-API drivers. iso/test-static.py keeps the two in step.
    'sof-firmware' 'linux-firmware-marvell'
    'vulkan-intel' 'vulkan-nouveau' 'vulkan-radeon' 'intel-media-driver'
    'greetd' 'greetd-regreet' 'kwallet-pam'
    'dolphin' 'kdegraphics-thumbnailers' 'ffmpegthumbs'
    'breeze-icons' 'adwaita-icon-theme'              # KDE application icons not provided in hicolor.
    # Before firefox, so pacman resolves Firefox's ttf-font with it, not gnu-free-fonts.
    'noto-fonts'                # Broad script coverage for web pages (2026-10-03).
    'noto-fonts-emoji'          # Colour emoji outside Firefox.
    'firefox'                   # The web browser (2026-10-03).
)
optdepends=(
    'swayidle: optional emaki-idle policy'
    'greetd-tuigreet: optional text-mode login recovery'
)

package() {
    install -Dm644 "$srcdir/emaki-lock.pam" "$pkgdir/etc/pam.d/emaki-lock"
}
