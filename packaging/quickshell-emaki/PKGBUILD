# Derived from the Arch Linux 'quickshell' package (Maintainer: Caleb Maclennan <caleb@alerque.com>)
# Emaki: same build + a fix for the wlr-screencopy crash on Smithay compositors (niri),
# a fix that names the activation each network connection failure belongs to, a
# repaired polkit service (one request at a time, no cookie in logs, wiped replies), a
# desktop entry watch that follows application directories created later, and theme icons
# found when installed after startup (bindings are told when a missed icon arrives).

_pkgname=quickshell
pkgname=quickshell-emaki
pkgver=0.3.1
pkgrel=12
pkgdesc='Flexible toolkit for making desktop shells with QtQuick (Emaki patched build)'
arch=(x86_64 aarch64)
url="https://git.outfoxxed.me/$_pkgname/$_pkgname"
license=(LGPL-3.0-only)
depends=(glibc # libc.so libm.so
         hicolor-icon-theme
         jemalloc libjemalloc.so
         libdrm # libdrm.so
         libgcc libgcc_s.so
         libglvnd libEGL.so libOpenGL.so
