         libstdc++ libstdc++.so
         libxcb # libxcb.so
         mesa # libgbm.so
         pam libpam.so
         polkit
         'qt6-base>=6.12.0' 'qt6-base<6.13' # libQt6Core.so libQt6DBus.so libQt6Gui.so libQt6Network.so libQt6Widgets.so
         'qt6-declarative>=6.12.0' 'qt6-declarative<6.13' # libQt6Qml.so libQt6Quick.so
         'qt6-svg>=6.12.0' 'qt6-svg<6.13'
