# Derived from the Arch Linux 'quickshell' package (Maintainer: Caleb Maclennan <caleb@alerque.com>)
# Emaki: same build + a fix for the wlr-screencopy crash on Smithay compositors (niri)
# and a fix that names the activation each network connection failure belongs to.

_pkgname=quickshell
pkgname=quickshell-emaki
pkgver=0.3.1
pkgrel=6
pkgdesc='Flexible toolkit for making desktop shells with QtQuick (Emaki patched build)'
arch=(x86_64 aarch64)
url="https://git.outfoxxed.me/$_pkgname/$_pkgname"
license=(LGPL-3.0-only)
depends=(cpptrace libcpptrace.so
         glibc # libc.so libm.so
         hicolor-icon-theme
         jemalloc libjemalloc.so
         libdrm # libdrm.so
         libgcc libgcc_s.so
         libglvnd libEGL.so libOpenGL.so
         libpipewire libpipewire-0.3.so
         libstdc++ libstdc++.so
         libxcb # libxcb.so
         mesa # libgbm.so
         pam libpam.so
         polkit
         'qt6-base>=6.12.0' 'qt6-base<6.13' # libQt6Core.so libQt6DBus.so libQt6Gui.so libQt6Network.so libQt6Widgets.so
         'qt6-declarative>=6.12.0' 'qt6-declarative<6.13' # libQt6Qml.so libQt6Quick.so
         'qt6-svg>=6.12.0' 'qt6-svg<6.13'
         wayland libwayland-client.so)
makedepends=(cli11
             cmake
             ninja
             pkgconf
             'qt6-shadertools>=6.12.0' 'qt6-shadertools<6.13'
             spirv-tools
             vulkan-headers
             wayland-protocols)
_qtver=6.12.0
provides=("quickshell=$pkgver" "emaki-quickshell-qt-build=$_qtver")
conflicts=(quickshell)
_archive="$_pkgname-$pkgver"
source=("$_archive.tar.gz::$url/archive/v$pkgver.tar.gz"
        0001-wlr-screencopy-raw-wl_output-for-transform.patch
        0002-network-nm-name-the-activation-a-connection-failure.patch
        0003-qt-6.12-moc-includes.patch)
sha256sums=('d60592622f1aa1cbb853d4814f605dfde827bc692befbfecffaccf4c90e352d8'
            'b32f0be7920e0dd10cf89bb0fecdd0a7c0ac73f0f113fc93e3b235ad36e894c7'
            'a01afe049a5eec79752ecbb57b705fb672a34bb7b5eff20c43e68c544f70ea65'
            '4cb3b5acc94e0c9546568a782540ab01c1ad06946c8c7b7e290e2b9ffc21b7a2')

prepare() {
	cd "$_pkgname" || return 1
	patch -Np1 -i "$srcdir/0001-wlr-screencopy-raw-wl_output-for-transform.patch"
	patch -Np1 -i "$srcdir/0002-network-nm-name-the-activation-a-connection-failure.patch"
	patch -Np1 -i "$srcdir/0003-qt-6.12-moc-includes.patch"
}

# Keep the runtime floor equal to the Qt release used for this rebuild.
_qt_build_version() {
	local core qml module version
	core=$(pkg-config --modversion Qt6Core) || return 1
	qml=$(pkg-config --modversion Qt6Qml) || return 1
	if [[ ! $core =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || $core != "$qml" || $core != "$_qtver" ]] ||
	   [[ " ${depends[*]} " != *" qt6-base>=$core "* ||
	      " ${depends[*]} " != *" qt6-declarative>=$core "* ]]; then
		printf '%s\n' 'Qt build versions must agree and match both dependency lower bounds.' >&2
		return 1
	fi
	# WaylandClient is supplied by qt6-base in Arch's Qt 6.12 packages.
	for module in Qt6Svg Qt6ShaderTools Qt6WaylandClient; do
		version=$(pkg-config --modversion "$module") || return 1
		if [[ $version != "$_qtver" ]]; then
			printf 'Qt module %s must match build version %s (found %s).\n' "$module" "$_qtver" "$version" >&2
			return 1
		fi
	done
	printf '%s\n' "$core"
}

build() {
	local qt_build_version
	qt_build_version=$(_qt_build_version) || return 1
	cd "$_pkgname" || return 1
	local cmake_options=(
		-D CMAKE_BUILD_TYPE=RelWithDebInfo
		-D DISTRIBUTOR='Emaki (Arch Linux package + patches)'
		-D DISTRIBUTOR_DEBUGINFO_AVAILABLE=Yes
		-D CRASH_REPORTER=Off
		-D CMAKE_INSTALL_PREFIX=/usr
		-D INSTALL_QML_PREFIX=lib/qt6/qml
	)
	cmake -G Ninja -B build -W no-dev "${cmake_options[@]}" || return 1
	cmake --build build || return 1
	printf '%s\n' "$qt_build_version" > build/emaki-qt-build-version
}

package() {
	cd "$_pkgname" || return 1
	local qt_build_version current_qt_version
	[[ -s build/emaki-qt-build-version ]] || return 1
	qt_build_version=$(<build/emaki-qt-build-version) || return 1
	current_qt_version=$(_qt_build_version) || return 1
	[[ $qt_build_version == "$current_qt_version" ]] || return 1
	DESTDIR="$pkgdir" cmake --install build || return 1
	install -Dm0644 build/emaki-qt-build-version "$pkgdir/usr/share/quickshell-emaki/qt-build-version" || return 1
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
