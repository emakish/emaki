+// Qt's icon loader reads each theme's directories once, so an icon installed while the shell
+// runs (a program from the store) stays missing until the themes are loaded again.
+void QuickshellTracked::reloadIconThemes() {
+	this->sinceIconReload.start();
+
+	// Qt keeps only the icon directories that existed at startup, so add the data directories'
+	// icon directories that exist now (the first flatpak install creates its export directory).
+	auto paths = QIcon::themeSearchPaths();
+	const auto now = QStandardPaths::locateAll(
+	    QStandardPaths::GenericDataLocation,
+	    QStringLiteral("icons"),
+	    QStandardPaths::LocateDirectory
+	);
+	for (const auto& path: now) {
+		if (!paths.contains(path)) paths.append(path);
+	}
+
+	QIcon::setThemeSearchPaths(paths);
+}
+
+bool QuickshellTracked::themeHasIcon(const QString& icon) {
+	if (!QIcon::fromTheme(icon).isNull()) return true;
+
+	if (!this->sinceIconReload.isValid() || this->sinceIconReload.elapsed() >= 2000) {
+		this->reloadIconThemes();
+		if (!QIcon::fromTheme(icon).isNull()) return true;
+	}
+
+	// Still missing, or the themes were reloaded less than two seconds ago: look again when this
+	// window ends, and keep looking for two seconds after this miss (a package's icons can land
+	// just after its desktop entry). One timer serves every miss, so a reload never runs more
+	// often than every two seconds.
+	if (!this->missingIcons.contains(icon)) {
+		if (!this->iconClock.isValid()) this->iconClock.start();
+		this->missingIcons.insert(icon, this->iconClock.elapsed());
+	}
+
+	if (!this->iconRetry.isActive()) {
+		this->iconRetry.start(static_cast<int>(qMax(0, 2000 - this->sinceIconReload.elapsed())));
+	}
+
+	return false;
+}
+
+void QuickshellTracked::retryMissingIcons() {
+	this->reloadIconThemes();
+
+	// Only a found icon changes anything. A name still missing two seconds after its miss is
+	// dropped until its next lookup, so bindings that look again and miss settle after at most
+	// two more reloads.
+	auto found = false;
+	const auto now = this->iconClock.elapsed();
+	for (auto it = this->missingIcons.begin(); it != this->missingIcons.end();) {
+		if (!QIcon::fromTheme(it.key()).isNull()) {
+			found = true;
+			it = this->missingIcons.erase(it);
+		} else if (now - it.value() >= 2000) {
+			it = this->missingIcons.erase(it);
+		} else {
+			++it;
+		}
+	}
+
+	if (!this->missingIcons.isEmpty()) this->iconRetry.start(2000);
+
+	if (found) {
+		this->mIconThemeRevision++;
+		emit this->iconThemeChanged();
+	}
+}
+
 void QuickshellTracked::updateScreens() {
 	auto screens = QGuiApplication::screens();
 	auto newScreens = QList<QuickshellScreenInfo*>();
@@ -142,6 +219,7 @@ QuickshellGlobal::QuickshellGlobal(QObject* parent): QObject(parent) {
