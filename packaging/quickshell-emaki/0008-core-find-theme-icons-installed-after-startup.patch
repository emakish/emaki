diff --git a/src/core/test-icon-theme-reload.py b/src/core/test-icon-theme-reload.py
new file mode 100755
index 0000000..fbc9ced
--- /dev/null
+++ b/src/core/test-icon-theme-reload.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+# Copyright (C) 2026 Artur Yakymenko
+# SPDX-License-Identifier: LGPL-3.0-only
+"""Quickshell.iconPath(name, true) finds an icon installed after the shell started, also in a
+data directory that did not exist yet (the first flatpak install creates its export directory).
+A binding that read iconThemeRevision looks again by itself when an icon it missed is installed
+within the two seconds after a reload, with nothing calling iconPath again."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+PNG = bytes.fromhex('89504e470d0a1a0a0000000d4948445200000001000000010806000000'
+                    '1f15c4890000000d49444154789c6360f8cf00000301010018dd8db00000'
+                    '000049454e44ae426082')
+THEME = '[Icon Theme]\nName=Hicolor\nDirectories=48x48/apps\n\n[48x48/apps]\nSize=48\nType=Fixed\n'
+
+with tempfile.TemporaryDirectory(prefix='qs-icon-reload-', dir=os.getcwd()) as directory:
+    root = Path(directory)
+    root.chmod(0o700)
+    apps = root / 'data/icons/hicolor/48x48/apps'
+    apps.mkdir(parents=True)
+    (root / 'data/icons/hicolor/index.theme').write_text(THEME)
+    (apps / 'present.png').write_bytes(PNG)
+    for name in ('home', 'config/qt6ct', 'cache', 'state', 'runtime'):
+        (root / name).mkdir(parents=True, mode=0o700)
+    (root / 'shell.qml').write_text('''import QtQuick
+import Quickshell
+ShellRoot {
+    Component.onCompleted: Quickshell.watchFiles = false
+    Timer {
+        interval: 300; running: true; repeat: true
+        onTriggered: console.info("ICONS " + (Quickshell.iconPath("present", true) !== "")
+                                  + " " + (Quickshell.iconPath("later", true) !== "")
+                                  + " " + (Quickshell.iconPath("fresh", true) !== ""))
+    }
+    Timer { interval: 20000; running: true; onTriggered: Qt.quit() }
+}
+''')
+    # The offscreen platform has no icon theme; qt6ct with an empty configuration gives the
+    # generic hicolor lookup.
+    environment = dict(os.environ, QT_QPA_PLATFORM='offscreen', QT_QPA_PLATFORMTHEME='qt6ct',
+                       QT_QUICK_BACKEND='software', QML_DISABLE_DISK_CACHE='1',
+                       HOME=str(root / 'home'), XDG_DATA_HOME=str(root / 'home/data'),
+                       XDG_DATA_DIRS=str(root / 'data') + ':' + str(root / 'late'),
+                       XDG_CONFIG_HOME=str(root / 'config'),
+                       XDG_CACHE_HOME=str(root / 'cache'), XDG_STATE_HOME=str(root / 'state'),
+                       XDG_RUNTIME_DIR=str(root / 'runtime'),
+                       DBUS_SESSION_BUS_ADDRESS='unix:path=' + str(root / 'no-bus'))
+    shell = subprocess.Popen([sys.argv[1], '-p', str(root), '--no-color'], env=environment,
+                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    log = []
+    try:
+        def wait_for(text, seconds):
+            until = time.monotonic() + seconds
+            while time.monotonic() < until:
+                line = shell.stdout.readline()
+                if not line:
+                    break
+                log.append(line)
+                if text in line:
+                    return True
+            return False
+
+        if not wait_for('ICONS ', 10):
+            raise AssertionError('no icon probe output\n' + ''.join(log))
+        if 'ICONS true' not in log[-1]:
+            print('SKIP: no icon theme lookup on this platform (qt6ct missing?)')
+            sys.exit(0)
+        assert 'ICONS true false false' in log[-1], ''.join(log)
+        (apps / 'later.png').write_bytes(PNG)
+        assert wait_for('ICONS true true false', 5), 'an icon installed later stays missing\n' + ''.join(log[-10:])
+        # A data directory that did not exist at startup: its icons directory appears later.
+        late = root / 'late/icons/hicolor/48x48/apps'
+        late.mkdir(parents=True)
+        (late / 'fresh.png').write_bytes(PNG)
+        assert wait_for('ICONS true true true', 5), \
+            'an icon in a data directory created later stays missing\n' + ''.join(log[-10:])
+    finally:
+        shell.kill()
+        shell.wait()
+
+    # Bindings, no polling: the first lookup reloads, the second falls in the same two seconds,
+    # then both icons are installed within that window.
+    (root / 'bound.qml').write_text('''import QtQuick
+import Quickshell
+ShellRoot {
+    readonly property string first: { Quickshell.iconThemeRevision; return Quickshell.iconPath("first", true); }
+    readonly property string second: { Quickshell.iconThemeRevision; return Quickshell.iconPath("second", true); }
+    readonly property string never: { Quickshell.iconThemeRevision; return Quickshell.iconPath("never", true); }
+    readonly property string both: "BOUND " + (first !== "") + " " + (second !== "")
+    onBothChanged: console.info(both)
+    Connections {
+        target: Quickshell
+        function onIconThemeRevisionChanged() { console.info("REVISION " + Quickshell.iconThemeRevision); }
+    }
+    Component.onCompleted: { Quickshell.watchFiles = false; console.info(both); }
+    Timer { interval: 9000; running: true; onTriggered: Qt.quit() }
+}
+''')
+    shell = subprocess.Popen([sys.argv[1], '-p', str(root / 'bound.qml'), '--no-color'], env=environment,
+                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    log = []
+    try:
+        if not wait_for('BOUND ', 10):
+            raise AssertionError('no binding output\n' + ''.join(log))
+        assert 'BOUND false false' in log[-1], ''.join(log)
+        (apps / 'first.png').write_bytes(PNG)
+        (apps / 'second.png').write_bytes(PNG)
+        assert wait_for('BOUND true true', 6), \
+            'a binding stays empty after its icon was installed\n' + ''.join(log[-10:])
+        # An icon that stays missing ("never") is looked up once more and then left alone: the
+        # revision changed once, for the two icons, and not again.
+        assert not wait_for('REVISION 2', 5), 'a missing icon keeps the themes reloading\n' + ''.join(log[-10:])
+        assert any('REVISION 1' in line for line in log), ''.join(log[-10:])
+    finally:
+        shell.kill()
+        shell.wait()
+
+    # A miss late in a reload window, its icon installed just after that window ends (a package's
+    # icons land after its desktop entry): the name is looked up for two seconds after its miss.
+    (root / 'late.qml').write_text('''import QtQuick
+import Quickshell
+ShellRoot {
+    property bool late: false
+    readonly property string early: { Quickshell.iconThemeRevision; return Quickshell.iconPath("early", true); }
+    readonly property string third: { Quickshell.iconThemeRevision; return late ? Quickshell.iconPath("third", true) : ""; }
+    onThirdChanged: console.info("THIRD " + (third !== ""))
+    Component.onCompleted: Quickshell.watchFiles = false
+    Timer { interval: 1500; running: true; onTriggered: { late = true; console.info("LATE " + (third !== "")); } }
+    Timer { interval: 9000; running: true; onTriggered: Qt.quit() }
+}
+''')
+    shell = subprocess.Popen([sys.argv[1], '-p', str(root / 'late.qml'), '--no-color'], env=environment,
+                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    log = []
+    try:
+        if not wait_for('LATE ', 10):
+            raise AssertionError('no late lookup\n' + ''.join(log))
+        assert 'LATE false' in log[-1], ''.join(log)
+        time.sleep(.8)  # past the end of the window the first lookup opened
+        (apps / 'third.png').write_bytes(PNG)
+        assert wait_for('THIRD true', 5), \
+            'an icon installed just after the reload window stays missing\n' + ''.join(log[-10:])
+    finally:
+        shell.kill()
+        shell.wait()
+print('PASS: an icon installed after startup is found, also in a data directory created later, '
+      'and bindings that missed it update by themselves')
-- 
