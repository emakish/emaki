+	QObject::connect(QuickshellTracked::instance(), &QuickshellTracked::iconThemeChanged, this, &QuickshellGlobal::iconThemeRevisionChanged);
 	// clang-format on
 
 	QObject::connect(
@@ -260,6 +338,10 @@ QString QuickshellGlobal::cacheDir() const { // NOLINT
