+	// Damage history belongs to the shared manager, even across outputs and regions.
+	// Preserve request timing and trust damage only across exclusive intervals.
+	quint64 captureEpoch = 0;
+	uint captureCount = 0;
+	void captureStarted();
+	void captureStopped();
+	bool damageExclusive(quint64& epoch) const;
+
 	friend class WlrScreencopyContext;
 };
 
