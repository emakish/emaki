 namespace qs::wayland::screencopy {
 
+// Damage belongs to the completed frontbuffer, in physical buffer pixels.
+// Backends without reliable metadata keep known false.
+struct ScreencopyDamage {
+	QRegion region;
+	bool known = false;
+};
+
 class ScreencopyContext: public QObject {
 	Q_OBJECT;
 
 public:
 	[[nodiscard]] buffer::WlBufferSwapchain& swapchain() { return this->mSwapchain; }
 	virtual void captureFrame() = 0;
+	[[nodiscard]] virtual ScreencopyDamage frameDamage() const { return {}; }
 
 signals:
 	void frameCaptured();
diff --git a/src/wayland/screencopy/view.hpp b/src/wayland/screencopy/view.hpp
--- a/src/wayland/screencopy/view.hpp
+++ b/src/wayland/screencopy/view.hpp
@@ -49,6 +49,10 @@
 	/// Capture a single frame. Has no effect if @@live is true.
 	Q_INVOKABLE void captureFrame();
 
+	/// Whether completed-frame damage may affect a rectangle in this item's coordinates.
+	/// An empty rectangle means the whole item; unknown damage always returns true.
+	Q_INVOKABLE bool damageIntersects(const QRectF& sourceRect) const;
+
 	[[nodiscard]] QObject* captureSource() const { return this->mCaptureSource; }
 	void setCaptureSource(QObject* captureSource);
 
@@ -65,6 +69,9 @@
 signals:
 	/// The compositor has ended the video stream. Attempting to restart it may or may not work.
 	void stopped();
+
+	/// Emitted for every completed frame, including consecutive identical damage regions.
+	void frameCaptured();
 
 	void captureSourceChanged();
 	void paintCursorsChanged();
@@ -99,6 +106,7 @@
 	bool mLive = false;
 	ScreencopyContext* context = nullptr;
 	bool completed = false;
+	ScreencopyDamage completedDamage;
 };
 
 } // namespace qs::wayland::screencopy
diff --git a/src/wayland/screencopy/view.cpp b/src/wayland/screencopy/view.cpp
--- a/src/wayland/screencopy/view.cpp
+++ b/src/wayland/screencopy/view.cpp
@@ -1,4 +1,5 @@
 #include "view.hpp"
+#include <cmath>
 
 #include <qnamespace.h>
 #include <qobject.h>
@@ -107,6 +108,7 @@
 	auto hadContext = this->context != nullptr;
 	delete this->context;
 	this->context = nullptr;
+	this->completedDamage = {};
 	this->bHasContent = false;
 	this->bSourceSize = QSize();
 	if (hadContext && update) this->update();
@@ -126,8 +128,29 @@
 	auto size = frontbuffer->size();
 	if (frontbuffer->transform.flipSize()) size.transpose();
 
+	this->completedDamage = this->context->frameDamage();
 	this->bSourceSize = size;
 	this->bHasContent = true;
+	emit this->frameCaptured();
+}
+
+bool ScreencopyView::damageIntersects(const QRectF& sourceRect) const {
+	if (!this->bHasContent || !this->completedDamage.known) return true;
+	const auto size = this->bSourceSize.value();
+	if (size.isEmpty() || this->width() <= 0 || this->height() <= 0) return true;
+	const auto rect = sourceRect.isEmpty() ? this->boundingRect() : sourceRect;
+	const auto sx = size.width() / this->width();
+	const auto sy = size.height() / this->height();
+	const QRectF physical(rect.x() * sx, rect.y() * sy, rect.width() * sx, rect.height() * sy);
+	if (!std::isfinite(physical.left()) || !std::isfinite(physical.top())
+	    || !std::isfinite(physical.right()) || !std::isfinite(physical.bottom()))
+		return true;
+	// Linear source sampling can reach the neighbouring texel at the crop boundary.
+	// Clamp to the full buffer before rounding so out-of-output crops stay conservative.
+	const auto bounds = QRectF(QPointF(), QSizeF(size));
+	const auto clipped = physical.adjusted(-1, -1, 1, 1).intersected(bounds);
+	if (clipped.isEmpty()) return true;
+	return this->completedDamage.region.intersects(clipped.toAlignedRect());
 }
 
 void ScreencopyView::componentComplete() {
