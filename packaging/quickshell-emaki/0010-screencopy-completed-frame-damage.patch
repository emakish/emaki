+#include <limits>
 
 #include <private/qwaylanddisplay_p.h>
 #include <private/qwaylandscreen_p.h>
@@ -33,6 +34,22 @@
 	return instance;
 }
 
+void WlrScreencopyManager::captureStarted() {
+	++this->captureEpoch;
+	++this->captureCount;
+}
+
+void WlrScreencopyManager::captureStopped() {
+	++this->captureEpoch;
+	--this->captureCount;
+}
+
+bool WlrScreencopyManager::damageExclusive(quint64& epoch) const {
+	const auto exclusive = this->captureCount == 1 && this->captureEpoch == epoch;
+	epoch = this->captureEpoch;
+	return exclusive;
+}
+
 ScreencopyContext*
 WlrScreencopyManager::captureOutput(QScreen* screen, bool paintCursors, QRect region) {
 	if (!dynamic_cast<QtWaylandClient::QWaylandScreen*>(screen->handle())) return nullptr;
@@ -49,12 +66,14 @@
     , screen(dynamic_cast<QtWaylandClient::QWaylandScreen*>(screen->handle()))
     , paintCursors(paintCursors)
     , region(region) {
+	this->manager->captureStarted();
 	this->transform.setScreen(this->screen);
 	QObject::connect(screen, &QObject::destroyed, this, &WlrScreencopyContext::onScreenDestroyed);
 }
 
 WlrScreencopyContext::~WlrScreencopyContext() {
 	if (this->object()) this->destroy();
+	this->manager->captureStopped();
 }
 
 void WlrScreencopyContext::onScreenDestroyed() {
@@ -67,6 +86,10 @@
 	if (this->object()) return;
 
 	this->request.reset();
+	this->pendingDamage = QRegion();
+	this->sawDamage = false;
+	this->invalidDamage = false;
+	this->requestedDamage = false;
 
 	if (this->region.isEmpty()) {
 		this->init(this->manager->capture_output(this->paintCursors ? 1 : 0, this->screen->output()));
@@ -109,6 +132,26 @@
 	this->yInvert = flags & ZWLR_SCREENCOPY_FRAME_V1_FLAGS_Y_INVERT;
 }
 
+void WlrScreencopyContext::zwlr_screencopy_frame_v1_damage(
+    uint32_t x,
+    uint32_t y,
+    uint32_t width,
+    uint32_t height
+) {
+	this->sawDamage = true;
+	const auto limit = static_cast<uint32_t>(std::numeric_limits<int>::max());
+	if (x > limit || y > limit || width > limit - x || height > limit - y) {
+		this->invalidDamage = true;
+		return;
+	}
+	this->pendingDamage += QRect(
+	    static_cast<int>(x),
+	    static_cast<int>(y),
+	    static_cast<int>(width),
+	    static_cast<int>(height)
+	);
+}
+
 void WlrScreencopyContext::zwlr_screencopy_frame_v1_buffer_done() {
 	auto* backbuffer = this->mSwapchain.createBackbuffer(this->request);
 
@@ -121,6 +164,7 @@
 		return;
 	}
 
+	this->requestedDamage = this->copiedFirstFrame;
 	if (this->copiedFirstFrame) {
 		this->copy_with_damage(backbuffer->buffer());
 	} else {
@@ -156,6 +200,16 @@
 
 	this->destroy();
 	this->mSwapchain.swapBuffers();
+	// A shared manager's damage is relative to its previous copy, not this context's.
+	// The membership epoch also detects peers that joined and left during a request.
+	const auto exclusive = this->manager->damageExclusive(this->damageEpoch);
+	// A plain first copy, absent metadata, and transformed buffers are conservative.
+	// Snapshot before notifying consumers: captureFrame resets the pending region.
+	this->completedDamage = {
+	    this->pendingDamage.intersected(QRect(QPoint(), this->mSwapchain.frontbuffer()->size())),
+	    exclusive && this->requestedDamage && this->sawDamage && !this->invalidDamage
+	        && this->transform.transform == buffer::WlBufferTransform::Normal0 && !this->yInvert
+	};
 	emit this->frameCaptured();
 }
 
