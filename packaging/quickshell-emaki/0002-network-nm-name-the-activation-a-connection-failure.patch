+		if (this->reason() != NMConnectionStateReason::DeviceDisconnected) return;
+		// NetworkManager signals the device's Failed state before the active connection ends.
+		// An activation that ended without it (a disconnect, a newer activation) did not fail.
+		auto deviceReason = this->deviceFailReason();
+		if (!deviceReason) return;
+		auto reason = ConnectionFailReason::Unknown;
+		switch (*deviceReason) {
+		case NMDeviceStateReason::NoSecrets: reason = ConnectionFailReason::NoSecrets; break;
+		case NMDeviceStateReason::SupplicantDisconnect:
+			reason = ConnectionFailReason::WifiClientDisconnected;
+			break;
+		case NMDeviceStateReason::SupplicantFailed:
+			reason = ConnectionFailReason::WifiClientFailed;
+			break;
+		case NMDeviceStateReason::SupplicantTimeout:
+			reason = ConnectionFailReason::WifiAuthTimeout;
+			break;
+		case NMDeviceStateReason::SsidNotFound: reason = ConnectionFailReason::WifiNetworkLost; break;
+		default: break;
 		}
+		emit frontend->connectionFailed(reason);
 	});
 
 	QObject::connect(
