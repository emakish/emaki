diff --git a/src/network/test/connectionfailure.cpp b/src/network/test/connectionfailure.cpp
new file mode 100644
index 0000000..026d294
--- /dev/null
+++ b/src/network/test/connectionfailure.cpp
@@ -0,0 +1,156 @@
+#include "connectionfailure.hpp"
+
+#include <qdbusconnection.h>
+#include <qlist.h>
+#include <qobject.h>
+#include <qstring.h>
+#include <qtest.h>
+#include <qtestcase.h>
+#include <qtypes.h>
+#include <qvariant.h>
+
+#include "../device.hpp"
+#include "../enums.hpp"
+#include "../network.hpp"
+#include "../nm/active_connection.hpp"
+#include "../nm/device.hpp"
+#include "../nm/enums.hpp"
+#include "../nm/network.hpp"
+
+using namespace qs::network;
+
+namespace {
+
+const QString ACTIVE1 = QStringLiteral("/org/freedesktop/NetworkManager/ActiveConnection/1");
+const QString ACTIVE2 = QStringLiteral("/org/freedesktop/NetworkManager/ActiveConnection/2");
+
+// A device without a D-Bus peer. Its state changes are fed in the order NetworkManager signals
+// them: the device's StateChanged first, then the active connection's StateChanged.
+class FakeDevice: public NMDevice {
+public:
+	FakeDevice(): NMDevice(QStringLiteral("/org/freedesktop/NetworkManager/Devices/1")) {}
+
+	NetworkDevice* frontend() override { return &this->mFrontend; }
+	void bind(NMNetwork* net) { this->bindNetwork(net); }
+
+	void state(NMDeviceState::Enum state, NMDeviceStateReason::Enum reason) {
+		QVERIFY(
+		    QMetaObject::invokeMethod(
+		        this,
+		        "onStateChanged",
+		        Q_ARG(quint32, state),
+		        Q_ARG(quint32, NMDeviceState::Unknown),
+		        Q_ARG(quint32, reason)
+		    )
+		);
+	}
+
+private:
+	NetworkDevice mFrontend {DeviceType::Wired};
+};
+
+void deactivate(NMActiveConnection* active, NMConnectionStateReason::Enum reason) {
+	QVERIFY(
+	    QMetaObject::invokeMethod(
+	        active,
+	        "onStateChanged",
+	        Q_ARG(quint32, NMConnectionState::Deactivated),
+	        Q_ARG(quint32, reason)
+	    )
+	);
+}
+
+QString activation(Network* network) {
+	auto value = network->property("activation");
+	return value.isValid() ? value.toString() : QStringLiteral("<no activation property>");
+}
+
+using Failure = QPair<ConnectionFailReason::Enum, QString>;
+
+// Every failure the network signals, with the activation it names while signalling it.
+QList<Failure>* record(Network* network) {
+	auto* failures = new QList<Failure>();
+	QObject::connect(network, &QObject::destroyed, [failures]() { delete failures; });
+	QObject::connect(
+	    network,
+	    &Network::connectionFailed,
+	    [network, failures](ConnectionFailReason::Enum reason) {
+		    failures->append({reason, activation(network)});
+	    }
+	);
+	return failures;
+}
+
+} // namespace
+
+void TestConnectionFailure::initTestCase() {
+	// Never reach a real NetworkManager: the proxies stay without a bus.
+	qputenv("DBUS_SYSTEM_BUS_ADDRESS", "unix:path=/nonexistent/qs-test-system-bus");
+	QVERIFY(!QDBusConnection::systemBus().isConnected());
+}
+
+void TestConnectionFailure::failureNamesItsActivation() {
+	FakeDevice device;
+	NMGenericNetwork net(QStringLiteral("net"), device.frontend());
+	device.bind(&net);
+	auto* failures = record(net.frontend());
+	QCOMPARE(activation(net.frontend()), QString());
+
+	auto* active = new NMActiveConnection(ACTIVE1, &device);
+	device.state(NMDeviceState::Prepare, NMDeviceStateReason::None);
+	net.addActiveConnection(active);
+	QCOMPARE(activation(net.frontend()), ACTIVE1);
+
+	device.state(NMDeviceState::Failed, NMDeviceStateReason::NoSecrets);
+	deactivate(active, NMConnectionStateReason::DeviceDisconnected);
+	QCOMPARE(*failures, QList<Failure>({{ConnectionFailReason::NoSecrets, ACTIVE1}}));
+
+	delete active;
+	QCOMPARE(activation(net.frontend()), QString());
+}
+
+void TestConnectionFailure::unmappedReasonIsUnknown() {
+	FakeDevice device;
+	NMGenericNetwork net(QStringLiteral("net"), device.frontend());
+	device.bind(&net);
+	auto* failures = record(net.frontend());
+
+	auto* active = new NMActiveConnection(ACTIVE1, &device);
+	device.state(NMDeviceState::Prepare, NMDeviceStateReason::None);
+	net.addActiveConnection(active);
+	// DHCP gave no address: NetworkManager fails the device with a reason that has no
+	// ConnectionFailReason of its own.
+	device.state(NMDeviceState::Failed, NMDeviceStateReason::IpConfigUnavailable);
+	deactivate(active, NMConnectionStateReason::DeviceDisconnected);
+	QCOMPARE(*failures, QList<Failure>({{ConnectionFailReason::Unknown, ACTIVE1}}));
+}
+
+void TestConnectionFailure::failureIsNotCarriedIntoNextActivation() {
+	FakeDevice device;
+	NMGenericNetwork net(QStringLiteral("net"), device.frontend());
+	device.bind(&net);
+	auto* failures = record(net.frontend());
+
+	auto* first = new NMActiveConnection(ACTIVE1, &device);
+	device.state(NMDeviceState::Prepare, NMDeviceStateReason::None);
+	net.addActiveConnection(first);
+	device.state(NMDeviceState::Failed, NMDeviceStateReason::NoSecrets);
+	deactivate(first, NMConnectionStateReason::DeviceDisconnected);
+	device.state(NMDeviceState::Disconnected, NMDeviceStateReason::None);
+	delete first;
+	QCOMPARE(failures->size(), 1);
+
+	// The next activation is replaced by another one before it finishes: it ends, but the
+	// device never failed during it.
+	auto* second = new NMActiveConnection(ACTIVE2, &device);
+	device.state(NMDeviceState::Prepare, NMDeviceStateReason::None);
+	net.addActiveConnection(second);
+	device.state(NMDeviceState::Deactivating, NMDeviceStateReason::NewActivation);
+	device.state(NMDeviceState::Disconnected, NMDeviceStateReason::NewActivation);
+	deactivate(second, NMConnectionStateReason::DeviceDisconnected);
+	QCOMPARE(failures->size(), 1);
+	// A new activation of the same network has an identifier of its own.
+	QCOMPARE(activation(net.frontend()), ACTIVE2);
+}
+
+QTEST_MAIN(TestConnectionFailure);
