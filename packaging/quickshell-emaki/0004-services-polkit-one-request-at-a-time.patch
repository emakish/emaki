+#include "fakesession.hpp"
+
+#include <qlist.h>
+#include <qobject.h>
+#include <qstring.h>
+
+#include "../session.hpp"
+
+namespace fake {
+QList<SessionRecord*>& sessions() {
+	static QList<SessionRecord*> list;
+	return list;
+}
+
+int& createdCount() {
+	static int count = 0;
+	return count;
+}
+
+bool& failInitiate() {
+	static bool fail = false;
+	return fail;
+}
+
+SessionRecord* record(qs::service::polkit::Session* session) {
+	for (auto* rec: sessions()) {
+		if (rec->session == session) return rec;
+	}
+	return nullptr;
+}
+
+void complete(qs::service::polkit::Session* session, bool result) {
+	auto* rec = record(session);
+	if (!rec || rec->completed) return;
+	rec->completed = true;
+	emit session->completed(result);
+}
+
+void reset() {
+	createdCount() = 0;
+	failInitiate() = false;
+}
+} // namespace fake
+
+namespace qs::service::polkit {
+Session::Session(PolkitIdentity* identity, const QString& cookie, QObject* parent)
+    : QObject(parent) {
+	auto* rec = new fake::SessionRecord();
+	rec->session = this;
+	rec->identity = identity;
+	rec->cookie = cookie;
+	fake::sessions().append(rec);
+	fake::createdCount()++;
+}
+
+Session::~Session() {
+	auto* rec = fake::record(this);
+	fake::sessions().removeOne(rec);
+	delete rec;
+}
+
+void Session::initiate() {
+	fake::record(this)->initiated = true;
+	if (fake::failInitiate()) fake::complete(this, false);
+}
+
+void Session::cancel() {
+	fake::record(this)->cancelled = true;
+	fake::complete(this, false);
+}
+
+void Session::respond(const QString& response) { fake::record(this)->responses.append(response); }
+} // namespace qs::service::polkit
