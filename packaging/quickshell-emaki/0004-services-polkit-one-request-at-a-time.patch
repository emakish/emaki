+	// returned, so requests live until cleanup() has drained them.
+	std::vector<std::unique_ptr<Request>> requests;
+
+	Request& request(const char* action) {
+		return *this->requests.emplace_back(std::make_unique<Request>(QString::fromUtf8(action)));
+	}
+
+	enum class IdentityKind : quint8 { User, Netgroup, TwoUsers };
+
+	void submit(
+	    Request& request,
+	    IdentityKind kind = IdentityKind::User,
+	    PolkitDetails* details = nullptr,
+	    const char* cookie = "cookie"
+	) {
+		auto uid = static_cast<gint>(getuid());
+		PolkitIdentity* identity = kind == IdentityKind::Netgroup
+		                             ? polkit_unix_netgroup_new("emaki-test")
+		                             : polkit_unix_user_new(uid);
+		GList* identities = g_list_append(nullptr, identity);
+		if (kind == IdentityKind::TwoUsers) {
+			identities = g_list_append(identities, polkit_unix_user_new(uid == 0 ? 1 : 0));
+		}
+		auto action = request.action.toUtf8();
+		polkit_agent_listener_initiate_authentication(
+		    POLKIT_AGENT_LISTENER(this->listener),
+		    action.constData(),
+		    "Test message",
+		    "test-icon",
+		    details,
+		    cookie,
+		    identities,
+		    request.cancellable,
+		    &finished,
+		    &request.result
+		);
+		g_list_free_full(identities, g_object_unref);
+	}
+
+	[[nodiscard]] AuthFlow* active() const { return this->impl->activeFlow().value(); }
+
+	// The flow's live session: the newest one not cancelled or completed.
+	static Session* liveSession() {
+		for (auto it = fake::sessions().rbegin(); it != fake::sessions().rend(); ++it) {
+			if (!(*it)->cancelled && !(*it)->completed) return (*it)->session;
+		}
+		return nullptr;
+	}
+
+	static void spin() {
+		for (auto i = 0; i < 5; i++) {
+			QCoreApplication::processEvents();
+			QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+			while (g_main_context_iteration(nullptr, false)) {}
+		}
+	}
+
+private slots:
+	void initTestCase() {
+		// Double results and other GLib misuse abort the test.
+		g_log_set_always_fatal(static_cast<GLogLevelFlags>(G_LOG_LEVEL_CRITICAL | G_LOG_LEVEL_ERROR));
+	}
+
+	void init() {
+		fake::reset();
+		this->activeHistory.clear();
+		this->frontend = new PolkitAgent();
+		this->impl = PolkitAgentImpl::tryGetOrCreate(this->frontend);
+		QVERIFY(this->impl);
+		this->listener = qs_polkit_agent_new(this->impl);
+		QObject::connect(this->impl, &PolkitAgentImpl::activeFlowChanged, this, [this]() {
+			this->activeHistory.append(this->active());
+		});
+	}
+
+	void cleanup() {
+		delete this->frontend;
+		this->frontend = nullptr;
+		this->impl = nullptr;
+		g_object_unref(this->listener);
+		this->listener = nullptr;
+		spin();
+		for (const auto& request: this->requests) {
+			QVERIFY2(request->result.done, qPrintable(request->action));
+			QCOMPARE(request->result.calls, 1);
+		}
+		this->requests.clear();
+	}
+
+	void secondRequestWaits() {
+		auto& first = this->request("org.emaki.test.first");
+		auto& second = this->request("org.emaki.test.second");
+
+		this->submit(first);
+		auto* flowA = this->active();
+		QVERIFY(flowA);
+		QCOMPARE(flowA->actionId(), QStringLiteral("org.emaki.test.first"));
+
+		this->submit(second);
+		spin();
+		QCOMPARE(this->active(), flowA);
+		QCOMPARE(this->activeHistory, QList<AuthFlow*>({flowA}));
+		QCOMPARE(fake::createdCount(), 1);
+		QVERIFY(!second.result.done);
+
+		auto guardA = QPointer(flowA);
+		fake::complete(liveSession(), true);
+		spin();
+		QVERIFY(first.result.done);
+		QVERIFY(first.result.authorized);
+		QVERIFY(!guardA);
+
+		auto* flowB = this->active();
+		QVERIFY(flowB);
+		QCOMPARE(flowB->actionId(), QStringLiteral("org.emaki.test.second"));
+		QCOMPARE(this->activeHistory.size(), 3);
+		QCOMPARE(this->activeHistory.at(1), nullptr);
+
+		fake::complete(liveSession(), true);
+		spin();
+		QVERIFY(second.result.authorized);
+		QCOMPARE(this->active(), nullptr);
+		QCOMPARE(first.result.calls, 1);
+		QCOMPARE(second.result.calls, 1);
+	}
+
+	void requestDuringCompletionWaits() {
+		auto& first = this->request("org.emaki.test.first");
+		auto& second = this->request("org.emaki.test.second");
+
+		this->submit(first);
+		auto* flowA = this->active();
+		fake::complete(liveSession(), true);
+		// Completed but not yet finished: the next request must still wait.
+		this->submit(second);
+		QCOMPARE(this->active(), flowA);
+		spin();
+		QVERIFY(this->active() != nullptr);
+		QCOMPARE(this->active()->actionId(), QStringLiteral("org.emaki.test.second"));
+		QCOMPARE(this->activeHistory.at(1), nullptr);
+	}
