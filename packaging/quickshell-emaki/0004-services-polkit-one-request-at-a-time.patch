+// The production Session: the polkit library's debug output never carries the cookie,
+// and the response buffer is wiped when Session::respond returns.
+//
+// No helper is started: the identity is a unix group, which polkit refuses before
+// it looks for one, and the response is caught before it would reach the helper.
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+#include <glib-object.h>
+#include <glib.h>
+#include <qbytearray.h>
+#include <qbytearrayview.h>
+#include <qcoreapplication.h>
+#include <qlist.h>
+#include <qobject.h>
+#include <qstring.h>
+#include <qtenvironmentvariables.h>
+#include <qtestcase.h>
+#include <qtmetamacros.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define POLKIT_AGENT_I_KNOW_API_IS_SUBJECT_TO_CHANGE
+#undef signals
+#include <polkit/polkit.h>
+#include <polkitagent/polkitagent.h>
+#define signals Q_SIGNALS
+
+#include "../session.hpp"
+
+using namespace qs::service::polkit;
+
+namespace {
+// What polkit_agent_session_response was given, and whether those bytes were
+// zero when the buffer was freed.
+const char* responseBuffer = nullptr; // NOLINT
+QByteArray responseSeen;              // NOLINT
+bool responseFreed = false;           // NOLINT
+bool responseZeroWhenFreed = false;   // NOLINT
+
+QList<QByteArray>& printed() {
+	static QList<QByteArray> list;
+	return list;
+}
+
+void recordPrint(const gchar* string) { printed().append(QByteArray(string)); }
+
+// Runs fn with stdout and stderr going to a file and returns what was written.
+template <typename F>
+QByteArray captureOutput(F fn) {
+	auto file = memfd_create("polkitsession-output", 0);
+	fflush(stdout);
+	fflush(stderr);
+	auto savedOut = dup(STDOUT_FILENO);
+	auto savedErr = dup(STDERR_FILENO);
+	dup2(file, STDOUT_FILENO);
+	dup2(file, STDERR_FILENO);
+
+	fn();
+
+	fflush(stdout);
+	fflush(stderr);
+	dup2(savedOut, STDOUT_FILENO);
+	dup2(savedErr, STDERR_FILENO);
+	close(savedOut);
+	close(savedErr);
+
+	QByteArray output;
+	char buffer[4096]; // NOLINT
+	lseek(file, 0, SEEK_SET);
+	for (auto n = read(file, buffer, sizeof(buffer)); n > 0; n = read(file, buffer, sizeof(buffer)))
+		output.append(buffer, n);
+	close(file);
+	return output;
+}
+} // namespace
+
+// Stands in for the library function: the response is recorded instead of being
+// written to a helper.
+extern "C" void
+polkit_agent_session_response(PolkitAgentSession* /*session*/, const gchar* response) {
+	responseBuffer = response;
+	responseSeen = QByteArray(response);
+}
+
+// new[]/delete[] are replaced so the response buffer can be read just before it is freed.
+void* operator new[](std::size_t size) {
+	if (auto* ptr = std::malloc(size ? size : 1)) return ptr; // NOLINT
+	throw std::bad_alloc();
+}
+
+void operator delete[](void* ptr) noexcept {
+	if (ptr && ptr == responseBuffer) {
+		responseFreed = true;
+		responseZeroWhenFreed = true;
+		// The bytes polkit was given and their terminator.
+		const QByteArrayView bytes(static_cast<const char*>(ptr), responseSeen.size() + 1);
+		for (auto byte: bytes) {
+			if (byte != '\0') responseZeroWhenFreed = false;
+		}
+		responseBuffer = nullptr;
+	}
+	std::free(ptr); // NOLINT
+}
+
+void operator delete[](void* ptr, std::size_t /*size*/) noexcept { operator delete[](ptr); }
+
+class SessionTest: public QObject {
+	Q_OBJECT;
+
+private:
+	static PolkitIdentity* unsupportedIdentity() { return polkit_unix_group_new(0); }
+
+private slots:
+	void initTestCase() {
+		// The polkit library reads it once, on the first initiate.
+		QVERIFY(qEnvironmentVariableIsSet("POLKIT_DEBUG"));
+	}
+
+	void cookieNeverPrinted() {
+		const QByteArray cookie = "cookie-sentinel-3b7d";
+		auto* identity = unsupportedIdentity();
+		auto* session = new Session(identity, QString::fromUtf8(cookie));
+		QList<bool> results;
+		QObject::connect(session, &Session::completed, this, [&](bool ok) { results.append(ok); });
+
+		// GLib's own output path (GLib 2.88 returns its default handler, never null).
+		auto* before = g_set_print_handler(nullptr);
+		auto* glibDefault = g_set_print_handler(nullptr);
+		auto output = captureOutput([&]() { session->initiate(); });
+		auto* after = g_set_print_handler(before);
+		delete session;
+		g_object_unref(identity);
+
+		// Debug output was on, so the cookie would have been printed.
+		QVERIFY2(
+		    output.contains("PolkitAgentSession: emitting ::completed(FALSE)"),
+		    output.constData()
+		);
+		QVERIFY2(!output.contains(cookie), output.constData());
+		QCOMPARE(results, QList<bool>({false}));
+
+		// No handler is left behind.
+		QVERIFY(after == glibDefault);
+	}
+
+	void cookieFilterKeepsPrintHandler() {
+		const QByteArray cookie = "cookie-sentinel-a41e";
+		printed().clear();
+		g_set_print_handler(&recordPrint);
+		auto* identity = unsupportedIdentity();
+		auto* session = new Session(identity, QString::fromUtf8(cookie));
+		session->initiate();
+		delete session;
+		g_object_unref(identity);
+		g_print("after initiate\n");
+		QVERIFY(g_set_print_handler(nullptr) == &recordPrint);
+
+		QVERIFY(printed().contains("PolkitAgentSession: emitting ::completed(FALSE)\n"));
+		QVERIFY(printed().contains("after initiate\n"));
+		for (const auto& line: printed()) QVERIFY2(!line.contains(cookie), line.constData());
+	}
+
+	void responseWipedOnReturn() {
+		const auto password = QStringLiteral(u"pässwörd \U0001F511");
+		auto* identity = unsupportedIdentity();
+		auto* session = new Session(identity, QStringLiteral("cookie"));
+		responseFreed = false;
+		session->respond(password);
+		delete session;
+		g_object_unref(identity);
+
+		QCOMPARE(responseSeen, password.toUtf8());
+		QVERIFY(responseFreed);
+		QVERIFY(responseZeroWhenFreed);
+	}
+};
