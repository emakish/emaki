--- /dev/null
+++ b/src/services/polkit/secret.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <memory>
+#include <string.h> // NOLINT(modernize-deprecated-headers): explicit_bzero
+
+#include <qstring.h>
+#include <qstringconverter.h>
+#include <qtclasshelpermacros.h>
+#include <qtypes.h>
+
+namespace qs::service::polkit {
+//! UTF-8 copy of a secret in a buffer this class owns and wipes.
+///
+/// QString::toUtf8() leaves the bytes in a QByteArray that is freed without
+/// being cleared. This buffer is cleared with explicit_bzero, spare capacity
+/// included, by wipe() and on destruction. The source QString is not touched:
+/// its storage may be shared with QML and cannot be cleared from here.
+class SecretUtf8 {
+public:
+	explicit SecretUtf8(QStringView text) {
+		QStringEncoder encoder(QStringEncoder::Utf8);
+		this->mCapacity = encoder.requiredSpace(text.size()) + 1;
+		this->buffer = std::make_unique<char[]>(this->mCapacity); // NOLINT(*-avoid-c-arrays)
+		auto* end = encoder.appendToBuffer(this->buffer.get(), text);
+		*end = '\0';
+		this->mSize = end - this->buffer.get();
+	}
+
+	~SecretUtf8() { this->wipe(); }
+	Q_DISABLE_COPY_MOVE(SecretUtf8);
+
+	/// Null-terminated UTF-8 bytes; empty after wipe().
+	[[nodiscard]] const char* data() const { return this->buffer.get(); }
+	[[nodiscard]] qsizetype size() const { return this->mSize; }
+	[[nodiscard]] qsizetype capacity() const { return this->mCapacity; }
+
+	void wipe() {
+		if (this->buffer) explicit_bzero(this->buffer.get(), this->mCapacity);
+		this->mSize = 0;
+	}
+
+private:
+	std::unique_ptr<char[]> buffer; // NOLINT(*-avoid-c-arrays)
+	qsizetype mCapacity = 0;
+	qsizetype mSize = 0;
+};
+} // namespace qs::service::polkit
