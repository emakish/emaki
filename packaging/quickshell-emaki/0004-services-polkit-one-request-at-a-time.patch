+void finished(GObject* source, GAsyncResult* res, gpointer data) {
+	auto* result = static_cast<Result*>(data);
+	GError* error = nullptr;
+	result->authorized = polkit_agent_listener_initiate_authentication_finish(
+	    POLKIT_AGENT_LISTENER(source),
+	    res,
+	    &error
+	);
+	result->cancelled = g_error_matches(error, POLKIT_ERROR, POLKIT_ERROR_CANCELLED);
+	g_clear_error(&error);
+	result->done = true;
+	result->calls++;
+}
+
+struct Request {
+	QString action;
+	Result result;
+	GCancellable* cancellable = g_cancellable_new();
+
+	explicit Request(QString action): action(std::move(action)) {}
+	~Request() { g_object_unref(this->cancellable); }
