+		QVERIFY(netgroup.result.done);
+		QVERIFY(netgroup.result.cancelled);
+		QVERIFY(!netgroup.result.authorized);
+		QVERIFY(this->active());
+		QCOMPARE(this->active()->actionId(), QStringLiteral("org.emaki.test.third"));
