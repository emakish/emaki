+
+/// Spawn a captured command without consulting the reloadable child environment.
+pub(crate) fn spawn_prepared(process: Command) {
+    if let Err(err) = thread::Builder::new()
+        .name("Command Spawner".to_owned())
+        .spawn(move || run_prepared(process))
+    {
+        warn!("error spawning a thread to spawn the command: {err:?}");
+    }
+}
+
+fn run_prepared(mut process: Command) {
+    let command = process.get_program().to_owned();
+    process
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
     unsafe { process.pre_exec(crate::utils::signals::unblock_all) };
 
-    let Some(mut child) = do_spawn(command, process) else {
+    let Some(mut child) = do_spawn(&command, process) else {
         return;
     };
 
