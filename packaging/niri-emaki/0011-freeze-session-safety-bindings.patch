+#[test]
+fn trusted_binds_package_install_recovers_revoke_and_freezes_it_for_the_session() {
+    let sh = Shell::new().unwrap();
+    let dir = sh.create_temp_dir().unwrap();
+    let main = dir.path().join("config.kdl");
+    let rules = dir.path().join("fork-rules.kdl");
+    let package = dir.path().join("sudo-key.kdl");
+    let attacker = dir.path().join("niri-emaki.kdl");
+    fs::write(
+        &rules,
+        "binds { Ctrl+Alt+Delete repeat=false { show-trusted-prompt-mark; }; }",
+    )
+    .unwrap();
+    fs::write(
+        &main,
+        "hotkey-overlay { skip-at-startup; }\ninclude \"fork-rules.kdl\"\ninclude optional=true \"sudo-key.kdl\"\ninclude optional=true \"niri-emaki.kdl\"\n",
+    )
+    .unwrap();
+    // The package does not exist yet, but the personal include already claims
+    // the promised chord. Production startup must reserve it without spawning.
+    fs::write(
+        &attacker,
+        "binds { Super+Ctrl+Escape { toggle-debug-tint; }; }",
+    )
+    .unwrap();
+    let mut f = Fixture::with_config(Config::load(&main).config.unwrap());
+    f.niri().trusted_bind_dispatches = Some(Vec::new());
+    f.niri().trusted_binds.use_fixture_source(rules.clone());
+    assert_no_dispatch(&mut f, &[125, 29, 1]);
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_no_dispatch(&mut f, &[125, 29, 1]);
+
+    let packaged = format!(
+        "binds {{ Mod+Ctrl+Escape repeat=false allow-inhibiting=false {{ spawn {REVOKE_PROGRAM:?} \"revoke-all\" \"--json\"; }}; }}"
+    );
+    fs::write(&package, &packaged).unwrap();
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_reserved(&mut f);
+    assert_dispatch(&mut f, &[125, 29, 1], expected()[1].action.clone());
+
+    // Rewrite the personal include after installation, then remove and replace
+    // the package. None of these reloads can replace the recovered action.
+    for replacement in [
+        "binds { Mod+Ctrl+Escape { toggle-debug-tint; }; }",
+        "binds { Super+Ctrl+Escape { toggle-debug-tint; }; }",
+    ] {
+        fs::write(&attacker, replacement).unwrap();
+        f.niri_state()
+            .reload_config(Ok(Config::load(&main).config.unwrap()));
+        assert_reserved(&mut f);
+        assert_dispatch(&mut f, &[125, 29, 1], expected()[1].action.clone());
+    }
+    fs::remove_file(&package).unwrap();
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_dispatch(&mut f, &[125, 29, 1], expected()[1].action.clone());
+    fs::write(
+        &package,
+        "binds { Mod+Ctrl+Escape { toggle-debug-tint; }; }",
+    )
+    .unwrap();
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_dispatch(&mut f, &[125, 29, 1], expected()[1].action.clone());
+
+    // A fresh session with the genuine package and the hostile include present
+    // recovers the same action through the verified packaged-source path.
+    fs::write(&package, packaged).unwrap();
+    let mut next = Fixture::with_config(Config::load(&main).config.unwrap());
+    next.niri().trusted_bind_dispatches = Some(Vec::new());
+    next.niri().trusted_binds.use_fixture_source(rules);
+    next.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_reserved(&mut next);
+    assert_dispatch(&mut next, &[125, 29, 1], expected()[1].action.clone());
+}
