+++ b/src/trusted_keyboard.rs
@@ -0,0 +1,93 @@
+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! A private startup keymap, updated only by physical backend key events.
+
+use niri_config::{Bind, ModKey, Trigger};
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::{Keycode, Keysym, ModifiersState};
+use xkbcommon::xkb;
+
+pub struct TrustedKeyboard {
+    state: xkb::State,
+}
+
+impl TrustedKeyboard {
+    pub fn new(keymap: String) -> Self {
+        // Compile a serialized snapshot into an independent context. Retaining a
+        // reference to Smithay's keymap would violate its thread/lifetime contract.
+        let context =
+            xkb::Context::new(xkb::CONTEXT_NO_DEFAULT_INCLUDES | xkb::CONTEXT_NO_ENVIRONMENT_NAMES);
+        let keymap = xkb::Keymap::new_from_string(
+            &context,
+            keymap,
+            xkb::KEYMAP_FORMAT_TEXT_V1,
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        )
+        .expect("the startup keyboard keymap must remain valid");
+        Self {
+            state: xkb::State::new(&keymap),
+        }
+    }
+
+    pub fn update(&mut self, code: Keycode, state: KeyState) {
+        self.state.update_key(
+            code,
+            match state {
+                KeyState::Pressed => xkb::KeyDirection::Down,
+                KeyState::Released => xkb::KeyDirection::Up,
+            },
+        );
+    }
+
+    pub fn is_safety_key<'a>(&self, code: Keycode, binds: impl Iterator<Item = &'a Bind>) -> bool {
+        let keymap = self.state.get_keymap();
+        binds.into_iter().any(|bind| {
+            (0..keymap.num_layouts()).any(|layout| {
+                keymap
+                    .key_get_syms_by_level(code, layout, 0)
+                    .iter()
+                    .any(|sym| {
+                        // Captured keys already have Mod resolved at startup.
+                        crate::input::proof_key_or_modifier(bind.key, ModKey::Super, *sym)
+                    })
+            })
+        })
+    }
+
+    pub fn matching_bind<'a>(
+        &self,
+        code: Keycode,
+        binds: impl Iterator<Item = &'a Bind>,
+    ) -> Option<Bind> {
+        let raw = self.raw_sym(code)?;
+        let mut mods = ModifiersState::default();
+        mods.update_with(&self.state);
+        crate::input::find_configured_bind(binds, ModKey::Super, Trigger::Keysym(raw), mods)
+    }
+
+    fn raw_sym(&self, code: Keycode) -> Option<Keysym> {
+        let keymap = self.state.get_keymap();
+        let layout = self.state.key_get_layout(code);
+        let base = *keymap.key_get_syms_by_level(code, layout, 0).first()?;
+        // Match ordinary bind semantics, including the Latin fallback, against
+        // only the captured keymap and its private physical-input state.
+        if base.key_char().map(|ch| ch.is_ascii()).unwrap_or(true) {
+            return Some(base);
+        }
+        for other in 0..keymap.num_layouts() {
+            if other == layout {
+                continue;
+            }
+            if let Some(sym) = keymap.key_get_syms_by_level(code, other, 0).first() {
+                if sym
+                    .key_char()
+                    .is_some_and(|ch| ch.is_ascii() && !ch.is_ascii_control())
+                {
+                    return Some(*sym);
+                }
+            }
+        }
+        Some(base)
+    }
+}
