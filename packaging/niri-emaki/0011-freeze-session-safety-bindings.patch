+// Send physical evdev keycodes through the same dispatcher as hardware keyboards.
+struct KeyboardInput;
+struct PhysicalKey {
+    evdev: u32,
+    state: smithay::backend::input::KeyState,
+    count: u32,
+}
+
+impl smithay::backend::input::InputBackend for KeyboardInput {
+    type Device = smithay::backend::winit::WinitVirtualDevice;
+    type KeyboardKeyEvent = PhysicalKey;
+    type PointerAxisEvent = smithay::backend::input::UnusedEvent;
+    type PointerButtonEvent = smithay::backend::input::UnusedEvent;
+    type PointerMotionEvent = smithay::backend::input::UnusedEvent;
+    type PointerMotionAbsoluteEvent = smithay::backend::input::UnusedEvent;
+    type GestureSwipeBeginEvent = smithay::backend::input::UnusedEvent;
+    type GestureSwipeUpdateEvent = smithay::backend::input::UnusedEvent;
+    type GestureSwipeEndEvent = smithay::backend::input::UnusedEvent;
+    type GesturePinchBeginEvent = smithay::backend::input::UnusedEvent;
+    type GesturePinchUpdateEvent = smithay::backend::input::UnusedEvent;
+    type GesturePinchEndEvent = smithay::backend::input::UnusedEvent;
+    type GestureHoldBeginEvent = smithay::backend::input::UnusedEvent;
+    type GestureHoldEndEvent = smithay::backend::input::UnusedEvent;
+    type TouchUpEvent = smithay::backend::input::UnusedEvent;
+    type TouchMotionEvent = smithay::backend::input::UnusedEvent;
+    type TouchCancelEvent = smithay::backend::input::UnusedEvent;
+    type TouchFrameEvent = smithay::backend::input::UnusedEvent;
+    type TabletToolAxisEvent = smithay::backend::input::UnusedEvent;
+    type TabletToolProximityEvent = smithay::backend::input::UnusedEvent;
+    type TabletToolTipEvent = smithay::backend::input::UnusedEvent;
+    type TabletToolButtonEvent = smithay::backend::input::UnusedEvent;
+    type SwitchToggleEvent = smithay::backend::input::UnusedEvent;
+    type TouchDownEvent = smithay::backend::input::UnusedEvent;
+    type SpecialEvent = ();
+}
+
+impl smithay::backend::input::Event<KeyboardInput> for PhysicalKey {
+    fn time(&self) -> u64 {
+        1_000
+    }
+    fn device(&self) -> smithay::backend::winit::WinitVirtualDevice {
+        smithay::backend::winit::WinitVirtualDevice
+    }
+}
+
+impl smithay::backend::input::KeyboardKeyEvent<KeyboardInput> for PhysicalKey {
+    fn key_code(&self) -> smithay::input::keyboard::Keycode {
+        (self.evdev + 8).into()
+    }
+    fn state(&self) -> smithay::backend::input::KeyState {
+        self.state
+    }
+    fn count(&self) -> u32 {
+        self.count
+    }
+}
+
+fn physical_key(f: &mut Fixture, evdev: u32, pressed: bool, count: u32) {
+    use smithay::backend::input::{InputEvent, KeyState};
+    f.niri_state()
+        .process_input_event::<KeyboardInput>(InputEvent::Keyboard {
+            event: PhysicalKey {
+                evdev,
+                state: if pressed {
+                    KeyState::Pressed
+                } else {
+                    KeyState::Released
+                },
+                count,
+            },
+        });
+}
+
+fn press_chord(f: &mut Fixture, keys: &[u32]) {
+    for (index, &key) in keys.iter().enumerate() {
+        physical_key(f, key, true, index as u32 + 1);
+    }
+}
+
+fn release_chord(f: &mut Fixture, keys: &[u32]) {
+    for (index, &key) in keys.iter().enumerate().rev() {
+        physical_key(f, key, false, index as u32);
+    }
+}
+
+fn live_symbols(f: &mut Fixture, evdev: u32) -> Vec<smithay::input::keyboard::Keysym> {
+    let state = f.niri_state();
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    keyboard.with_xkb_state(state, |context| {
+        let xkb = context.xkb().lock().unwrap();
+        xkb.layouts()
+            .flat_map(|layout| {
+                xkb.raw_syms_for_key_in_layout((evdev + 8).into(), layout)
+                    .to_vec()
+            })
+            .collect()
+    })
+}
+
+fn assert_dispatch(f: &mut Fixture, keys: &[u32], action: Action) {
+    f.niri().trusted_bind_dispatches.as_mut().unwrap().clear();
+    press_chord(f, keys);
+    assert_eq!(
+        f.niri().trusted_bind_dispatches.as_ref().unwrap(),
+        &[action]
+    );
+    release_chord(f, keys);
+}
