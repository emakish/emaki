+#[test]
+fn trusted_binds_physical_chords_survive_live_xkb_changes() {
+    use smithay::input::keyboard::Keysym;
+
+    let sh = Shell::new().unwrap();
+    let dir = sh.create_temp_dir().unwrap();
+    let keymap = dir.path().join("remapped.xkb");
+    fs::write(
+        &keymap,
+        r#"
+        xkb_keymap {
+            xkb_keycodes { include "evdev+aliases(qwerty)" };
+            xkb_types { include "complete" };
+            xkb_compatibility { include "complete" };
+            xkb_symbols {
+                include "pc+us+inet(evdev)"
+                replace key <DELE> { [ F11 ] };
+                replace key <ESC> { [ F12 ] };
+            };
+        };
+    "#,
+    )
+    .unwrap();
+    let cases = [
+        (
+            "options \"ctrl:swap_lwin_lctl\"".to_owned(),
+            "Super+Alt+Delete",
+            "Ctrl+Super+Escape",
+            29,
+            Keysym::Super_L,
+        ),
+        (
+            "options \"altwin:swap_alt_win\"".to_owned(),
+            "Ctrl+Super+Delete",
+            "Ctrl+Alt+Escape",
+            56,
+            Keysym::Super_L,
+        ),
+        (
+            format!("file {:?}", keymap),
+            "Ctrl+Alt+F11",
+            "Super+Ctrl+F12",
+            111,
+            Keysym::F11,
+        ),
+    ];
+    for (xkb, proof_alias, revoke_alias, changed_code, changed_sym) in cases {
+        let mut f = fixture(startup());
+        f.niri().trusted_bind_dispatches = Some(Vec::new());
+        assert!(!live_symbols(&mut f, changed_code).contains(&changed_sym));
+        let reload = Config::parse_mem(&format!(
+            r#"
+            input {{ keyboard {{ xkb {{ {xkb}; }}; }}; }}
+            binds {{
+                {proof_alias} {{ toggle-debug-tint; }}
+                {revoke_alias} {{ toggle-debug-tint; }}
+                F10 {{ toggle-debug-tint; }}
+            }}
+        "#
+        ))
+        .unwrap();
+        // Reload while the proof modifiers are physically held. Their releases must
+        // also update the startup state, despite the changed live modifier map.
+        press_chord(&mut f, &[29, 56]);
+        f.niri_state().reload_config(Ok(reload));
+        assert!(
+            live_symbols(&mut f, changed_code).contains(&changed_sym),
+            "{xkb}"
+        );
+        for code in [29_u32, 56, 125, 111, 1] {
+            let niri = f.niri();
+            assert!(
+                niri.trusted_keyboard
+                    .as_ref()
+                    .unwrap()
+                    .is_safety_key((code + 8).into(), niri.trusted_binds.iter()),
+                "physical safety key {code} after {xkb}"
+            );
+        }
+        f.niri().trusted_bind_dispatches.as_mut().unwrap().clear();
+        physical_key(&mut f, 111, true, 3);
+        assert_eq!(
+            f.niri().trusted_bind_dispatches.as_ref().unwrap(),
+            &[Action::ShowTrustedPromptMark],
+            "{xkb}"
+        );
+        release_chord(&mut f, &[29, 56, 111]);
+        assert_dispatch(&mut f, &[29, 56, 111], Action::ShowTrustedPromptMark);
+        assert_dispatch(&mut f, &[125, 29, 1], expected()[1].action.clone());
+        // Let the proof view end before checking ordinary input outside isolation.
+        f.niri().trusted_prompt_proof_deadline = None;
+        f.niri_state().refresh_trusted_prompt_input();
+        // Ordinary bindings still work, and released physical modifiers do not stick.
+        assert_dispatch(&mut f, &[68], Action::ToggleDebugTint);
+        f.niri().trusted_bind_dispatches.as_mut().unwrap().clear();
+        press_chord(&mut f, &[111]);
+        release_chord(&mut f, &[111]);
+        assert!(f
+            .niri()
+            .trusted_bind_dispatches
+            .as_ref()
+            .unwrap()
+            .is_empty());
+    }
+}
+
+fn assert_no_dispatch(f: &mut Fixture, keys: &[u32]) {
+    f.niri().trusted_bind_dispatches.as_mut().unwrap().clear();
+    press_chord(f, keys);
+    release_chord(f, keys);
+    assert!(f
+        .niri()
+        .trusted_bind_dispatches
+        .as_ref()
+        .unwrap()
+        .is_empty());
+}
