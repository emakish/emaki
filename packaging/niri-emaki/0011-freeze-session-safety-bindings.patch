+        assert_eq!(selected(&after, name), selected(&before, name), "{name}");
+    }
+
+    let mut ordinary = Command::new("unused-test-command");
+    crate::utils::spawning::configure_child_environment(&mut ordinary);
+    assert_eq!(
+        selected(&ordinary, "B2B_REVOKE_TEST"),
+        Some("changed".into())
+    );
+    assert_eq!(
+        selected(&ordinary, "LD_PRELOAD"),
+        Some("/tmp/untrusted.so".into())
+    );
+}
