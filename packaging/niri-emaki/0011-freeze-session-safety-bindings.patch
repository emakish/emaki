+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Startup security chords survive configuration reloads and include changes.
+
+use std::fs;
+
+use niri_config::{Action, Bind, Config, Key, Modifiers};
+use xshell::Shell;
+
+use super::Fixture;
+use crate::trusted_binds::REVOKE_PROGRAM;
+
+const STARTUP: &str = concat!(
+    r#"
+    hotkey-overlay { skip-at-startup; }
+    binds {
+        Ctrl+Alt+Delete repeat=false { show-trusted-prompt-mark; }
+        Mod+Ctrl+Escape repeat=false allow-inhibiting=false {
+            spawn ""#,
+    env!("NIRI_EMAKI_SUDO_PROGRAM"),
+    r#"" "revoke-all" "--json";
+        }
+        Mod+T { spawn "old-terminal"; }
+    }
+"#
+);
+
+fn startup() -> Config {
+    Config::parse_mem(STARTUP).unwrap()
+}
+
+fn fixture(config: Config) -> Fixture {
+    let binds = niri_config::Binds(config.binds.0.clone());
+    let mut f = Fixture::with_config(config);
+    f.niri().trusted_binds =
+        crate::trusted_binds::TrustedBinds::capture_fixture(&binds, niri_config::ModKey::Super);
+    let niri = f.niri();
+    niri.trusted_binds.restore(
+        &mut niri.config.borrow_mut().binds,
+        niri_config::ModKey::Super,
+    );
+    f
+}
+
+fn expected() -> Vec<Bind> {
+    let mut binds = startup().binds.0;
+    binds.truncate(2);
+    for bind in &mut binds {
+        if bind.key.modifiers.contains(Modifiers::COMPOSITOR) {
+            bind.key.modifiers.remove(Modifiers::COMPOSITOR);
+            bind.key.modifiers.insert(Modifiers::SUPER);
+        }
+    }
+    binds
+}
+
+fn assert_reserved(f: &mut Fixture) {
+    let config = f.niri().config.borrow();
+    for expected in expected() {
+        let matches: Vec<_> = config
+            .binds
+            .0
+            .iter()
+            .filter(|b| b.key == expected.key)
+            .collect();
+        assert_eq!(matches, vec![&expected]);
+    }
+    let revoke = config
+        .binds
+        .0
+        .iter()
+        .find(|b| b.key == "Super+Ctrl+Escape".parse::<Key>().unwrap())
+        .unwrap();
+    assert_eq!(
+        revoke.action,
+        Action::Spawn(vec![
+            REVOKE_PROGRAM.into(),
+            "revoke-all".into(),
+            "--json".into(),
+        ])
+    );
+}
+
+#[test]
+fn trusted_binds_later_optional_include_cannot_rebind_either_chord() {
+    for chord in ["Ctrl+Alt+Delete", "Mod+Ctrl+Escape", "Super+Ctrl+Escape"] {
+        let sh = Shell::new().unwrap();
+        let dir = sh.create_temp_dir().unwrap();
+        let main = dir.path().join("config.kdl");
+        let optional = dir.path().join("user.kdl");
+        fs::write(
+            &main,
+            format!("{STARTUP}\ninclude \"user.kdl\" optional=true\n"),
+        )
+        .unwrap();
+        let mut f = fixture(Config::load(&main).config.unwrap());
+        fs::write(
+            &optional,
+            format!("binds {{ {chord} {{ spawn \"hostile\"; }}; }}"),
+        )
+        .unwrap();
+        f.niri_state()
+            .reload_config(Ok(Config::load(&main).config.unwrap()));
+        assert_reserved(&mut f);
+        assert!(!f
+            .niri()
+            .config
+            .borrow()
+            .binds
+            .0
+            .iter()
+            .any(|b| b.action == Action::Spawn(vec!["hostile".into()])));
+    }
+}
+
+#[test]
+fn trusted_binds_optional_file_removal_retains_startup_actions() {
+    let sh = Shell::new().unwrap();
+    let dir = sh.create_temp_dir().unwrap();
+    let main = dir.path().join("config.kdl");
+    let optional = dir.path().join("security.kdl");
+    fs::write(&main, "include \"security.kdl\" optional=true\n").unwrap();
+    fs::write(&optional, STARTUP).unwrap();
+    let mut f = fixture(Config::load(&main).config.unwrap());
+    fs::remove_file(optional).unwrap();
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_reserved(&mut f);
+}
+
+#[test]
+fn trusted_binds_removed_include_retains_startup_actions() {
+    let sh = Shell::new().unwrap();
+    let dir = sh.create_temp_dir().unwrap();
+    let main = dir.path().join("config.kdl");
+    fs::write(dir.path().join("security.kdl"), STARTUP).unwrap();
+    fs::write(&main, "include \"security.kdl\"\n").unwrap();
+    let mut f = fixture(Config::load(&main).config.unwrap());
+    fs::write(&main, "hotkey-overlay { skip-at-startup; }\n").unwrap();
+    f.niri_state()
+        .reload_config(Ok(Config::load(&main).config.unwrap()));
+    assert_reserved(&mut f);
+}
+
+#[test]
+fn trusted_binds_removed_bindings_retain_actions_and_reload_unrelated_bind() {
+    let mut f = fixture(startup());
+    f.niri_state().reload_config(Ok(Config::parse_mem(
+        r#"binds { Mod+T { spawn "new-terminal"; }; }"#,
+    )
+    .unwrap()));
+    assert_reserved(&mut f);
+    let config = f.niri().config.borrow();
+    assert!(config
+        .binds
+        .0
+        .iter()
+        .any(|b| b.action == Action::Spawn(vec!["new-terminal".into()])));
+    assert!(!config
+        .binds
+        .0
+        .iter()
+        .any(|b| b.action == Action::Spawn(vec!["old-terminal".into()])));
+}
+
+#[test]
+fn trusted_binds_modifier_reload_does_not_move_physical_chord() {
+    let mut f = fixture(startup());
+    let config = Config::parse_mem(
+        r#"
+        input { mod-key "Alt"; }
+        binds {
+            Super+Ctrl+Escape { spawn "hostile"; }
+            Mod+T { spawn "new-terminal"; }
+        }
+    "#,
+    )
+    .unwrap();
+    f.niri_state().reload_config(Ok(config));
+    assert_reserved(&mut f);
+    let config = f.niri().config.borrow();
+    assert_eq!(config.input.mod_key, Some(niri_config::ModKey::Alt));
+    assert!(!config.binds.0.iter().any(|b| {
+        matches!(&b.action, Action::Spawn(argv) if argv.first().map(String::as_str) == Some(REVOKE_PROGRAM))
+            && b.key != "Super+Ctrl+Escape".parse::<Key>().unwrap()
+    }));
+}
+
+#[test]
+fn trusted_binds_reload_restores_full_binding_properties() {
+    let mut f = fixture(startup());
+    let config = Config::parse_mem(
+        &r#"
+        binds {
+            Ctrl+Alt+Delete repeat=true cooldown-ms=60000 {
+                show-trusted-prompt-mark;
+            }
+            Mod+Ctrl+Escape repeat=true allow-inhibiting=true allow-when-locked=true cooldown-ms=60000 hotkey-overlay-title="Changed" {
+                spawn "@REVOKE_PROGRAM@" "revoke-all" "--json";
+            }
+        }
+    "#.replace("@REVOKE_PROGRAM@", REVOKE_PROGRAM),
+    )
+    .unwrap();
+    f.niri_state().reload_config(Ok(config));
+    assert_reserved(&mut f);
+}
+
+#[test]
+fn trusted_binds_sequential_reloads_cannot_relocate_or_replace_startup_actions() {
+    let mut f = fixture(startup());
+    for replacement in [
+        r#"
+        binds {
+            Ctrl+Alt+F10 { show-trusted-prompt-mark; }
+            Mod+Ctrl+F11 { spawn "@REVOKE_PROGRAM@" "revoke-all" "--json"; }
+            Mod+T { spawn "new-terminal"; }
+        }
+        "#,
+        r#"
+        binds {
+            Ctrl+Alt+Delete { spawn "hostile"; }
+            Mod+Ctrl+Escape { spawn "/different/bin/emaki-sudo" "revoke-all" "--json"; }
+            Mod+T { spawn "new-terminal"; }
+        }
+        "#,
+        r#"
+        binds {
+            Ctrl+Alt+F12 { show-trusted-prompt-mark; }
+            Super+Ctrl+F9 { spawn "/different/bin/emaki-sudo" "revoke-all" "--json"; }
+            Mod+T { spawn "new-terminal"; }
+        }
+        "#,
+    ] {
+        f.niri_state().reload_config(Ok(Config::parse_mem(
+            &replacement.replace("@REVOKE_PROGRAM@", REVOKE_PROGRAM),
+        )
+        .unwrap()));
+        assert_reserved(&mut f);
+        let config = f.niri().config.borrow();
+        assert_eq!(config.binds.0.len(), 3);
+        assert!(config.binds.0.iter().any(|bind| {
+            bind.key == "Mod+T".parse::<Key>().unwrap()
+                && bind.action == Action::Spawn(vec!["new-terminal".into()])
+        }));
+    }
+}
+
+#[test]
+fn trusted_binds_warn_on_change_removal_and_physical_alias_shadow() {
+    // A separate process keeps parallel tests from changing trace callsite interest.
+    const CHILD: &str = "NIRI_TEST_SAFETY_BIND_LOG";
+    if std::env::var_os(CHILD).is_none() {
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "tests::trusted_binds::trusted_binds_warn_on_change_removal_and_physical_alias_shadow",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr),
+        );
+        return;
+    }
+
+    use std::io::Write;
+    use std::sync::{Arc, Mutex};
+
+    use crate::trusted_binds::TrustedBinds;
+    use niri_config::ModKey;
+
+    #[derive(Clone)]
+    struct Log(Arc<Mutex<Vec<u8>>>);
+    impl Write for Log {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    let log = Log(Arc::default());
+    let writer = log.clone();
+    let subscriber = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::WARN)
+        .with_ansi(false)
+        .without_time()
+        .with_writer(move || writer.clone())
+        .finish();
+    let _guard = tracing::subscriber::set_default(subscriber);
+    let original = startup();
+    let captured = TrustedBinds::capture_fixture(&original.binds, ModKey::Super);
+    let key = "Super+Ctrl+Escape".parse::<Key>().unwrap();
+    for mutation in ["changed", "removed", "shadowed"] {
+        log.0.lock().unwrap().clear();
+        let mut config = startup();
+        match mutation {
+            "changed" => config.binds.0[1].action = Action::Spawn(vec!["hostile".into()]),
+            "removed" => {
+                config.binds.0.remove(1);
+            }
+            "shadowed" => {
+                let mut shadow = config.binds.0[1].clone();
+                shadow.key = key;
+                shadow.action = Action::Spawn(vec!["hostile".into()]);
+                config.binds.0.push(shadow);
+            }
+            _ => unreachable!(),
+        }
+        captured.restore(&mut config.binds, ModKey::Super);
+        let text = String::from_utf8(log.0.lock().unwrap().clone()).unwrap();
+        assert_eq!(
+            text.matches("ignoring changed, removed or shadowed session safety binding")
+                .count(),
+            1,
+            "{mutation}: {text}",
+        );
+        assert!(text.contains("WARN"), "{mutation}: {text}");
+        assert!(text.contains(&format!("key={key:?}")), "{mutation}: {text}");
+    }
+}
