+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Safety chords and their complete actions are captured once per session.
+
+use std::collections::BTreeMap;
+use std::ffi::OsString;
+use std::fs;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use niri_config::{Action, Bind, Binds, Config, Key, ModKey, Modifiers, Trigger};
+use tracing::warn;
+
+pub const REVOKE_PROGRAM: &str = env!("NIRI_EMAKI_SUDO_PROGRAM");
+#[cfg(not(test))]
+const SAFETY_CONFIG: &str = env!("NIRI_EMAKI_SAFETY_CONFIG");
+
+#[derive(Debug)]
+pub struct TrustedBinds {
+    binds: Vec<Bind>,
+    mod_key: ModKey,
+    recovery_path: PathBuf,
+    environment: BTreeMap<OsString, OsString>,
+    reserved_revoke: Bind,
+    authority: PackageAuthority,
+    #[cfg(test)]
+    _fixture_root: xshell::TempDir,
+}
+
+#[derive(Debug)]
+struct PackageAuthority {
+    uid: u32,
+    #[cfg(test)]
+    root: Option<PathBuf>,
+}
+
+impl PackageAuthority {
+    fn installed() -> Self {
+        Self {
+            uid: 0,
+            #[cfg(test)]
+            root: None,
+        }
+    }
+
+    #[cfg(test)]
+    fn fixture(root: &Path) -> Self {
+        Self {
+            uid: unsafe { libc::geteuid() },
+            root: Some(root.to_path_buf()),
+        }
+    }
+}
+
+fn is_revoke_lookalike(action: &Action) -> bool {
+    let Action::Spawn(command) = action else {
+        return false;
+    };
+    matches!(command.as_slice(), [program, operation, format]
+        if Path::new(program).is_absolute()
+            && Path::new(program).file_name().is_some_and(|name| name == "emaki-sudo")
+            && operation == "revoke-all"
+            && format == "--json")
+}
+
+pub fn is_revoke_action(action: &Action) -> bool {
+    matches!(action, Action::Spawn(command)
+        if matches!(command.as_slice(), [program, operation, format]
+            if program == REVOKE_PROGRAM && operation == "revoke-all" && format == "--json"))
+}
+
+fn effective_safety_binds(binds: &Binds, mod_key: ModKey) -> Vec<Bind> {
+    let mut seen = Vec::new();
+    let mut captured = Vec::new();
+    // Resolve safety aliases backwards in include order. Ordinary actions
+    // and untrusted executable lookalikes cannot claim a safety chord.
+    for bind in binds.0.iter().rev() {
+        let key = physical_key(bind.key, mod_key);
+        if !is_safety_action(&bind.action) || seen.contains(&key) {
+            continue;
+        }
+        seen.push(key);
+        if matches!(key.trigger, Trigger::Keysym(_)) && is_safety_action(&bind.action) {
+            let mut bind = bind.clone();
+            bind.key = key;
+            captured.push(bind);
+        }
+    }
+    captured.reverse();
+    captured
+}
+
+fn is_safety_action(action: &Action) -> bool {
+    matches!(action, Action::ShowTrustedPromptMark) || is_revoke_action(action)
+}
+
+fn physical_key(mut key: Key, mod_key: ModKey) -> Key {
+    if key.modifiers.contains(Modifiers::COMPOSITOR) {
+        key.modifiers.remove(Modifiers::COMPOSITOR);
+        key.modifiers.insert(mod_key.to_modifiers());
+    }
+    key
+}
+
+impl TrustedBinds {
+    pub fn capture(binds: &Binds, mod_key: ModKey) -> Self {
+        #[cfg(not(test))]
+        let (recovery_path, authority) =
+            (PathBuf::from(SAFETY_CONFIG), PackageAuthority::installed());
+        // Every test compositor starts with its own absent packages. Inject the
+        // source before the first recovery, including indirect Fixture callers.
+        #[cfg(test)]
+        let fixture_root = xshell::Shell::new().unwrap().create_temp_dir().unwrap();
+        #[cfg(test)]
+        let (recovery_path, authority) = (
+            fixture_root.path().join("fork-rules.kdl"),
+            PackageAuthority::fixture(fixture_root.path()),
+        );
+        let reserved_revoke = Bind {
+            key: "Super+Ctrl+Escape".parse().unwrap(),
+            action: Action::Spawn(Vec::new()),
+            repeat: false,
+            cooldown: None,
+            allow_when_locked: true,
+            allow_inhibiting: false,
+            hotkey_overlay_title: None,
+        };
+        // Parsed personal includes have no provenance. They may never supply the
+        // revoke action, even at startup or before the optional package exists.
+        let captured = effective_safety_binds(binds, mod_key)
+            .into_iter()
+            .filter(|bind| !is_revoke_action(&bind.action) && bind.key != reserved_revoke.key)
+            .collect();
+        let mut configured = Command::new("");
+        crate::utils::spawning::configure_child_environment(&mut configured);
+        let environment =
+            crate::trusted_client::snapshot_environment(std::env::vars_os(), &configured);
+        let mut captured = Self {
+            binds: captured,
+            mod_key,
+            recovery_path,
+            authority,
+            environment,
+            reserved_revoke,
+            #[cfg(test)]
+            _fixture_root: fixture_root,
+        };
+        captured.recover_missing();
+        captured
+    }
+
+    fn missing(&self) -> (bool, bool) {
+        (
+            !self
+                .binds
+                .iter()
+                .any(|bind| matches!(bind.action, Action::ShowTrustedPromptMark)),
+            !self.binds.iter().any(|bind| is_revoke_action(&bind.action)),
+        )
+    }
+
+    fn warn_missing(&self) {
+        let (proof, revoke) = self.missing();
+        if proof {
+            warn!(
+                "session proof safety binding is missing; recovery requires the packaged safety config on a reload attempt"
+            );
+        }
+        if revoke {
+            warn!(
+                "session revoke safety binding is missing; recovery requires the packaged safety config on a reload attempt"
+            );
+        }
+    }
+
+    /// Retry missing actions only from the installed, build-time packaged path.
+    /// Existing actions, the startup modifier interpretation and environment stay frozen.
+    pub fn recover_missing(&mut self) {
+        if self.missing() == (false, false) {
+            return;
+        }
+        let path = self.recovery_path.clone();
+        self.recover_missing_from(&path);
+    }
+
+    fn recover_missing_from(&mut self, path: &Path) {
+        let (proof, revoke) = self.missing();
+        let mut sources = Vec::new();
+        if proof {
+            sources.push((path.to_path_buf(), false));
+        }
+        if revoke {
+            sources.push((path.with_file_name("sudo-key.kdl"), true));
+        }
+        for (path, revoke_source) in sources {
+            let Some(config) = load_packaged_config(&path, &self.authority) else {
+                continue;
+            };
+            for bind in effective_safety_binds(&config.binds, self.mod_key) {
+                let wanted = if revoke_source {
+                    is_revoke_action(&bind.action)
+                } else {
+                    matches!(bind.action, Action::ShowTrustedPromptMark)
+                        && bind.key != self.reserved_revoke.key
+                };
+                if wanted && !self.binds.iter().any(|old| old.key == bind.key) {
+                    self.binds.push(bind);
+                }
+            }
+        }
+        self.warn_missing();
+    }
+
+    /// The absent optional action still owns its physical chord. Its inert
+    /// placeholder is used only by the private keyboard route, never spawned.
+    pub fn keyboard_binds(&self) -> impl Iterator<Item = &Bind> {
+        self.binds.iter().chain(
+            std::iter::once(&self.reserved_revoke)
+                .filter(|reserved| !self.binds.iter().any(|bind| bind.key == reserved.key)),
+        )
+    }
+
+    #[cfg(test)]
+    pub(crate) fn capture_fixture(binds: &Binds, mod_key: ModKey) -> Self {
+        let mut captured = Self::capture(&Binds::default(), mod_key);
+        // Legacy dispatch tests supply an already trusted snapshot. Production
+        // always validates the installed source instead.
+        captured.binds = effective_safety_binds(binds, mod_key);
+        captured
+    }
+
+    #[cfg(test)]
+    pub(crate) fn use_fixture_source(&mut self, path: PathBuf) {
+        self.authority = PackageAuthority::fixture(path.parent().unwrap());
+        self.recovery_path = path;
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = &Bind> {
+        self.binds.iter()
+    }
+
+    pub fn revoke_command(&self, action: &Action) -> Option<Command> {
+        if !is_revoke_action(action) || !self.binds.iter().any(|bind| bind.action == *action) {
+            return None;
+        }
+        let Action::Spawn(argv) = action else {
+            unreachable!()
+        };
+        let mut command = Command::new(&argv[0]);
+        command.args(&argv[1..]).env_clear().envs(&self.environment);
+        Some(command)
+    }
+
+    pub fn restore(&self, binds: &mut Binds, mod_key: ModKey) {
+        for captured in &self.binds {
+            let matching: Vec<_> = binds
+                .0
+                .iter()
+                .filter(|bind| physical_key(bind.key, mod_key) == captured.key)
+                .collect();
+            let unchanged = matching.len() == 1 && {
+                let mut candidate = matching[0].clone();
+                candidate.key = physical_key(candidate.key, mod_key);
+                candidate == *captured
+            };
+            if !unchanged {
+                warn!(key = ?captured.key, "ignoring changed, removed or shadowed session safety binding");
+            }
+        }
+        binds.0.retain(|bind| {
+            if physical_key(bind.key, mod_key) == self.reserved_revoke.key {
+                return false;
+            }
+            if self
+                .binds
+                .iter()
+                .any(|captured| physical_key(bind.key, mod_key) == captured.key)
+            {
+                return false;
+            }
+            if matches!(bind.key.trigger, Trigger::Keysym(_))
+                && (matches!(bind.action, Action::ShowTrustedPromptMark)
+                    || is_revoke_lookalike(&bind.action))
+            {
+                warn!(key = ?bind.key, "ignoring new session safety binding until next login");
+                return false;
+            }
+            true
+        });
+        binds.0.extend(self.binds.iter().cloned());
+    }
+}
+
+/// Every component must belong to the package authority and be unwritable by
+/// others. Refuse symlinks rather than trusting a target outside that hierarchy.
+fn verify_packaged_path(path: &Path, authority: &PackageAuthority) -> bool {
+    verify_packaged_path_or_absent(path, authority, false)
+}
+
+fn verify_packaged_path_or_absent(
+    path: &Path,
+    authority: &PackageAuthority,
+    allow_absent: bool,
+) -> bool {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|part| matches!(part, std::path::Component::ParentDir))
+    {
+        return false;
+    }
+    // Check directories before children, including when the optional leaf is
+    // absent. An attacker cannot erase an unsafe include after it was parsed to
+    // make its untrusted contents look like an absent optional package.
+    #[cfg(test)]
+    if authority
+        .root
+        .as_ref()
+        .is_some_and(|root| !path.starts_with(root))
+    {
+        return false;
+    }
+    let ancestors: Vec<_> = path.ancestors().collect();
+    for component in ancestors.into_iter().rev() {
+        // A fixture grants authority only inside its explicit private root.
+        // Its host ancestors (such as a sticky temporary directory) are not
+        // packaged paths. Production always checks the complete hierarchy.
+        #[cfg(test)]
+        if authority
+            .root
+            .as_ref()
+            .is_some_and(|root| component != root && root.starts_with(component))
+        {
+            continue;
+        }
+        let leaf = component == path;
+        let metadata = match fs::symlink_metadata(component) {
+            Ok(metadata) => metadata,
+            Err(error) => {
+                return leaf && allow_absent && error.kind() == std::io::ErrorKind::NotFound
+            }
+        };
+        let expected_owner = metadata.uid() == authority.uid || (!leaf && metadata.uid() == 0);
+        if !expected_owner
+            || metadata.mode() & 0o022 != 0
+            || (leaf && !metadata.is_file())
+            || (!leaf && !metadata.is_dir())
+        {
+            return false;
+        }
+    }
+    true
+}
+
+fn load_packaged_config(path: &Path, authority: &PackageAuthority) -> Option<Config> {
+    if !verify_packaged_path(path, authority) {
+        warn!(
+            ?path,
+            "refusing unsafe packaged safety config path, owner or mode"
+        );
+        return None;
+    }
+    // Verified directories and files cannot be changed by the session uid.
+    // Includes are checked too before any parsed binding becomes authoritative.
+    let parsed = Config::load(path);
+    for include in &parsed.includes {
+        if !verify_packaged_path_or_absent(include, authority, true) {
+            warn!(?include, "refusing unsafe packaged safety config include");
+            return None;
+        }
+    }
+    match parsed.config {
+        Ok(config) => Some(config),
+        Err(error) => {
+            warn!(
+                ?path,
+                ?error,
+                "cannot recover session safety bindings from packaged config"
+            );
+            None
+        }
+    }
+}
