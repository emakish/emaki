# Keep the cargo cache inside $srcdir: makepkg remaps $srcdir paths in the binary
# (--remap-path-prefix); otherwise the builder's ~/.cargo leaks into panic messages —
# 900+ lines of /home/<builder>/.cargo (GOTCHAS rule “builder paths in binaries”).
# Set inside functions: $srcdir is still empty when PKGBUILD is read.
_cargo_home() {
  export CARGO_HOME="$srcdir/cargo-home"
  # Compile installed package identities into the safety route; another platform
  # supplies its own immutable program and config paths at build time.
  export NIRI_EMAKI_SUDO_PROGRAM="${NIRI_EMAKI_SUDO_PROGRAM:-/usr/bin/emaki-sudo}"
  export NIRI_EMAKI_SAFETY_CONFIG="${NIRI_EMAKI_SAFETY_CONFIG:-/usr/share/emaki/niri/fork-rules.kdl}"
}

prepare() {
  _cargo_home
  cd $_pkgname-$pkgver
  patch -Np1 -i ../0001-layer-Add-hide-from-own-screencopy-layer-rule.patch
  patch -Np1 -i ../0002-keep-greeter-frame-and-cover-session-startup.patch
  patch -Np1 -i ../0003-emaki-overview-backdrop.patch
  patch -Np1 -i ../0004-crisp-xcursor-at-fractional-scale.patch
  patch -Np1 -i ../0005-emaki-wallpaper.patch
  patch -Np1 -i ../0006-exit-without-primary-renderer.patch
  patch -Np1 -i ../0007-protect-session-pixels-while-locked.patch
  patch -Np1 -i ../0008-account-for-static-blur-occlusion.patch
  patch -Np1 -i ../0009-preserve-mapped-layer-keyboard-focus.patch
  patch -Np1 -i ../0010-trusted-authentication-prompt.patch
  patch -Np1 -i ../0011-freeze-session-safety-bindings.patch
  patch -Np1 -i ../0012-report-trusted-shell-cast-pid.patch
  patch -Np1 -i ../0013-fullscreen-panel-reservation.patch
  python "$srcdir/check-assumptions.py" . || return 1
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  _cargo_home
  cd $_pkgname-$pkgver
  export NIRI_BUILD_COMMIT="v$pkgver+emaki.$pkgrel"
  CFLAGS+=(' -ffat-lto-objects')
  cargo build --frozen --release --features default
}

check() {
  _cargo_home
  cd $_pkgname-$pkgver
  export XDG_RUNTIME_DIR="$(mktemp -d)"
  export RAYON_NUM_THREADS=1
  # Only test the patch: the official package runs the full niri suite.
  cargo test --frozen --release --lib trusted_binds
  cargo test --frozen --release --lib trusted_prompt
  cargo test --frozen --release --lib trusted_client
  cargo test --frozen --release -p niri-config trusted
  cargo test --frozen --release -p niri-ipc trusted_shell
  cargo test --frozen --release --lib tests::layer_shell
  cargo test --frozen --release --lib screencopy
  cargo test --frozen --release --lib startup_cover
  cargo test --frozen --release --lib keep_frame
  LIBGL_ALWAYS_SOFTWARE=1 cargo test --frozen --release --lib lock_capture
  # Includes wallpaper GL/asset/scheduler and workspace camera regressions.
  LIBGL_ALWAYS_SOFTWARE=1 cargo test --frozen --release --lib emaki_
  LIBGL_ALWAYS_SOFTWARE=1 cargo test --frozen --release --lib cursor::
  cargo test --frozen --release -p niri-config emaki_backdrop
  cargo test --frozen --release -p niri-config emaki_wallpaper
  cargo test --frozen --release -p niri-ipc emaki_wallpaper
}

package() {
  cd $_pkgname-$pkgver
  install -vDm 755 target/release/$_pkgname "$pkgdir/usr/bin/niri-emaki"
}
