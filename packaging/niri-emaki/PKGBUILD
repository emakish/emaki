# Maintainer: Yakyman <246958375+Yakyman@users.noreply.github.com>
#
# Upstream v26.04 plus Emaki's capture, login handoff, overview, cursor, wallpaper, lock privacy, keyboard focus, trusted authentication, shell cast identity and fullscreen panel inset patches.
# Installs only /usr/bin/niri-emaki alongside stock niri; install the session
# files through make install-niri-emaki after make install. The dedicated greeter
# prefers this fork, with stock niri as a recovery fallback. Rebase all thirteen patches on updates.
# Patch 0006 makes the fork exit with status 3 when it has no primary renderer (software EGL,
# failed driver): emaki-greeter-compositor shows its text failure screen on that status.

pkgname=niri-emaki
_pkgname=niri
pkgver=26.04
pkgrel=22
pkgdesc="niri with Emaki glass capture, login handoff, overview backdrop, crisp cursors and living wallpaper"
arch=(x86_64)
url="https://github.com/niri-wm/niri"
license=(GPL-3.0-or-later)
depends=(
  cairo
  glib2
  glibc
  libdisplay-info
  libgcc
  libinput
  libpipewire
  libxkbcommon
  mesa
  pango
  pixman
  seatd
  systemd-libs
  xdg-desktop-portal-impl
  'niri>=26.04'  # The stock package supplies niri-shutdown.target and portal configuration.
  'libdisplay-info.so=3-64'
  'libinput.so=10-64'
  'libseat.so=1-64'
  # libgbm comes from mesa (listed above); Arch's mesa has no libgbm.so provides entry.
  'libxkbcommon.so=0-64'
  'libpipewire-0.3.so=0-64'
)
makedepends=(
  clang
  git
  python
  rust
)
