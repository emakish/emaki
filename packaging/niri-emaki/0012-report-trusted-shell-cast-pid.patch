+/// Credentials reported for a client's screencasts. The trusted shell's socket pair
+/// names no process, so its casts carry the PID of the shell the supervisor spawned.
+pub fn get_cast_credentials_for_client(dh: &DisplayHandle, client: &Client) -> Option<Credentials> {
+    let data = client.get_data::<ClientState>().unwrap();
+    if data.trusted_shell {
+        let pid = data
+            .trusted_shell_pid
+            .load(std::sync::atomic::Ordering::Relaxed);
+        return (pid > 0).then(|| Credentials {
+            pid,
+            uid: unsafe { libc::getuid() },
+            gid: unsafe { libc::getgid() },
+        });
+    }
+    get_credentials_for_client(dh, client)
+}
