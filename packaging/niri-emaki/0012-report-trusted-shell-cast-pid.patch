+#[test]
+fn trusted_shell_screencopy_reports_the_spawned_shell_pid() {
+    let mut f = fixture();
+    let shell = f.add_trusted_shell();
+    map(&mut f, shell, NAMESPACE);
+    let prompt = f.niri().trusted_prompt().unwrap();
+    let client = prompt.wl_surface().client().unwrap();
+    let dh = f.niri().display_handle.clone();
+    // Before the supervisor names the process there is nothing to report.
+    assert!(crate::utils::get_cast_credentials_for_client(&dh, &client).is_none());
+    client
+        .get_data::<crate::niri::ClientState>()
+        .unwrap()
+        .trusted_shell_pid
+        .store(4242, std::sync::atomic::Ordering::Relaxed);
+    let creds = crate::utils::get_cast_credentials_for_client(&dh, &client).unwrap();
+    assert_eq!(creds.pid, 4242);
+    // Only casts use it: the connection still claims no credentials elsewhere.
+    assert!(crate::utils::get_credentials_for_client(&dh, &client).is_none());
+}
