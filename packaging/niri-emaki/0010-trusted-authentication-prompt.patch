+/// Identity of the unreaped child given the compositor's private Wayland connection.
+/// This is meaningful only when obtained from an authenticated compositor IPC socket.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub struct TrustedShellIdentity {
+    /// Linux process ID; pin and verify with a pidfd before using it.
+    pub pid: u32,
+    /// Linux /proc/PID/stat starttime, in clock ticks since boot.
+    pub start_time: u64,
+}
+
+/// State of the compositor-owned shell supervisor. This is not proof of a prompt.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq)]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub struct TrustedShell {
+    /// A command was captured at compositor startup.
+    pub configured: bool,
+    /// The supervised child is currently running.
+    pub running: bool,
+    /// A compositor-authorized prompt is mapped, visible and owns input now.
+    /// This is session state, not authority granted to the caller.
+    pub prompt_active: bool,
+}
+
 /// Current compositor startup cover, for a shell taking over the same image.
