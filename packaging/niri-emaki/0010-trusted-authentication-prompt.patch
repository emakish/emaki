+#[test]
+fn egl_trusted_prompt_lock_never_enters_competing_overlay() {
+    use std::sync::{atomic::AtomicBool, Arc};
+    use smithay::reexports::wayland_protocols::ext::session_lock::v1::client::ext_session_lock_manager_v1::ExtSessionLockManagerV1;
+    use wayland_client::Proxy as _;
+
+    for unmap_prompt in ["retained", "after-lock", "before-lock"] {
+        let mut f = fixture();
+        f.niri_state().backend.headless().add_renderer().unwrap();
+        let hostile = f.add_client();
+        let hostile_enters = keyboard_enters(&mut f, hostile);
+        let hostile_pointer_enters = pointer_enters(&mut f, hostile);
+        let hostile_touch_downs = touch_downs(&mut f, hostile);
+        f.niri()
+            .seat
+            .get_pointer()
+            .unwrap()
+            .set_location((50., 80.).into());
+        let overlay = map(&mut f, hostile, "competing-exclusive-overlay");
+        assert_eq!(*hostile_enters.lock().unwrap(), [overlay.clone()]);
+        assert_eq!(*hostile_pointer_enters.lock().unwrap(), [overlay.clone()]);
+        touch_overlay(&mut f);
