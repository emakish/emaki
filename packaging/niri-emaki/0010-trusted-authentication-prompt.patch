+        // Tap the hostile overlay while the lock is waiting, both with the
+        // prompt retained and after the broker has unmapped it.
+        touch_overlay(&mut f);
+        f.double_roundtrip(hostile);
+        assert!(hostile_touch_downs.lock().unwrap().is_empty());
+        assert!(f
+            .niri()
+            .seat
+            .get_keyboard()
+            .unwrap()
+            .current_focus()
