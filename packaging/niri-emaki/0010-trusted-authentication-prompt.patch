+#[test]
+fn egl_trusted_prompt_proof_covers_real_hostile_lock_without_unlocking() {
+    use std::time::{Duration, Instant};
+
+    let mut f = fixture();
+    let shell = f.add_trusted_shell();
+    let prompt = f.client(shell).create_layer(None, Layer::Overlay, crate::trusted_prompt::NAMESPACE);
+    prompt.set_configure_props(LayerConfigureProps {
+        anchor: Some(Anchor::Top | Anchor::Left),
+        size: Some((u32::from(SIZE.0), u32::from(SIZE.1))),
+        ..Default::default()
+    });
+    let surface = prompt.surface.clone();
+    prompt.commit();
+    f.double_roundtrip(shell);
+    let prompt = f.client(shell).layer(&surface);
+    prompt.attach_new_buffer();
+    prompt.set_size(SIZE.0, SIZE.1);
+    prompt.ack_last_and_commit();
+    f.double_roundtrip(shell);
+    assert!(f.niri().trusted_prompt_active());
+    let lock = lock(&mut f);
+    assert!(!f.niri().trusted_prompt_active());
+    let before = pixels(&mut f, RenderTarget::Output);
+    assert!(before.chunks_exact(4).any(|px| px == LOCK_PIXEL));
+    f.niri().show_trusted_prompt_mark();
+    f.state.server.dispatch();
+    assert!(f.niri().is_locked());
+    assert!(f.niri().trusted_prompt_input_isolated());
+    assert!(!f.niri().trusted_prompt_mark_active());
+    let proof = pixels(&mut f, RenderTarget::Output);
+    assert_ne!(before, proof, "physical proof must erase pre-painted lock pixels");
+    assert!(proof.chunks_exact(4).all(|px| px == [0, 0, 0, 255]));
+    assert!(f.niri().seat.get_keyboard().unwrap().current_focus().is_none());
+    assert!(f.niri().contents_under((10., 10.).into()).surface.is_none());
+    // Expiry restores the same live lock surface, without an unlock or a new client.
+    f.niri().trusted_prompt_proof_deadline = Some(Instant::now() - Duration::from_secs(1));
+    f.state.server.dispatch();
+    assert!(f.niri().is_locked());
+    assert!(!f.niri().trusted_prompt_input_isolated());
+    assert_eq!(pixels(&mut f, RenderTarget::Output), before);
+    assert!(lock.surface.is_alive());
+}
