+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! The shell's authority belongs to one compositor-created Wayland connection.
+//! No public socket, client credential, environment string or IPC request grants it.
+
+use std::collections::BTreeMap;
+use std::ffi::OsString;
+use std::io;
+use std::net::Shutdown;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::os::unix::process::CommandExt;
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use calloop::timer::{TimeoutAction, Timer};
+use niri_ipc::TrustedShellIdentity;
+use smithay::reexports::wayland_server::{Client, DisplayHandle};
+
+use crate::niri::State;
+use crate::utils::spawning::{configure_child_environment, restore_nofile_rlimit};
+
+const POLL_INTERVAL: Duration = Duration::from_millis(250);
+const RESTART_GRACE: Duration = Duration::from_secs(2);
+const STABLE_UPTIME: Duration = Duration::from_secs(60);
+const MAX_FAILURES: u32 = 5;
+
+/// Control the captured startup command without accepting replacement arguments.
+#[derive(Clone, Default)]
+pub struct SupervisorHandle {
+    restart: Arc<AtomicBool>,
+    running: Arc<AtomicBool>,
+    connection: Arc<Mutex<Option<Arc<TrustedConnection>>>>,
+}
+
+impl SupervisorHandle {
+    pub fn request_restart(&self) {
+        self.restart.store(true, Ordering::Relaxed);
+    }
+
+    pub fn is_running(&self) -> bool {
+        self.running.load(Ordering::Relaxed)
+    }
+
+    /// Report only the child to which this compositor gave the private connection.
+    pub fn identity(&self, display: &DisplayHandle) -> Option<TrustedShellIdentity> {
+        if self.restart.load(Ordering::Relaxed) {
+            return None;
+        }
+        let connection = self.connection.lock().ok()?;
+        connection.as_ref()?.identity(display)
+    }
+}
+
+/// Capture login decoration before threads, backend setup or any client starts.
+/// It must never enter the shared environment or the restart snapshot.
+pub fn take_login_handoff() -> Option<OsString> {
+    let marker = std::env::var_os("EMAKI_LOGIN_HANDOFF");
+    std::env::remove_var("EMAKI_LOGIN_HANDOFF");
+    // Preserve TTY cleanup even when the login image could not be prepared.
+    if marker.is_some() {
+        std::env::set_var("EMAKI_SESSION_TAKEOVER", "1");
+    }
+    marker
+}
+
+/// Only the first successful private shell launch receives this login's marker.
+fn configure_login_handoff(process: &mut Command, handoff: &Option<OsString>) {
+    process.env_remove("EMAKI_LOGIN_HANDOFF");
+    if let Some(marker) = handoff {
+        process.env("EMAKI_LOGIN_HANDOFF", marker);
+    }
+}
+
+fn spawn_with_login_handoff(
+    process: &mut Command,
+    handoff: &mut Option<OsString>,
+) -> io::Result<Child> {
+    configure_login_handoff(process, handoff);
+    let child = process.spawn()?;
+    handoff.take();
+    Ok(child)
+}
+
+/// Start one shell, using the startup command even after configuration reloads.
+/// The child must exec the shell in the foreground, retaining WAYLAND_SOCKET.
+pub fn start(state: &mut State, command: Vec<String>, login_handoff: Option<OsString>) {
+    if command.is_empty() {
+        return;
+    }
+    // Capture authority-bearing executable, arguments and the entire environment
+    // once. An IPC config reload may change ordinary spawn environment, never this.
+    let executable = Path::new(&command[0]);
+    let expanded = crate::utils::expand_home(executable).unwrap_or_else(|err| {
+        warn!("could not expand trusted shell command: {err}");
+        None
+    });
+    let executable = expanded
+        .as_deref()
+        .unwrap_or(executable)
+        .as_os_str()
+        .to_owned();
+    let mut configured = Command::new(&executable);
+    configure_child_environment(&mut configured);
+    let environment = snapshot_environment(std::env::vars_os(), &configured);
+    let handle = SupervisorHandle::default();
+    state.niri.trusted_shell_supervisor = Some(handle.clone());
+    let mut supervisor = Supervisor {
+        handle,
+        stopped: false,
+        executable,
+        arguments: command.into_iter().skip(1).collect(),
+        environment,
+        login_handoff,
+        running: None,
+        failures: 0,
+        retry_at: Instant::now(),
+    };
+    let timer = Timer::immediate();
+    if let Err(err) = state
+        .niri
+        .event_loop
+        .insert_source(timer, move |_, _, state| supervisor.tick(state))
+    {
+        state.niri.trusted_shell_supervisor = None;
+        warn!("could not supervise trusted shell: {err:?}");
+    }
+}
+
+/// A pidfd pins the child even after it exits; the saved ClientId pins the exact
+/// private Wayland connection. Socketpair SO_PEERCRED identifies this compositor,
+/// so it must never be used as the identity of the child that inherited its peer.
+struct TrustedConnection {
+    process: ProcessIdentity,
+    client: Client,
+    socket: UnixStream,
+    revoked: AtomicBool,
+}
+
+impl TrustedConnection {
+    fn identity(&self, display: &DisplayHandle) -> Option<TrustedShellIdentity> {
+        if self.revoked.load(Ordering::Relaxed)
+            || !self.process.is_alive()
+            || !socket_is_connected(&self.socket)
+            || display
+                .backend_handle()
+                .get_client_data(self.client.id())
+                .is_err()
+        {
+            return None;
+        }
+        Some(self.process.identity.clone())
+    }
+}
+
+struct ProcessIdentity {
+    pidfd: OwnedFd,
+    identity: TrustedShellIdentity,
+}
+
+impl ProcessIdentity {
+    /// The caller owns an unreaped Child, so its PID cannot be reused while the
+    /// pidfd and proc start time are captured. Never construct this from a caller PID.
+    fn new(child: &Child) -> io::Result<Self> {
+        let pid = child.id();
+        let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid, 0) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let pidfd = unsafe { OwnedFd::from_raw_fd(fd as i32) };
+        let stat = std::fs::read_to_string(format!("/proc/{pid}/stat"))?;
+        let start_time = proc_start_time(&stat)
+            .ok_or_else(|| io::Error::other("invalid trusted child process identity"))?;
+        Ok(Self {
+            pidfd,
+            identity: TrustedShellIdentity { pid, start_time },
+        })
+    }
+
+    fn is_alive(&self) -> bool {
+        let mut poll = libc::pollfd {
+            fd: self.pidfd.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        // Errors and exit readiness both fail closed; a stopped child remains the
+        // same process and never makes an ordinary sibling eligible as provider.
+        unsafe { libc::poll(&mut poll, 1, 0) == 0 }
+    }
+}
+
+fn socket_is_connected(socket: &UnixStream) -> bool {
+    let mut poll = libc::pollfd {
+        fd: socket.as_raw_fd(),
+        events: libc::POLLRDHUP,
+        revents: 0,
+    };
+    unsafe { libc::poll(&mut poll, 1, 0) == 0 }
+}
+
+fn proc_start_time(stat: &str) -> Option<u64> {
+    // comm may contain spaces and closing parentheses; fields after its final
+    // parenthesis begin at field 3, and starttime is field 22.
+    stat.rsplit_once(')')?
+        .1
+        .split_whitespace()
+        .nth(19)?
+        .parse()
+        .ok()
+}
+
+/// Probe the existing shell IPC without ever blocking compositor dispatch. The
+/// target is the unreaped foreground child, never an instance selected by name.
+struct Heartbeat {
+    probe: Option<(std::sync::mpsc::Receiver<bool>, Arc<AtomicBool>)>,
+    next_probe: Instant,
+    deadline: Instant,
+    last_tick: Instant,
+}
+
+impl Heartbeat {
+    fn new(now: Instant) -> Self {
+        Self {
+            probe: None,
+            next_probe: now + Duration::from_secs(15),
+            deadline: now + Duration::from_secs(30),
+            last_tick: now,
+        }
+    }
+
+    fn cancel_probe(&mut self) {
+        if let Some((_, cancel)) = self.probe.take() {
+            cancel.store(true, Ordering::Relaxed);
+        }
+    }
+
+    fn tick(&mut self, now: Instant, pid: u32, environment: &BTreeMap<OsString, OsString>) -> bool {
+        // A stalled compositor also means the shell could not dispatch Wayland.
+        // Discard that observation and allow a fresh round trip after a gap.
+        let gap = now.saturating_duration_since(self.last_tick) > Duration::from_secs(2);
+        self.last_tick = now;
+        if gap {
+            self.deadline = self.deadline.max(now + Duration::from_secs(45));
+            self.next_probe = now;
+            self.cancel_probe();
+        }
+        if let Some((result, _)) = &self.probe {
+            match result.try_recv() {
+                Ok(success) => {
+                    if success {
+                        self.deadline = now + Duration::from_secs(45);
+                    }
+                    self.probe = None;
+                }
+                Err(std::sync::mpsc::TryRecvError::Empty) => (),
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => self.probe = None,
+            }
+        }
+        if now >= self.deadline {
+            self.cancel_probe();
+            return false;
+        }
+        if self.probe.is_none() && now >= self.next_probe {
+            self.next_probe = now + Duration::from_secs(15);
+            let (send, result) = std::sync::mpsc::channel();
+            let cancel = Arc::new(AtomicBool::new(false));
+            let cancelled = cancel.clone();
+            let environment = environment.clone();
+            // The worker owns spawn, wait and retirement: neither fork/pre_exec
+            // nor a failed wait can block compositor dispatch or strand a probe.
+            let worker = std::thread::Builder::new().name("Shell Probe".into()).spawn(move || {
+                const PROGRAM: &str = env!("NIRI_EMAKI_QS_PROGRAM");
+                const _: () = assert!(!PROGRAM.is_empty() && PROGRAM.as_bytes()[0] == b'/',
+                    "NIRI_EMAKI_QS_PROGRAM must be an absolute path");
+                let program = PROGRAM;
+                let mut command = Command::new(program);
+                command.args(["ipc", "--pid", &pid.to_string(), "call", "system", "ping"])
+                    .env_clear().envs(environment).env_remove("WAYLAND_SOCKET")
+                    .stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null());
+                unsafe {
+                    command.pre_exec(|| {
+                        crate::utils::signals::unblock_all()?;
+                        restore_nofile_rlimit();
+                        Ok(())
+                    });
+                }
+                let Ok(mut probe) = command.spawn() else { return };
+                loop {
+                    if cancelled.load(Ordering::Relaxed) {
+                        break;
+                    }
+                    match probe.try_wait() {
+                        Ok(Some(status)) => {
+                            let _ = send.send(status.success());
+                            return;
+                        }
+                        Ok(None) => std::thread::sleep(Duration::from_millis(50)),
+                        Err(_) => break,
+                    }
+                }
+                let _ = probe.kill();
+                // Retire the slot before reaping: even a stuck wait must not
+                // prevent later rounds from probing the healthy shell.
+                drop(send);
+                let _ = probe.wait();
+            });
+            if worker.is_ok() {
+                self.probe = Some((result, cancel));
+            }
+        }
+        true
+    }
+}
+
+impl Drop for Heartbeat {
+    fn drop(&mut self) {
+        self.cancel_probe();
+    }
+}
+
+struct Running {
+    child: Child,
+    /// Duplicates only the server endpoint, so shutdown revokes a lingering client
+    /// even if the shell accidentally left its connection in a descendant.
+    revoke: UnixStream,
+    connection: Option<Arc<TrustedConnection>>,
+    started_at: Instant,
+    terminating_at: Option<Instant>,
+    heartbeat: Heartbeat,
+    heartbeat_failed: bool,
+}
+
+impl Running {
+    fn begin_restart(&mut self, now: Instant) {
+        if self.terminating_at.is_some() {
+            return;
+        }
+        // Revoke authority immediately; give the old process time to flush state.
+        if let Some(connection) = &self.connection {
+            connection.revoked.store(true, Ordering::Relaxed);
+        }
+        let _ = self.revoke.shutdown(Shutdown::Both);
+        // A child cannot have its PID reused before we reap it.
+        unsafe { libc::kill(self.child.id() as libc::pid_t, libc::SIGTERM) };
+        self.terminating_at = Some(now);
+    }
+
+    fn enforce_restart_deadline(&mut self, now: Instant) {
+        if self
+            .terminating_at
+            .is_some_and(|at| now.duration_since(at) >= RESTART_GRACE)
+        {
+            let _ = self.child.kill();
+        }
+    }
+}
+
+impl Drop for Running {
+    fn drop(&mut self) {
+        if let Some(connection) = &self.connection {
+            connection.revoked.store(true, Ordering::Relaxed);
+        }
+        let _ = self.revoke.shutdown(Shutdown::Both);
+        let _ = self.child.kill();
+        // Normal retirement has already reaped the child. Never block the event
+        // loop waiting for a process to finish, even when the supervisor is dropped.
+        let _ = self.child.try_wait();
+    }
+}
+
+struct Supervisor {
+    handle: SupervisorHandle,
+    stopped: bool,
+    executable: OsString,
+    arguments: Vec<String>,
+    environment: BTreeMap<OsString, OsString>,
+    login_handoff: Option<OsString>,
+    running: Option<Running>,
+    failures: u32,
+    retry_at: Instant,
+}
+
+impl Supervisor {
+    fn tick(&mut self, state: &mut State) -> TimeoutAction {
+        if self.handle.restart.swap(false, Ordering::Relaxed) {
+            if let Some(running) = &mut self.running {
+                running.heartbeat_failed = false;
+                running.begin_restart(Instant::now());
+            }
+            self.handle.running.store(false, Ordering::Relaxed);
+            self.failures = 0;
+            self.stopped = false;
+            self.retry_at = Instant::now();
+        }
+        if self.stopped {
+            return TimeoutAction::ToDuration(POLL_INTERVAL);
+        }
+        if let Some(running) = &mut self.running {
+            let now = Instant::now();
+            if running.terminating_at.is_none()
+                && !running
+                    .heartbeat
+                    .tick(now, running.child.id(), &self.environment)
+            {
+                warn!("trusted shell stopped responding; restarting");
+                running.heartbeat_failed = true;
+                running.begin_restart(now);
+                self.handle.running.store(false, Ordering::Relaxed);
+            }
+            running.enforce_restart_deadline(now);
+            let restarting = running.terminating_at.is_some() && !running.heartbeat_failed;
+            let disabled = match running.child.try_wait() {
+                Ok(None) => return TimeoutAction::ToDuration(POLL_INTERVAL),
+                Ok(Some(status)) => {
+                    if status.code() == Some(78) {
+                        info!("trusted shell is disabled by its autostart switch");
+                        true
+                    } else {
+                        warn!("trusted shell exited: {status}");
+                        false
+                    }
+                }
+                Err(err) => {
+                    warn!("could not wait for trusted shell: {err}");
+                    false
+                }
+            };
+            let stable = running.started_at.elapsed() >= STABLE_UPTIME;
+            // Revoke the old connection before creating a fresh trusted connection.
+            self.running.take();
+            *self.handle.connection.lock().unwrap() = None;
+            self.handle.running.store(false, Ordering::Relaxed);
+            if restarting {
+                return TimeoutAction::ToDuration(Duration::ZERO);
+            }
+            if disabled {
+                self.stopped = true;
+                return TimeoutAction::ToDuration(POLL_INTERVAL);
+            }
+            if stable {
+                self.failures = 0;
+            }
+            return self.failed();
+        }
+        let now = Instant::now();
+        if now < self.retry_at {
+            return TimeoutAction::ToInstant(self.retry_at);
+        }
+        match self.spawn(state) {
+            Ok(running) => {
+                *self.handle.connection.lock().unwrap() = running.connection.clone();
+                self.running = Some(running);
+                self.handle.running.store(true, Ordering::Relaxed);
+                TimeoutAction::ToDuration(POLL_INTERVAL)
+            }
+            Err(err) => {
+                warn!("could not start trusted shell: {err}");
+                self.failed()
+            }
+        }
+    }
+
+    fn failed(&mut self) -> TimeoutAction {
+        self.failures += 1;
+        let Some(delay) = restart_delay(self.failures) else {
+            warn!("trusted shell stopped after repeated failures; starting shell recovery");
+            self.stopped = true;
+            if let Err(err) = start_recovery(self.environment.clone()) {
+                warn!("could not start shell recovery worker: {err}");
+            }
+            return TimeoutAction::ToDuration(POLL_INTERVAL);
+        };
+        self.retry_at = Instant::now() + delay;
+        TimeoutAction::ToInstant(self.retry_at)
+    }
+
+    fn spawn(&mut self, state: &mut State) -> io::Result<Running> {
+        let (server, client) = UnixStream::pair()?;
+        let revoke = server.try_clone()?;
+        let identity_socket = server.try_clone()?;
+        let wayland_client = state.niri.insert_trusted_shell(server)?;
+
+        let mut process = Command::new(&self.executable);
+        process
+            .env_clear()
+            .envs(&self.environment)
+            .args(&self.arguments)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            // Keep shell diagnostics in the compositor's journal.
+            .stderr(Stdio::inherit());
+        let socket_fd = client.as_raw_fd();
+        // Apply this after configured environment so it cannot replace the descriptor.
+        process.env("WAYLAND_SOCKET", socket_fd.to_string());
+        unsafe {
+            process.pre_exec(move || {
+                crate::utils::signals::unblock_all()?;
+                restore_nofile_rlimit();
+                // Only this child's copy becomes inheritable. In the compositor it
+                // remains CLOEXEC, including while other commands spawn concurrently.
+                let flags = libc::fcntl(socket_fd, libc::F_GETFD);
+                if flags == -1
+                    || libc::fcntl(socket_fd, libc::F_SETFD, flags & !libc::FD_CLOEXEC) == -1
+                {
+                    return Err(io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+        let result = spawn_with_login_handoff(&mut process, &mut self.login_handoff);
+        // The compositor must not retain the client endpoint after exec.
+        drop(client);
+        match result {
+            Ok(mut child) => {
+                let process = match ProcessIdentity::new(&child) {
+                    Ok(process) => process,
+                    Err(err) => {
+                        let _ = revoke.shutdown(Shutdown::Both);
+                        let _ = child.kill();
+                        let _ = child.wait();
+                        return Err(err);
+                    }
+                };
+                let connection = Arc::new(TrustedConnection {
+                    process,
+                    client: wayland_client,
+                    socket: identity_socket,
+                    revoked: AtomicBool::new(false),
+                });
+                Ok(Running {
+                    child,
+                    revoke,
+                    connection: Some(connection),
+                    started_at: Instant::now(),
+                    terminating_at: None,
+                    heartbeat: Heartbeat::new(Instant::now()),
+                    heartbeat_failed: false,
+                })
+            }
+            Err(err) => {
+                let _ = revoke.shutdown(Shutdown::Both);
+                Err(err)
+            }
+        }
+    }
+}
+
+/// Recovery has a fixed command and the same captured session environment as
+/// startup. It receives no trusted connection and cannot replace the shell argv.
+fn start_recovery(
+    environment: BTreeMap<OsString, OsString>,
+) -> io::Result<std::thread::JoinHandle<()>> {
+    std::thread::Builder::new()
+        .name("Shell Recovery".to_owned())
+        .spawn(move || {
+            let mut command = Command::new("systemctl");
+            command
+                .args(["--user", "--no-block", "start", "emaki-shell-heal.service"])
+                .env_clear()
+                .envs(environment)
+                .env_remove("WAYLAND_SOCKET")
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::inherit());
+            unsafe {
+                command.pre_exec(|| {
+                    crate::utils::signals::unblock_all()?;
+                    restore_nofile_rlimit();
+                    Ok(())
+                });
+            }
+            match command.status() {
+                Ok(status) if status.success() => (),
+                Ok(status) => warn!("could not activate shell recovery: {status}"),
+                Err(err) => warn!("could not activate shell recovery: {err}"),
+            }
+        })
+}
+
+fn snapshot_environment(
+    inherited: impl IntoIterator<Item = (OsString, OsString)>,
+    configured: &Command,
+) -> BTreeMap<OsString, OsString> {
+    let mut environment: BTreeMap<_, _> = inherited.into_iter().collect();
+    for (name, value) in configured.get_envs() {
+        if let Some(value) = value {
+            environment.insert(name.to_owned(), value.to_owned());
+        } else {
+            environment.remove(name);
+        }
+    }
+    environment.remove(std::ffi::OsStr::new("WAYLAND_SOCKET"));
+    environment
+}
+
+fn restart_delay(failures: u32) -> Option<Duration> {
+    (failures < MAX_FAILURES).then(|| Duration::from_secs(1 << failures.saturating_sub(1)))
+}
