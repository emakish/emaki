+    // Trace callsite interest is shared with parallel tests that use no subscriber.
+    // Exercise actual warning output in a fresh, single-test process.
+    if std::env::var_os("NIRI_TEST_PROMPT_DENIAL_LOG").is_none() {
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "tests::trusted_prompt::trusted_prompt_refusal_logs_once_per_connection_and_still_closes_every_role",
+                "--nocapture",
+            ])
+            .env("NIRI_TEST_PROMPT_DENIAL_LOG", "1")
+            .output()
+            .unwrap();
+        assert!(result.status.success(), "{}\n{}",
+            String::from_utf8_lossy(&result.stdout), String::from_utf8_lossy(&result.stderr));
+        return;
+    }
+    use std::io::Write;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Clone)]
+    struct Log(Arc<Mutex<Vec<u8>>>);
+    impl Write for Log {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+    }
+    let log = Log(Arc::default());
+    let writer = log.clone();
+    let subscriber = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::WARN)
+        .with_writer(move || writer.clone())
+        .finish();
+    let _guard = tracing::subscriber::set_default(subscriber);
+    let mut f = fixture();
+    for _ in 0..2 {
+        let hostile = f.add_client();
+        for _ in 0..3 {
+            let surface = request(&mut f, hostile, NAMESPACE);
+            let layer = f.client(hostile).layer(&surface);
+            assert!(layer.close_requested);
+            assert!(layer.configures_received.is_empty());
+        }
+    }
+    let shell = f.add_trusted_shell();
+    map(&mut f, shell, NAMESPACE);
+    for _ in 0..3 {
+        let surface = request(&mut f, shell, NAMESPACE);
+        assert!(f.client(shell).layer(&surface).close_requested);
+    }
+    let text = String::from_utf8(log.0.lock().unwrap().clone()).unwrap();
+    assert_eq!(text.matches("denied untrusted emaki-auth-prompt layer surface").count(), 2);
+    assert_eq!(text.matches("denied duplicate emaki-auth-prompt layer surface").count(), 1);
+}
