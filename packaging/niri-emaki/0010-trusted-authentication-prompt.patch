+impl wayland_client::Dispatch<wayland_client::protocol::wl_pointer::WlPointer, SurfaceEnters>
+    for super::client::State
+{
+    fn event(
+        _state: &mut Self,
+        _proxy: &wayland_client::protocol::wl_pointer::WlPointer,
+        event: wayland_client::protocol::wl_pointer::Event,
+        enters: &SurfaceEnters,
+        _conn: &wayland_client::Connection,
+        _qh: &wayland_client::QueueHandle<Self>,
+    ) {
+        if let wayland_client::protocol::wl_pointer::Event::Enter { surface, .. } = event {
+            enters.lock().unwrap().push(surface);
+        }
+    }
+}
