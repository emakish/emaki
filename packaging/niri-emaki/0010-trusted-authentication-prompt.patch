+pub const NAMESPACE: &str = "emaki-auth-prompt";
+pub const PROOF_BAND_HEIGHT: f64 = 48.;
+
+pub fn client_is_trusted(surface: &WlSurface) -> bool {
+    surface.client().is_some_and(|client| {
+        client
+            .get_data::<ClientState>()
+            .is_some_and(|state| state.trusted_shell)
+    })
+}
+
+impl Niri {
+    /// A mapped role, even while it is hidden by a lock request.
+    fn mapped_trusted_prompt(&self) -> Option<LayerSurface> {
+        self.mapped_layer_surfaces
+            .keys()
+            .find(|layer| layer.namespace() == NAMESPACE && client_is_trusted(layer.wl_surface()))
+            .cloned()
+    }
+
+    pub fn trusted_prompt(&self) -> Option<LayerSurface> {
+        if !matches!(self.lock_state, LockState::Unlocked) {
+            return None;
+        }
+        self.mapped_trusted_prompt()
+    }
+
+    pub fn trusted_prompt_active(&self) -> bool {
+        self.trusted_prompt().is_some()
+    }
+
+    /// The no-prompt proof curtain also absorbs input. A fake client cannot keep
+    /// displaying a pre-painted proof while the physical action is held/invoked.
+    pub fn trusted_prompt_input_isolated(&self) -> bool {
+        (!self.is_locked()
+            && (self.session_lock_prepared || self.mapped_trusted_prompt().is_some()))
+            || self.trusted_prompt_proof_active()
+    }
+
+    pub fn trusted_prompt_proof_active(&self) -> bool {
+        self.trusted_prompt_proof_deadline
+            .is_some_and(|end| Instant::now() < end)
+    }
+
+    pub fn trusted_prompt_mark_active(&self) -> bool {
+        self.trusted_prompt_proof_active()
+            && self.trusted_prompt().is_some_and(|layer| {
+                self.trusted_prompt_proof_surface.as_ref() == Some(layer.wl_surface())
+            })
+    }
+
+    /// Only the physical keyboard dispatch calls this. There is no IPC action.
+    pub fn show_trusted_prompt_mark(&mut self) {
+        let deadline = Instant::now() + Duration::from_secs(3);
+        self.trusted_prompt_proof_deadline = Some(deadline);
+        self.trusted_prompt_proof_surface = self.trusted_prompt().map(|l| l.wl_surface().clone());
+        self.event_loop
+            .insert_source(Timer::from_deadline(deadline), move |_, _, state| {
+                if state.niri.trusted_prompt_proof_deadline == Some(deadline) {
+                    state.niri.trusted_prompt_proof_deadline = None;
+                    state.niri.trusted_prompt_proof_surface = None;
+                    state.niri.queue_redraw_all();
+                }
+                TimeoutAction::Drop
+            })
+            .unwrap();
+        self.queue_redraw_all();
+    }
+
+    pub(crate) fn trusted_prompt_contents_under(
+        &self,
+        output: &Output,
+        pos: Point<f64, Logical>,
+    ) -> PointContents {
+        let mut contents = PointContents {
+            output: Some(output.clone()),
+            ..Default::default()
+        };
+        let Some(layer) = self.trusted_prompt() else {
+            return contents;
+        };
+        // The proof view may move/scale the card. Do not send pointer or touch
+        // coordinates to a moving target; keyboard focus stays on the trusted role.
+        if self.trusted_prompt_proof_active() {
+            return contents;
+        }
+        let map = layer_map_for_output(output);
+        let Some(geometry) = map.layer_geometry(&layer) else {
+            return contents;
+        };
+        let origin = geometry.loc;
+        let global = self.global_space.output_geometry(output).unwrap().loc;
+        // Only this role's surface tree receives input. Layer popups are not part
+        // of the password card and cannot claim focus through a popup grab.
+        contents.surface = layer
+            .surface_under(
+                pos - origin.to_f64(),
+                WindowSurfaceType::TOPLEVEL | WindowSurfaceType::SUBSURFACE,
+            )
+            .map(|(surface, offset)| (surface, (offset + origin + global).to_f64()));
+        if contents.surface.is_some() {
+            contents.layer = Some(layer);
+        }
+        contents
+    }
+
+    pub(crate) fn render_trusted_prompt<R: NiriRenderer>(
+        &self,
+        ctx: RenderCtx<R>,
+        output: &Output,
+        include_pointer: bool,
+        push: &mut dyn FnMut(OutputRenderElements<R>),
+    ) {
+        let scale = Scale::from(output.current_scale().fractional_scale());
+        let size = output_size(output);
+        let marked = self.trusted_prompt_mark_active();
+        let band = if marked {
+            PROOF_BAND_HEIGHT.min(size.h / 2.)
+        } else {
+            0.
+        };
+        let viewport = Rectangle::new((0., band).into(), (size.w, size.h - band).into())
+            .to_physical_precise_round(scale);
+
+        // The proof occupies reserved output space outside every client buffer,
+        // including cursors. This neutral geometric fixture has no client text.
+        if marked {
+            for (id, (x, y, w, h)) in self.trusted_prompt_mark_ids.iter().zip([
+                (16., 16., 8., 16.),
+                (24., 24., 16., 8.),
+                (40., 8., 8., 24.),
+            ]) {
+                push(
+                    SolidColorRenderElement::new(
+                        id.clone(),
+                        Rectangle::new((x, y).into(), (w, h).into()),
+                        Default::default(),
+                        [1., 1., 1., 1.].into(),
+                        Kind::Unspecified,
+                    )
+                    .into(),
+                );
+            }
+        }
+        if include_pointer && !self.trusted_prompt_proof_active() && self.pointer_visibility.is_visible() {
+            self.render_pointer(ctx.renderer, output, &mut |element| {
+                if let Some(element) = CropRenderElement::from_element(element, scale, viewport) {
+                    push(OutputRenderElements::TrustedPointer(element));
+                }
+            });
+        }
+        if let Some(layer) = self.trusted_prompt().filter(|layer| {
+            let rules = self.mapped_layer_surfaces.get(layer).unwrap().rules();
+            let own_capture = rules.hide_from_own_screencopy
+                && ctx
+                    .capture_client
+                    .is_some_and(|client| layer.wl_surface().client().as_ref() == Some(client));
+            // Keep the existing capture privacy rules above the ordinary scene
+            // too. The proof interval alone supplies an opaque curtain.
+            !own_capture && !ctx.target.should_block_out(rules.block_out_from)
+        }) {
+            let map = layer_map_for_output(output);
+            if let Some(geometry) = map.layer_geometry(&layer) {
+                let origin = geometry.loc.to_f64().to_physical_precise_round(scale);
+                let bounds = bbox_from_surface_tree(layer.wl_surface(), geometry.loc).to_f64();
+                let zoom = if marked {
+                    ((size.h - band) / bounds.size.h.max(1.))
+                        .min(size.w / bounds.size.w.max(1.))
+                        .min(1.)
+                } else {
+                    1.
+                };
+                let proof_origin = Point::from((
+                    bounds.loc.x.clamp(0., (size.w - bounds.size.w * zoom).max(0.)),
+                    bounds.loc.y.clamp(band, (size.h - bounds.size.h * zoom).max(band)),
+                ));
+                let bounds_origin = bounds.loc.to_physical_precise_round(scale);
+                let offset = if marked {
+                    proof_origin.to_physical_precise_round(scale) - bounds_origin
+                } else {
+                    Point::from((0, 0))
+                };
+                push_elements_from_surface_tree(
+                    ctx.renderer,
+                    layer.wl_surface(),
+                    origin,
+                    scale,
+                    1.,
+                    Kind::Unspecified,
+                    &mut |element| {
+                        let element = RescaleRenderElement::from_element(element, bounds_origin, zoom);
+                        let element = RelocateRenderElement::from_element(element, offset, Relocate::Relative);
+                        if let Some(element) =
+                            CropRenderElement::from_element(element, scale, viewport)
+                        {
+                            push(OutputRenderElements::TrustedPrompt(element));
+                        }
+                    },
+                );
+            }
+        }
+        // Only proof replaces the desktop. A normally mapped prompt sits above
+        // the ordinary scene with no dimming and retains the same input boundary.
+        if !self.trusted_prompt_proof_active() {
+            return;
+        }
+        push(
+            SolidColorRenderElement::new(
+                self.trusted_prompt_backdrop_id.clone(),
+                Rectangle::from_size(size),
+                Default::default(),
+                [0., 0., 0., 1.].into(),
+                Kind::Unspecified,
+            )
+            .into(),
+        );
+    }
+}
+
+impl State {
+    /// Acknowledge only after revoking focus and grabs. There is no IPC cancellation:
+    /// the protocol lock owner must complete the normal unlock transition.
+    pub fn prepare_session_lock(&mut self) {
+        self.niri.session_lock_prepared = true;
+        self.update_keyboard_focus();
+    }
+
+    /// Revoke inherited grabs at both sides of a trust/lock boundary. Also called
+    /// at input dispatch: a commit and input may arrive in the same event turn.
+    pub fn refresh_trusted_prompt_input(&mut self) {
+        if !matches!(self.niri.lock_state, LockState::Unlocked) {
+            // A proof requested while locked still curtains the hostile lock
+            // surface. It must never authenticate a hidden session prompt.
+            self.niri.trusted_prompt_proof_surface = None;
+        } else if self
+            .niri
+            .trusted_prompt_proof_surface
+            .as_ref()
+            .is_some_and(|surface| {
+                !self
+                    .niri
+                    .mapped_trusted_prompt()
+                    .is_some_and(|layer| layer.wl_surface() == surface)
+            })
+        {
+            // A later remap on the same wl_surface needs a fresh physical proof.
+            self.niri.trusted_prompt_proof_surface = None;
+        }
+        let isolated = self.niri.trusted_prompt_input_isolated();
+        let marked = self.niri.trusted_prompt_mark_active();
+        let surface = self.niri.trusted_prompt().map(|l| l.wl_surface().clone());
+        if isolated == self.niri.trusted_prompt_was_isolated
+            && marked == self.niri.trusted_prompt_was_marked
+            && surface == self.niri.trusted_prompt_input_surface
+        {
+            return;
+        }
+        self.niri.trusted_prompt_was_isolated = isolated;
+        self.niri.trusted_prompt_was_marked = marked;
+        self.niri.trusted_prompt_input_surface = surface;
+        let pointer = self.niri.seat.get_pointer().unwrap();
+        if let Some((surface, _)) = &self.niri.pointer_contents.surface {
+            with_pointer_constraint(surface, &pointer, |constraint| {
+                if let Some(constraint) = constraint {
+                    constraint.deactivate();
+                }
+            });
+        }
+        if let Some(mut grab) = self.niri.popup_grab.take() {
+            grab.grab.ungrab(PopupUngrabStrategy::All);
+        }
+        self.niri.seat.get_keyboard().unwrap().unset_grab(self);
+        pointer.unset_grab(
+            self,
+            SERIAL_COUNTER.next_serial(),
+            get_monotonic_time().as_millis() as u32,
+        );
+        if let Some(touch) = self.niri.seat.get_touch() {
+            touch.cancel(self);
+            touch.unset_grab(self);
+        }
+        self.niri.dnd_icon = None;
+        self.niri.tablet_cursor_location = None;
+        if let Some(timer) = self.niri.bind_repeat_timer.take() {
+            self.niri.event_loop.remove(timer);
+        }
+        self.niri
+            .cursor_manager
+            .set_cursor_image(CursorImageStatus::Named(CursorIcon::Default));
+        self.niri.queue_redraw_all();
+        // These call back into the boundary check, now with the updated state.
+        self.update_keyboard_focus();
+        self.refresh_pointer_contents();
+    }
+}
