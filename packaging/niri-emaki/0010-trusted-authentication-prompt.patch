+// A hostile connection can create arbitrarily many refused roles. Keep its first
+// diagnostic while closing every attempt before configure, without journal spam.
+fn warn_prompt_denial_once(surface: &WlSurface, duplicate: bool) {
+    let Some(client) = surface.client() else { return; };
+    let Some(state) = client.get_data::<crate::niri::ClientState>() else { return; };
+    if !state.trusted_prompt_denial_logged.swap(true, Ordering::Relaxed) {
+        let kind = if duplicate { "duplicate" } else { "untrusted" };
+        warn!("denied {kind} emaki-auth-prompt layer surface");
+    }
+}
