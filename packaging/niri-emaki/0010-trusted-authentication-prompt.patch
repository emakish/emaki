+        assert_eq!(*hostile_touch_downs.lock().unwrap(), [overlay.clone()]);
+
+        let shell = f.add_trusted_shell();
+        let prompt = map(&mut f, shell, NAMESPACE);
+        assert!(!f.niri().trusted_prompt_proof_active());
+        f.double_roundtrip(hostile);
+        hostile_enters.lock().unwrap().clear();
+        hostile_pointer_enters.lock().unwrap().clear();
+        hostile_touch_downs.lock().unwrap().clear();
+
+        if unmap_prompt == "before-lock" {
+            // The supervisor first awaits this compositor transition, then the
+            // gate watcher cancels the shell prompt before the locker connects.
+            f.niri_state().prepare_session_lock();
+            f.niri_state().prepare_session_lock();
+            let layer = f.client(shell).layer(&prompt);
+            layer.attach_null();
+            layer.commit();
+            f.double_roundtrip(shell);
+            f.double_roundtrip(hostile);
+            assert!(matches!(f.niri().lock_state, LockState::Unlocked));
+            // The rendering-failure cleanup shares Niri::unlock(), but must not
+            // release preparation without the protocol owner's unlock request.
+            f.niri().unlock();
+            f.double_roundtrip(hostile);
+            assert!(f.niri().session_lock_prepared);
+            assert!(!f.niri().trusted_prompt_proof_active());
+            assert!(hostile_enters.lock().unwrap().is_empty());
+            assert!(hostile_pointer_enters.lock().unwrap().is_empty());
+            touch_overlay(&mut f);
+            f.double_roundtrip(hostile);
+            assert!(hostile_touch_downs.lock().unwrap().is_empty());
+            assert!(f
+                .niri()
+                .seat
+                .get_keyboard()
+                .unwrap()
+                .current_focus()
+                .is_none());
+        }
+
+        let locker = f.add_client();
+        let lock_enters = keyboard_enters(&mut f, locker);
+        let client = f.client(locker);
+        let registry = client.display.get_registry(&client.qh, ());
+        let global = client
+            .state
+            .globals
+            .iter()
+            .find(|g| g.interface == ExtSessionLockManagerV1::interface().name)
+            .unwrap();
+        let manager: ExtSessionLockManagerV1 = registry.bind(global.name, 1, &client.qh, ());
+        let lock = manager.lock(&client.qh, Arc::new(AtomicBool::new(false)));
+        f.double_roundtrip(locker);
+        f.double_roundtrip(hostile);
+        assert!(matches!(
+            f.niri().lock_state,
+            LockState::WaitingForSurfaces { .. }
+        ));
+        assert!(hostile_enters.lock().unwrap().is_empty());
+        assert!(hostile_pointer_enters.lock().unwrap().is_empty());
+        assert!(f
+            .niri()
+            .seat
+            .get_keyboard()
+            .unwrap()
+            .current_focus()
+            .is_none());
+
+        if unmap_prompt == "after-lock" {
+            // The broker cancels the prompt on lock. This can happen while the
+            // locker is still preparing its first surface.
+            let layer = f.client(shell).layer(&prompt);
+            layer.attach_null();
+            layer.commit();
+            f.double_roundtrip(shell);
+            f.double_roundtrip(hostile);
+            assert!(hostile_enters.lock().unwrap().is_empty());
+            assert!(hostile_pointer_enters.lock().unwrap().is_empty());
+            assert!(f
+                .niri()
+                .seat
+                .get_keyboard()
+                .unwrap()
+                .current_focus()
+                .is_none());
+        }
