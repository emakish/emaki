+        // A parallel fork can inherit even a CLOEXEC peer until exec, so dropping
+        // our copy alone need not disconnect it. Keep a duplicate to exercise that
+        // case and shut down the connection independently of the last close.
+        let inherited_peer = peer.try_clone().unwrap();
