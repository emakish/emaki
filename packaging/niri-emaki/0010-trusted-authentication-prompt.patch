+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Reserved prompt identity, focus isolation, and compositor proof lifecycle.
+
+use niri_config::Config;
+use smithay::reexports::wayland_protocols::ext::session_lock::v1::server::ext_session_lock_v1::ExtSessionLockV1;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::{
+    zwlr_layer_shell_v1::Layer,
+    zwlr_layer_surface_v1::{Anchor, KeyboardInteractivity},
+};
+use smithay::reexports::wayland_server::{backend::ObjectId, Resource as _};
+use wayland_client::protocol::wl_surface::WlSurface;
+
+use super::client::{ClientId, LayerConfigureProps};
+use super::Fixture;
+use crate::niri::LockState;
+
+const NAMESPACE: &str = "emaki-auth-prompt";
+
+fn fixture() -> Fixture {
+    let mut f =
+        Fixture::with_config(Config::parse_mem("hotkey-overlay { skip-at-startup; }").unwrap());
+    f.add_output(1, (800, 600));
+    f
+}
+
+fn request(f: &mut Fixture, id: ClientId, namespace: &str) -> WlSurface {
+    let layer = f.client(id).create_layer(None, Layer::Overlay, namespace);
+    layer.set_configure_props(LayerConfigureProps {
+        size: Some((200, 100)),
+        anchor: Some(Anchor::Top | Anchor::Left),
+        kb_interactivity: Some(KeyboardInteractivity::Exclusive),
+        ..Default::default()
+    });
+    let surface = layer.surface.clone();
+    layer.commit();
+    f.double_roundtrip(id);
+    surface
+}
+
+fn map(f: &mut Fixture, id: ClientId, namespace: &str) -> WlSurface {
+    let surface = request(f, id, namespace);
+    let layer = f.client(id).layer(&surface);
+    assert!(!layer.close_requested);
+    assert!(!layer.configures_received.is_empty());
+    layer.attach_new_buffer();
+    layer.set_size(200, 100);
+    layer.ack_last_and_commit();
+    f.double_roundtrip(id);
+    surface
+}
+
+fn set_locked(f: &mut Fixture) {
+    // A dead lock resource represents a session whose locker has disconnected.
+    let lock = ExtSessionLockV1::from_id(&f.niri().display_handle, ObjectId::null()).unwrap();
+    f.niri().lock_state = LockState::Locked(lock);
+    f.state.server.dispatch();
+}
+
+#[test]
+fn trusted_prompt_public_socket_cannot_claim_namespace() {
+    let mut f = fixture();
+    let id = f.add_client();
+    let surface = request(&mut f, id, NAMESPACE);
+    let layer = f.client(id).layer(&surface);
+    assert!(layer.close_requested);
+    assert!(layer.configures_received.is_empty());
+    assert!(!f.niri().trusted_prompt_active());
+    // Refusing a reserved role does not disconnect ordinary layer-shell clients.
+    map(&mut f, id, "ordinary-overlay");
+    assert!(!f.niri().trusted_prompt_active());
+}
+
+#[test]
+fn trusted_prompt_excludes_competing_layers_in_both_arrival_orders() {
+    for hostile_first in [false, true] {
+        let mut f = fixture();
+        let hostile = f.add_client();
+        let shell = f.add_trusted_shell();
+        if hostile_first {
+            map(&mut f, hostile, "hostile-overlay");
+        }
+        map(&mut f, shell, NAMESPACE);
+        if !hostile_first {
+            map(&mut f, hostile, "hostile-overlay");
+        }
+        let prompt = f.niri().trusted_prompt().unwrap();
+        let keyboard = f.niri().seat.get_keyboard().unwrap();
+        assert_eq!(keyboard.current_focus().as_ref(), Some(prompt.wl_surface()));
+        assert_eq!(
+            f.niri()
+                .contents_under((50., 80.).into())
+                .surface
+                .map(|s| s.0),
+            Some(prompt.wl_surface().clone()),
+        );
+        assert!(f
+            .niri()
+            .contents_under((500., 400.).into())
+            .surface
+            .is_none());
+        // Moving the active output must not return focus to another client.
+        f.add_output(2, (800, 600));
+        f.niri_focus_output(2);
+        f.niri_state().update_keyboard_focus();
+        assert_eq!(keyboard.current_focus().as_ref(), Some(prompt.wl_surface()));
+    }
+}
+
+#[test]
+fn trusted_prompt_mark_requires_prompt_and_resets_on_unmap() {
+    let mut f = fixture();
+    f.niri().show_trusted_prompt_mark();
+    assert!(!f.niri().trusted_prompt_mark_active());
+    let shell = f.add_trusted_shell();
+    let surface = map(&mut f, shell, NAMESPACE);
+    f.niri().show_trusted_prompt_mark();
+    assert!(f.niri().trusted_prompt_mark_active());
+    let layer = f.client(shell).layer(&surface);
+    layer.attach_null();
+    layer.commit();
+    f.double_roundtrip(shell);
+    assert!(!f.niri().trusted_prompt_active());
+    assert!(!f.niri().trusted_prompt_mark_active());
+}
+
+#[test]
+fn trusted_prompt_lock_revokes_focus_and_mark() {
+    let mut f = fixture();
+    let shell = f.add_trusted_shell();
+    map(&mut f, shell, NAMESPACE);
+    f.niri().show_trusted_prompt_mark();
+    assert!(f.niri().trusted_prompt_mark_active());
+    set_locked(&mut f);
+    assert!(!f.niri().trusted_prompt_active());
+    assert!(!f.niri().trusted_prompt_mark_active());
+    assert!(f
+        .niri()
+        .seat
+        .get_keyboard()
+        .unwrap()
+        .current_focus()
+        .is_none());
+    assert!(f.niri().contents_under((50., 80.).into()).surface.is_none());
+    f.niri().show_trusted_prompt_mark();
+    assert!(!f.niri().trusted_prompt_mark_active());
+}
+
+#[test]
+fn trusted_prompt_mapped_during_lock_has_no_focus_or_mark() {
+    let mut f = fixture();
+    set_locked(&mut f);
+    let shell = f.add_trusted_shell();
+    map(&mut f, shell, NAMESPACE);
+    assert!(!f.niri().trusted_prompt_active());
+    assert!(f
+        .niri()
+        .seat
+        .get_keyboard()
+        .unwrap()
+        .current_focus()
+        .is_none());
+    assert!(f.niri().contents_under((50., 80.).into()).surface.is_none());
+    f.niri().show_trusted_prompt_mark();
+    assert!(!f.niri().trusted_prompt_mark_active());
+}
+
+fn pixels(f: &mut Fixture) -> Vec<u8> {
+    capture_pixels(f, None, crate::render_helpers::RenderTarget::Output)
+}
+
+fn capture_pixels(
+    f: &mut Fixture,
+    capture_client: Option<&smithay::reexports::wayland_server::Client>,
+    target: crate::render_helpers::RenderTarget,
+) -> Vec<u8> {
+    use crate::render_helpers::{render_to_vec, RenderCtx};
+    use smithay::backend::allocator::Fourcc;
+    use smithay::utils::{Scale, Transform};
+
+    let output = f.niri_output(1);
+    let state = f.niri_state();
+    state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let elements = state.niri.render_to_vec(
+                RenderCtx {
+                    renderer,
+                    target,
+                    xray: None,
+                    capture_client,
+                },
+                &output,
+                false,
+            );
+            render_to_vec(
+                renderer,
+                output.current_mode().unwrap().size,
+                Scale::from(1.),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap()
+        })
+        .unwrap()
+}
+
+fn paint(f: &mut Fixture, id: ClientId, surface: &WlSurface, rgba: [u32; 4]) {
+    let layer = f.client(id).layer(surface);
+    let buffer =
+        layer
+            .spbm
+            .create_u32_rgba_buffer(rgba[0], rgba[1], rgba[2], rgba[3], &layer.qh, ());
+    layer.surface.attach(Some(&buffer), 0, 0);
+    layer.commit();
+    f.double_roundtrip(id);
+}
+
+#[test]
+fn egl_trusted_prompt_proof_band_cannot_be_painted_by_clients() {
+    let mut f = fixture();
+    f.niri_state().backend.headless().add_renderer().unwrap();
+    let shell = f.add_trusted_shell();
+    let surface = map(&mut f, shell, NAMESPACE);
+    paint(&mut f, shell, &surface, [u32::MAX, 0, 0, u32::MAX]);
+    let hostile = f.add_client();
+    let hostile_surface = map(&mut f, hostile, "hostile-overlay");
+    paint(
+        &mut f,
+        hostile,
+        &hostile_surface,
+        [0, u32::MAX, 0, u32::MAX],
+    );
+    let before = pixels(&mut f);
+    let red = [255, 0, 0, 255];
+    let green = [0, 255, 0, 255];
+    let index = (80 * 800 + 50) * 4;
+    assert_eq!(&before[index..index + 4], red);
+    assert!(!before.chunks_exact(4).any(|px| px == green));
+    f.niri().show_trusted_prompt_mark();
+    let proof = pixels(&mut f);
+    assert_ne!(
+        proof, before,
+        "compositor action must change rendered pixels"
+    );
+    assert!(
+        !proof[..800 * 48 * 4]
+            .chunks_exact(4)
+            .any(|px| px == red || px == green),
+        "a client buffer painted the reserved proof band"
+    );
+    assert_eq!(
+        proof.chunks_exact(4).filter(|px| *px == red).count(),
+        before.chunks_exact(4).filter(|px| *px == red).count(),
+        "proof must retain every pixel of the card, including its top edge"
+    );
+    set_locked(&mut f);
+    let locked = pixels(&mut f);
+    assert!(
+        !locked.chunks_exact(4).any(|px| px == red || px == green),
+        "a session layer leaked into locked output"
+    );
+}
