+// Record the actual wire events: checking only final compositor focus misses a
+// transient enter followed by a leave within the same dispatch.
+type SurfaceEnters = std::sync::Arc<std::sync::Mutex<Vec<WlSurface>>>;
+
+wayland_client::delegate_noop!(super::client::State: ignore wayland_client::protocol::wl_seat::WlSeat);
+
+impl wayland_client::Dispatch<wayland_client::protocol::wl_keyboard::WlKeyboard, SurfaceEnters>
+    for super::client::State
+{
+    fn event(
+        _state: &mut Self,
+        _proxy: &wayland_client::protocol::wl_keyboard::WlKeyboard,
+        event: wayland_client::protocol::wl_keyboard::Event,
+        enters: &SurfaceEnters,
+        _conn: &wayland_client::Connection,
+        _qh: &wayland_client::QueueHandle<Self>,
+    ) {
+        if let wayland_client::protocol::wl_keyboard::Event::Enter { surface, .. } = event {
+            enters.lock().unwrap().push(surface);
+        }
+    }
+}
