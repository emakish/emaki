@@ -0,0 +1,419 @@
+//! Tests for the `hide-from-own-screencopy` layer rule.
+
+use std::fs::File;
+use std::os::fd::{AsFd as _, FromRawFd as _, OwnedFd};
+use std::os::unix::fs::FileExt as _;
+use std::sync::{Arc, Mutex};
+
+use niri_config::Config;
+use smithay::backend::allocator::Fourcc;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_shell_v1::Layer;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_surface_v1::Anchor;
+use smithay::reexports::wayland_protocols_wlr::screencopy::v1::client::zwlr_screencopy_frame_v1::{
+    self, ZwlrScreencopyFrameV1,
+};
+use smithay::reexports::wayland_protocols_wlr::screencopy::v1::client::zwlr_screencopy_manager_v1::ZwlrScreencopyManagerV1;
+use smithay::utils::{Scale, Transform};
+use wayland_client::protocol::wl_registry::WlRegistry;
+use wayland_client::protocol::wl_shm::{self, WlShm};
+use wayland_client::protocol::wl_shm_pool::WlShmPool;
+use wayland_client::protocol::wl_surface::WlSurface;
+use wayland_client::{Connection, Dispatch, Proxy as _, QueueHandle};
+
+use super::client::{self, ClientId, LayerConfigureProps};
+use super::*;
+use crate::render_helpers::{render_to_vec, RenderCtx, RenderTarget};
+
+const RED: [u8; 3] = [255, 0, 0];
+const GREEN: [u8; 3] = [0, 255, 0];
+const BLUE: [u8; 3] = [0, 0, 255];
+// DEFAULT_BACKGROUND_COLOR (0.25 gray) as 8-bit values.
+const BACKGROUND: [u8; 3] = [64, 64, 64];
+
+// Inside the hidden layer (top-left, 100 × 100).
+const HIDDEN_PX: (u32, u32) = (50, 50);
+// Inside the visible layer (top-right, 50 × 50).
+const VISIBLE_PX: (u32, u32) = (295, 25);
+
+/// Registry user data for binding extra globals without disturbing the main test registry.
+struct ExtraRegistry;
+
+#[derive(Default)]
+struct FrameData {
+    buffer: Option<(u32, u32, u32)>,
+    ready: bool,
+    failed: bool,
+}
+
+struct Screencopier {
+    shm: WlShm,
+    manager: ZwlrScreencopyManagerV1,
+}
+
+struct Capture {
+    data: Arc<Mutex<FrameData>>,
+    file: File,
+    stride: u32,
+}
+
+impl Capture {
+    fn is_ready(&self) -> bool {
+        let data = self.data.lock().unwrap();
+        assert!(!data.failed, "screencopy failed");
+        data.ready
+    }
+
+    fn pixel(&self, (x, y): (u32, u32)) -> [u8; 3] {
+        // Xrgb8888 is stored as little-endian B, G, R, X.
+        let mut buf = [0; 4];
+        let offset = u64::from(y * self.stride + x * 4);
+        self.file.read_exact_at(&mut buf, offset).unwrap();
+        [buf[2], buf[1], buf[0]]
+    }
+}
+
+fn set_up() -> (Fixture, ClientId, WlSurface, WlSurface) {
+    let config = Config::parse_mem(
+        r#"
+hotkey-overlay {
+    skip-at-startup
+}
+
+layer-rule {
+    match namespace="^emaki-"
+    hide-from-own-screencopy true
+}
+"#,
+    )
+    .unwrap();
+
+    let mut f = Fixture::with_config(config);
+    f.niri_state().backend.headless().add_renderer().unwrap();
+    f.add_output(1, (320, 240));
+
+    let shell = f.add_client();
+    // Matches the rule.
+    let hidden = create_layer(
+        &mut f,
+        shell,
+        "emaki-panel",
+        Anchor::Top | Anchor::Left,
+        100,
+        RED,
+    );
+    // Same client, but doesn't match the rule.
+    let visible = create_layer(
+        &mut f,
+        shell,
+        "dock",
+        Anchor::Top | Anchor::Right,
+        50,
+        GREEN,
+    );
+
+    (f, shell, hidden, visible)
+}
+
+fn create_layer(
+    f: &mut Fixture,
+    id: ClientId,
+    namespace: &str,
+    anchor: Anchor,
+    size: u16,
+    color: [u8; 3],
+) -> WlSurface {
+    let layer = f.client(id).create_layer(None, Layer::Top, namespace);
+    let surface = layer.surface.clone();
+    layer.set_configure_props(LayerConfigureProps {
+        anchor: Some(anchor),
+        size: Some((u32::from(size), u32::from(size))),
+        ..Default::default()
+    });
+    layer.commit();
+    f.roundtrip(id);
+
+    let layer = f.client(id).layer(&surface);
+    attach_color(layer, color);
+    layer.set_size(size, size);
+    layer.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    surface
+}
+
+fn attach_color(layer: &client::LayerSurface, color: [u8; 3]) {
+    let c = |x: u8| u32::from(x) * 0x01010101;
+    let buffer = layer.spbm.create_u32_rgba_buffer(
+        c(color[0]),
+        c(color[1]),
+        c(color[2]),
+        u32::MAX,
+        &layer.qh,
+        (),
+    );
+    layer.surface.attach(Some(&buffer), 0, 0);
+}
+
+fn recolor(f: &mut Fixture, id: ClientId, surface: &WlSurface, color: [u8; 3]) {
+    let layer = f.client(id).layer(surface);
+    attach_color(layer, color);
+    layer.surface.damage_buffer(0, 0, 1, 1);
+    layer.commit();
+    f.roundtrip(id);
+}
+
+fn bind_screencopy(f: &mut Fixture, id: ClientId) -> Screencopier {
+    let client = f.client(id);
+    let registry = client.display.get_registry(&client.qh, ExtraRegistry);
+    let global = |interface: &str| {
+        let global = client
+            .state
+            .globals
+            .iter()
+            .find(|g| g.interface == interface);
+        let global = global.unwrap();
+        (global.name, global.version)
+    };
+
+    let (name, _) = global(WlShm::interface().name);
+    let shm = registry.bind(name, 1, &client.qh, ());
+    let (name, version) = global(ZwlrScreencopyManagerV1::interface().name);
+    let manager = registry.bind(name, version.min(3), &client.qh, ());
+
+    f.roundtrip(id);
+    Screencopier { shm, manager }
+}
+
+fn start_capture(
+    f: &mut Fixture,
+    id: ClientId,
+    screencopier: &Screencopier,
+    with_damage: bool,
+) -> Capture {
+    let client = f.client(id);
+    let output = client.output("headless-1");
+    let data = Arc::new(Mutex::new(FrameData::default()));
+    let frame = screencopier
+        .manager
+        .capture_output(0, &output, &client.qh, data.clone());
+    f.roundtrip(id);
+
+    let (width, height, stride) = data.lock().unwrap().buffer.unwrap();
+    let len = stride * height;
+
+    let fd = unsafe { libc::memfd_create(c"niri-screencopy-test".as_ptr(), libc::MFD_CLOEXEC) };
+    assert!(fd >= 0);
+    let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+    file.set_len(u64::from(len)).unwrap();
+
+    let client = f.client(id);
+    let pool = screencopier
+        .shm
+        .create_pool(file.as_fd(), len as i32, &client.qh, ());
+    let buffer = pool.create_buffer(
+        0,
+        width as i32,
+        height as i32,
+        stride as i32,
+        wl_shm::Format::Xrgb8888,
+        &client.qh,
+        (),
+    );
+    pool.destroy();
+
+    if with_damage {
+        frame.copy_with_damage(&buffer);
+    } else {
+        frame.copy(&buffer);
+    }
+
+    Capture { data, file, stride }
+}
+
+/// Dispatches with output redraws until the capture completes or `max_redraws` is reached.
+fn redraw_until_ready(f: &mut Fixture, id: ClientId, capture: &Capture, max_redraws: usize) {
+    for _ in 0..max_redraws {
+        f.niri().queue_redraw_all();
+        f.double_roundtrip(id);
+        if capture.is_ready() {
+            return;
+        }
+    }
+}
+
+fn copy_output(
+    f: &mut Fixture,
+    id: ClientId,
+    screencopier: &Screencopier,
+    with_damage: bool,
+) -> Capture {
+    let capture = start_capture(f, id, screencopier, with_damage);
+    redraw_until_ready(f, id, &capture, 5);
+    assert!(capture.is_ready(), "screencopy did not complete");
+    capture
+}
+
+/// Renders the output the way niri itself does (no screencopy client) and returns two pixels.
+fn render_pixels(f: &mut Fixture, target: RenderTarget) -> [[u8; 3]; 2] {
+    let output = f.niri_output(1);
+    let state = f.niri_state();
+    let niri = &state.niri;
+    state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let ctx = RenderCtx {
+                renderer,
+                target,
+                xray: None,
+                capture_client: None,
+            };
+            let elements = niri.render_to_vec(ctx, &output, false);
+            let size = output.current_mode().unwrap().size;
+            let pixels = render_to_vec(
+                renderer,
+                size,
+                Scale::from(1.),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap();
+
+            // Abgr8888 is stored as little-endian R, G, B, A.
+            let px = |(x, y): (u32, u32)| {
+                let i = ((y * size.w as u32 + x) * 4) as usize;
+                [pixels[i], pixels[i + 1], pixels[i + 2]]
+            };
+            [px(HIDDEN_PX), px(VISIBLE_PX)]
+        })
+        .unwrap()
+}
+
+#[test]
+fn egl_hide_from_own_screencopy() {
+    let (mut f, shell, _hidden, _visible) = set_up();
+    let other = f.add_client();
+
+    // Normal output rendering and niri's own screen captures are unaffected.
+    assert_eq!(render_pixels(&mut f, RenderTarget::Output), [RED, GREEN]);
+    assert_eq!(
+        render_pixels(&mut f, RenderTarget::ScreenCapture),
+        [RED, GREEN]
+    );
+
+    // Separate managers, since each has its own damage tracker, and a copy without damage would
+    // leave nothing to report for the following copy with damage.
+    for with_damage in [false, true] {
+        // Another client sees the shell as usual.
+        let screencopier = bind_screencopy(&mut f, other);
+        let capture = copy_output(&mut f, other, &screencopier, with_damage);
+        assert_eq!(capture.pixel(HIDDEN_PX), RED);
+        assert_eq!(capture.pixel(VISIBLE_PX), GREEN);
+
+        // The shell itself sees what's underneath its matching layer, but still sees its other
+        // layer.
+        let screencopier = bind_screencopy(&mut f, shell);
+        let capture = copy_output(&mut f, shell, &screencopier, with_damage);
+        assert_eq!(capture.pixel(HIDDEN_PX), BACKGROUND);
+        assert_eq!(capture.pixel(VISIBLE_PX), GREEN);
+    }
+}
+
+#[test]
+fn egl_hidden_layer_does_not_damage_own_screencopy() {
+    let (mut f, shell, hidden, visible) = set_up();
+    let screencopier = bind_screencopy(&mut f, shell);
+
+    // The first with_damage frame is always fully damaged.
+    let capture = copy_output(&mut f, shell, &screencopier, true);
+    assert_eq!(capture.pixel(HIDDEN_PX), BACKGROUND);
+
+    // Changing the hidden layer redraws the output but produces no damage for the shell.
+    let pending = start_capture(&mut f, shell, &screencopier, true);
+    recolor(&mut f, shell, &hidden, BLUE);
+    redraw_until_ready(&mut f, shell, &pending, 5);
+    assert!(
+        !pending.is_ready(),
+        "hidden layer must not damage its own screencopy"
+    );
+    assert_eq!(render_pixels(&mut f, RenderTarget::Output), [BLUE, GREEN]);
+
+    // Changing a non-hidden layer completes the frame.
+    recolor(&mut f, shell, &visible, RED);
+    redraw_until_ready(&mut f, shell, &pending, 5);
+    assert!(pending.is_ready());
+    assert_eq!(pending.pixel(HIDDEN_PX), BACKGROUND);
+    assert_eq!(pending.pixel(VISIBLE_PX), RED);
+}
+
+impl Dispatch<WlRegistry, ExtraRegistry> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &WlRegistry,
+        _event: <WlRegistry as wayland_client::Proxy>::Event,
+        _data: &ExtraRegistry,
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<WlShm, ()> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &WlShm,
+        _event: <WlShm as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<WlShmPool, ()> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &WlShmPool,
+        _event: <WlShmPool as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ZwlrScreencopyManagerV1, ()> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &ZwlrScreencopyManagerV1,
+        _event: <ZwlrScreencopyManagerV1 as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ZwlrScreencopyFrameV1, Arc<Mutex<FrameData>>> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &ZwlrScreencopyFrameV1,
+        event: <ZwlrScreencopyFrameV1 as wayland_client::Proxy>::Event,
+        data: &Arc<Mutex<FrameData>>,
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        let mut data = data.lock().unwrap();
+        match event {
+            zwlr_screencopy_frame_v1::Event::Buffer {
+                width,
+                height,
+                stride,
+                ..
+            } => data.buffer = Some((width, height, stride)),
+            zwlr_screencopy_frame_v1::Event::Ready { .. } => data.ready = true,
+            zwlr_screencopy_frame_v1::Event::Failed => data.failed = true,
+            _ => (),
+        }
+    }
+}
