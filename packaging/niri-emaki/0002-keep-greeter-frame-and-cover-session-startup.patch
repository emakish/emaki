diff --git a/src/backend/tty/keep_frame.rs b/src/backend/tty/keep_frame.rs
new file mode 100644
index 00000000..22e49e2a
--- /dev/null
+++ b/src/backend/tty/keep_frame.rs
@@ -0,0 +1,61 @@
+//! The greeter's final DRM framebuffer must outlive its creating process.
+//!
+//! CLOSEFB (Linux 6.8) drops file ownership without removing a displayed buffer.
+//! The drm 0.14 API has no wrapper yet. This ioctl does not suppress the kernel's
+//! last-DRM-close fbdev restoration; the system handoff setup must do that too.
+
+use std::io;
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+use smithay::reexports::rustix::ioctl::{opcode, Opcode};
+
+#[repr(C)]
+struct DrmModeCloseFb {
+    fb_id: u32,
+    pad: u32,
+}
+
+// DRM_IOWR(0xD0, struct drm_mode_closefb), from drm.h/drm_mode.h. Use
+// rustix's architecture-aware encoding instead of an x86-specific ioctl number.
+const DRM_IOCTL_MODE_CLOSEFB: Opcode = opcode::read_write::<DrmModeCloseFb>(b'd', 0xd0);
+
+pub(super) fn close_framebuffer(fd: BorrowedFd<'_>, framebuffer: u32) -> io::Result<()> {
+    let mut arg = DrmModeCloseFb {
+        fb_id: framebuffer,
+        pad: 0,
+    };
+    // SAFETY: the DRM UAPI expects a pointer to this initialized repr(C), two-u32
+    // structure. The borrowed fd and argument remain alive throughout the call.
+    let result = unsafe { libc::ioctl(fd.as_raw_fd(), DRM_IOCTL_MODE_CLOSEFB as _, &mut arg) };
+    if result < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs::File;
+    use std::os::fd::AsFd;
+
+    use super::*;
+
+    #[test]
+    fn closefb_matches_kernel_abi() {
+        assert_eq!(std::mem::size_of::<DrmModeCloseFb>(), 8);
+        assert_eq!(std::mem::align_of::<DrmModeCloseFb>(), 4);
+        #[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+        assert_eq!(DRM_IOCTL_MODE_CLOSEFB, 0xc00864d0);
+    }
+
+    #[test]
+    fn unsupported_closefb_is_an_error() {
+        // Exercise the actual syscall/error boundary without touching a DRM node.
+        // The caller must preserve normal teardown on this error, including on
+        // kernels predating CLOSEFB.
+        let fd = File::open("/dev/null").unwrap();
+        let error = close_framebuffer(fd.as_fd(), 1).unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::ENOTTY));
+    }
+}
