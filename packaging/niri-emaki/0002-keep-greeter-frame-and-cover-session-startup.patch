+#[test]
+fn egl_session_lock_request_releases_cover_immediately() {
+    use smithay::reexports::wayland_protocols::ext::session_lock::v1::client::{
+        ext_session_lock_manager_v1::ExtSessionLockManagerV1, ext_session_lock_v1::ExtSessionLockV1,
+    };
+    use std::os::unix::net::UnixStream;
+    use wayland_client::protocol::wl_registry::{self, WlRegistry};
+    use wayland_client::{Connection, Dispatch, QueueHandle};
+
+    #[derive(Default)]
+    struct LockClient {
+        manager: Option<ExtSessionLockManagerV1>,
+    }
+    impl Dispatch<WlRegistry, ()> for LockClient {
+        fn event(
+            state: &mut Self,
+            registry: &WlRegistry,
+            event: wl_registry::Event,
+            _: &(),
+            _: &Connection,
+            qh: &QueueHandle<Self>,
+        ) {
+            if let wl_registry::Event::Global {
+                name,
+                interface,
+                version,
+            } = event
+            {
+                if interface == "ext_session_lock_manager_v1" {
+                    state.manager = Some(registry.bind(name, version.min(1), qh, ()));
+                }
+            }
+        }
+    }
+    wayland_client::delegate_noop!(LockClient: ignore ExtSessionLockManagerV1);
+    wayland_client::delegate_noop!(LockClient: ignore ExtSessionLockV1);
+
+    let mut fixture = fixture();
+    // A socket pair exercises the real lock protocol without a listening socket.
+    let (server, client) = UnixStream::pair().unwrap();
+    fixture
+        .niri()
+        .display_handle
+        .insert_client(
+            server,
+            std::sync::Arc::new(crate::niri::ClientState {
+                compositor_state: Default::default(),
+                can_view_decoration_globals: false,
+                primary_selection_disabled: false,
+                restricted: false,
+                credentials_unknown: false,
+            }),
+        )
+        .expect(
+            "Wayland client insertion requires socket access (denied in the restricted sandbox)",
+        );
+    let connection = Connection::from_socket(client).unwrap();
+    let mut queue = connection.new_event_queue::<LockClient>();
+    let qh = queue.handle();
+    let _registry = connection.display().get_registry(&qh, ());
+    let mut client = LockClient::default();
+    let limit = Instant::now() + std::time::Duration::from_secs(2);
+    while client.manager.is_none() {
+        assert!(Instant::now() < limit, "lock global was not delivered");
+        connection.flush().unwrap();
+        fixture.state.server.dispatch();
+        if let Some(guard) = queue.prepare_read() {
+            match guard.read() {
+                Ok(_) => (),
+                Err(wayland_client::backend::WaylandError::Io(err))
+                    if err.kind() == std::io::ErrorKind::WouldBlock =>
+                {
+                    ()
+                }
+                Err(err) => panic!("Wayland read failed: {err}"),
+            }
+        }
+        queue.dispatch_pending(&mut client).unwrap();
+    }
+    let _lock = client.manager.unwrap().lock(&qh, ());
+    connection.flush().unwrap();
+    while fixture.niri().startup_cover_status().active {
+        assert!(
+            Instant::now() < limit,
+            "Niri::lock did not release the cover"
+        );
+        fixture.state.server.dispatch();
+    }
+    assert!(fixture
+        .niri()
+        .startup_cover_layer_expired("emaki-session-cover"));
+    assert!(fixture.niri().startup_cover_timer_finished());
+    assert_eq!(
+        pixels(&mut fixture, 1, RenderTarget::Output),
+        BACKGROUND_PIXEL.repeat(32 * 24)
+    );
+}
