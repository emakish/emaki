+//! A bounded, output-only copy of the greeter's final frame.
+
+use std::ffi::OsString;
+use std::fs::File;
+use std::io::BufReader;
+use std::path::Path;
+use std::sync::mpsc::{self, Receiver};
+use std::time::{Duration, Instant};
+
+use anyhow::{ensure, Context};
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::element::Kind;
+use smithay::backend::renderer::gles::{GlesRenderer, GlesTexture};
+use smithay::backend::renderer::Texture;
+use smithay::output::Output;
+use smithay::utils::{Scale, Transform};
+
+use crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement;
+use crate::render_helpers::texture::{TextureBuffer, TextureRenderElement};
+
+// Eight seconds leaves slow shell startup time while keeping a crashed login bounded.
+// Clients query the remaining duration; they must not restart this budget.
+pub const DEADLINE: Duration = Duration::from_secs(8);
+const MAX_IMAGE_BYTES: usize = 128 * 1024 * 1024;
+
+/// A frozen client cannot retain the replacement PNG after the compositor's deadline.
+/// No guard exists on ordinary starts; the exact namespace is reserved for this handoff.
+#[cfg(test)]
+pub fn client_cover_expired(namespace: &str, deadline: Option<Instant>, now: Instant) -> bool {
+    client_cover_hidden(namespace, deadline, now, true)
+}
+
+/// The reserved replacement surface follows the compositor PNG's capture exclusion,
+/// including interactive captures which otherwise retain Output rendering semantics.
+pub fn client_cover_hidden(
+    namespace: &str,
+    deadline: Option<Instant>,
+    now: Instant,
+    include_startup_cover: bool,
+) -> bool {
+    namespace == "emaki-session-cover"
+        && (!include_startup_cover || deadline.is_some_and(|deadline| now >= deadline))
+}
+
+pub struct StartupCoverLoader {
+    decoded: Receiver<anyhow::Result<DecodedImage>>,
+    deadline: Instant,
+}
+
+struct DecodedImage {
+    rgba: Vec<u8>,
+    size: (i32, i32),
+}
+
+impl StartupCoverLoader {
+    /// `path` is taken out of the environment by main before any children start.
+    pub fn start(path: Option<OsString>, started_at: Instant) -> Option<Self> {
+        let path = path?;
+        let (tx, decoded) = mpsc::sync_channel(1);
+        std::thread::Builder::new()
+            .name("startup-cover".into())
+            .spawn(move || {
+                let _ = tx.send(decode(Path::new(&path)));
+            })
+            .ok()?;
+        Some(Self {
+            decoded,
+            deadline: started_at + DEADLINE,
+        })
+    }
+
+    /// Called before dispatching the event loop, so no output frame can precede the cover.
+    /// Decode and file I/O happen on the worker; even a stuck read cannot delay startup past
+    /// the original deadline. No renderer is sent to the worker thread.
+    pub fn finish(self, renderer: &mut GlesRenderer) -> Option<StartupCover> {
+        let image = match self
+            .decoded
+            .recv_timeout(self.deadline.saturating_duration_since(Instant::now()))
+        {
+            Ok(Ok(image)) if Instant::now() < self.deadline => image,
+            Ok(Err(err)) => {
+                warn!("ignoring invalid startup cover: {err:#}");
+                return None;
+            }
+            _ => return None,
+        };
+        let texture = TextureBuffer::from_memory(
+            renderer,
+            &image.rgba,
+            Fourcc::Abgr8888,
+            image.size,
+            false,
+            1.,
+            Transform::Normal,
+            Vec::new(), // Keep frame callbacks flowing to clients underneath.
+        )
+        .map_err(|err| warn!("error uploading startup cover: {err:?}"))
+        .ok()?;
+        Some(StartupCover {
+            texture,
+            lifetime: Lifetime::new(self.deadline),
+        })
+    }
+}
+
+fn decode(path: &Path) -> anyhow::Result<DecodedImage> {
+    // Checking first also avoids blocking open() on a FIFO. A replacement race is harmless:
+    // the receiver still abandons this worker at the fixed deadline.
+    let metadata = path.metadata()?;
+    ensure!(metadata.is_file(), "startup cover is not a regular file");
+    ensure!(metadata.len() <= MAX_IMAGE_BYTES as u64, "PNG is too large");
+    let file = File::open(path)?;
+    let mut decoder = png::Decoder::new(BufReader::new(file));
+    decoder.set_limits(png::Limits {
+        bytes: MAX_IMAGE_BYTES,
+    });
+    decoder.set_transformations(png::Transformations::EXPAND | png::Transformations::STRIP_16);
+    let mut reader = decoder.read_info().context("reading PNG header")?;
+    let info = reader.info();
+    let pixels = u64::from(info.width) * u64::from(info.height);
+    ensure!(
+        pixels > 0 && pixels <= (MAX_IMAGE_BYTES / 4) as u64,
+        "PNG dimensions too large"
+    );
+    let size = (i32::try_from(info.width)?, i32::try_from(info.height)?);
+    let mut bytes = vec![
+        0;
+        reader
+            .output_buffer_size()
+            .context("PNG buffer size overflow")?
+    ];
+    let info = reader.next_frame(&mut bytes).context("decoding PNG")?;
+    let mut rgba = Vec::with_capacity(pixels as usize * 4);
+    let channels = info.color_type.samples();
+    for pixel in bytes[..info.buffer_size()].chunks_exact(channels) {
+        let [r, g, b, a] = match info.color_type {
+            png::ColorType::Rgba => [pixel[0], pixel[1], pixel[2], pixel[3]],
+            png::ColorType::Rgb => [pixel[0], pixel[1], pixel[2], 255],
+            png::ColorType::Grayscale => [pixel[0], pixel[0], pixel[0], 255],
+            png::ColorType::GrayscaleAlpha => [pixel[0], pixel[0], pixel[0], pixel[1]],
+            png::ColorType::Indexed => unreachable!("EXPAND removes indexed color"),
+        };
+        let premultiply = |v| ((u16::from(v) * u16::from(a) + 127) / 255) as u8;
+        rgba.extend_from_slice(&[premultiply(r), premultiply(g), premultiply(b), a]);
+    }
+    Ok(DecodedImage { rgba, size })
+}
+
+#[derive(Debug)]
+struct Lifetime {
+    deadline: Instant,
+    release: Option<(Instant, Duration)>,
+}
+
+impl Lifetime {
+    fn new(deadline: Instant) -> Self {
+        Self {
+            deadline,
+            release: None,
+        }
+    }
+
+    fn release(&mut self, now: Instant, fade: Duration) {
+        // Repeated requests never extend or restart the fade.
+        self.release.get_or_insert((now, fade));
+    }
+
+    fn lock(&mut self, now: Instant) {
+        // A lock overrides even a previously requested fade.
+        self.release = Some((now, Duration::ZERO));
+    }
+
+    fn alpha(&self, now: Instant) -> f32 {
+        if now >= self.deadline {
+            return 0.;
+        }
+        match self.release {
+            Some((start, fade)) if now >= start + fade => 0.,
+            Some((start, fade)) => {
+                1. - now.saturating_duration_since(start).as_secs_f32() / fade.as_secs_f32()
+            }
+            None => 1.,
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct StartupCover {
+    texture: TextureBuffer<GlesTexture>,
+    lifetime: Lifetime,
+}
+
+impl StartupCover {
+    #[cfg(test)]
+    pub(crate) fn set_deadline(&mut self, deadline: Instant) {
+        self.lifetime.deadline = deadline;
+    }
+
+    pub fn deadline(&self) -> Instant {
+        self.lifetime.deadline
+    }
+
+    pub fn release(&mut self, fade_ms: Option<u16>) {
+        self.lifetime.release(
+            Instant::now(),
+            Duration::from_millis(u64::from(fade_ms.unwrap_or(0))),
+        );
+    }
+
+    pub fn lock(&mut self) {
+        self.lifetime.lock(Instant::now());
+    }
+
+    pub fn is_done(&self) -> bool {
+        self.lifetime.alpha(Instant::now()) <= 0.
+    }
+
+    pub fn is_fading(&self) -> bool {
+        self.lifetime.release.is_some() && !self.is_done()
+    }
+
+    pub fn is_active(&self) -> bool {
+        self.lifetime.release.is_none() && !self.is_done()
+    }
+
+    pub fn matches_output(&self, output: &Output) -> bool {
+        let Some(mode) = output.current_mode() else {
+            return false;
+        };
+        let size = output.current_transform().transform_size(mode.size);
+        let image_size = self.texture.texture().size();
+        image_size.w == size.w && image_size.h == size.h
+    }
+
+    pub fn render(&self, output: &Output) -> Option<PrimaryGpuTextureRenderElement> {
+        let alpha = self.lifetime.alpha(Instant::now());
+        if alpha <= 0. || !self.matches_output(output) {
+            return None;
+        }
+        let mut texture = self.texture.clone();
+        texture.set_texture_scale(Scale::from(output.current_scale().fractional_scale()));
+        // The PNG is already in display orientation; output rendering applies its transform.
+        Some(PrimaryGpuTextureRenderElement(
+            TextureRenderElement::from_texture_buffer(
+                texture,
+                (0., 0.),
+                alpha,
+                None,
+                None,
+                Kind::Unspecified,
+            ),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn frozen_client_cover_expires_without_affecting_normal_layers() {
+        let now = Instant::now();
+        let deadline = now + DEADLINE;
+        assert!(!client_cover_expired("emaki-session-cover", None, deadline));
+        assert!(!client_cover_expired(
+            "emaki-session-cover",
+            Some(deadline),
+            now
+        ));
+        assert!(client_cover_expired(
+            "emaki-session-cover",
+            Some(deadline),
+            deadline
+        ));
+        assert!(!client_cover_expired(
+            "emaki-test-bar",
+            Some(deadline),
+            deadline
+        ));
+    }
+
+    #[test]
+    fn replacement_cover_is_hidden_from_captures_before_and_after_release() {
+        let now = Instant::now();
+        // Texture release leaves the deadline intact; captures must not depend on
+        // texture presence, capture-client identity or hide-from-own-screencopy.
+        for deadline in [None, Some(now + DEADLINE), Some(now)] {
+            assert!(client_cover_hidden(
+                "emaki-session-cover",
+                deadline,
+                now,
+                false
+            ));
+            assert!(!client_cover_hidden("emaki-bar", deadline, now, false));
+        }
+        assert!(!client_cover_hidden(
+            "emaki-session-cover",
+            Some(now + DEADLINE),
+            now,
+            true
+        ));
+        assert!(client_cover_hidden(
+            "emaki-session-cover",
+            Some(now),
+            now,
+            true
+        ));
+    }
+
+    #[test]
+    fn no_environment_means_no_cover() {
+        assert!(StartupCoverLoader::start(None, Instant::now()).is_none());
+    }
+
+    #[test]
+    fn release_is_idempotent() {
+        let now = Instant::now();
+        let mut lifetime = Lifetime::new(now + DEADLINE);
+        lifetime.release(now, Duration::from_millis(100));
+        lifetime.release(now + Duration::from_millis(50), Duration::from_secs(3));
+        assert_eq!(lifetime.alpha(now + Duration::from_millis(50)), 0.5);
+        assert_eq!(lifetime.alpha(now + Duration::from_millis(100)), 0.);
+        lifetime.release(now + Duration::from_secs(1), Duration::from_secs(3));
+        assert_eq!(lifetime.alpha(now + Duration::from_secs(1)), 0.);
+    }
+
+    #[test]
+    fn deadline_fires_even_during_fade() {
+        let now = Instant::now();
+        let mut lifetime = Lifetime::new(now + DEADLINE);
+        assert_eq!(lifetime.alpha(now + DEADLINE - Duration::from_nanos(1)), 1.);
+        assert_eq!(lifetime.alpha(now + DEADLINE), 0.);
+        lifetime.release(now + Duration::from_secs(3), Duration::from_secs(3));
+        assert!(lifetime.alpha(now + Duration::from_millis(3500)) > 0.);
+        assert_eq!(lifetime.alpha(now + DEADLINE), 0.);
+    }
+
+    #[test]
+    fn lock_releases_immediately() {
+        let now = Instant::now();
+        let mut lifetime = Lifetime::new(now + DEADLINE);
+        lifetime.release(now, Duration::from_secs(2));
+        lifetime.lock(now + Duration::from_millis(10));
+        assert_eq!(lifetime.alpha(now + Duration::from_millis(10)), 0.);
+    }
+
+    #[test]
+    fn missing_or_invalid_png_is_ignored() {
+        assert!(decode(Path::new("/nonexistent-emaki-startup-cover.png")).is_err());
+        assert!(decode(Path::new("/dev/null")).is_err());
+    }
+}
