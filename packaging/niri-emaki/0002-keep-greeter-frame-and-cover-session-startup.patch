+//! Rendering and action integration for the compositor's bounded login cover.
+
+use std::fs::File;
+use std::time::Instant;
+
+use niri_config::{Action, Config};
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::element::Element;
+use smithay::utils::{Scale, Transform};
+
+use super::Fixture;
+use crate::render_helpers::{render_to_vec, RenderCtx, RenderTarget};
+use crate::ui::startup_cover::StartupCoverLoader;
+
+const COVER_PIXEL: [u8; 4] = [173, 91, 37, 255];
+const BACKGROUND_PIXEL: [u8; 4] = [64, 64, 64, 255];
+
+fn fixture() -> Fixture {
+    fixture_with_deadline(None)
+}
+
+fn fixture_with_deadline(deadline: Option<std::time::Duration>) -> Fixture {
+    let config = Config::parse_mem("hotkey-overlay { skip-at-startup; }").unwrap();
+    let mut fixture = Fixture::with_config(config);
+    fixture
+        .niri_state()
+        .backend
+        .headless()
+        .add_renderer()
+        .unwrap();
+    fixture.add_output(1, (32, 24));
+    fixture.add_output(2, (40, 30));
+
+    let shell = xshell::Shell::new().unwrap();
+    let directory = shell.create_temp_dir().unwrap();
+    let path = directory.path().join("cover.png");
+    let mut encoder = png::Encoder::new(File::create(&path).unwrap(), 32, 24);
+    encoder.set_color(png::ColorType::Rgba);
+    let mut writer = encoder.write_header().unwrap();
+    writer
+        .write_image_data(&COVER_PIXEL.repeat(32 * 24))
+        .unwrap();
+    writer.finish().unwrap();
+
+    let loader = StartupCoverLoader::start(Some(path.into_os_string()), Instant::now()).unwrap();
+    let state = fixture.niri_state();
+    let mut cover = state
+        .backend
+        .with_primary_renderer(|renderer| loader.finish(renderer))
+        .flatten()
+        .unwrap();
+    if let Some(duration) = deadline {
+        cover.set_deadline(Instant::now() + duration);
+    }
+    state.niri.install_startup_cover(cover);
+    fixture
+}
+
+fn pixels(fixture: &mut Fixture, output_index: u8, target: RenderTarget) -> Vec<u8> {
+    let output = fixture.niri_output(output_index);
+    let state = fixture.niri_state();
+    state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let ctx = RenderCtx {
+                renderer,
+                target,
+                xray: None,
+                capture_client: None,
+            };
+            let elements = state.niri.render_to_vec(ctx, &output, false);
+            if target == RenderTarget::Output
+                && output_index == 1
+                && state.niri.startup_cover_status().active
+            {
+                assert!(elements[0].opaque_regions(Scale::from(1.)).is_empty());
+            }
+            render_to_vec(
+                renderer,
+                output.current_mode().unwrap().size,
+                Scale::from(1.),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap()
+        })
+        .unwrap()
+}
+
+#[test]
+fn egl_startup_cover_is_output_only_and_size_checked() {
+    let mut fixture = fixture();
+    let status = fixture.niri().startup_cover_status();
+    assert!(status.active);
+    assert!(status.remaining_ms > 0 && status.remaining_ms <= 8000);
+    assert_eq!(status.outputs, ["headless-1"]);
+    assert_eq!(
+        pixels(&mut fixture, 1, RenderTarget::Output),
+        COVER_PIXEL.repeat(32 * 24)
+    );
+    for target in [RenderTarget::ScreenCapture, RenderTarget::Screencast] {
+        assert_eq!(
+            pixels(&mut fixture, 1, target),
+            BACKGROUND_PIXEL.repeat(32 * 24)
+        );
+    }
+    assert_eq!(
+        pixels(&mut fixture, 2, RenderTarget::Output),
+        BACKGROUND_PIXEL.repeat(40 * 30)
+    );
+
+    // A screen transition must not preserve the startup PNG beyond its lifetime.
+    let state = fixture.niri_state();
+    state
+        .backend
+        .with_primary_renderer(|renderer| state.niri.do_screen_transition(renderer, Some(0)));
+    fixture
+        .niri_state()
+        .do_action(Action::EmakiStartupCoverRelease(None), false);
+    fixture
+        .niri_state()
+        .do_action(Action::EmakiStartupCoverRelease(Some(1000)), false);
+    assert!(!fixture.niri().startup_cover_status().active);
+    // Releasing the compositor texture does not disable the client-layer deadline.
+    assert!(!fixture
+        .niri()
+        .startup_cover_layer_expired("emaki-session-cover"));
+    assert_eq!(
+        pixels(&mut fixture, 1, RenderTarget::Output),
+        BACKGROUND_PIXEL.repeat(32 * 24)
+    );
+}
+
+#[test]
+fn startup_cover_action_parses_from_config_and_ipc() {
+    let config = Config::parse_mem(
+        r#"binds {
+            Mod+A { emaki-startup-cover-release; }
+            Mod+B { emaki-startup-cover-release fade-ms=150; }
+        }"#,
+    )
+    .unwrap();
+    assert_eq!(
+        config.binds.0[0].action,
+        Action::EmakiStartupCoverRelease(None)
+    );
+    assert_eq!(
+        config.binds.0[1].action,
+        Action::EmakiStartupCoverRelease(Some(150))
+    );
+    let action: niri_ipc::Action =
+        serde_json::from_str(r#"{"EmakiStartupCoverRelease":{"fade_ms":150}}"#).unwrap();
+    assert_eq!(
+        Action::from(action),
+        Action::EmakiStartupCoverRelease(Some(150))
+    );
+    let action: niri_ipc::Action =
+        serde_json::from_str(r#"{"EmakiStartupCoverRelease":{}}"#).unwrap();
+    assert_eq!(Action::from(action), Action::EmakiStartupCoverRelease(None));
+}
+
+#[test]
+fn egl_interactive_captures_omit_the_cover() {
+    use crate::input::pick_color_grab::PickColorGrab;
+
+    let mut fixture = fixture();
+    let output = fixture.niri_output(1);
+    let state = fixture.niri_state();
+    state.backend.with_primary_renderer(|renderer| {
+        let screenshots = state.niri.capture_screenshots(renderer).collect();
+        assert!(state
+            .niri
+            .screenshot_ui
+            .open(renderer, screenshots, output, false, None,));
+        let (size, pixels) = state.niri.screenshot_ui.capture(renderer).unwrap();
+        assert_eq!(pixels, BACKGROUND_PIXEL.repeat((size.w * size.h) as usize));
+        state.niri.screenshot_ui.close();
+    });
+    let color = PickColorGrab::pick_color_at_point((10., 10.).into(), fixture.niri_state())
+        .expect("color under cover");
+    assert_eq!(color.rgb, [64. / 255.; 3]);
+    assert!(fixture.niri().startup_cover_status().active);
+}
+
+#[test]
+fn egl_critical_ui_is_above_the_cover() {
+    let mut fixture = fixture();
+    fixture.niri().config_error_notification.show();
+    fixture.niri_complete_animations();
+    let output = fixture.niri_output(1);
+    let state = fixture.niri_state();
+    state.backend.with_primary_renderer(|renderer| {
+        let notification = state
+            .niri
+            .config_error_notification
+            .render(renderer, &output)
+            .unwrap();
+        let elements = state.niri.render_to_vec(
+            RenderCtx {
+                renderer,
+                target: RenderTarget::Output,
+                xray: None,
+                capture_client: None,
+            },
+            &output,
+            false,
+        );
+        assert_eq!(elements[0].id(), notification.id());
+    });
+    assert!(fixture.niri().exit_confirm_dialog.show());
+    fixture.niri_complete_animations();
+    let state = fixture.niri_state();
+    state.backend.with_primary_renderer(|renderer| {
+        let mut dialog_ids = Vec::new();
+        state
+            .niri
+            .exit_confirm_dialog
+            .render(renderer, &output, &mut |elem| {
+                dialog_ids.push(elem.id().clone());
+            });
+        assert!(!dialog_ids.is_empty());
+        let elements = state.niri.render_to_vec(
+            RenderCtx {
+                renderer,
+                target: RenderTarget::Output,
+                xray: None,
+                capture_client: None,
+            },
+            &output,
+            false,
+        );
+        // The dialog texture is uploaded anew on each render; its backdrop has a stable ID.
+        assert_eq!(elements[1].id(), &dialog_ids[1]);
+    });
+}
+
+#[test]
+fn egl_calloop_deadline_removes_texture_and_redraws_after_client_takeover() {
+    for release_first in [false, true] {
+        let mut fixture = fixture_with_deadline(Some(std::time::Duration::from_millis(30)));
+        // Clear initial redraw flags so this also checks the actual callback queues damage.
+        for state in fixture.niri().output_state.values_mut() {
+            state.redraw_state = crate::niri::RedrawState::Idle;
+        }
+        if release_first {
+            fixture.niri().release_startup_cover(None);
+            for state in fixture.niri().output_state.values_mut() {
+                state.redraw_state = crate::niri::RedrawState::Idle;
+            }
+        }
+        let server = &mut fixture.state.server;
+        let limit = Instant::now() + std::time::Duration::from_secs(2);
+        while !server.state.niri.startup_cover_timer_finished() {
+            assert!(
+                Instant::now() < limit,
+                "calloop startup-cover timer did not fire"
+            );
+            server
+                .event_loop
+                .dispatch(std::time::Duration::from_millis(50), &mut server.state)
+                .unwrap();
+        }
+        assert!(fixture
+            .niri()
+            .startup_cover_layer_expired("emaki-session-cover"));
+        assert!(!fixture.niri().startup_cover_status().active);
+        assert!(fixture
+            .niri()
+            .output_state
+            .values()
+            .all(|state| { !matches!(state.redraw_state, crate::niri::RedrawState::Idle) }));
+        assert_eq!(
+            pixels(&mut fixture, 1, RenderTarget::Output),
+            BACKGROUND_PIXEL.repeat(32 * 24)
+        );
+    }
+}
