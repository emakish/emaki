 impl XCursor {
+    /// Use the same physical hotspot and rounding for drawing and output overlap.
+    pub fn physical_position(
+        &self,
+        frame: &Image,
+        pointer: Point<f64, Logical>,
+        output_scale: f64,
+    ) -> Point<i32, Physical> {
+        if self.fallback {
+            let hotspot = Self::hotspot(frame).to_logical(output_scale.ceil() as i32);
+            (pointer - hotspot.to_f64()).to_physical_precise_round(output_scale)
+        } else {
+            (pointer.to_physical(output_scale) - Self::hotspot(frame).to_f64()).to_i32_round()
+        }
+    }
