+    #[test]
+    fn nominal_sizes_and_decoded_cache_keys() {
+        let manager = CursorManager {
+            theme: CursorTheme::load("default"),
+            size: 24,
+            current_cursor: CursorImageStatus::default_named(),
+            named_cursor_cache: Default::default(),
+        };
+        for (scale, size) in [
+            (1., 24),
+            (1.25, 30),
+            (1.5, 36),
+            (1.75, 42),
+            (2., 48),
+            (3., 72),
+        ] {
+            assert_eq!(nominal_size(24, scale), size);
+            let cursor = Rc::new(synthetic_cursor(size, size as u32, size as u32));
+            manager
+                .named_cursor_cache
+                .borrow_mut()
+                .get_or_insert_with((CursorIcon::Default, size), || Some(cursor.clone()));
+            let RenderCursor::Named {
+                size: actual,
+                cursor: loaded,
+                ..
+            } = manager.get_render_cursor(scale)
+            else {
+                panic!("expected named cursor");
+            };
+            assert_eq!(actual, size);
+            assert!(Rc::ptr_eq(&loaded, &cursor));
+        }
+        // Nearby scales requesting the same nominal size share the decoded entry.
+        assert!(Rc::ptr_eq(
+            &manager.get_default_cursor(1.25),
+            &manager.get_default_cursor(1.251)
+        ));
+        assert_eq!(manager.named_cursor_cache.borrow().0.len(), 6);
+        assert_eq!(nominal_size(25, 1.5), 38);
+        assert_eq!(nominal_size(0, 1.), 1);
+    }
