+    fn legacy_element(
+        renderer: &mut GlesRenderer,
+        cursor: &XCursor,
+        pointer: Point<f64, Logical>,
+        scale: f64,
+    ) -> MemoryRenderBufferRenderElement<GlesRenderer> {
+        let frame = &cursor.images[0];
+        let integer_scale = scale.ceil() as i32;
+        let buffer = MemoryRenderBuffer::from_slice(
+            &frame.pixels_rgba,
+            Fourcc::Argb8888,
+            (frame.width as i32, frame.height as i32),
+            integer_scale,
+            Transform::Normal,
+            None,
+        );
+        let hotspot = XCursor::hotspot(frame).to_logical(integer_scale);
+        let position = (pointer - hotspot.to_f64()).to_physical_precise_round(scale);
+        MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            position,
+            &buffer,
+            None,
+            None,
+            None,
+            Kind::Cursor,
+        )
+        .unwrap()
+    }
