+    fn synthetic_cursor(size: i32, width: u32, height: u32) -> XCursor {
+        // BGRA (Argb8888), with one-pixel stripes and an asymmetric corner.
+        let pixels = (0..height)
+            .flat_map(|y| {
+                (0..width).flat_map(move |x| {
+                    if (x + y) % 2 == 0 || (x == 0 && y < 3) {
+                        [19, 53, 231, 255]
+                    } else {
+                        [211, 173, 37, 255]
+                    }
+                })
+            })
+            .collect();
+        XCursor {
+            images: vec![Image {
+                size: size as u32,
+                width,
+                height,
+                xhot: 4,
+                yhot: 6,
+                delay: 0,
+                pixels_rgba: pixels,
+                pixels_argb: vec![],
+            }],
+            animation_duration: 0,
+            fallback: false,
+        }
+    }
+
+    fn renderer() -> GlesRenderer {
+        unsafe {
+            let display = EGLDisplay::new(EGLSurfacelessDisplay).unwrap();
+            let context = EGLContext::new(&display).unwrap();
+            GlesRenderer::new(context).unwrap()
+        }
+    }
