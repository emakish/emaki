+    fn get_or_insert_with(&mut self, key: CursorKey, make: impl FnOnce() -> V) -> &mut V {
+        if let Some(index) = self.0.iter().position(|(k, _)| *k == key) {
+            let entry = self.0.remove(index).unwrap();
