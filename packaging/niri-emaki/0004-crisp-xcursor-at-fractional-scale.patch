+/// A named cursor whose geometry and damage are measured in physical pixels.
+///
+/// Upload at buffer scale 1 and ask the inner element for scale-1 geometry. This
+/// avoids both filtering and integer logical-size truncation, including odd image
+/// dimensions. The built-in fallback alone retains its legacy geometry.
+#[derive(Debug)]
+pub struct CursorRenderElement<R: Renderer> {
+    inner: MemoryRenderBufferRenderElement<R>,
+    scale: Scale<f64>,
+    output_scale: Scale<f64>,
+}
+
+impl<R: Renderer + ImportMem> CursorRenderElement<R>
+where
+    R::TextureId: Send + Clone + 'static,
+{
+    pub fn new(
+        renderer: &mut R,
+        pointer: Point<f64, Logical>,
+        output_scale: f64,
+        buffer: &MemoryRenderBuffer,
+        cursor: &XCursor,
+        frame: &Image,
+    ) -> Result<Self, R::Error> {
+        let position = cursor.physical_position(frame, pointer, output_scale);
+        let (src, size, scale) = if cursor.fallback {
+            // Match the old buffer-scale = ceil(output_scale) path, including
+            // its integer hotspot and image-size division.
+            let integer_scale = output_scale.ceil() as i32;
+            let size = Size::<i32, Buffer>::from((frame.width as i32, frame.height as i32))
+                .to_logical(integer_scale, Transform::Normal);
+            let src = Rectangle::from_size(size.to_f64().upscale(integer_scale as f64));
+            (Some(src), Some(size), output_scale)
+        } else {
+            (None, None, 1.)
+        };
+        let inner = MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            position.to_f64(),
+            buffer,
+            None,
+            src,
+            size,
+            Kind::Cursor,
+        )?;
+        Ok(Self {
+            inner,
+            scale: scale.into(),
+            output_scale: output_scale.into(),
+        })
+    }
+}
+
+impl<R: Renderer> Element for CursorRenderElement<R> {
+    fn id(&self) -> &Id {
+        self.inner.id()
+    }
+
+    fn current_commit(&self) -> CommitCounter {
+        self.inner.current_commit()
+    }
+
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        self.inner.src()
+    }
+
+    fn geometry(&self, scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        debug_assert_eq!(scale, self.output_scale);
+        self.inner.geometry(self.scale)
+    }
+
+    fn damage_since(
+        &self,
+        scale: Scale<f64>,
+        commit: Option<CommitCounter>,
+    ) -> DamageSet<i32, Physical> {
+        debug_assert_eq!(scale, self.output_scale);
+        self.inner.damage_since(self.scale, commit)
+    }
+
+    fn opaque_regions(&self, scale: Scale<f64>) -> OpaqueRegions<i32, Physical> {
+        debug_assert_eq!(scale, self.output_scale);
+        self.inner.opaque_regions(self.scale)
+    }
+
+    fn transform(&self) -> Transform {
+        self.inner.transform()
+    }
+
+    fn alpha(&self) -> f32 {
+        self.inner.alpha()
+    }
+
+    fn kind(&self) -> Kind {
+        self.inner.kind()
+    }
+}
