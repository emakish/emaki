+        let mut cache = CursorCache::default();
+        for size in 1..=MAX_CURSOR_CACHE_ENTRIES as i32 {
+            cache.get_or_insert_with((CursorIcon::Default, size), || size);
+        }
+        cache.get_or_insert_with((CursorIcon::Default, 1), || panic!("cache miss"));
+        cache.get_or_insert_with((CursorIcon::Default, 999), || 999);
+        assert_eq!(cache.0.len(), MAX_CURSOR_CACHE_ENTRIES);
