+            let cursor = Rc::new(cursor);
+            let frame = &cursor.images[0];
+            for pointer in [(20.3, 17.7), (0.3, 1.7)] {
+                let pointer: Point<f64, Logical> = pointer.into();
+                let buffer = cache.get(CursorIcon::Default, size, &cursor, 0);
+                let element = CursorRenderElement::new(
+                    &mut renderer,
+                    pointer,
+                    scale,
+                    &buffer,
+                    &cursor,
+                    frame,
+                )
+                .unwrap();
+                let x0 = (pointer.x * scale - frame.xhot as f64).round() as i32;
+                let y0 = (pointer.y * scale - frame.yhot as f64).round() as i32;
+                assert_eq!(
+                    element.geometry(scale.into()),
+                    Rectangle::new(
+                        (x0, y0).into(),
+                        (frame.width as i32, frame.height as i32).into()
+                    )
+                );
+                assert_eq!(
+                    element.src().size,
+                    (frame.width as f64, frame.height as f64).into()
+                );
+                assert_eq!(
+                    element.damage_since(scale.into(), None).as_ref(),
+                    &[Rectangle::from_size(
+                        (frame.width as i32, frame.height as i32).into()
+                    )]
+                );
+                let actual = render_to_vec(
+                    &mut renderer,
+                    (160, 160).into(),
+                    scale.into(),
+                    Transform::Normal,
+                    Fourcc::Abgr8888,
+                    [element].into_iter(),
+                )
+                .unwrap();
+                for y in 0..160i32 {
+                    for x in 0..160i32 {
+                        let (sx, sy) = (x - x0, y - y0);
+                        let expected = if (0..frame.width as i32).contains(&sx)
+                            && (0..frame.height as i32).contains(&sy)
+                        {
+                            let offset = (sy as usize * frame.width as usize + sx as usize) * 4;
+                            let bgra = &frame.pixels_rgba[offset..offset + 4];
+                            [bgra[2], bgra[1], bgra[0], bgra[3]]
+                        } else {
+                            [0; 4]
+                        };
+                        let offset = (y as usize * 160 + x as usize) * 4;
+                        assert_eq!(
+                            &actual[offset..offset + 4],
+                            &expected,
+                            "scale {scale}, pointer {pointer:?}, pixel {x},{y}"
+                        );
+                    }
+                }
+                if scale == 2. {
+                    let old = legacy_element(&mut renderer, &cursor, pointer, scale);
+                    let expected = render_to_vec(
+                        &mut renderer,
+                        (160, 160).into(),
+                        scale.into(),
+                        Transform::Normal,
+                        Fourcc::Abgr8888,
+                        [old].into_iter(),
+                    )
+                    .unwrap();
+                    assert_eq!(actual, expected);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn fallback_pixels_match_legacy_path() {
+        let mut renderer = renderer();
+        let cache = CursorTextureCache::default();
+        let cursor = Rc::new(CursorManager::fallback_cursor());
+        let pointer = (17.3, 19.7).into();
+        for scale in [1., 1.25, 1.5, 2., 3.] {
+            let buffer = cache.get(CursorIcon::Default, nominal_size(24, scale), &cursor, 0);
+            let new = CursorRenderElement::new(
+                &mut renderer,
+                pointer,
+                scale,
+                &buffer,
+                &cursor,
+                &cursor.images[0],
+            )
+            .unwrap();
+            let old = legacy_element(&mut renderer, &cursor, pointer, scale);
+            assert_eq!(new.geometry(scale.into()), old.geometry(scale.into()));
+            assert_eq!(new.src(), old.src());
+            let new = render_to_vec(
+                &mut renderer,
+                (160, 160).into(),
+                scale.into(),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                [new].into_iter(),
+            )
+            .unwrap();
+            let old = render_to_vec(
+                &mut renderer,
+                (160, 160).into(),
+                scale.into(),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                [old].into_iter(),
+            )
+            .unwrap();
+            assert_eq!(new, old, "scale {scale}");
+        }
+    }
+
+    #[test]
+    fn animation_frame_timing_is_unchanged() {
+        let mut cursor = synthetic_cursor(30, 30, 30);
+        cursor.images[0].delay = 20;
+        let mut second = cursor.images[0].clone();
+        second.delay = 30;
+        cursor.images.push(second);
+        cursor.animation_duration = 50;
+        assert!(cursor.is_animated_cursor());
+        for (time, index) in [(0, 0), (19, 0), (20, 1), (49, 1), (50, 0), (70, 1)] {
+            assert_eq!(cursor.frame(time).0, index);
+        }
+    }
+}
