+    use crate::backend::tty::{
+        calculate_drm_mode_from_modeline, calculate_mode_cvt, primary_renderer_missing,
+    };
+
+    #[test]
+    fn emaki_no_primary_renderer_only_when_the_primary_gpu_was_listed_at_start() {
+        // Listed and its renderer created: niri runs.
+        assert!(!primary_renderer_missing(true, true));
+        // Listed, but adding it created no renderer (software EGL, failed driver): exit status 3.
+        assert!(primary_renderer_missing(true, false));
+        // Not in the list taken at start: the GPU registered after the list was taken and before
+        // the primary GPU was picked. Its udev "added" event still initializes the renderer, so
+        // init must not report it missing.
+        assert!(
+            !primary_renderer_missing(false, false),
+            "a primary GPU that registered after the device list was taken counts as missing"
+        );
+    }
 
