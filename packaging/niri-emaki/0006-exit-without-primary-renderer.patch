+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::rc::Rc;
+    use std::time::Duration;
+
+    use calloop::timer::{TimeoutAction, Timer};
+    use calloop::EventLoop;
+    use niri_config::Config;
+    use smithay::reexports::wayland_server::Display;
+
+    use crate::niri::State;
+
+    /// Sets its flag when dropped.
+    struct DropFlag(Rc<Cell<bool>>);
+    impl Drop for DropFlag {
+        fn drop(&mut self) {
+            self.0.set(true);
+        }
+    }
+
+    /// main() answers `NoPrimaryRenderer` by dropping the event loop before it exits: the libseat
+    /// session lives in its notifier, which `Tty::new` inserts into the loop as a source, and
+    /// only dropping that source closes the seat. A source stands in for the notifier here, and
+    /// the compositor state is built as in main(), on the headless backend.
+    #[test]
+    fn emaki_no_primary_renderer_exit_drops_the_session_notifier_with_the_event_loop() {
+        let event_loop = EventLoop::<State>::try_new().unwrap();
+        let dropped = Rc::new(Cell::new(false));
+        let notifier = DropFlag(dropped.clone());
+        event_loop
+            .handle()
+            .insert_source(
+                Timer::from_duration(Duration::from_secs(3600)),
+                move |_, _, _| {
+                    let _notifier = &notifier;
+                    TimeoutAction::Drop
+                },
+            )
+            .unwrap();
+        let state = State::new(
+            Config::default(),
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            true,
+            false,
+        )
+        .unwrap();
+        // What State::new's error return drops: the backend and Niri. The session stays open.
+        drop(state);
+        assert!(
+            !dropped.get(),
+            "the notifier is not owned by the compositor state"
+        );
+        drop(event_loop);
+        assert!(
+            dropped.get(),
+            "a source outlived the event loop: something State::new built keeps the loop alive"
+        );
+    }
+}
