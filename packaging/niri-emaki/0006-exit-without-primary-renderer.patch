+/// Whether [`Tty::init`] ends without the primary renderer for good: the primary GPU was in the
+/// device list taken at start and adding it created no renderer.
+///
+/// `Tty::new` takes the device list before it picks the primary GPU. A GPU that registers in
+/// between can become the primary one without being in the list; like stock niri, init then
+/// waits for its udev "added" event, which initializes the renderer.
+fn primary_renderer_missing(primary_listed: bool, primary_renderer: bool) -> bool {
+    primary_listed && !primary_renderer
+}
