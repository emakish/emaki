+/// The TTY backend started on an active session, found the primary GPU among its devices, and
+/// got no primary renderer from it.
+///
+/// niri exits with [`NoPrimaryRenderer::EXIT_STATUS`] instead of idling with no output.
+#[derive(Debug)]
+pub struct NoPrimaryRenderer;
+
+impl NoPrimaryRenderer {
+    pub const EXIT_STATUS: i32 = 3;
+}
+
+impl std::fmt::Display for NoPrimaryRenderer {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("no primary GPU renderer (software EGL rejected or driver failed)")
+    }
+}
+
+impl std::error::Error for NoPrimaryRenderer {}
+
 #[allow(clippy::large_enum_variant)]
 pub enum Backend {
     Tty(Tty),
@@ -55,13 +74,18 @@ impl OutputId {
 }
 
 impl Backend {
-    pub fn init(&mut self, niri: &mut Niri) {
+    pub fn init(&mut self, niri: &mut Niri) -> Result<(), NoPrimaryRenderer> {
         let _span = tracy_client::span!("Backend::init");
         match self {
-            Backend::Tty(tty) => tty.init(niri),
+            Backend::Tty(tty) => {
+                if !tty.init(niri) {
+                    return Err(NoPrimaryRenderer);
+                }
+            }
             Backend::Winit(winit) => winit.init(niri),
             Backend::Headless(headless) => headless.init(niri),
         }
+        Ok(())
     }
 
     pub fn seat_name(&self) -> String {
@@ -233,3 +257,67 @@ impl Backend {
         }
     }
 }
