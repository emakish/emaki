+// Only the trusted shell's fullscreen inset marker opts into fullscreen reservation. The
+// marker carries the inset as its requested height and reserves no working area, so entering
+// or leaving fullscreen never resizes other windows. The same namespace from any other client,
+// and every other layer surface, including the panel and the dock, keep upstream fullscreen.
+pub(super) fn fullscreen_inset_marker(
+    namespace: &str,
+    trusted: bool,
+    mapped: bool,
+    state: &LayerSurfaceCachedState,
+) -> f64 {
+    if namespace != "emaki-fullscreen-inset"
+        || !trusted
+        || !mapped
+        || !state.anchor.contains(Anchor::TOP)
+        || state.anchor.contains(Anchor::BOTTOM)
+    {
+        return 0.;
+    }
+    (f64::from(state.size.h) + f64::from(state.margin.top)).max(0.)
+}
+
+fn compute_fullscreen_top_inset(output: &Output) -> f64 {
+    let map = layer_map_for_output(output);
+    let inset = map
+        .layers()
+        .map(|surface| {
+            fullscreen_inset_marker(
+                surface.namespace(),
+                crate::trusted_prompt::client_is_trusted(surface.wl_surface()),
+                is_mapped(surface.wl_surface()),
+                &surface.cached_state(),
+            )
+        })
+        .fold(0., f64::max);
+    let height = output_size(output).h;
+    let scale = output.current_scale().fractional_scale();
+    let inset = inset.min((height - 1.).max(0.));
+    round_logical_in_physical(scale, inset)
+}
+
 pub(super) fn compute_working_area(output: &Output) -> Rectangle<f64, Logical> {
     layer_map_for_output(output).non_exclusive_zone().to_f64()
 }
