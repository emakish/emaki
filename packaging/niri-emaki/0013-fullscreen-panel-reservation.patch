+const EMAKI_INSET_MARKER: &str = "emaki-fullscreen-inset";
+
+fn emaki_map_inset_marker(f: &mut Fixture, id: ClientId, height: i32) -> WlSurface {
+    let layer = f
+        .client(id)
+        .create_layer(None, Layer::Overlay, EMAKI_INSET_MARKER);
+    let marker = layer.surface.clone();
+    layer.set_configure_props(LayerConfigureProps {
+        anchor: Some(Anchor::Top | Anchor::Left),
+        size: Some((1, height.try_into().unwrap())),
+        exclusive_zone: Some(-1),
+        ..Default::default()
+    });
+    layer.commit();
+    f.double_roundtrip(id);
+    let layer = f.client(id).layer(&marker);
+    layer.attach_new_buffer();
+    layer.set_size(1, height.try_into().unwrap());
+    layer.ack_last_and_commit();
+    f.double_roundtrip(id);
+    marker
+}
+
+fn emaki_assert_fullscreen_inset(f: &mut Fixture, app: ClientId, surface: &WlSurface, inset: i32) {
+    let window = f.client(app).window(surface);
+    assert_eq!(
+        window.configures_received.last().unwrap().1.size,
+        (1920, 1080 - inset)
+    );
+    window.set_size(1920, (1080 - inset).try_into().unwrap());
+    window.ack_last_and_commit();
+    f.double_roundtrip(app);
+    f.niri_complete_animations();
+    let ws = f.niri().layout.active_workspace().unwrap();
+    let (tile, pos, _) = ws.tiles_with_render_positions().next().unwrap();
+    assert_eq!((pos.x, pos.y), (0., f64::from(inset)));
+    assert_eq!(
+        (tile.tile_size().w, tile.tile_size().h),
+        (1920., f64::from(1080 - inset))
+    );
+    let (_, ipc) = ws.tiles_with_ipc_layouts().next().unwrap();
+    assert_eq!(
+        ipc.tile_pos_in_workspace_view,
+        (inset > 0).then_some((0., f64::from(inset)))
+    );
+}
