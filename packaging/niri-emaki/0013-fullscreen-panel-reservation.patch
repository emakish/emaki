+#[test]
+fn emaki_fullscreen_panel_preserves_normal_and_maximized_geometry() {
+    for maximized in [false, true] {
+        let (mut baseline, baseline_window, _clock) = setup(0., 1.);
+        let (mut inset, inset_window, _inset_clock) = setup(40., 1.);
+        if maximized {
+            baseline.set_maximized(baseline_window.id(), true);
+            inset.set_maximized(inset_window.id(), true);
+            settle(&mut baseline, &baseline_window);
+            settle(&mut inset, &inset_window);
+        }
+        assert_eq!(
+            baseline_window.0.requested_size.get(),
+            inset_window.0.requested_size.get()
+        );
+        let (baseline_tile, baseline_pos, _) =
+            baseline.tiles_with_render_positions().next().unwrap();
+        let (inset_tile, inset_pos, _) = inset.tiles_with_render_positions().next().unwrap();
+        assert_eq!(baseline_pos, inset_pos);
+        assert_eq!(baseline_tile.tile_size(), inset_tile.tile_size());
+        assert_eq!(
+            inset
+                .tiles_with_ipc_layouts()
+                .next()
+                .unwrap()
+                .1
+                .tile_pos_in_workspace_view,
+            None
+        );
+    }
+}
