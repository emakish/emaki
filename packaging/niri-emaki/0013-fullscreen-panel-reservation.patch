+#[test]
+fn emaki_fullscreen_panel_untrusted_marker_is_ignored() {
+    // Any client can name a layer surface like the shell's marker. Only the trusted shell
+    // connection may shrink fullscreen windows: an ordinary client's marker, even one nearly
+    // as tall as the output, neither creates an inset nor raises the shell's.
+    for (shell_marker, inset) in [(None, 0), (Some(40), 40)] {
+        // The fullscreen window comes from the marker's own client or from a third client.
+        for window_from_marker_client in [true, false] {
+            let mut f = Fixture::new();
+            f.add_output(1, (1920, 1080));
+            let shell = f.add_trusted_shell();
+            let other = f.add_client();
+            if let Some(height) = shell_marker {
+                emaki_map_inset_marker(&mut f, shell, height);
+            }
+            emaki_map_inset_marker(&mut f, other, 1079);
+
+            let app = if window_from_marker_client {
+                other
+            } else {
+                f.add_client()
+            };
+            let window = f.client(app).create_window();
+            let surface = window.surface.clone();
+            window.set_fullscreen(None);
+            window.commit();
+            f.double_roundtrip(app);
+            let window = f.client(app).window(&surface);
+            assert_eq!(
+                window.configures_received.last().unwrap().1.size,
+                (1920, 1080 - inset),
+                "initial configure, shell marker {shell_marker:?}, \
+                 window from marker client {window_from_marker_client}"
+            );
+            window.attach_new_buffer();
+            emaki_assert_fullscreen_inset(&mut f, app, &surface, inset);
+        }
+    }
+}
