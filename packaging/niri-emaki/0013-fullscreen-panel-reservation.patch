+#[test]
+fn emaki_fullscreen_panel_marker_predicate() {
+    use crate::layout::workspace::fullscreen_inset_marker;
+    use smithay::wayland::shell::wlr_layer::{
+        Anchor, ExclusiveZone, Layer, LayerSurfaceCachedState,
+    };
+
+    let marker = LayerSurfaceCachedState {
+        layer: Layer::Overlay,
+        anchor: Anchor::TOP | Anchor::LEFT,
+        size: Size::from((1, 52)),
+        exclusive_zone: ExclusiveZone::DontCare,
+        ..Default::default()
+    };
+    let inset = |state: &LayerSurfaceCachedState| {
+        fullscreen_inset_marker("emaki-fullscreen-inset", true, true, state)
+    };
+    assert_eq!(inset(&marker), 52.);
+    // Only the trusted shell connection reserves fullscreen space: any other client could
+    // otherwise shrink fullscreen windows on its output, in every panel mode.
+    for state in [
+        marker,
+        LayerSurfaceCachedState {
+            size: Size::from((1, i32::MAX)),
+            ..marker
+        },
+    ] {
+        assert_eq!(
+            fullscreen_inset_marker("emaki-fullscreen-inset", false, true, &state),
+            0.
+        );
+    }
+    // The panel's own exclusive zone never insets fullscreen tiles: it is shared with the
+    // ordinary working area, and changing it would resize every other window.
+    let panel = LayerSurfaceCachedState {
+        anchor: Anchor::TOP | Anchor::LEFT | Anchor::RIGHT,
+        size: Size::from((0, 84)),
+        exclusive_zone: ExclusiveZone::Exclusive(52),
+        ..marker
+    };
+    assert_eq!(
+        fullscreen_inset_marker("emaki-test-bar", true, true, &panel),
+        0.
+    );
+    assert_eq!(
+        fullscreen_inset_marker("emaki-test-dock", true, true, &marker),
+        0.
+    );
+    assert_eq!(
+        fullscreen_inset_marker("other-panel", true, true, &marker),
+        0.
+    );
+    assert_eq!(
+        fullscreen_inset_marker("emaki-fullscreen-inset", true, false, &marker),
+        0.
+    );
+    for layer in [Layer::Background, Layer::Bottom, Layer::Top] {
+        assert_eq!(inset(&LayerSurfaceCachedState { layer, ..marker }), 52.);
+    }
+    for (anchor, expected) in [
+        (Anchor::TOP, 52.),
+        (Anchor::TOP | Anchor::LEFT | Anchor::RIGHT, 52.),
+        (Anchor::LEFT, 0.),
+        (Anchor::BOTTOM | Anchor::LEFT, 0.),
+        (Anchor::TOP | Anchor::BOTTOM | Anchor::LEFT, 0.),
+    ] {
+        assert_eq!(
+            inset(&LayerSurfaceCachedState { anchor, ..marker }),
+            expected
+        );
+    }
+    for exclusive_zone in [
+        ExclusiveZone::Neutral,
+        ExclusiveZone::DontCare,
+        ExclusiveZone::Exclusive(10),
+    ] {
+        assert_eq!(
+            inset(&LayerSurfaceCachedState {
+                exclusive_zone,
+                ..marker
+            }),
+            52.
+        );
+    }
+    for (height, top, expected) in [
+        (40, 8, 48.),
+        (40, -8, 32.),
+        (40, -80, 0.),
+        (i32::MAX, i32::MAX, 4294967294.),
+        (40, i32::MIN, 0.),
+    ] {
+        let mut state = marker;
+        state.size = Size::from((1, height));
+        state.margin.top = top;
+        assert_eq!(inset(&state), expected);
+    }
+}
