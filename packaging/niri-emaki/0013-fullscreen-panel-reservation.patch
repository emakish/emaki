+#[test]
+fn emaki_fullscreen_panel_zone_change_and_unmap() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let shell = f.add_trusted_shell();
+    let app = f.add_client();
+    let panel = emaki_map_inset_marker(&mut f, shell, 40);
+
+    let window = f.client(app).create_window();
+    let surface = window.surface.clone();
+    window.set_fullscreen(None);
+    window.commit();
+    f.double_roundtrip(app);
+    let window = f.client(app).window(&surface);
+    window.attach_new_buffer();
+    emaki_assert_fullscreen_inset(&mut f, app, &surface, 40);
+
+    for zone in [56, 24, 40] {
+        let layer = f.client(shell).layer(&panel);
+        layer.set_configure_props(LayerConfigureProps {
+            size: Some((1, zone.try_into().unwrap())),
+            ..Default::default()
+        });
+        layer.commit();
+        f.double_roundtrip(shell);
+        f.double_roundtrip(app);
+        emaki_assert_fullscreen_inset(&mut f, app, &surface, zone);
+    }
+
+    // A panel reserves space only on its own output, including after a column move.
+    f.add_output(2, (1920, 1080));
+    for (output_number, inset) in [(2, 0), (1, 40)] {
+        let output = f.niri_output(output_number);
+        f.niri().layout.move_column_to_output(&output, None, true);
+        f.double_roundtrip(app);
+        emaki_assert_fullscreen_inset(&mut f, app, &surface, inset);
+    }
+
+    let layer = f.client(shell).layer(&panel);
+    layer.attach_null();
+    layer.commit();
+    f.double_roundtrip(shell);
+    f.double_roundtrip(app);
+    emaki_assert_fullscreen_inset(&mut f, app, &surface, 0);
+}
