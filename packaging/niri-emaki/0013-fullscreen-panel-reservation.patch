+#[test]
+fn emaki_fullscreen_panel_output_resize_and_column_transfer() {
+    let (mut panel_space, window, clock) = setup(40., 1.);
+    panel_space.set_fullscreen(window.id(), true);
+    settle(&mut panel_space, &window);
+    let view = Size::from((1280., 720.));
+    let options = Rc::new(Options::default());
+    panel_space.update_config(view, Rectangle::from_size(view), 52., 1.25, options.clone());
+    settle(&mut panel_space, &window);
+    assert_eq!(window.0.requested_size.get(), Some(Size::from((1280, 668))));
+    let (tile, pos, _) = panel_space.tiles_with_render_positions().next().unwrap();
+    assert_eq!(pos, Point::from((0., 52.)));
+    assert_eq!(tile.tile_size(), Size::from((1280., 668.)));
+    assert_eq!(pos.y + tile.tile_size().h, view.h);
+
+    let mut plain_space =
+        ScrollingSpace::new(view, Rectangle::from_size(view), 0., 1.25, clock, options);
+    let column = panel_space.remove_column_by_idx(0, None);
+    plain_space.add_column(None, column, true, None);
+    settle(&mut plain_space, &window);
+    assert_eq!(window.0.requested_size.get(), Some(Size::from((1280, 720))));
+    let (tile, pos, _) = plain_space.tiles_with_render_positions().next().unwrap();
+    assert_eq!(pos, Point::from((0., 0.)));
+    assert_eq!(tile.tile_size(), view);
+
+    let column = plain_space.remove_column_by_idx(0, None);
+    panel_space.add_column(None, column, true, None);
+    settle(&mut panel_space, &window);
+    assert_eq!(window.0.requested_size.get(), Some(Size::from((1280, 668))));
+    let (tile, pos, _) = panel_space.tiles_with_render_positions().next().unwrap();
+    assert_eq!(pos, Point::from((0., 52.)));
+    assert_eq!(tile.tile_size(), Size::from((1280., 668.)));
+}
