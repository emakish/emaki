+#[test]
+fn emaki_fullscreen_panel_geometry_and_hit_testing() {
+    for scale in [1., 1.25, 2.] {
+        for inset in [0., 40., 56.] {
+            let (mut space, window, _clock) = setup(inset, scale);
+            space.set_fullscreen(window.id(), true);
+            settle(&mut space, &window);
+            assert_fullscreen(&space, &window, inset);
+        }
+    }
