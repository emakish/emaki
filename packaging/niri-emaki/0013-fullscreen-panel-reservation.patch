+use super::*;
+use crate::layout::scrolling::{ColumnWidth, ScrollingSpace};
+
+fn setup(inset: f64, scale: f64) -> (ScrollingSpace<TestWindow>, TestWindow, Clock) {
+    let view = Size::from((1920., 1080.));
+    let options = Rc::new(Options::default());
+    let mut clock = Clock::with_time(Duration::ZERO);
+    clock.set_complete_instantly(true);
+    let mut space = ScrollingSpace::new(
+        view,
+        Rectangle::from_size(view),
+        inset,
+        scale,
+        clock.clone(),
+        options.clone(),
+    );
+    let window = TestWindow::new(TestWindowParams::new(1));
+    let tile = Tile::new(window.clone(), view, scale, clock.clone(), options);
+    space.add_tile(None, tile, true, ColumnWidth::Proportion(0.5), false, None);
+    settle(&mut space, &window);
+    (space, window, clock)
+}
+
+fn settle(space: &mut ScrollingSpace<TestWindow>, window: &TestWindow) {
+    window.communicate();
+    space.update_window(window.id(), None);
+    space.advance_animations();
+}
+
+fn assert_fullscreen(space: &ScrollingSpace<TestWindow>, window: &TestWindow, inset: f64) {
+    assert_eq!(
+        window.0.requested_size.get(),
+        Some(Size::from((1920, 1080 - inset as i32)))
+    );
+    let (tile, pos, visible) = space.tiles_with_render_positions().next().unwrap();
+    assert!(visible);
+    assert_eq!(pos, Point::from((0., inset)));
+    assert_eq!(tile.tile_size(), Size::from((1920., 1080. - inset)));
+    let (_, ipc) = space.tiles_with_ipc_layouts().next().unwrap();
+    assert_eq!(
+        ipc.tile_pos_in_workspace_view,
+        (inset > 0.).then_some((0., inset))
+    );
+    assert!(space
+        .window_under(Point::from((960., inset + 1.)))
+        .is_some());
+    if inset > 0. {
+        assert!(space
+            .window_under(Point::from((960., inset - 1.)))
+            .is_none());
+    }
+}
