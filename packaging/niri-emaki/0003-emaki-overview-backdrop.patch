+    /// Finish explicit navigation using camera targets and the destination output.
+    pub fn emaki_note_navigation(
+        &mut self,
+        before: Vec<(Output, monitor::EmakiCameraSnapshot)>,
+        input_output: Option<Option<&Output>>,
+        direction: Option<crate::render_helpers::emaki_backdrop::Direction>,
+        key: Option<smithay::backend::input::Keycode>,
+    ) {
+        if before.is_empty() {
+            return;
+        }
+        // Some(None) means an under-mouse action found no target (for example
+        // beneath a shell layer). Only ordinary navigation uses the active output.
