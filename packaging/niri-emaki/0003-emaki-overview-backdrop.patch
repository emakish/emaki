+#[test]
+fn emaki_lifecycle_redraw_and_element_gate() {
+    let mut layout = setup();
+    assert!(layout.monitors().all(|m| !m.emaki_backdrop_active()));
+    layout.update_render_elements(None);
+    assert!(layout
+        .monitors()
+        .all(|m| m.emaki_backdrop_element().is_none()));
+    layout.open_overview();
+    assert!(layout.monitors().all(|m| m.emaki_backdrop_active()));
+    Op::CompleteAnimations.apply(&mut layout);
+    layout.update_render_elements(None);
+    assert!(layout
+        .monitors()
+        .all(|m| m.emaki_backdrop_element().is_some()));
+    layout.close_overview();
+    // Keep animating through the closing zoom, then drop the effect completely.
+    assert!(layout.monitors().all(|m| m.emaki_backdrop_active()));
+    Op::CompleteAnimations.apply(&mut layout);
+    layout.update_render_elements(None);
+    assert!(layout
+        .monitors()
+        .all(|m| !m.emaki_backdrop_active() && m.emaki_backdrop_element().is_none()));
+    let mut config = niri_config::Config::default();
+    config.overview.emaki_backdrop.off = true;
+    layout.update_config(&config);
+    layout.open_overview();
+    layout.update_render_elements(None);
+    assert!(layout
+        .monitors()
+        .all(|m| !m.emaki_backdrop_active() && m.emaki_backdrop_element().is_none()));
+}
