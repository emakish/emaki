+                    };
+                    let flow = (millis as f64 / 1000. * 120.) % 14.;
+                    for (lane, a) in (-14..(if vertical { 128 } else { 96 }) + 14)
+                        .step_by(14)
+                        .enumerate()
+                    {
+                        let stagger = (lane % 2) as i32 * 7;
+                        for b in (-14..(if vertical { 96 } else { 128 }) + 14).step_by(14) {
+                            let along = (b as f64 + stagger as f64 + sign * flow).round() as i32;
+                            let ci =
+                                ((b + stagger).div_euclid(14) + lane as i32).rem_euclid(4) as usize;
+                            for i in 0..4 {
+                                for thick in 0..2 {
+                                    for side in [-1, 1] {
+                                        let across = a + side * (4 - i);
+                                        let along = along + (sign as i32) * (-4 + i + thick);
+                                        let (x, y) = if vertical {
+                                            (across, along)
+                                        } else {
+                                            (along, across)
+                                        };
+                                        if (0..128).contains(&x) && (0..96).contains(&y) {
+                                            grid[y as usize * 128 + x as usize] = palette[ci];
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    for y in 0..h {
+                        for x in 0..w {
+                            let gx = ((x as f64 + 0.5) / (2. * scale)).floor() as usize;
+                            let gy = ((y as f64 + 0.5) / (2. * scale)).floor() as usize;
+                            let pixel = &actual[(y * w + x) * 4..(y * w + x + 1) * 4];
+                            assert_eq!(
+                                pixel,
+                                grid[gy * 128 + gx],
+                                "{dir:?} at {millis}ms scale {scale}, pixel {x},{y}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+
+        // Inspect all eight ring pieces, gaps, subpixel motion and premultiplied fade.
+        let table = Rectangle::new((96., 64.).into(), (192., 128.).into());
+        let output = (384., 256.).into();
+        backdrop.clear();
+        for millis in [0, 62, 125] {
+            backdrop.update(
+                settings,
+                Duration::from_millis(millis),
+                table,
+                output,
+                1.,
+                None,
+            );
+            let pixels = render_to_vec(
+                &mut renderer,
+                (384, 256).into(),
+                1.0.into(),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                backdrop.element().into_iter(),
+            )
+            .unwrap();
+            let colors = backdrop.colors.iter().rev().nth(1).unwrap().1;
+            let d = 5. + millis as f64 / 1000. * 4.;
+            let alpha = fade(d, 54.);
+            for (x, y, piece) in [
+                (87, 55, 0),
+                (295, 55, 1),
+                (87, 200, 2),
+                (295, 200, 3),
+                (192, 55, 4),
+                (192, 200, 5),
+                (87, 128, 6),
+                (295, 128, 7),
+            ] {
+                let actual = &pixels[(y * 384 + x) * 4..(y * 384 + x + 1) * 4];
+                let col = palette[colors[piece] as usize];
+                for channel in 0..4 {
+                    let expected = col[channel] as f64 * alpha;
+                    assert!(
+                        (actual[channel] as f64 - expected).abs() <= 1.,
+                        "piece {piece}, {millis}ms: {actual:?}, expected {col:?} * {alpha}"
+                    );
+                }
+            }
+            assert_eq!(
+                &pixels[(55 * 384 + 125) * 4..(55 * 384 + 126) * 4],
+                [0, 0, 0, 0]
+            );
+        }
+        // The existing front-to-back compositor ordering must hide even a newborn
+        // ring behind the table and let a neighbouring table cover older rings.
+        use crate::niri::OutputRenderElements;
+        use crate::render_helpers::solid_color::{SolidColorBuffer, SolidColorRenderElement};
+        let table_buffer = SolidColorBuffer::new(table.size, [0., 0., 0., 1.]);
+        let neighbour_buffer = SolidColorBuffer::new((384., 32.), [0., 0., 0., 1.]);
+        let elements: Vec<OutputRenderElements<GlesRenderer>> = vec![
+            SolidColorRenderElement::from_buffer(&table_buffer, table.loc, 1., Kind::Unspecified)
+                .into(),
+            SolidColorRenderElement::from_buffer(
+                &neighbour_buffer,
+                (0., 0.),
+                1.,
+                Kind::Unspecified,
+            )
+            .into(),
+            backdrop.element().unwrap().into(),
+        ];
+        let pixels = render_to_vec(
+            &mut renderer,
+            (384, 256).into(),
+            1.0.into(),
+            Transform::Normal,
+            Fourcc::Abgr8888,
+            elements.into_iter().rev(),
+        )
+        .unwrap();
+        for (x, y) in [(98, 65), (192, 14), (192, 128)] {
+            assert_eq!(
+                &pixels[(y * 384 + x) * 4..(y * 384 + x + 1) * 4],
+                [0, 0, 0, 255]
+            );
+        }
+
+        // Exercise every constant matrix selector and every base-four digit on GLES.
+        backdrop.clear();
+        let settings = EmakiBackdrop {
+            px: 1.,
+            spacing: 4.,
+            thick: 1.,
+            fade: 300.,
+            ..settings
+        };
+        backdrop.update(
+            settings,
+            Duration::ZERO,
+            Rectangle::new((450., 450.).into(), (300., 300.).into()),
+            (1200., 1200.).into(),
+            1.,
+            None,
+        );
+        let pixels = render_to_vec(
+            &mut renderer,
+            (1200, 1200).into(),
+            1.0.into(),
+            Transform::Normal,
+            Fourcc::Abgr8888,
+            backdrop.element().into_iter(),
+        )
+        .unwrap();
+        for (k, (_, colors)) in backdrop.colors.iter().rev().enumerate() {
+            let d = k as i32 * 4 - 1;
+            let lo = (450 - d) as usize;
+            let hi = (750 + d - 1) as usize;
+            let alpha = fade(d as f64, 300.);
+            for (piece, (x, y)) in [
+                (lo, lo),
+                (hi, lo),
+                (lo, hi),
+                (hi, hi),
+                (600, lo),
+                (600, hi),
+                (lo, 600),
+                (hi, 600),
+            ]
+            .into_iter()
+            .enumerate()
+            {
+                let actual = &pixels[(y * 1200 + x) * 4..(y * 1200 + x + 1) * 4];
+                let col = palette[colors[piece] as usize];
+                for channel in 0..4 {
+                    assert!(
+                        (actual[channel] as f64 - col[channel] as f64 * alpha).abs() <= 1.,
+                        "ring {k} piece {piece}: {actual:?}, expected {col:?} * {alpha}"
+                    );
+                }
+            }
+        }
+    }
+}
