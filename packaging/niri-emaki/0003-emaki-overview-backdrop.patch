+//! Emaki overview: one output-sized shader, with bounded, persistent ring colours.
+use std::collections::{HashMap, VecDeque};
+use std::rc::Rc;
+use std::time::Duration;
+
+use niri_config::EmakiBackdrop;
+use smithay::backend::input::Keycode;
+use smithay::backend::renderer::element::Kind;
+use smithay::backend::renderer::gles::{Uniform, UniformValue};
+use smithay::utils::{Logical, Rectangle, Size};
+
+use super::shader_element::ShaderRenderElement;
+use super::shaders::ProgramType;
+
+const MAX_RINGS: usize = 64;
+const ORDER: [usize; 8] = [0, 4, 1, 7, 3, 5, 2, 6];
+const INPUT_LIFETIME: Duration = Duration::from_millis(140);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Direction {
+    Right = 1,
+    Down = 2,
+    Left = 3,
+    Up = 4,
+}
+
+/// Records navigation input, including held keys and attempts at boundaries.
+#[derive(Debug, Default)]
+pub struct ScrollActivity {
+    last: Option<(Duration, Direction)>,
+    held: Vec<(Keycode, Direction)>,
+}
+
+impl ScrollActivity {
+    pub fn input(&mut self, now: Duration, dx: f64, dy: f64) {
+        let direction = if dy != 0. {
+            if dy > 0. {
+                Direction::Down
+            } else {
+                Direction::Up
+            }
+        } else if dx != 0. {
+            if dx > 0. {
+                Direction::Right
+            } else {
+                Direction::Left
+            }
+        } else {
+            return;
+        };
+        self.last = Some((now, direction));
+    }
+
+    pub fn press(&mut self, key: Keycode, direction: Direction) {
+        self.held.retain(|(k, _)| *k != key);
+        self.held.push((key, direction));
+    }
+
+    pub fn release(&mut self, now: Duration, key: Keycode) {
+        if let Some(i) = self.held.iter().position(|(k, _)| *k == key) {
+            let (_, direction) = self.held.remove(i);
+            self.last = Some((now, direction));
+        }
+    }
+
+    pub fn stop_repeat(&mut self, now: Duration) {
+        if let Some((_, direction)) = self.held.last() {
+            self.last = Some((now, *direction));
+        }
+        self.held.clear();
+    }
+
+    pub fn direction(&self, now: Duration) -> Option<Direction> {
+        self.held.last().map(|(_, d)| *d).or_else(|| {
+            self.last
+                .and_then(|(last, dir)| (now.saturating_sub(last) < INPUT_LIFETIME).then_some(dir))
+        })
+    }
+}
+
+pub fn needs_redraw(off: bool, open: bool, animating: bool) -> bool {
+    !off && (open || animating)
+}
+
+#[derive(Debug, Clone, Copy)]
+struct RingStyle {
+    thick: f64,
+    gap: f64,
+    arm: f64,
+}
+
+impl RingStyle {
+    fn new(table: Size<f64, Logical>, s: EmakiBackdrop) -> Self {
+        // Match the mockup. Only degenerate tables need a geometry guard.
+        let short = table.w.min(table.h).max(0.);
+        let (thick, gap, arm) = if short > 2. * s.thick {
+            (s.thick, s.gap, s.arm.min((short - 2. * s.gap) / 3.).max(2.))
+        } else {
+            // A table smaller than its birth stroke is degenerate at near-zero zoom.
+            (
+                s.thick.min(short / 8.),
+                s.gap.min(short / 8.),
+                s.arm.min(short / 8.),
+            )
+        };
+        Self { thick, gap, arm }
+    }
+}
+
+fn distance(k: usize, offset: f64, spacing: f64, thick: f64) -> f64 {
+    k as f64 * spacing + offset - thick
+}
+
+#[cfg(test)]
+fn fade(distance: f64, limit: f64) -> f64 {
+    (1. - distance / limit).clamp(0., 1.)
+}
+
+fn hash(mut n: u32) -> u32 {
+    n = (n ^ 61) ^ (n >> 16);
+    n = n.wrapping_mul(9);
+    n ^= n >> 4;
+    n = n.wrapping_mul(0x27d4eb2d);
+    n ^ (n >> 15)
+}
+
+fn ring_colors(index: i64, previous: Option<[u8; 8]>) -> [u8; 8] {
+    let mut seed = hash((index as u32).wrapping_mul(7919).wrapping_add(4)).max(1);
+    let mut result = [0; 8];
+    for (j, &piece) in ORDER.iter().enumerate() {
+        let mut choices = [0; 4];
+        let mut len = 0;
+        for color in 0..4 {
+            if (j > 0 && result[ORDER[j - 1]] == color)
+                || (j == 7 && result[ORDER[0]] == color)
+                || previous.is_some_and(|prev| prev[piece] == color)
+            {
+                continue;
+            }
+            choices[len] = color;
+            len += 1;
+        }
+        // At most three exclusions; four colours always leave a valid choice.
+        seed = hash(seed);
+        result[piece] = choices[seed as usize % len];
+    }
+    result
+}
+
+fn packed(colors: [u8; 8]) -> f32 {
+    colors
+        .iter()
+        .enumerate()
+        .fold(0u32, |v, (i, c)| v | ((*c as u32) << (2 * i))) as f32
+}
+
+#[derive(Debug, Default)]
+pub struct Backdrop {
+    settings: Option<EmakiBackdrop>,
+    epoch: Option<Duration>,
+    latest: Duration,
+    colors: VecDeque<(i64, [u8; 8])>,
+    element: Option<ShaderRenderElement>,
+}
+
+impl Backdrop {
+    pub fn clear(&mut self) {
+        // No allocations, timers, colour generation or uniform updates while closed.
+        if self.epoch.is_some() {
+            *self = Self::default();
+        }
+    }
+
+    fn colors(&mut self, first: i64) -> [[f32; 16]; 4] {
+        if self
+            .colors
+            .back()
+            .is_none_or(|&(last, _)| first - last >= MAX_RINGS as i64)
+        {
+            self.colors.clear();
+        }
+        let start = self
+            .colors
+            .back()
+            .map_or(first - MAX_RINGS as i64 + 1, |&(i, _)| i + 1);
+        for i in start..=first {
+            let next = ring_colors(i, self.colors.back().map(|&(_, c)| c));
+            if self.colors.len() == MAX_RINGS {
+                self.colors.pop_front();
+            }
+            self.colors.push_back((i, next));
+        }
+        let mut matrices = [[0.; 16]; 4];
+        for &(index, colors) in &self.colors {
+            let k = first - index;
+            if !(0..MAX_RINGS as i64).contains(&k) {
+                continue;
+            }
+            let k = k as usize;
+            matrices[k / 16][k % 16] = packed(colors);
+        }
+        matrices
+    }
+
+    pub fn advance_time(&mut self, now: Duration) -> Duration {
+        self.latest = self.latest.max(now);
+        self.latest
+    }
+
+    pub fn element(&self) -> Option<ShaderRenderElement> {
+        self.element.clone()
+    }
+
+    pub fn update(
+        &mut self,
+        settings: EmakiBackdrop,
+        now: Duration,
+        table: Rectangle<f64, Logical>,
+        output: Size<f64, Logical>,
+        scale: f64,
+        direction: Option<Direction>,
+    ) {
+        if self.settings != Some(settings) {
+            *self = Self::default();
+            self.settings = Some(settings);
+        }
+        let now = self.advance_time(now);
+        let epoch = *self.epoch.get_or_insert(now);
+        // Keep high-precision time on the CPU. Only bounded phases reach GLES floats.
+        let t = now.saturating_sub(epoch).as_secs_f64();
+        let s = settings;
+        let table = Rectangle::new(table.loc.downscale(s.px), table.size.downscale(s.px));
+        let style = RingStyle::new(table.size, s);
+        let travel = t * s.speed;
+        let first = (travel / s.spacing).floor() as i64;
+        let offset = travel.rem_euclid(s.spacing);
+        let colors = self.colors(first);
+        let element = self.element.get_or_insert_with(|| {
+            let mut element =
+                ShaderRenderElement::empty(ProgramType::EmakiBackdrop, Kind::Unspecified);
+            element.update(
+                output,
+                None,
+                scale as f32,
+                1.,
+                Rc::from(vec![
+                    Uniform::new("canvas_size", [0f32; 2]),
+                    Uniform::new("table", [0f32; 4]),
+                    Uniform::new("ring_style", [0f32; 4]),
+                    Uniform::new("ring_phase", [0f32; 2]),
+                    Uniform::new("arrows", [0f32; 4]),
+                    Uniform::new(
+                        "ring_colors",
+                        UniformValue::Matrix4x4 {
+                            matrices: vec![[0.; 16]; 4],
+                            transpose: false,
+                        },
+                    ),
+                    Uniform::new(
+                        "palette",
+                        UniformValue::Matrix4x4 {
+                            matrices: vec![[
+                                176. / 255.,
+                                30. / 255.,
+                                120. / 255.,
+                                1.,
+                                236. / 255.,
+                                42. / 255.,
+                                85. / 255.,
+                                1.,
+                                1.,
+                                106. / 255.,
+                                42. / 255.,
+                                1.,
+                                1.,
+                                182. / 255.,
+                                46. / 255.,
+                                1.,
+                            ]],
+                            transpose: false,
+                        },
+                    ),
+                ]),
+                HashMap::new(),
+            );
+            element
+        });
+        element.update_uniforms(output, scale as f32, |uniforms| {
+            uniforms[0].value = [output.w as f32, output.h as f32].into();
+            uniforms[1].value = [
+                table.loc.x as f32,
+                table.loc.y as f32,
+                table.size.w as f32,
+                table.size.h as f32,
+            ]
+            .into();
+            uniforms[2].value = [
+                s.spacing as f32,
+                style.thick as f32,
+                style.gap as f32,
+                style.arm as f32,
+            ]
+            .into();
+            uniforms[3].value = [
+                distance(0, offset, s.spacing, style.thick) as f32,
+                s.fade as f32,
+            ]
+            .into();
+            uniforms[4].value = [
+                s.px as f32,
+                (t * s.aspeed).rem_euclid(s.adense) as f32,
+                s.adense as f32,
+                direction.map_or(0., |d| d as u8 as f32),
+            ]
+            .into();
+            if let UniformValue::Matrix4x4 { matrices, .. } = &mut uniforms[5].value {
+                matrices.copy_from_slice(&colors);
+            }
+        });
+    }
+}
+
+#[cfg(test)]
