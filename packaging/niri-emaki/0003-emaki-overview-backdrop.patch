diff --git a/src/render_helpers/shaders/emaki_backdrop.frag b/src/render_helpers/shaders/emaki_backdrop.frag
new file mode 100644
index 00000000..3a831fd0
--- /dev/null
+++ b/src/render_helpers/shaders/emaki_backdrop.frag
@@ -0,0 +1,126 @@
+precision highp float;
+uniform float niri_alpha;
+uniform float niri_scale;
+uniform vec2 canvas_size; // logical output size, independent of capture/render scale
+varying vec2 niri_v_coords;
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+
+// All coordinates below are mockup grid units, except the output size.
+uniform vec4 table;
+uniform vec4 ring_style; // spacing, thickness, gap, fixed arm
+uniform vec2 ring_phase; // birth distance, fade distance
+uniform vec4 arrows; // logical pixel size, bounded flow, pitch, direction (0 = rings)
+uniform mat4 ring_colors[4]; // 64 rings, eight base-four colour indices per float
+uniform mat4 palette;
+
+float box(vec2 p, vec2 lo, vec2 hi) {
+    // Analytic pixel coverage keeps moving rings smooth without snapping to the grid.
+    if (any(lessThanEqual(hi, lo))) return 0.0;
+    float aa = 0.5 / (niri_scale * arrows.x);
+    vec2 coverage = clamp((min(p - lo, hi - p) + aa) / (2.0 * aa), 0.0, 1.0);
+    return coverage.x * coverage.y;
+}
+
+vec4 hot(float color) {
+    if (color < 0.5) return palette[0];
+    if (color < 1.5) return palette[1];
+    if (color < 2.5) return palette[2];
+    return palette[3];
+}
+
+// All selectors use literal uniform indices (GLSL ES 1.00 fragment portability).
+float component(vec4 v, float i) {
+    if (i < 0.5) return v.x;
+    if (i < 1.5) return v.y;
+    if (i < 2.5) return v.z;
+    return v.w;
+}
+
+float ringCode(float k) {
+    mat4 m;
+    if (k < 16.0) m = ring_colors[0];
+    else if (k < 32.0) m = ring_colors[1];
+    else if (k < 48.0) m = ring_colors[2];
+    else m = ring_colors[3];
+    float column = mod(floor(k / 4.0), 4.0);
+    vec4 v;
+    if (column < 0.5) v = m[0];
+    else if (column < 1.5) v = m[1];
+    else if (column < 2.5) v = m[2];
+    else v = m[3];
+    return component(v, mod(k, 4.0));
+}
+
+vec4 piece(float code, float divisor, float coverage) {
+    // Powers of two and packed 16-bit integers are exact in highp floats.
+    return hot(mod(floor(code / divisor), 4.0)) * coverage;
+}
+
+vec4 ring(vec2 p, float k) {
+    float d = k * ring_style.x + ring_phase.x;
+    if (k < 0.0 || k >= 64.0 || d > ring_phase.y) return vec4(0.0);
+    vec2 lo = table.xy - d;
+    vec2 hi = table.xy + table.zw + d;
+    float th = ring_style.y, gap = ring_style.z, arm = ring_style.w;
+    float code = ringCode(k);
+    vec4 c = vec4(0.0);
+    c += piece(code, 1.0, max(box(p, lo, lo + vec2(arm, th)), box(p, lo, lo + vec2(th, arm))));
+    c += piece(code, 4.0, max(box(p, vec2(hi.x-arm, lo.y), vec2(hi.x, lo.y+th)), box(p, vec2(hi.x-th, lo.y), vec2(hi.x, lo.y+arm))));
+    c += piece(code, 16.0, max(box(p, vec2(lo.x, hi.y-th), vec2(lo.x+arm, hi.y)), box(p, vec2(lo.x, hi.y-arm), vec2(lo.x+th, hi.y))));
+    c += piece(code, 64.0, max(box(p, hi-vec2(arm, th), hi), box(p, hi-vec2(th, arm), hi)));
+    c += piece(code, 256.0, box(p, vec2(lo.x+arm+gap, lo.y), vec2(hi.x-arm-gap, lo.y+th)));
+    c += piece(code, 1024.0, box(p, vec2(lo.x+arm+gap, hi.y-th), vec2(hi.x-arm-gap, hi.y)));
+    c += piece(code, 4096.0, box(p, vec2(lo.x, lo.y+arm+gap), vec2(lo.x+th, hi.y-arm-gap)));
+    c += piece(code, 16384.0, box(p, vec2(hi.x-th, lo.y+arm+gap), vec2(hi.x, hi.y-arm-gap)));
+    return c * clamp(1.0 - d / ring_phase.y, 0.0, 1.0);
+}
+
+vec4 chevrons(vec2 p) {
+    // The mockup rasterizes arrows in a low-resolution canvas, with no interpolation.
+    p = floor(p + 0.0001); // deterministic ties at physical pixel centres
+    bool vertical = arrows.w == 2.0 || arrows.w == 4.0;
+    bool positive = arrows.w == 1.0 || arrows.w == 2.0;
+    float sign = positive ? 1.0 : -1.0;
+    vec2 q = vertical ? p : p.yx; // across, along
+    float pitch = arrows.z;
+    float lane = floor((q.x + pitch * 0.5) / pitch);
+    float across = floor(lane * pitch);
+    // The reference starts its lane counter at -pitch, hence lane + 1.
+    float stagger = mod(lane + 1.0, 2.0) * floor(pitch / 2.0);
+    float row = floor((q.y - stagger - sign * arrows.y + pitch * 0.5) / pitch);
+    float center = floor(row * pitch + stagger + sign * arrows.y + 0.5);
+    float x = abs(q.x - across);
+    float y = q.y - center;
+    // s=4; two blocks thick, with the reference's open tip (x=1..4).
+    float step = -sign * x;
+    bool hit = x >= 1.0 && x <= 4.0 && (y == step || y == step + sign);
+    float color = mod(row + floor(stagger / pitch) + lane + 1.0, 4.0);
+    return hit ? hot(color) : vec4(0.0);
+}
+
+void main() {
+    vec2 p = niri_v_coords * canvas_size / arrows.x;
+    vec4 color;
+    if (arrows.w != 0.0) {
+        color = chevrons(p);
+    } else {
+        vec2 edge = max(table.xy - p, p - table.xy - table.zw);
+        float distance = max(edge.x, edge.y);
+        float aa = 0.5 / (niri_scale * arrows.x);
+        float k = ceil((distance - ring_phase.x - aa) / ring_style.x);
+        color = vec4(0.0);
+        // Bounds in config allow at most two overlapping rings, plus AA coverage.
+        // Constant work per fragment, independent of the number of living rings.
+        for (int i = 0; i < 3; i++) {
+            vec4 next = ring(p, k + float(i));
+            color = next + color * (1.0 - next.a);
+        }
+    }
+    color *= niri_alpha;
+#if defined(DEBUG_FLAGS)
+    if (niri_tint == 1.0) color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+    gl_FragColor = color;
+}
