+#[test]
+fn emaki_repeat_cancellation_and_monitor_crossing() {
+    let mut layout = setup();
+    layout.open_overview();
+    Op::CompleteAnimations.apply(&mut layout);
+    let source = layout.active_output().unwrap().clone();
+    let destination = layout
+        .monitors()
+        .find(|m| m.output() != &source)
+        .unwrap()
+        .output()
+        .clone();
+    let snapshot = |layout: &Layout<TestWindow>| {
+        layout
+            .monitors()
+            .map(|m| (m.output().clone(), m.emaki_camera_snapshot()))
+            .collect()
+    };
+    let key = Some(42u32.into());
+    layout.emaki_note_navigation(snapshot(&layout), None, Some(Direction::Right), key);
+    Op::AdvanceAnimations { msec_delta: 700 }.apply(&mut layout);
+    assert_eq!(
+        layout
+            .monitor_for_output(&source)
+            .unwrap()
+            .emaki_scroll_direction(),
+        Some(Direction::Right)
+    );
+
+    let before = snapshot(&layout);
+    layout.focus_output(&destination);
+    layout.emaki_note_navigation(before, None, Some(Direction::Right), key);
+    Op::AdvanceAnimations { msec_delta: 140 }.apply(&mut layout);
+    assert_eq!(
+        layout
+            .monitor_for_output(&source)
+            .unwrap()
+            .emaki_scroll_direction(),
+        None
+    );
+    assert_eq!(
+        layout
+            .monitor_for_output(&destination)
+            .unwrap()
+            .emaki_scroll_direction(),
+        Some(Direction::Right)
+    );
+
+    // This is the cancellation path for modifier-first and unrelated-key release,
+    // and for replacing the bind repeat timer. It needs no matching keycode.
+    for mon in layout.monitors_mut() {
+        mon.emaki_stop_key_repeat();
+    }
+    Op::AdvanceAnimations { msec_delta: 139 }.apply(&mut layout);
+    assert_eq!(
+        layout
+            .monitor_for_output(&destination)
+            .unwrap()
+            .emaki_scroll_direction(),
+        Some(Direction::Right)
+    );
+    Op::AdvanceAnimations { msec_delta: 1 }.apply(&mut layout);
+    assert!(layout
+        .monitors()
+        .all(|m| m.emaki_scroll_direction().is_none()));
+
+    // Under-mouse bindings retain their explicit target instead of the active one.
+    layout.emaki_note_navigation(
+        snapshot(&layout),
+        Some(Some(&source)),
+        Some(Direction::Left),
+        None,
+    );
+    assert_eq!(
+        layout
+            .monitor_for_output(&source)
+            .unwrap()
+            .emaki_scroll_direction(),
+        Some(Direction::Left)
+    );
+    assert_eq!(
+        layout
+            .monitor_for_output(&destination)
+            .unwrap()
+            .emaki_scroll_direction(),
+        None
+    );
+    Op::AdvanceAnimations { msec_delta: 140 }.apply(&mut layout);
+    assert!(layout
+        .monitors()
+        .all(|m| m.emaki_scroll_direction().is_none()));
+}
