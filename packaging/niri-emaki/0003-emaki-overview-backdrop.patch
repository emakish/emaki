+        let table = Rectangle::new((320., 200.).into(), (640., 400.).into());
+        let output = (1280., 800.).into();
+        let ms = Duration::from_millis;
+        for t in [0, 1740, 1751] {
+            backdrop.update(settings, ms(t), table, output, 1., None);
+        }
+        let colors = backdrop.colors.clone();
+        let uniforms = backdrop.colors(1);
+        // A capture just before the 1750 ms birth follows a future-vblank redraw.
+        backdrop.update(settings, ms(1745), table, output, 1., None);
+        assert_eq!(backdrop.latest, ms(1751));
+        assert_eq!(backdrop.colors, colors);
+        assert_eq!(backdrop.colors(1), uniforms);
+        // Even a direct cache lookup behind its newest ring must preserve identities.
+        backdrop.colors(0);
+        assert_eq!(backdrop.colors, colors);
+        backdrop.update(settings, ms(1760), table, output, 1., None);
+        assert_eq!(backdrop.colors, colors);
+    }
