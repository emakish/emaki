+    // The same twelve rectangles used by the shader: eight pieces, corners have two arms.
+    fn segments(w: f64, h: f64, s: RingStyle) -> [(usize, f64, f64); 12] {
+        let a = s.arm;
+        [
+            (0, a, s.thick),
+            (0, s.thick, a),
+            (1, a, s.thick),
+            (1, s.thick, a),
+            (2, a, s.thick),
+            (2, s.thick, a),
+            (3, a, s.thick),
+            (3, s.thick, a),
+            (4, w - 2. * a - 2. * s.gap, s.thick),
+            (5, w - 2. * a - 2. * s.gap, s.thick),
+            (6, s.thick, h - 2. * a - 2. * s.gap),
+            (7, s.thick, h - 2. * a - 2. * s.gap),
+        ]
+    }
+
+    #[test]
+    fn emaki_monotonic_time_and_persistent_colors() {
+        let mut backdrop = Backdrop::default();
