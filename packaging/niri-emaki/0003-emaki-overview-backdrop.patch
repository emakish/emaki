+        for text in ["", "overview {}", "overview { emaki-backdrop {}; }"] {
+            assert_eq!(
+                Config::parse_mem(text).unwrap().overview.emaki_backdrop,
+                expected
+            );
+        }
+    }
+
+    #[test]
+    fn emaki_backdrop_overrides_and_off() {
+        let config = Config::parse_mem(
+            r##"
+            overview {
+                backdrop-color "#123456"
+                emaki-backdrop {
+                    off
+                    px 4
+                    speed 5.5
+                    spacing 9
+                    thick 3
+                    gap 0
+                    arm 30
+                    fade 100
+                    aspeed 60
+                    adense 20
+                }
+            }
+            "##,
+        )
+        .unwrap();
+        assert_eq!(
+            config.overview.emaki_backdrop,
+            EmakiBackdrop {
+                off: true,
+                px: 4.0,
+                speed: 5.5,
+                spacing: 9.0,
+                thick: 3.0,
+                gap: 0.0,
+                arm: 30.0,
+                fade: 100.0,
+                aspeed: 60.0,
+                adense: 20.0,
+            }
