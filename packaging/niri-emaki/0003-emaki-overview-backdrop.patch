+/// Count explicit camera navigation. A direction also records attempts at a boundary;
+/// target-based actions use their actual camera delta instead.
+fn emaki_navigation(
+    action: &Action,
+) -> Option<Option<crate::render_helpers::emaki_backdrop::Direction>> {
+    use crate::render_helpers::emaki_backdrop::Direction::*;
+    use Action::*;
+    let direction = match action {
+        FocusColumnLeft
+        | FocusColumnLeftUnderMouse
+        | FocusColumnFirst
+        | FocusColumnLeftOrLast
+        | FocusColumnOrMonitorLeft
+        | FocusWindowDownOrColumnLeft
+        | FocusWindowUpOrColumnLeft
+        | MoveColumnLeft
+        | MoveColumnToFirst
+        | MoveColumnLeftOrToMonitorLeft
+        | MoveWindowToMonitorLeft
+        | MoveColumnToMonitorLeft
+        | MoveWorkspaceToMonitorLeft => Left,
+        FocusColumnRight
+        | FocusColumnRightUnderMouse
+        | FocusColumnLast
+        | FocusColumnRightOrFirst
+        | FocusColumnOrMonitorRight
+        | FocusWindowDownOrColumnRight
+        | FocusWindowUpOrColumnRight
+        | MoveColumnRight
+        | MoveColumnToLast
+        | MoveColumnRightOrToMonitorRight
+        | MoveWindowToMonitorRight
+        | MoveColumnToMonitorRight
+        | MoveWorkspaceToMonitorRight => Right,
+        FocusWorkspaceDown
+        | FocusWorkspaceDownUnderMouse
+        | FocusWindowOrWorkspaceDown
+        | MoveWindowDownOrToWorkspaceDown
+        | MoveWorkspaceDown
+        | MoveWindowToWorkspaceDown(true)
+        | MoveColumnToWorkspaceDown(true)
+        | MoveWindowToMonitorDown
+        | MoveColumnToMonitorDown
+        | MoveWorkspaceToMonitorDown => Down,
+        FocusWorkspaceUp
+        | FocusWorkspaceUpUnderMouse
+        | FocusWindowOrWorkspaceUp
+        | MoveWindowUpOrToWorkspaceUp
+        | MoveWorkspaceUp
+        | MoveWindowToWorkspaceUp(true)
+        | MoveColumnToWorkspaceUp(true)
+        | MoveWindowToMonitorUp
+        | MoveColumnToMonitorUp
+        | MoveWorkspaceToMonitorUp => Up,
+        SwapWindowLeft
+        | SwapWindowRight
+        | ConsumeOrExpelWindowLeft
+        | ConsumeOrExpelWindowRight
+        | ConsumeOrExpelWindowLeftById(_)
+        | ConsumeOrExpelWindowRightById(_)
+        | ConsumeWindowIntoColumn
+        | ExpelWindowFromColumn
+        | FocusColumn(_)
+        | FocusWindow(_)
+        | FocusWindowPrevious
+        | FocusWorkspace(_)
+        | FocusWorkspacePrevious
+        | CenterColumn
+        | CenterWindow
+        | CenterWindowById(_)
+        | CenterVisibleColumns
+        | MoveWindowDown
+        | MoveWindowUp
+        | MoveColumnToIndex(_)
+        | MoveWindowToWorkspace(_, _)
+        | MoveWindowToWorkspaceById { .. }
+        | MoveColumnToWorkspace(_, _)
+        | MoveWorkspaceToIndex(_)
+        | MoveWorkspaceToIndexByRef { .. }
+        | MoveWindowToWorkspaceDown(false)
+        | MoveWindowToWorkspaceUp(false)
+        | MoveColumnToWorkspaceDown(false)
+        | MoveColumnToWorkspaceUp(false)
+        | MoveWorkspaceToMonitorByRef { .. }
+        | MoveWorkspaceToMonitor(_)
+        | MoveWindowToMonitor(_)
+        | MoveWindowToMonitorById { .. }
+        | MoveColumnToMonitor(_)
+        | MoveWindowToMonitorPrevious
+        | MoveWindowToMonitorNext
+        | MoveColumnToMonitorPrevious
+        | MoveColumnToMonitorNext
+        | MoveWorkspaceToMonitorPrevious
+        | MoveWorkspaceToMonitorNext
+        | MoveWindowToFloating
+        | MoveWindowToFloatingById(_)
+        | MoveWindowToTiling
+        | MoveWindowToTilingById(_) => return Some(None),
+        _ => return None,
+    };
+    Some(Some(direction))
+}
