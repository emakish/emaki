+        assert_ne!(config.overview.backdrop_color, DEFAULT_BACKDROP_COLOR);
+        assert_eq!(config.overview.zoom, Overview::default().zoom);
+    }
+
+    #[test]
+    fn emaki_backdrop_parts_preserve_omitted_settings() {
+        let mut overview = Overview::default();
+        let parts: Vec<OverviewPart> = knuffel::parse(
+            "test.kdl",
+            r#"
+            overview { emaki-backdrop { off; speed 12; }; }
+            overview { emaki-backdrop { px 4; }; }
+            overview { emaki-backdrop { off false; }; }
+        "#,
+        )
+        .unwrap();
+        overview.merge_with(&parts[0]);
+        overview.merge_with(&parts[1]);
+        assert!(overview.emaki_backdrop.off);
+        assert_eq!(overview.emaki_backdrop.speed, 12.0);
+        assert_eq!(overview.emaki_backdrop.px, 4.0);
+        assert_eq!(overview.emaki_backdrop.fade, 54.0);
+        overview.merge_with(&parts[2]);
+        assert!(!overview.emaki_backdrop.off);
+    }
+
+    #[test]
+    fn emaki_backdrop_rejects_invalid_values() {
+        for (name, min, max) in [
+            ("px", 2, 8),
+            ("speed", 2, 40),
+            ("spacing", 3, 16),
+            ("thick", 1, 4),
+            ("gap", 0, 40),
+            ("arm", 6, 120),
+            ("fade", 20, 160),
+            ("aspeed", 10, 120),
+            ("adense", 10, 40),
+        ] {
+            for value in [
+                (min - 1).to_string(),
+                (max + 1).to_string(),
+                "1.0e999".into(),
+                "NaN".into(),
+                "\"8\"".into(),
+            ] {
+                let text = format!("overview {{ emaki-backdrop {{ {name} {value}; }}; }}");
+                assert!(Config::parse_mem(&text).is_err(), "accepted {text}");
+            }
+            for value in [min, max] {
+                let text = format!("overview {{ emaki-backdrop {{ {name} {value}; }}; }}");
+                assert!(Config::parse_mem(&text).is_ok(), "rejected {text}");
+            }
+        }
+    }
+}
