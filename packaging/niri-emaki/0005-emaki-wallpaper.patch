+        assert!(smoke.fade(smoke.born + smoke.life * 0.35) < 1e-6);
+        assert!(smoke.geometry(smoke.born + 2.).1 < smoke.geometry(smoke.born).1);
+        assert_eq!(train.dip(52. / SPEED, 0, 0, 87), 1.);
+        assert_eq!(train.dip(56. / SPEED, 0, 0, 87), 0.);
+    }
+    #[test]
+    fn emaki_wallpaper_off_left_train_blocks_spawn_and_survives_other_view() {
+        let art = art();
+        let mut rng = fastrand::Rng::with_seed(42);
+        for gap in 19..=26 {
+            let mut schedule = Schedule::default();
+            schedule.trains.push(Train {
+                id: 1,
+                born: 0.,
+                start: 100.,
+                carriages: 3,
+            });
+            schedule.next_spawn = Some(gap as f64);
+            let now = gap as f64;
+            let origin = 2000. + now * SPEED;
+            schedule.update(
+                now,
+                origin,
+                1920.,
+                &[(origin, 1920.)],
+                &art,
+                [20., 60.],
+                &mut rng,
+            );
+            assert_eq!(schedule.trains.len(), 1);
+            assert_eq!(schedule.trains[0].id, 1);
+            assert!(
+                schedule
+                    .deadline(now, origin, 1920., &[origin], &art)
+                    .unwrap()
+                    > now
+            );
+        }
+        let mut schedule = Schedule::default();
+        schedule.trains.push(Train {
+            id: 1,
+            born: 0.,
+            start: 5000.,
+            carriages: 3,
+        });
+        schedule.next_spawn = Some(100.);
+        schedule.update(
+            1.,
+            0.,
+            1920.,
+            &[(0., 1920.), (5000., 1920.)],
+            &art,
+            [20., 60.],
+            &mut rng,
+        );
+        assert_eq!(schedule.trains.len(), 1);
+        schedule.update(1., 0., 1920., &[(0., 1920.)], &art, [20., 60.], &mut rng);
+        assert!(schedule.trains.is_empty());
+    }
+
+    #[test]
+    fn emaki_wallpaper_train_removal_all_views_and_one_ring_bound() {
+        let art = art();
+        let mut rng = fastrand::Rng::with_seed(1);
+        for views in [vec![(0., 1920.), (8000., 1920.)], vec![(0., 6000.)]] {
+            let mut s = Schedule::default();
+            s.next_spawn = Some(10000.);
+            s.trains.push(Train {
+                id: 1,
+                born: 0.,
+                start: 0.,
+                carriages: 3,
+            });
+            let death = RING_WIDTH as f64 / SPEED;
+            assert!(
+                s.deadline(
+                    0.,
+                    0.,
+                    views[0].1,
+                    &views.iter().map(|v| v.0).collect::<Vec<_>>(),
+                    &art
+                )
+                .unwrap()
+                    <= death
+            );
+            s.update(death, 0., views[0].1, &views, &art, [20., 60.], &mut rng);
+            assert!(s.trains.is_empty());
+        }
+        let mut s = Schedule::default();
+        s.next_spawn = Some(10000.);
+        s.trains.push(Train {
+            id: 1,
+            born: 0.,
+            start: 1950.,
+            carriages: 3,
+        });
+        s.update(
+            0.,
+            0.,
+            1920.,
+            &[(0., 1920.), (100., 1920.)],
+            &art,
+            [20., 60.],
+            &mut rng,
+        );
+        assert_eq!(s.trains.len(), 1, "second view still sees the tail");
+        s.update(
+            2.,
+            0.,
+            1920.,
+            &[(0., 1920.), (100., 1920.)],
+            &art,
+            [20., 60.],
+            &mut rng,
+        );
+        assert!(s.trains.is_empty(), "tail passed both right edges");
+    }
+}
