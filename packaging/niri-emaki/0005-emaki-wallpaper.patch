+use approx::assert_abs_diff_eq;
+
+use super::*;
+use crate::layout::workspace::{
+    choose_wallpaper_start, wallpaper_distance, WorkspaceAddWindowTarget, WALLPAPER_RING_WIDTH,
+};
+
+fn setup(scale: f64, windows: usize) -> Layout<TestWindow> {
+    let mut layout = check_ops_with_options(
+        Options::default(),
+        [Op::AddScaledOutput {
+            id: 1,
+            scale,
+            layout_config: None,
+        }],
+    );
+    for id in 1..=windows {
+        Op::AddWindow {
+            params: TestWindowParams::new(id),
+        }
+        .apply(&mut layout);
+        Op::Communicate(id).apply(&mut layout);
+    }
+    Op::CompleteAnimations.apply(&mut layout);
+    layout
+}
+
+fn origin(layout: &Layout<TestWindow>) -> f64 {
+    layout.active_workspace().unwrap().wallpaper_origin()
+}
+
+fn tile_x(layout: &Layout<TestWindow>, id: usize, scale: f64) -> f64 {
+    let ws = layout.active_workspace().unwrap();
+    let (_, pos, _) = ws
+        .tiles_with_render_positions()
+        .find(|(tile, _, _)| tile.window().id() == &id)
+        .unwrap();
+    (pos.x * scale).round()
+}
+
+#[test]
+fn random_starts_separate_both_neighbors_over_many_seeds() {
+    for seed in 0..4096 {
+        let mut rng = fastrand::Rng::with_seed(seed);
+        let first = choose_wallpaper_start(&mut rng, &[], 3840.);
+        let second = choose_wallpaper_start(&mut rng, &[first], 3840.);
+        let middle = choose_wallpaper_start(&mut rng, &[first, second], 3840.);
+        assert!((0. ..WALLPAPER_RING_WIDTH).contains(&middle));
+        assert!(wallpaper_distance(first, second) >= 3840.);
+        assert!(wallpaper_distance(first, middle) >= 3840.);
+        assert!(wallpaper_distance(second, middle) >= 3840.);
+    }
+    assert_ne!(
+        choose_wallpaper_start(&mut fastrand::Rng::with_seed(1), &[], 3840.),
+        choose_wallpaper_start(&mut fastrand::Rng::with_seed(2), &[], 3840.),
+    );
+}
+
+#[test]
+fn impossible_ultrawide_separation_is_bounded_and_maximally_spaced() {
+    let neighbors = [0., WALLPAPER_RING_WIDTH / 2.];
+    let result = choose_wallpaper_start(&mut fastrand::Rng::with_seed(0), &neighbors, 10000.);
+    for other in neighbors {
+        assert_eq!(wallpaper_distance(result, other), WALLPAPER_RING_WIDTH / 4.);
+    }
+}
+
+#[test]
+fn new_empty_and_named_workspaces_respect_actual_neighbors() {
+    for scale in [1., 1.25, 2.] {
+        let mut layout = setup(scale, 1);
+        for id in 1..=20 {
+            Op::AddNamedWorkspace {
+                ws_name: id,
+                output_name: Some(1),
+                layout_config: None,
+            }
+            .apply(&mut layout);
+        }
+        let mon = layout.monitors_mut().next().unwrap();
+        mon.add_workspace_at(10);
+        assert!(!mon.workspaces[10].has_windows_or_name());
+        for pair in mon.workspaces.windows(2) {
+            assert!(
+                wallpaper_distance(pair[0].wallpaper_start(), pair[1].wallpaper_start()) >= 2560.
+            );
+        }
+    }
+}
+
+#[test]
+fn lifetime_start_and_origin_survive_switches_monitor_moves_and_scale_changes() {
+    let mut layout = setup(1., 3);
+    let ws = layout.active_workspace().unwrap();
+    let id = ws.id();
+    let start = ws.wallpaper_start();
+    let before = ws.wallpaper_origin();
+    Op::AddScaledOutput {
+        id: 2,
+        scale: 1.25,
+        layout_config: None,
+    }
+    .apply(&mut layout);
+    for _ in 0..3 {
+        layout.switch_workspace_down();
+        layout.switch_workspace_up();
+        Op::MoveWorkspaceToOutput(2).apply(&mut layout);
+        let ws = layout
+            .workspaces()
+            .find(|(_, _, ws)| ws.id() == id)
+            .unwrap()
+            .2;
+        assert_eq!(ws.wallpaper_start(), start);
+        assert_abs_diff_eq!(ws.wallpaper_origin(), before, epsilon = 1e-8);
+        Op::MoveWorkspaceToOutput(1).apply(&mut layout);
+        let ws = layout
+            .workspaces()
+            .find(|(_, _, ws)| ws.id() == id)
+            .unwrap()
+            .2;
+        assert_eq!(ws.wallpaper_start(), start);
+        assert_abs_diff_eq!(ws.wallpaper_origin(), before, epsilon = 1e-8);
+    }
+    Op::RemoveOutput(1).apply(&mut layout);
+    let ws = layout
+        .workspaces()
+        .find(|(_, _, ws)| ws.id() == id)
+        .unwrap()
+        .2;
+    assert_eq!(ws.wallpaper_start(), start);
+    assert_abs_diff_eq!(ws.wallpaper_origin(), before, epsilon = 1e-8);
+}
+
+#[test]
+fn inserting_removing_and_resizing_to_left_preserves_camera() {
+    for scale in [1., 1.25] {
+        let mut layout = setup(scale, 3);
+        let before = origin(&layout);
+        let before_window = tile_x(&layout, 3, scale);
+        let ws = layout.active_workspace_mut().unwrap();
+        let tile = Tile::new(
+            TestWindow::new(TestWindowParams::new(4)),
+            ws.scrolling().view_size(),
+            scale,
+            ws.clock.clone(),
+            ws.options.clone(),
+        );
+        ws.add_tile(
+            tile,
+            WorkspaceAddWindowTarget::NewColumnAt(0),
+            ActivateWindow::No,
+            ColumnWidth::Fixed(300.),
+            false,
+            false,
+        );
+        assert_abs_diff_eq!(origin(&layout), before, epsilon = 1e-8);
+        assert_eq!(tile_x(&layout, 3, scale), before_window);
+        Op::Communicate(4).apply(&mut layout);
+        assert_abs_diff_eq!(origin(&layout), before, epsilon = 1e-8);
+        Op::SetForcedSize {
+            id: 4,
+            size: Some(Size::new(701, 200)),
+        }
+        .apply(&mut layout);
+        Op::Communicate(4).apply(&mut layout);
+        assert_abs_diff_eq!(origin(&layout), before, epsilon = 1e-8);
+        assert_eq!(tile_x(&layout, 3, scale), before_window);
+        Op::CloseWindow(4).apply(&mut layout);
+        assert_abs_diff_eq!(origin(&layout), before, epsilon = 1e-8);
+        assert_eq!(tile_x(&layout, 3, scale), before_window);
+    }
+}
+
+#[test]
+fn growing_and_shrinking_a_column_left_of_active_preserves_camera() {
+    let mut layout = setup(1.25, 3);
+    let before = origin(&layout);
+    let before_window = tile_x(&layout, 3, 1.25);
+    let ws = layout.active_workspace_mut().unwrap();
+    let mut params = TestWindowParams::new(4);
+    params.bbox.size.w = 900;
+    let tile = Tile::new(
