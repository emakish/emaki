+#[test]
+fn emaki_wallpaper_idle_locked_screenshot_and_reload_gate() {
+    let mut wallpaper = Wallpaper::default();
+    let config = EmakiWallpaper::default();
+    assert_eq!(wallpaper.configure(&config), None);
+    assert_eq!(wallpaper.load_state, "image");
+    assert!(wallpaper.wake_after().is_none());
+    assert!(!wallpaper.animated("test"));
+    let ring = EmakiWallpaper {
+        mode: EmakiWallpaperMode::Ring,
+        ..config.clone()
+    };
+    let generation = wallpaper.configure(&ring).unwrap();
+    assert_eq!(wallpaper.configure(&ring), None);
+    wallpaper.configure(&config);
+    wallpaper.loaded(generation, Err(anyhow::anyhow!("old worker")));
+    assert_eq!(wallpaper.load_state, "image");
+    assert!(wallpaper.error.is_none());
+    wallpaper.clock(Duration::from_secs(1), false);
+    wallpaper.clock(Duration::from_secs(2), false);
+    assert_eq!(wallpaper.now, 1.);
+    wallpaper.clock(Duration::from_secs(3), true);
+    wallpaper.clock(Duration::from_secs(300), true);
+    assert_eq!(wallpaper.now, 1.);
+    assert!(wallpaper.wake_after().is_none());
+    assert!(!wallpaper.animated("test"));
+    wallpaper.clock(Duration::from_secs(301), false);
+    assert_eq!(wallpaper.now, 1.);
+    wallpaper.clock(Duration::from_secs(302), false);
+    assert_eq!(wallpaper.now, 2.);
+    // A presentation timestamp can be ahead of the event-loop timestamp.
+    wallpaper.clock(Duration::from_secs(301), false);
+    wallpaper.clock(Duration::from_secs(302), false);
+    assert_eq!(wallpaper.now, 2.);
+}
