+        width: 372,
+        height: 576,
+        bytes: vec![10; 372 * 576],
+        palette: gpu.train.palette.clone(),
+    };
+    // Force the atlas and its small-limit fallback independently of driver limits.
+    assert!(assets::upload_layer(&mut renderer, &ring, 4096)
+        .unwrap()
+        .iter()
+        .all(|t| t.atlas_stride == 0));
+    gpu.ring = assets::upload_layer(&mut renderer, &ring, 16384).unwrap();
+    gpu.front = assets::upload_layer(&mut renderer, &front, 16384).unwrap();
+    assert_eq!(gpu.ring.len(), 1);
+    assert_eq!(gpu.ring[0].atlas_stride, 4096);
+    let decoded = assets::Decoded {
+        ring,
+        front,
+        frames,
+        train: gpu.train.clone(),
+    };
+    let mut wallpaper = engine(gpu);
+    wallpaper.decoded = Some(decoded.prepare(16384));
+    for origin in [4094., 19394.] {
+        let mut view = view(7000, 1200, 1.25, origin);
+        view.zoom = 0.5;
+        let pixels = draw(&mut renderer, &mut wallpaper, &view);
+        assert_eq!(wallpaper.scenes[&1].ring.len(), 1);
+        for y in [0, 1, 200, 599] {
+            for x in 0..3500 {
+                let mut expected = [0.; 4];
+                for dy in 0..2 {
+                    for dx in 0..2 {
+                        let c = colour(pattern(
+                            (origin as usize + x * 2 + dx) % RING_WIDTH,
+                            y * 2 + dy,
+                        ));
+                        for k in 0..4 {
+                            expected[k] += c[k] as f64 / 4.;
+                        }
+                    }
+                }
+                let actual = &pixels[(y * 7000 + x) * 4..(y * 7000 + x) * 4 + 4];
+                for k in 0..4 {
+                    assert!(
+                        (actual[k] as f64 - expected[k]).abs() <= 1.,
+                        "{origin}: {x},{y}: {actual:?} != {expected:?}"
+                    );
+                }
+            }
+        }
+    }
+    let old = wallpaper.gpu.as_ref().unwrap().context.clone();
+    let mut replacement = self::renderer();
+    let view = view(30, 1200, 1., 0.);
+    assert!(wallpaper.render(&mut replacement, "test", &view).is_empty());
+    assert!(wallpaper.decoded.is_none());
+    assert!(wallpaper.reload_requested);
+    let settings = wallpaper.settings.clone().unwrap();
+    let generation = wallpaper.configure(&settings).unwrap();
+    // Worker decoding is covered by assets tests; stage replacement data here.
+    wallpaper.loaded(
+        generation,
+        Ok(assets::Decoded {
+            ring: assets::IndexedImage {
+                width: RING_WIDTH,
+                height: RING_HEIGHT,
+                bytes: (0..RING_HEIGHT)
+                    .flat_map(|y| (0..RING_WIDTH).map(move |x| pattern(x, y) as u8))
+                    .collect(),
+                palette: vec![],
+            },
+            front: assets::IndexedImage {
+                width: RING_WIDTH,
+                height: RING_HEIGHT,
+                bytes: vec![64; RING_WIDTH * RING_HEIGHT],
+                palette: vec![],
+            },
+            frames: assets::IndexedImage {
+                width: 372,
+                height: 576,
+                bytes: vec![10; 372 * 576],
+                palette: vec![],
+            },
+            train: wallpaper.art.clone().unwrap(),
+        }
+        .prepare(assets::texture_limit(&mut replacement).unwrap())),
+    );
+    let pixels = draw(&mut replacement, &mut wallpaper, &view);
+    assert!(wallpaper.decoded.is_none());
+    assert!(!Rc::ptr_eq(&old, &wallpaper.gpu.as_ref().unwrap().context));
+    assert_eq!(&pixels[..4], colour(pattern(0, 0)));
+    // A pre-existing unrelated GL error must not reject a valid upload.
+    replacement
+        .with_context(|gl| unsafe {
+            gl.BindTexture(0xffff, 0);
+        })
+        .unwrap();
+    assets::upload_texture(&mut replacement, &[0], 1, 1, false).unwrap();
+}
