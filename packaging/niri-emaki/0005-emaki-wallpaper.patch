+#[test]
+fn emaki_wallpaper_unchanged_train_frame_keeps_commits_on_fast_outputs() {
+    let mut renderer = renderer();
+    let mut wallpaper = engine(art(&mut renderer));
+    let view = view(900, 1200, 1., 0.);
+    let mut schedule = Schedule::default();
+    schedule.trains.push(Train {
+        id: 1,
+        born: 0.,
+        start: 100.,
+        carriages: 3,
+    });
+    wallpaper.outputs.insert(
+        "test".into(),
+        OutputScene {
+            schedule,
+            views: vec![view.clone()],
+            active: view.clone(),
+            animated: true,
+            deadline: None,
+            now: 2.,
+            prediction: None,
+        },
+    );
+    // The same clock twice: nothing changed, so no element may commit again.
+    let a = frame(&mut renderer, &mut wallpaper, &view, 2.01);
+    let b = frame(&mut renderer, &mut wallpaper, &view, 2.01);
+    assert!(a.iter().any(|(_, _, geo)| geo.size.w > 0));
+    assert_eq!(a, b, "a repeated frame must not commit any element");
+    let vehicles = (0..4)
+        .map(|v| {
+            wallpaper.scenes[&1].dynamic[&(1, 0, v)]
+                .element
+                .id()
+                .clone()
+        })
+        .collect::<Vec<_>>();
+    let vehicle = |frame: &Frame, id: &Id| {
+        frame
+            .iter()
+            .find(|(e, _, _)| e == id)
+            .map(|(_, commit, geo)| (*commit, *geo))
+            .unwrap()
+    };
+    // Two 120 Hz frames with the same art-pixel position and wheel frame: at 60 px/s
+    // the train moves one pixel per 60 Hz step, so every other fast frame repeats.
+    let b = frame(&mut renderer, &mut wallpaper, &view, 2.018);
+    for id in &vehicles {
+        assert_eq!(
+            vehicle(&a, id),
+            vehicle(&b, id),
+            "quantised train re-committed"
+        );
+    }
+    // One art pixel on: the element moves (geometry is tracked by the damage tracker)
+    // but samples the same wheel frame, so its commit stays.
+    let c = frame(&mut renderer, &mut wallpaper, &view, 2.03);
+    for id in &vehicles {
+        let (commit, geo) = vehicle(&b, id);
+        let (moved_commit, moved_geo) = vehicle(&c, id);
+        assert_eq!(moved_geo.loc.x, geo.loc.x + 1);
+        assert_eq!(moved_commit, commit, "a pure move must not commit");
+    }
+    // The next wheel frame changes the sampled source rectangle: a new commit.
+    let d = frame(&mut renderer, &mut wallpaper, &view, 2.05);
+    for id in &vehicles {
+        assert_ne!(
+            vehicle(&c, id).0,
+            vehicle(&d, id).0,
+            "wheel frame change lost"
+        );
+    }
+}
