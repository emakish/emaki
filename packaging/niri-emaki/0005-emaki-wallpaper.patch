+pub(crate) fn renderer() -> GlesRenderer {
+    let mut renderer = unsafe {
+        let display = EGLDisplay::new(EGLSurfacelessDisplay).unwrap();
+        let context = EGLContext::new(&display).unwrap();
+        GlesRenderer::new(context).unwrap()
+    };
+    resources::init(&mut renderer);
+    shaders::init(&mut renderer);
+    assert!(Shaders::get(&mut renderer).emaki_wallpaper.is_some());
+    assert!(Shaders::get(&mut renderer).emaki_puff.is_some());
+    renderer
+}
+fn colour(index: usize) -> [u8; 4] {
+    if index == 64 {
+        [0; 4]
+    } else {
+        [
+            (index * 31 % 256) as u8,
+            (index * 79 % 256) as u8,
+            (index * 127 % 256) as u8,
+            255,
+        ]
+    }
+}
+fn pattern(x: usize, y: usize) -> usize {
+    (x + y) % 4
+}
+pub(crate) fn art(renderer: &mut GlesRenderer) -> GpuArt {
+    let palette = (0..65).flat_map(colour).collect::<Vec<_>>();
+    let palette = upload_texture(renderer, &palette, 65, 1, true).unwrap();
+    let mut ring = Vec::new();
+    let mut front = Vec::new();
+    // Force seams at 1024 even on large-texture desktop drivers.
+    for start in (0..RING_WIDTH).step_by(1024) {
+        let width = (RING_WIDTH - start).min(1024);
+        let mut indices = Vec::new();
+        let mut foreground = Vec::new();
+        for y in 0..RING_HEIGHT {
+            for x in 0..width + 2 {
+                let wx = (start + x + RING_WIDTH - 1) % RING_WIDTH;
+                indices.push(pattern(wx, y) as u8);
+                foreground.push(if (110..120).contains(&wx) && (770..830).contains(&y) {
+                    8
+                } else {
+                    64
+                });
+            }
+        }
+        ring.push(Tile {
+            atlas_stride: 0,
+            start,
+            width,
+            texture: upload_texture(renderer, &indices, width + 2, RING_HEIGHT, false).unwrap(),
+        });
+        front.push(Tile {
+            atlas_stride: 0,
+            start,
+            width,
+            texture: upload_texture(renderer, &foreground, width + 2, RING_HEIGHT, false).unwrap(),
+        });
+    }
+    let bytes = (0..576)
+        .flat_map(|y| std::iter::repeat_n((y / 36 + 10) as u8, 372))
+        .collect::<Vec<_>>();
+    let frames = upload_texture(renderer, &bytes, 372, 576, false).unwrap();
+    GpuArt {
+        context: assets::context_token(renderer),
+        ring,
+        front,
+        frames,
+        palette,
+        train: TrainArt {
+            width: 372,
+            height: 36,
+            frames: 16,
+            wheel_radius: 6.,
+            wheel_bottom_row: 818.,
+            speed: 60.,
+            chimney: [353., 0.],
+            cylinder: [358., 30.],
+            vehicles: [[0, 87], [87, 171], [171, 250], [250, 372]],
+            clear: 64,
+            palette: (0..64)
+                .map(|i| colour(i)[..3].try_into().unwrap())
+                .collect(),
+        },
+    }
+}
+fn view(width: i32, height: i32, scale: f64, origin: f64) -> View {
+    let size = Size::from((width as f64 / scale, height as f64 / scale));
+    View {
+        id: 1,
+        origin,
+        size,
+        scale,
+        geo: Rectangle::from_size(size),
+        zoom: 1.,
+        occluders: Vec::new(),
+    }
+}
+fn draw(renderer: &mut GlesRenderer, wallpaper: &mut Wallpaper, view: &View) -> Vec<u8> {
+    let elements = wallpaper.render(renderer, "test", view);
+    render_to_vec(
+        renderer,
+        view.size.to_physical_precise_round(view.scale),
+        view.scale.into(),
+        Transform::Normal,
+        Fourcc::Abgr8888,
+        elements.iter().rev(),
+    )
+    .unwrap()
+}
+pub(crate) fn engine(gpu: GpuArt) -> Wallpaper {
+    Wallpaper {
+        settings: Some(EmakiWallpaper {
+            mode: EmakiWallpaperMode::Ring,
+            ..Default::default()
+        }),
+        art: Some(gpu.train.clone()),
+        gpu: Some(gpu),
+        load_state: "ready",
+        ..Default::default()
+    }
+}
+#[test]
+fn emaki_wallpaper_gl_palette_sampling_seams_wrap_bottom_anchor_and_damage() {
+    let mut renderer = renderer();
+    let gpu = art(&mut renderer);
+    let mut wallpaper = engine(gpu);
+    for scale in [1., 1.25] {
+        for origin in [1020., 19392., 1020.375] {
+            let view = view(48, 1080, scale, origin);
+            let actual = draw(&mut renderer, &mut wallpaper, &view);
+            for y in 0..1080 {
+                for x in 0..48 {
+                    let wx = ((origin.round() + x as f64).floor() as usize) % RING_WIDTH;
+                    assert_eq!(
+                        &actual[(y * 48 + x) * 4..(y * 48 + x + 1) * 4],
+                        colour(pattern(wx, 120 + y)),
+                        "scale {scale} origin {origin} pixel {x},{y}"
+                    );
+                }
+            }
+            let before = wallpaper.render(&mut renderer, "test", &view);
+            let after = wallpaper.render(&mut renderer, "test", &view);
+            assert_eq!(before.len(), after.len());
+            for (a, b) in before.iter().zip(&after) {
+                assert_eq!(a.id(), b.id());
+                assert_eq!(a.current_commit(), b.current_commit());
+            }
+        }
+    }
+    // On a 1600 px output, texel interiors stay hard. Only the integrated
+    // footprint crossing a texel boundary mixes palette colours.
+    for origin in [1020., 19392.] {
+        let view = view(48, 1600, 1.25, origin);
+        let actual = draw(&mut renderer, &mut wallpaper, &view);
+        let a = 1600. / 1200.;
+        for y in 0..1600 {
+            for x in 0..48 {
+                let expected = colour(pattern(
+                    (origin as usize + ((x as f64 + 0.5) / a).floor() as usize) % RING_WIDTH,
+                    ((y as f64 + 0.5) / a).floor() as usize,
+                ));
+                let pixel = &actual[(y * 48 + x) * 4..(y * 48 + x + 1) * 4];
+                for (channel, expected) in pixel.iter().zip(expected) {
+                    assert!(
+                        (*channel as f64 - expected as f64).abs() < 1.1,
+                        "tall output origin {origin} pixel {x},{y}: {pixel:?} expected channel {expected}"
+                    );
+                }
+            }
+        }
+    }
+}
