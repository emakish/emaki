+#[test]
+fn emaki_wallpaper_smoke_front_to_back_is_oldest_first() {
+    let mut renderer = renderer();
+    let mut wallpaper = engine(art(&mut renderer));
+    let view = view(900, 1200, 1., 0.);
+    let mut schedule = Schedule::default();
+    schedule.trains.push(Train {
+        id: 1,
+        born: 0.,
+        start: 100.,
+        carriages: 3,
+    });
+    wallpaper.outputs.insert(
+        "test".into(),
+        OutputScene {
+            schedule,
+            views: vec![view.clone()],
+            active: view.clone(),
+            animated: true,
+            deadline: None,
+            now: 2.,
+            prediction: None,
+        },
+    );
+    wallpaper.now = 2.;
+    let elements = wallpaper.render(&mut renderer, "test", &view);
+    let cache = &wallpaper.scenes[&1];
+    let chuffs = elements
+        .iter()
+        .filter_map(|element| {
+            cache.dynamic.iter().find_map(|(&(id, chuff, kind), e)| {
+                (id == 1 && kind >= 4 && e.element.id() == element.id()).then_some(chuff)
+            })
+        })
+        .collect::<Vec<_>>();
+    assert!(chuffs.len() >= 5);
+    assert!(chuffs.windows(2).all(|p| p[0] <= p[1]));
+    let a = wallpaper.render_static(&mut renderer, &view);
+    wallpaper.now = 2.1;
+    let b = wallpaper.render_static(&mut renderer, &view);
+    assert_eq!(a.len(), cache_size(&wallpaper, view.id | (1 << 63)));
+    assert!(a
+        .iter()
+        .zip(&b)
+        .all(|(a, b)| a.id() == b.id() && a.current_commit() == b.current_commit()));
+    let mut moved = view.clone();
+    moved.origin += 1.;
+    let c = wallpaper.render_static(&mut renderer, &moved);
+    assert_ne!(
+        b.last().unwrap().current_commit(),
+        c.last().unwrap().current_commit()
+    );
+}
+fn cache_size(wallpaper: &Wallpaper, id: u64) -> usize {
+    wallpaper.scenes[&id].ring.len() + wallpaper.scenes[&id].front.len()
+}
+
+type Frame = Vec<(Id, CommitCounter, Rectangle<i32, Physical>)>;
+fn frame(renderer: &mut GlesRenderer, wallpaper: &mut Wallpaper, view: &View, now: f64) -> Frame {
+    wallpaper.now = now;
+    wallpaper
+        .render(renderer, "test", view)
+        .iter()
+        .map(|e| {
+            (
+                e.id().clone(),
+                e.current_commit(),
+                e.geometry(view.scale.into()),
+            )
+        })
+        .collect()
+}
