+fn emaki_wallpaper_scheduler_visible_gate_and_overview_smoke_entry() {
+    let art = TrainArt {
+        width: 372,
+        height: 36,
+        frames: 16,
+        wheel_radius: 6.,
+        wheel_bottom_row: 818.,
+        speed: 60.,
+        chimney: [353., 0.],
+        cylinder: [358., 30.],
+        vehicles: [[0, 87], [87, 171], [171, 250], [250, 372]],
+        clear: 64,
+        palette: vec![[0; 3]; 64],
+    };
+    let mut wallpaper = Wallpaper {
+        settings: Some(EmakiWallpaper {
+            mode: EmakiWallpaperMode::Ring,
+            ..Default::default()
+        }),
+        art: Some(art),
+        ..Default::default()
+    };
+    let view = view(1920, 1200, 1., 1000.);
+    wallpaper.clock(Duration::ZERO, false);
+    wallpaper.update_output("test".into(), view.clone(), vec![view.clone()]);
+    assert!(!wallpaper.animated("test"));
+    let spawn = wallpaper.outputs["test"].schedule.next_spawn.unwrap();
+    assert!((20. ..=60.).contains(&wallpaper.wake_after().unwrap().as_secs_f64()));
+    wallpaper.now = spawn;
+    wallpaper.sample_now = None;
+    wallpaper.update_output("test".into(), view.clone(), vec![view.clone()]);
+    assert!(
+        !wallpaper.animated("test"),
+        "off-left train must have a deadline, not frame wakes"
+    );
+    assert!(wallpaper.wake_after().unwrap() < Duration::from_millis(50));
+    wallpaper.now = spawn + 0.1;
+    wallpaper.update_output("test".into(), view.clone(), vec![view.clone()]);
+    assert!(wallpaper.animated("test"));
+    wallpaper.clock(Duration::from_secs(100), true);
+    assert!(!wallpaper.animated("test"));
+    assert!(wallpaper.wake_after().is_none());
+    wallpaper.clock(Duration::from_secs(1000), false);
+    wallpaper.update_output("test".into(), view.clone(), vec![view.clone()]);
+    assert!(wallpaper.animated("test"));
+
+    // Only the area above ring row 760 intersects the output. Rails are hidden,
+    // but smoke will rise through that edge without any user input to wake us.
+    let mut clipped = view.clone();
+    clipped.geo.loc.y = 1200. - 760.;
+    wallpaper.now = 0.;
+    wallpaper.sample_now = None;
+    let scene = wallpaper.outputs.get_mut("test").unwrap();
+    scene.schedule = Schedule::default();
+    scene.now = 0.;
+    scene.schedule.trains.push(Train {
+        id: 1,
+        born: 0.,
+        start: 1000. + 200.,
+        carriages: 1,
+    });
+    wallpaper.update_output("test".into(), view.clone(), vec![clipped.clone()]);
+    assert!(!wallpaper.animated("test"));
+    let wake = wallpaper.outputs["test"].deadline.unwrap();
+    assert!(
+        wake > 0. && wake < 4.,
+        "smoke entry must wake earlier than train departure: {wake}"
+    );
+    wallpaper.now = wake;
+    wallpaper.update_output("test".into(), view, vec![clipped]);
+    assert!(wallpaper.animated("test"));
+}
