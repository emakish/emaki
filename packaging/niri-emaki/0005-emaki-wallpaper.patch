+//! Bounded indexed PNG decoding on a worker, and single-channel tiled GPU storage.
+use std::any::Any;
+use std::fs::{File, OpenOptions};
+use std::io::{BufReader, Read};
+use std::os::unix::fs::OpenOptionsExt;
