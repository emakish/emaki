+/// The wallpaper engine is opt-in, so greeters and stock configurations keep their image.
+#[derive(knuffel::DecodeScalar, Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum EmakiWallpaperMode {
+    #[default]
+    Image,
+    Ring,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct EmakiWallpaper {
+    pub mode: EmakiWallpaperMode,
+    pub ring: String,
+    pub front: String,
+    pub train_frames: String,
+    pub train: String,
+    pub trains: bool,
+    /// Minimum and maximum time between visible trains, in seconds.
+    pub train_gap: [f64; 2],
+}
+
+impl Default for EmakiWallpaper {
+    fn default() -> Self {
+        Self {
+            mode: EmakiWallpaperMode::Image,
+            ring: "/usr/share/emaki/wallpaper/ring.png".into(),
+            front: "/usr/share/emaki/wallpaper/ring-front.png".into(),
+            train_frames: "/usr/share/emaki/wallpaper/train-frames.png".into(),
+            train: "/usr/share/emaki/wallpaper/train.json".into(),
+            trains: true,
+            train_gap: [20.0, 60.0],
+        }
+    }
+}
+
+#[derive(knuffel::Decode, Debug, Clone, PartialEq)]
+pub struct EmakiWallpaperPart {
+    #[knuffel(child, unwrap(argument))]
+    pub mode: Option<EmakiWallpaperMode>,
+    #[knuffel(child, unwrap(argument))]
+    pub ring: Option<String>,
+    #[knuffel(child, unwrap(argument))]
+    pub front: Option<String>,
+    #[knuffel(child, unwrap(argument))]
+    pub train_frames: Option<String>,
+    #[knuffel(child, unwrap(argument))]
+    pub train: Option<String>,
+    #[knuffel(child, unwrap(argument))]
+    pub trains: Option<EmakiWallpaperTrains>,
+    #[knuffel(child)]
+    pub train_gap: Option<EmakiWallpaperTrainGap>,
+}
+
+#[derive(knuffel::DecodeScalar, Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EmakiWallpaperTrains {
+    On,
+    Off,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct EmakiWallpaperTrainGap(pub [f64; 2]);
+
+struct EmakiWallpaperSeconds(f64);
+
+impl<S: knuffel::traits::ErrorSpan> knuffel::DecodeScalar<S> for EmakiWallpaperSeconds {
+    fn type_check(
+        type_name: &Option<knuffel::span::Spanned<knuffel::ast::TypeName, S>>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) {
+        <FloatOrInt<0, 1> as knuffel::DecodeScalar<S>>::type_check(type_name, ctx);
+    }
+
+    fn raw_decode(
+        val: &knuffel::span::Spanned<knuffel::ast::Literal, S>,
+        _ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, knuffel::errors::DecodeError<S>> {
+        use knuffel::ast::Literal;
+        use knuffel::errors::DecodeError;
+
+        match &**val {
+            Literal::Int(value) => i64::try_from(value)
+                .map(|value| Self(value as f64))
+                .map_err(|err| DecodeError::conversion(val, err)),
+            Literal::Decimal(value) => f64::try_from(value)
+                .map(Self)
+                .map_err(|err| DecodeError::conversion(val, err)),
+            _ => Err(DecodeError::unsupported(
+                val,
+                "expected a number of seconds",
+            )),
+        }
+    }
+}
+
+impl<S: knuffel::traits::ErrorSpan> knuffel::Decode<S> for EmakiWallpaperTrainGap {
+    fn decode_node(
+        node: &knuffel::ast::SpannedNode<S>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, knuffel::errors::DecodeError<S>> {
+        #[derive(knuffel::Decode)]
+        struct Gap {
+            #[knuffel(argument)]
+            min: EmakiWallpaperSeconds,
+            #[knuffel(argument)]
+            max: EmakiWallpaperSeconds,
+        }
+
+        let Gap { min, max } = Gap::decode_node(node, ctx)?;
+        let (min, max) = (min.0, max.0);
+        if !min.is_finite() || !max.is_finite() || min <= 0.0 || max < min {
+            return Err(knuffel::errors::DecodeError::conversion(
+                node,
+                "train-gap requires finite positive seconds with minimum <= maximum",
+            ));
+        }
+        Ok(Self([min, max]))
+    }
+}
+
+impl MergeWith<EmakiWallpaperPart> for EmakiWallpaper {
+    fn merge_with(&mut self, part: &EmakiWallpaperPart) {
+        merge_clone!((self, part), mode, ring, front, train_frames, train);
+        if let Some(trains) = part.trains {
+            self.trains = trains == EmakiWallpaperTrains::On;
+        }
+        if let Some(gap) = part.train_gap {
+            self.train_gap = gap.0;
+        }
+    }
+}
