+        let expected_frame = wallpaper.art.as_ref().unwrap().frame(now * 60.);
+        let actual = draw(&mut renderer, &mut wallpaper, &view);
+        let pixel = |x: usize, y: usize| &actual[(y * 500 + x) * 4..(y * 500 + x + 1) * 4];
