diff --git a/src/render_helpers/shaders/emaki_puff.frag b/src/render_helpers/shaders/emaki_puff.frag
new file mode 100644
index 00000000..8086226d
--- /dev/null
+++ b/src/render_helpers/shaders/emaki_puff.frag
@@ -0,0 +1,34 @@
+precision highp float;
+uniform float niri_alpha;
+uniform vec4 puff; // scratch size, radius, dissolve threshold, Bayer offset packed base 4
+uniform vec4 lobes; // second y, third y, fourth x, steam flag
+uniform vec4 tones;
+uniform sampler2D palette_tex;
+varying vec2 niri_v_coords;
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+float lobe(vec2 p, vec2 offset, float fraction) {
+    vec2 d = p - offset * puff.y;
+    float r = fraction * puff.y;
+    return dot(d, d) <= r * r ? (d.x - d.y) / r : -9.0;
+}
+float bayer(vec2 p) {
+    // Same transposed BAYER[x][y] indexing as train.html.
+    vec2 lo = mod(p, 2.0), hi = floor(mod(p, 4.0) / 2.0);
+    return 4.0 * (2.0 * lo.y + 3.0 * lo.x - 4.0 * lo.x * lo.y)
+         + 2.0 * hi.y + 3.0 * hi.x - 4.0 * hi.x * hi.y;
+}
+void main() {
+    vec2 pixel = floor(niri_v_coords * puff.x);
+    vec2 p = pixel + 0.5 - puff.x / 2.0;
+    float best = max(max(lobe(p, vec2(0), 1.0), lobe(p, vec2(-0.55, lobes.x), 0.7)),
+                     max(lobe(p, vec2(0.5, lobes.y), 0.65), lobe(p, vec2(lobes.z, -0.45), 0.6)));
+    vec2 dither = vec2(mod(puff.w, 4.0), floor(puff.w / 4.0));
+    if (best == -9.0 || bayer(pixel + dither) < puff.z * 16.0) discard;
+    float tone = best > 0.35 ? tones.x : best < -0.45 ? tones.z : tones.y;
+    gl_FragColor = texture2D(palette_tex, vec2((tone + 0.5) / 65.0, 0.5)) * niri_alpha;
+#if defined(DEBUG_FLAGS)
+    gl_FragColor = mix(gl_FragColor, vec4(0.0, 0.2, 0.0, 0.2), niri_tint);
+#endif
+}
diff --git a/src/render_helpers/shaders/emaki_wallpaper.frag b/src/render_helpers/shaders/emaki_wallpaper.frag
new file mode 100644
index 00000000..3b9d803b
--- /dev/null
+++ b/src/render_helpers/shaders/emaki_wallpaper.frag
@@ -0,0 +1,50 @@
+precision highp float;
+uniform float niri_alpha;
+uniform vec2 tex_size;
+uniform vec4 source_rect;
+uniform vec2 footprint;
+uniform float atlas_stride;
+uniform sampler2D indices;
+uniform sampler2D palette_tex;
+varying vec2 niri_v_coords;
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+vec4 lookup(vec2 p) {
+    if (atlas_stride > 0.0) {
+        float x = mod(p.x, 19396.0);
+        p = vec2(mod(x, atlas_stride), clamp(p.y, 0.0, 1199.0) + floor(x / atlas_stride) * 1200.0);
+    }
+    // Tile textures include one guard column at each edge. Never leave them.
+    p = clamp(p, vec2(0.0), tex_size - 1.0);
+    float index = floor(texture2D(indices, (p + 0.5) / tex_size).r * 255.0 + 0.5);
+    return texture2D(palette_tex, vec2((index + 0.5) / 65.0, 0.5));
+}
+void main() {
+    vec2 p = source_rect.xy + niri_v_coords * source_rect.zw;
+    if (footprint.x <= 1.0 && footprint.y <= 1.0) {
+        gl_FragColor = lookup(floor(p)) * niri_alpha;
+    } else {
+        // A clamped footprint spans at most four texels per axis, even at the
+        // smallest valid overview zoom. Constant loop limits also work on ES 2.
+        vec2 width = min(footprint, vec2(3.0));
+        vec2 lo = p - width * 0.5, hi = p + width * 0.5;
+        vec2 base = floor(lo);
+        vec4 colour = vec4(0.0);
+        for (int iy = 0; iy < 4; iy++) {
+            float y = base.y + float(iy);
+            if (y >= hi.y) break;
+            float wy = min(y + 1.0, hi.y) - max(y, lo.y);
+            for (int ix = 0; ix < 4; ix++) {
+                float x = base.x + float(ix);
+                if (x >= hi.x) break;
+                float wx = min(x + 1.0, hi.x) - max(x, lo.x);
+                colour += lookup(vec2(x, y)) * wx * wy;
+            }
+        }
+        gl_FragColor = colour / (width.x * width.y) * niri_alpha;
+    }
+#if defined(DEBUG_FLAGS)
+    gl_FragColor = mix(gl_FragColor, vec4(0.0, 0.2, 0.0, 0.2), niri_tint);
+#endif
+}
