+pub fn upload_texture(
+    renderer: &mut GlesRenderer,
+    bytes: &[u8],
+    width: usize,
+    height: usize,
+    rgba: bool,
+) -> anyhow::Result<GlesTexture> {
+    ensure!(
+        bytes.len() == width * height * if rgba { 4 } else { 1 },
+        "invalid upload size"
+    );
+    let format = if rgba { ffi::RGBA } else { ffi::LUMINANCE };
+    let id = renderer.with_context(|gl| unsafe {
+        let mut clean = false;
+        for _ in 0..16 {
+            if gl.GetError() == ffi::NO_ERROR {
+                clean = true;
+                break;
+            }
+        }
+        ensure!(clean, "wallpaper GL error state did not clear");
+        let mut id = 0;
+        let mut alignment = 0;
+        gl.GetIntegerv(ffi::UNPACK_ALIGNMENT, &mut alignment);
+        gl.GenTextures(1, &mut id);
+        gl.BindTexture(ffi::TEXTURE_2D, id);
+        gl.PixelStorei(ffi::UNPACK_ALIGNMENT, 1);
+        gl.TexParameteri(
+            ffi::TEXTURE_2D,
+            ffi::TEXTURE_MIN_FILTER,
+            ffi::NEAREST as i32,
+        );
+        gl.TexParameteri(
+            ffi::TEXTURE_2D,
+            ffi::TEXTURE_MAG_FILTER,
+            ffi::NEAREST as i32,
+        );
+        gl.TexParameteri(
+            ffi::TEXTURE_2D,
+            ffi::TEXTURE_WRAP_S,
+            ffi::CLAMP_TO_EDGE as i32,
+        );
+        gl.TexParameteri(
+            ffi::TEXTURE_2D,
+            ffi::TEXTURE_WRAP_T,
+            ffi::CLAMP_TO_EDGE as i32,
+        );
+        gl.TexImage2D(
+            ffi::TEXTURE_2D,
+            0,
+            format as i32,
+            width as i32,
+            height as i32,
+            0,
+            format,
+            ffi::UNSIGNED_BYTE,
+            bytes.as_ptr().cast(),
+        );
+        gl.PixelStorei(ffi::UNPACK_ALIGNMENT, alignment);
+        gl.BindTexture(ffi::TEXTURE_2D, 0);
+        let error = gl.GetError();
+        if error != ffi::NO_ERROR {
+            gl.DeleteTextures(1, &id);
+            anyhow::bail!("wallpaper GL upload failed: {error:#x}");
+        }
+        Ok(id)
+    })??;
+    Ok(unsafe {
+        GlesTexture::from_raw(
+            renderer,
+            Some(format),
+            !rgba,
+            id,
+            (width as i32, height as i32).into(),
+        )
+    })
+}
+pub struct PreparedTile {
+    start: usize,
+    width: usize,
+    atlas_stride: usize,
+    image: IndexedImage,
+}
+pub struct Prepared {
+    ring: Vec<PreparedTile>,
+    front: Vec<PreparedTile>,
+    frames: IndexedImage,
+    pub train: TrainArt,
+    pub max_size: usize,
+}
+impl Decoded {
+    /// CPU staging belongs to the decoder worker, including the small-GL fallback.
+    pub fn prepare(self, max_size: usize) -> Prepared {
+        Prepared {
+            ring: prepare_layer(self.ring, max_size),
+            front: prepare_layer(self.front, max_size),
+            frames: self.frames,
+            train: self.train,
+            max_size,
+        }
+    }
+}
+fn prepare_layer(image: IndexedImage, max_size: usize) -> Vec<PreparedTile> {
+    let stride = max_size.clamp(3, 4096);
+    let rows = image.width.div_ceil(stride);
+    if rows * image.height <= max_size {
+        let mut bytes = vec![0; stride * image.height * rows];
+        for (y, row) in image.bytes.chunks_exact(image.width).enumerate() {
+            for (tile, part) in row.chunks(stride).enumerate() {
+                let offset = (tile * image.height + y) * stride;
+                bytes[offset..offset + part.len()].copy_from_slice(part);
+            }
+        }
+        return vec![PreparedTile {
+            start: 0,
+            width: image.width,
+            atlas_stride: stride,
+            image: IndexedImage {
+                width: stride,
+                height: rows * image.height,
+                bytes,
+                palette: vec![],
+            },
+        }];
+    }
+    let mut tiles = Vec::new();
+    for start in (0..image.width).step_by(stride - 2) {
+        let width = (image.width - start).min(stride - 2);
+        let mut bytes = Vec::with_capacity((width + 2) * image.height);
+        for row in image.bytes.chunks_exact(image.width) {
+            bytes.push(row[(start + image.width - 1) % image.width]);
+            bytes.extend_from_slice(&row[start..start + width]);
+            bytes.push(row[(start + width) % image.width]);
+        }
+        tiles.push(PreparedTile {
+            start,
+            width,
+            atlas_stride: 0,
+            image: IndexedImage {
+                width: width + 2,
+                height: image.height,
+                bytes,
+                palette: vec![],
+            },
+        });
+    }
+    tiles
+}
+fn upload_prepared(
+    renderer: &mut GlesRenderer,
+    tiles: &[PreparedTile],
+) -> anyhow::Result<Vec<Tile>> {
+    tiles
+        .iter()
+        .map(|tile| {
+            Ok(Tile {
+                start: tile.start,
+                width: tile.width,
+                atlas_stride: tile.atlas_stride,
+                texture: upload_texture(
+                    renderer,
+                    &tile.image.bytes,
+                    tile.image.width,
+                    tile.image.height,
+                    false,
+                )?,
+            })
+        })
+        .collect()
+}
+// The token belongs to the EGL context, not its recyclable native handle.
+pub fn context_token(renderer: &GlesRenderer) -> Rc<()> {
+    struct WallpaperContext(Rc<()>);
+    let data = renderer.egl_context().user_data();
+    data.insert_if_missing(|| WallpaperContext(Rc::new(())));
+    data.get::<WallpaperContext>().unwrap().0.clone()
+}
+#[cfg(test)]
+pub(super) fn upload_layer(
+    renderer: &mut GlesRenderer,
+    image: &IndexedImage,
+    max_size: usize,
+) -> anyhow::Result<Vec<Tile>> {
+    upload_prepared(
+        renderer,
+        &prepare_layer(
+            IndexedImage {
+                width: image.width,
+                height: image.height,
+                bytes: image.bytes.clone(),
+                palette: vec![],
+            },
+            max_size,
+        ),
+    )
+}
+#[cfg(test)]
+thread_local! {
+    /// Stands in for GL_MAX_TEXTURE_SIZE in tests of smaller GPUs than the test driver.
+    pub(super) static TEXTURE_LIMIT: std::cell::Cell<Option<usize>> =
+        const { std::cell::Cell::new(None) };
+}
+pub fn texture_limit(renderer: &mut GlesRenderer) -> anyhow::Result<usize> {
+    #[cfg(test)]
+    if let Some(limit) = TEXTURE_LIMIT.with(|limit| limit.get()) {
+        return Ok(limit);
+    }
+    let limit = renderer.with_context(|gl| {
+        let mut value = 0;
+        unsafe { gl.GetIntegerv(ffi::MAX_TEXTURE_SIZE, &mut value) };
+        value
+    })?;
+    ensure!(
+        limit >= RING_HEIGHT as i32,
+        "GL_MAX_TEXTURE_SIZE {limit} is below the art height"
+    );
+    Ok(limit as usize)
+}
+impl GpuArt {
+    pub fn upload(renderer: &mut GlesRenderer, decoded: &Prepared) -> anyhow::Result<Self> {
+        let mut palette = Vec::with_capacity(65 * 4);
+        for rgb in &decoded.train.palette {
+            palette.extend_from_slice(rgb);
+            palette.push(255);
+        }
+        palette.extend_from_slice(&[0, 0, 0, 0]);
+        Ok(Self {
+            context: context_token(renderer),
+            ring: upload_prepared(renderer, &decoded.ring)?,
+            front: upload_prepared(renderer, &decoded.front)?,
+            frames: upload_texture(
+                renderer,
+                &decoded.frames.bytes,
+                decoded.frames.width,
+                decoded.frames.height,
+                false,
+            )?,
+            palette: upload_texture(renderer, &palette, 65, 1, true)?,
+            train: decoded.train.clone(),
+        })
+    }
+}
