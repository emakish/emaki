diff --git a/src/tests/emaki_wallpaper.rs b/src/tests/emaki_wallpaper.rs
new file mode 100644
index 00000000..d396a8ce
--- /dev/null
+++ b/src/tests/emaki_wallpaper.rs
@@ -0,0 +1,149 @@
+//! The wallpaper refresh that runs on every event loop turn, and its decoder.
+
+use std::time::{Duration, Instant};
+
+use niri_config::{Config, EmakiWallpaper, EmakiWallpaperMode};
+
+use super::Fixture;
+
+/// The living mode with missing files: every decode fails at its first file.
+fn missing(dir: &str) -> EmakiWallpaper {
+    let path = |name: &str| format!("/nonexistent/emaki-wallpaper-test/{dir}/{name}");
+    EmakiWallpaper {
+        mode: EmakiWallpaperMode::Ring,
+        ring: path("ring.png"),
+        front: path("front.png"),
+        train_frames: path("frames.png"),
+        train: path("train.json"),
+        ..Default::default()
+    }
+}
+
+/// Config clones and views built by the wallpaper refresh.
+#[derive(Debug, Default, PartialEq, Eq)]
+struct Work {
+    clones: usize,
+    views: usize,
+}
+
+/// One output and one turn to settle the first configuration, then `turns` event loop turns
+/// with an unchanged config. Returns the work of the first turn and of the later ones.
+fn refresh_work(config: Config, turns: usize) -> (Work, Work) {
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (64, 48));
+    f.state.server.dispatch();
+    let niri = f.niri();
+    let first = Work {
+        clones: niri.emaki_wallpaper_config_clones,
+        views: niri.emaki_wallpaper_views_built,
+    };
+    for _ in 0..turns {
+        f.state.server.dispatch();
+    }
+    let niri = f.niri();
+    let later = Work {
+        clones: niri.emaki_wallpaper_config_clones - first.clones,
+        views: niri.emaki_wallpaper_views_built - first.views,
+    };
+    (first, later)
+}
+
+#[test]
+fn emaki_wallpaper_refresh_clones_no_config_while_it_is_unchanged() {
+    // The decoder fails once and nothing reloads until the config changes.
+    let config = Config {
+        emaki_wallpaper: missing("a"),
+        ..Default::default()
+    };
+    let (first, later) = refresh_work(config, 10);
+    assert_eq!(
+        first.clones, 1,
+        "the decoder of the first generation needs its copy"
+    );
+    assert_eq!(
+        later.clones, 0,
+        "an unchanged config was cloned on an event loop turn"
+    );
+    // The living mode keeps rebuilding its views on every turn.
+    assert!(
+        later.views >= 10,
+        "living mode views were not rebuilt: {later:?}"
+    );
+}
+
+#[test]
+fn emaki_wallpaper_refresh_in_image_mode_builds_no_views() {
+    let config = Config::default();
+    assert_eq!(config.emaki_wallpaper.mode, EmakiWallpaperMode::Image);
+    let (first, later) = refresh_work(config, 10);
+    assert_eq!(first, Work::default());
+    assert_eq!(later, Work::default());
+}
+
+#[test]
+fn emaki_wallpaper_quick_path_changes_share_one_decoder_thread() {
+    let mut f = Fixture::with_config(Config {
+        emaki_wallpaper: missing("a"),
+        ..Default::default()
+    });
+    f.add_output(1, (64, 48));
+    f.state.server.dispatch();
+    for dir in ["b", "c"] {
+        f.niri().config.borrow_mut().emaki_wallpaper = missing(dir);
+        f.state.server.dispatch();
+    }
+    // Only the newest generation's result is shown, and it arrives through the event loop.
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        f.state.server.dispatch();
+        let status = f.niri().emaki_wallpaper_status();
+        if status.load_state == "failed" {
+            let error = status.error.unwrap();
+            assert!(error.contains("/c/train.json"), "{error}");
+            break;
+        }
+        assert!(Instant::now() < deadline, "no decoder result");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert_eq!(f.niri().emaki_wallpaper_decoder_threads(), 1);
+}
+
+/// Turns the event loop until the wallpaper status is "failed"; returns its error.
+fn failed_status(f: &mut Fixture) -> String {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        f.state.server.dispatch();
+        let status = f.niri().emaki_wallpaper_status();
+        if status.load_state == "failed" {
+            return status.error.unwrap();
+        }
+        assert!(
+            Instant::now() < deadline,
+            "no decoder result; status {}",
+            status.load_state
+        );
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn emaki_wallpaper_decoder_panic_fails_its_job_and_the_next_change_loads() {
+    use crate::render_helpers::emaki_wallpaper::assets::PANICKING_TRAIN;
+
+    let mut f = Fixture::with_config(Config {
+        emaki_wallpaper: EmakiWallpaper {
+            train: PANICKING_TRAIN.to_owned(),
+            ..missing("a")
+        },
+        ..Default::default()
+    });
+    f.add_output(1, (64, 48));
+    // The panicking job reports a failure instead of leaving the status at "loading".
+    let error = failed_status(&mut f);
+    assert!(error.contains("panicked"), "{error}");
+    // The same thread decodes the next change.
+    f.niri().config.borrow_mut().emaki_wallpaper = missing("b");
+    let error = failed_status(&mut f);
+    assert!(error.contains("/b/train.json"), "{error}");
+    assert_eq!(f.niri().emaki_wallpaper_decoder_threads(), 1);
+}
