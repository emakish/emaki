+        assert_abs_diff_eq!(origin(&layout), before_focus, epsilon = 1e-8);
+        let initial = origin(&layout);
+        let initial_window = tile_x(&layout, 1, scale);
+        let mut animated = false;
+        for _ in 0..100 {
+            Op::AdvanceAnimations { msec_delta: 10 }.apply(&mut layout);
