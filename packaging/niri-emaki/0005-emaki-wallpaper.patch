+//! Analytic trains and puffs. Hidden trains need deadlines, not simulation ticks.
+use super::assets::{TrainArt, RAIL_Y, RING_WIDTH};
+
+#[cfg(test)]
+thread_local! { pub static PUFF_EVALUATIONS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) }; }
+
+pub const SPEED: f64 = 60.;
+pub fn screen_x(world: f64, camera: f64) -> f64 {
+    (world - camera + RING_WIDTH as f64 / 2.).rem_euclid(RING_WIDTH as f64) - RING_WIDTH as f64 / 2.
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Train {
+    pub id: u64,
+    pub born: f64,
+    pub start: f64,
+    pub carriages: u8,
+}
+impl Train {
+    pub fn travelled(&self, now: f64) -> f64 {
+        (now - self.born).max(0.) * SPEED
+    }
+    pub fn x(&self, now: f64) -> f64 {
+        self.start + self.travelled(now)
+    }
+    pub fn dip(&self, now: f64, first: usize, a: usize, b: usize) -> f64 {
+        let x = self.x(now).round();
+        if [a + 12 - first, b - 12 - first]
+            .into_iter()
+            .any(|wheel| (x + wheel as f64).rem_euclid(64.) < 3.)
+        {
+            1.
+        } else {
+            0.
+        }
+    }
+    pub fn puffs(&self, now: f64, art: &TrainArt) -> Vec<Puff> {
+        #[cfg(test)]
+        PUFF_EVALUATIONS.with(|count| count.set(count.get() + 1));
+        let interval = std::f64::consts::TAU * art.wheel_radius / 2. / SPEED;
+        let elapsed = (now - self.born).max(0.);
+        let first = ((elapsed - 4.025).max(0.) / interval).floor() as u32 + 1;
+        let last = (elapsed / interval).floor() as u32;
+        let mut puffs = Vec::new();
+        for chuff in first..=last {
+            let born = self.born + chuff as f64 * interval;
+            let x = self.x(born) - art.first(self.carriages) as f64;
+            let y = RAIL_Y - art.height as f64;
+            for steam in [false, true] {
+                if steam && chuff % 2 != 0 {
+                    continue;
+                }
+                let attachment = if steam { art.cylinder } else { art.chimney };
+                let p = Puff::new(
+                    chuff,
+                    steam,
+                    born,
+                    x + attachment[0],
+                    y + attachment[1] + if steam { 0. } else { 1. },
+                );
+                if now - born <= p.life {
+                    puffs.push(p);
+                }
+            }
+        }
+        puffs
+    }
+}
+
+#[derive(Debug)]
+pub struct Puff {
+    pub chuff: u32,
+    pub steam: bool,
+    pub born: f64,
+    pub x: f64,
+    pub y: f64,
+    pub life: f64,
+    pub r0: f64,
+    pub r1: f64,
+    pub lobes: [f32; 4],
+    pub dither: f32,
+    pub jitter: f64,
+}
+impl Puff {
+    fn new(chuff: u32, steam: bool, born: f64, x: f64, y: f64) -> Self {
+        let mut seed = chuff.wrapping_mul(if steam { 104729 } else { 7919 });
+        let mut random = || {
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            seed as f64 / 4294967296.
+        };
+        let life = if steam {
+            0.5 + 0.3 * random()
+        } else {
+            3.5 * (0.85 + 0.3 * random())
+        };
+        let r0 = if steam { 1.5 } else { 2.5 };
+        let r1 = if steam {
+            4. + 2. * random()
+        } else {
+            6. + 5. * random()
+        };
+        let lobes = [
+            (0.25 + 0.2 * random()) as f32,
+            (0.2 * random()) as f32,
+            (0.1 * random()) as f32,
+            if steam { 1. } else { 0. },
+        ];
+        let dx = (random() * 4.).floor();
+        let dy = (random() * 4.).floor();
+        Self {
+            chuff,
+            steam,
+            born,
+            x,
+            y,
+            life,
+            r0,
+            r1,
+            lobes,
+            dither: (dx + 4. * dy) as f32,
+            jitter: random() - 0.5,
+        }
+    }
+    pub fn geometry(&self, now: f64) -> (f64, f64, f64, f64) {
+        let age = (now - self.born).max(0.);
+        let radius = self.r0 + (self.r1 - self.r0) * (1. - (-age / 0.7).exp());
+        let size = (radius * 2.4).ceil() + 4.;
+        let carried = SPEED * if self.steam { 0.6 } else { 1. } * 0.25 * (1. - (-age / 0.25).exp());
+        let (x, y) = if self.steam {
+            (
+                self.x + carried - 8. * age,
+                self.y + 2. * age - 3. * (1. - (-age / 0.2).exp()),
+            )
+        } else {
+            (
+                self.x + carried - 6. * age + self.jitter * 6. * age,
+                self.y - 14. * age - 16. * (1. - (-age / 0.35).exp()),
+            )
+        };
+        (
+            (x - size / 2.).round(),
+            (y - size / 2.).round(),
+            size,
+            radius,
+        )
+    }
+    pub fn fade(&self, now: f64) -> f32 {
+        (((now - self.born) / self.life - 0.35) / 0.65).max(0.) as f32
+    }
+}
+
+#[derive(Default)]
+pub struct Schedule {
+    pub trains: Vec<Train>,
+    pub next_spawn: Option<f64>,
+    was_visible: bool,
+    sequence: u64,
+}
+impl Schedule {
+    fn gap(rng: &mut fastrand::Rng, gap: [f64; 2]) -> f64 {
+        gap[0] + rng.f64() * (gap[1] - gap[0])
+    }
+    pub fn update(
+        &mut self,
+        now: f64,
+        origin: f64,
+        width: f64,
+        views: &[(f64, f64)],
+        art: &TrainArt,
+        gap: [f64; 2],
+        rng: &mut fastrand::Rng,
+    ) {
+        self.trains.retain(|train| {
+            now < train.born + RING_WIDTH as f64 / SPEED
+                && views
+                    .iter()
+                    .any(|&(origin, width)| screen_x(train.x(now), origin) <= width)
+        });
+        let visible = self.trains.iter().any(|t| {
+            let x = screen_x(t.x(now), origin);
+            x < width && x + art.length(t.carriages) > 0.
+        });
+        if self.was_visible && !visible {
+            self.next_spawn = Some(now + Self::gap(rng, gap));
+        }
+        self.was_visible = visible;
+        let spawn = *self
+            .next_spawn
+            .get_or_insert_with(|| now + Self::gap(rng, gap));
+        // Every train has the same world speed. Keep the new train's complete
+        // interval + 200 texels clear on both sides, including off-left trains.
+        let carriages = rng.u8(1..=3);
+        let start = origin - art.length(carriages) - 1.;
+        let entering = self.trains.iter().any(|t| {
+            let distance = (t.x(now) - start).rem_euclid(RING_WIDTH as f64);
+            distance < art.length(carriages) + 200.
+                || RING_WIDTH as f64 - distance < art.length(t.carriages) + 200.
+                || screen_x(t.x(now), origin) + art.length(t.carriages) <= 0.
+        });
+        if !visible && !entering && now >= spawn {
+            self.sequence += 1;
+            self.trains.push(Train {
+                id: self.sequence,
+                born: now,
+                start: (origin - art.length(carriages) - 1.).rem_euclid(RING_WIDTH as f64),
+                carriages,
+            });
+            self.next_spawn = Some(now + Self::gap(rng, gap));
+        }
+    }
+    pub fn deadline(
+        &self,
+        now: f64,
+        active_origin: f64,
+        width: f64,
+        origins: &[f64],
+        art: &TrainArt,
+    ) -> Option<f64> {
+        let mut deadline = if self.was_visible {
+            None
+        } else {
+            self.next_spawn.filter(|t| *t > now + 0.0001)
+        };
+        let mut add = |t: f64| {
+            if t > now + 0.0001 {
+                deadline = Some(deadline.map_or(t, |v| v.min(t)));
+            }
+        };
+        for train in &self.trains {
+            let x = screen_x(train.x(now), active_origin);
+            add(now + (width + 0.5 - x) / SPEED);
+            add(train.born + RING_WIDTH as f64 / SPEED);
+            for origin in origins {
+                let x = screen_x(train.x(now), *origin);
+                add(now + (width + 0.5 - x) / SPEED);
+                if x + art.length(train.carriages) <= 0. {
+                    add(now + (-x - art.length(train.carriages) + 0.5) / SPEED);
+                }
+                if x <= width {
+                    add(now + (width - x + 0.5) / SPEED);
+                }
+            }
+        }
+        deadline
+    }
+}
