+/// Current configuration and runtime state of Emaki's wallpaper engine.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq)]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub struct EmakiWallpaperStatus {
+    /// Configured mode: `image` or `ring`.
+    pub mode: String,
+    /// Configured asset paths.
+    pub files: EmakiWallpaperFiles,
+    /// Asset state: `image`, `loading`, `ready` or `failed`.
+    pub load_state: String,
+    /// Last asset loading error, if any.
+    pub error: Option<String>,
+    /// Whether train spawning is enabled by the configuration.
+    pub trains_enabled: bool,
+    /// Minimum and maximum time between visible trains, in seconds.
+    pub train_gap: [f64; 2],
+    /// Current art scale and visible trains for each output.
+    pub outputs: Vec<EmakiWallpaperOutput>,
+    /// Stable starts and camera rebase compensation for every workspace.
+    pub workspaces: Vec<EmakiWallpaperWorkspace>,
+}
+
+/// Asset paths used by the wallpaper engine.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq)]
