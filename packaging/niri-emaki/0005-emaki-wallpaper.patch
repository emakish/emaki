+        let size = ring[0].texture.size();
+        (ring.len(), ring[0].atlas_stride, size.w, size.h)
+    };
+
+    let mut renderer = renderer();
+    let gpu = art(&mut renderer);
+    let train = gpu.train.clone();
+    let mut wallpaper = engine(gpu);
+    wallpaper.gpu = None;
+    wallpaper.decoded = Some(decoded(&train).prepare(16384));
+    // Both limits are set here, whatever the test driver reports.
+    assets::TEXTURE_LIMIT.with(|limit| limit.set(Some(16384)));
+    let expected = views
+        .iter()
+        .map(|view| draw(&mut renderer, &mut wallpaper, view))
+        .collect::<Vec<_>>();
+    // Five 4096-wide rows of 1200 lines: one 4096 x 6000 atlas.
+    assert_eq!(ring_layout(&wallpaper), (1, 4096, 4096, 6000));
+
+    // A GPU limited to 8192 rejects the staging made for 16384 and asks for a reload.
+    assets::TEXTURE_LIMIT.with(|limit| limit.set(Some(8192)));
+    let mut wallpaper = engine(art(&mut renderer));
+    wallpaper.gpu = None;
+    wallpaper.decoded = Some(decoded(&train).prepare(16384));
+    assert!(wallpaper
+        .render(&mut renderer, "test", &views[0])
+        .is_empty());
+    assert_eq!(wallpaper.upload_limit, Some(8192));
+    assert!(wallpaper.reload_requested);
+    // The reload generation is staged for the stored limit, as the compositor does.
+    let settings = wallpaper.settings.clone().unwrap();
+    let generation = wallpaper.configure(&settings).unwrap();
+    let limit = wallpaper.upload_limit.unwrap();
+    wallpaper.loaded(generation, Ok(decoded(&train).prepare(limit)));
+    for (view, expected) in views.iter().zip(&expected) {
+        let pixels = draw(&mut renderer, &mut wallpaper, view);
+        assert!(
+            pixels == *expected,
+            "8192 draw differs at origin {}",
+            view.origin
+        );
+    }
+    assert_eq!(wallpaper.load_state, "ready");
+    // The ring still fits one atlas within 8192.
+    assert_eq!(ring_layout(&wallpaper), (1, 4096, 4096, 6000));
+    assets::TEXTURE_LIMIT.with(|limit| limit.set(None));
+}
