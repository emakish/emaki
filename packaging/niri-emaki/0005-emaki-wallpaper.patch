+fn emaki_wallpaper_gl_front_over_train_frames_smoke_and_small_damage() {
+    let mut renderer = renderer();
+    let gpu = art(&mut renderer);
+    let mut wallpaper = engine(gpu);
+    let view = view(500, 1200, 1.25, 0.);
+    let mut schedule = Schedule::default();
+    schedule.trains.push(Train {
