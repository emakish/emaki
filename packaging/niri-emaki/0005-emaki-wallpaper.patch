+pub const RING_WIDTH: usize = 19396;
+pub const RING_HEIGHT: usize = 1200;
+pub const RAIL_Y: f64 = 818.;
+const LIMIT: usize = 64 * 1024 * 1024;
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TrainArt {
+    pub width: usize,
+    pub height: usize,
+    pub frames: usize,
+    pub wheel_radius: f64,
+    pub chimney: [f64; 2],
+    pub cylinder: [f64; 2],
+    pub vehicles: [[usize; 2]; 4],
+    pub clear: u8,
+    #[serde(default = "default_wheel_bottom_row")]
+    pub wheel_bottom_row: f64,
+    #[serde(default = "default_speed")]
+    pub speed: f64,
+    // Metadata may omit the palette: the indexed ring PNG is authoritative.
+    #[serde(default)]
+    pub palette: Vec<[u8; 3]>,
+}
+fn default_wheel_bottom_row() -> f64 {
+    RAIL_Y
+}
+fn default_speed() -> f64 {
+    60.
+}
+impl TrainArt {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        ensure!(
+            self.width == 372 && self.height == 36 && self.frames == 16,
+            "unexpected train sheet dimensions"
+        );
+        ensure!(
+            self.wheel_radius == 6. && self.clear == 64,
+            "unexpected train wheel or transparent index"
+        );
+        ensure!(
+            self.vehicles == [[0, 87], [87, 171], [171, 250], [250, 372]],
+            "unexpected train vehicle ranges"
+        );
+        ensure!(
+            self.chimney == [353., 0.] && self.cylinder == [358., 30.],
+            "unexpected train attachment points"
+        );
+        ensure!(
+            self.wheel_bottom_row == RAIL_Y && self.speed == 60.,
+            "unexpected train rail height or speed"
+        );
+        ensure!(
+            self.palette.is_empty() || self.palette.len() == 64,
+            "train palette must have 64 colours when present"
+        );
+        Ok(())
+    }
+    pub fn frame(&self, travelled: f64) -> u8 {
+        ((travelled / (std::f64::consts::TAU * self.wheel_radius) * self.frames as f64).floor()
+            as u64
+            % self.frames as u64) as u8
+    }
+    pub fn first(&self, carriages: u8) -> usize {
+        self.vehicles[3 - carriages as usize][0]
+    }
+    pub fn length(&self, carriages: u8) -> f64 {
+        (self.width - self.first(carriages)) as f64
+    }
+}
+
+pub struct IndexedImage {
+    pub width: usize,
+    pub height: usize,
+    pub bytes: Vec<u8>,
+    pub(super) palette: Vec<[u8; 3]>,
+}
+pub struct Decoded {
+    pub ring: IndexedImage,
+    pub front: IndexedImage,
+    pub frames: IndexedImage,
+    pub train: TrainArt,
+}
+
+fn open(path: &str, limit: usize) -> anyhow::Result<File> {
+    let expanded = crate::utils::expand_home(Path::new(path))?;
+    let resolved = expanded.as_deref().unwrap_or_else(|| Path::new(path));
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(resolved)
+        .with_context(|| format!("opening {path}"))?;
+    let meta = file.metadata()?;
+    ensure!(
+        meta.is_file() && meta.len() <= limit as u64,
+        "asset is not a bounded regular file: {path}"
+    );
+    Ok(file)
+}
+fn decode_image(
+    path: &str,
+    dimensions: (usize, usize),
+    transparent: bool,
+) -> anyhow::Result<IndexedImage> {
+    let mut decoder = png::Decoder::new(BufReader::new(open(path, LIMIT)?));
+    decoder.set_limits(png::Limits { bytes: LIMIT });
+    // No EXPAND: one byte per texel survives all the way to GL.
+    let mut reader = decoder
+        .read_info()
+        .with_context(|| format!("reading {path}"))?;
+    let info = reader.info();
+    ensure!(
+        (info.width as usize, info.height as usize) == dimensions,
+        "wrong PNG dimensions: {path}"
+    );
+    ensure!(
+        info.color_type == png::ColorType::Indexed && info.bit_depth == png::BitDepth::Eight,
+        "expected 8-bit indexed PNG: {path}"
+    );
+    ensure!(
+        info.animation_control.is_none(),
+        "animated PNG is not supported: {path}"
+    );
+    let palette = info.palette.as_ref().context("missing PNG palette")?;
+    ensure!(
+        palette.len() >= if transparent { 195 } else { 192 },
+        "incomplete palette: {path}"
+    );
+    let palette = palette[..192]
+        .chunks_exact(3)
+        .map(|p| [p[0], p[1], p[2]])
+        .collect();
+    let alpha = info.trns.as_deref().unwrap_or(&[]);
+    ensure!(
+        (0..64).all(|i| alpha.get(i).copied().unwrap_or(255) == 255),
+        "palette colours must be opaque: {path}"
+    );
+    if transparent {
+        ensure!(
+            alpha.get(64) == Some(&0),
+            "index 64 must be transparent: {path}"
+        );
+    }
+    let mut bytes = vec![0; dimensions.0 * dimensions.1];
+    let frame = reader
+        .next_frame(&mut bytes)
+        .with_context(|| format!("decoding {path}"))?;
+    ensure!(
+        frame.buffer_size() == bytes.len(),
+        "unexpected indexed buffer size"
+    );
+    reader
+        .finish()
+        .with_context(|| format!("finishing {path}"))?;
+    ensure!(
+        bytes
+            .iter()
+            .all(|&b| b <= if transparent { 64 } else { 63 }),
+        "invalid palette index: {path}"
+    );
+    Ok(IndexedImage {
+        width: dimensions.0,
+        height: dimensions.1,
+        bytes,
+        palette,
+    })
+}
+/// A newer wallpaper generation was submitted while this one was decoding.
+#[derive(Debug)]
+pub struct Superseded;
+impl std::fmt::Display for Superseded {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("superseded by a newer wallpaper configuration")
+    }
+}
+impl std::error::Error for Superseded {}
+
+/// The train path for which [`decode`] panics in tests.
+#[cfg(test)]
+pub(crate) const PANICKING_TRAIN: &str = "/nonexistent/emaki-wallpaper-test/panic/train.json";
+
+/// `current` is asked before each image stage; a stale job stops there with [`Superseded`].
+pub fn decode(config: &EmakiWallpaper, current: &dyn Fn() -> bool) -> anyhow::Result<Decoded> {
+    #[cfg(test)]
+    if config.train == PANICKING_TRAIN {
+        panic!("wallpaper decoder panic (expected by a test)");
+    }
+    let stage = || {
+        if current() {
+            Ok(())
+        } else {
+            Err(anyhow::Error::new(Superseded))
+        }
+    };
+    let mut json = String::new();
+    open(&config.train, 64 * 1024)?
+        .take(64 * 1024 + 1)
+        .read_to_string(&mut json)?;
+    let mut train: TrainArt = serde_json::from_str(&json).context("reading train.json")?;
+    train.validate()?;
+    stage()?;
+    let ring = decode_image(&config.ring, (RING_WIDTH, RING_HEIGHT), false)?;
+    if train.palette.is_empty() {
+        train.palette.clone_from(&ring.palette);
+    }
+    stage()?;
+    let front = decode_image(&config.front, (RING_WIDTH, RING_HEIGHT), true)?;
+    stage()?;
+    let frames = decode_image(
+        &config.train_frames,
+        (train.width, train.height * train.frames),
+        true,
+    )?;
+    ensure!(
+        ring.palette == train.palette
+            && front.palette == train.palette
+            && frames.palette == train.palette,
+        "wallpaper assets must share the fixed train palette"
+    );
+    Ok(Decoded {
+        ring,
+        front,
+        frames,
+        train,
+    })
+}
+
+type Run<J> = Arc<dyn Fn(u64, J, &dyn Fn() -> bool) + Send + Sync>;
+type Panicked = Arc<dyn Fn(u64, String) + Send + Sync>;
+
+/// A job running this long is taken to be stuck: a whole decode of the shipped wallpaper takes
+/// 0.04 to 0.1 s in a release build, and the job checks for a newer generation between its
+/// stages. A read from a file on a hung network mount never returns (`O_NONBLOCK` does nothing
+/// for regular files).
+const STUCK_AFTER: Duration = Duration::from_secs(5);
+
+/// The compositor's one wallpaper decoder thread. Its mailbox holds a single job: a newer job
+/// replaces a waiting one, and the running job sees at its stage boundaries whether a newer
+/// generation was submitted. Decoding never runs on the event loop. A panic while decoding fails
+/// only its job (see [`Decoder::on_panic`]); the thread goes on with the next one. A thread that
+/// is gone anyway is replaced when the next job arrives, and a job that waits behind a stuck one
+/// gets a new thread (see [`Decoder::unstick`]).
+pub struct Decoder<J> {
+    mailbox: Arc<Mailbox<J>>,
+    run: Run<J>,
+    panicked: Panicked,
+    thread: Option<JoinHandle<()>>,
+    stuck_after: Duration,
+    #[cfg(test)]
+    started: usize,
+}
+struct Mailbox<J> {
+    /// The newest submitted generation: a job of any other generation is stale.
+    latest: AtomicU64,
+    closed: AtomicBool,
+    job: Mutex<Option<(u64, J)>>,
+    wake: Condvar,
+    /// When the running job started; `None` while the thread waits for a job.
+    running_since: Mutex<Option<Instant>>,
+}
+impl<J> Mailbox<J> {
+    fn new(latest: u64, job: Option<(u64, J)>) -> Self {
+        Self {
+            latest: AtomicU64::new(latest),
+            closed: AtomicBool::new(false),
+            job: Mutex::new(job),
+            wake: Condvar::new(),
+            running_since: Mutex::new(None),
+        }
+    }
+    /// Its thread exits instead of taking another job, and its running job is stale.
+    fn close(&self) {
+        let _job = self.job.lock().unwrap_or_else(PoisonError::into_inner);
+        self.closed.store(true, Ordering::SeqCst);
+        self.wake.notify_all();
+    }
+    fn stuck(&self, after: Duration) -> bool {
+        self.running_since
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .is_some_and(|since| since.elapsed() >= after)
+    }
+}
+impl<J: Send + 'static> Decoder<J> {
+    pub fn new(run: impl Fn(u64, J, &dyn Fn() -> bool) + Send + Sync + 'static) -> Self {
+        Self {
+            mailbox: Arc::new(Mailbox::new(0, None)),
+            run: Arc::new(run),
+            panicked: Arc::new(|_, _| ()),
+            thread: None,
+            stuck_after: STUCK_AFTER,
+            #[cfg(test)]
+            started: 0,
+        }
+    }
+    /// `report` gets the generation and panic message of a job that panicked while it was still
+    /// the newest generation.
+    pub fn on_panic(mut self, report: impl Fn(u64, String) + Send + Sync + 'static) -> Self {
+        self.panicked = Arc::new(report);
+        self
+    }
+    #[cfg(test)]
+    pub(crate) fn stuck_after(mut self, stuck_after: Duration) -> Self {
+        self.stuck_after = stuck_after;
+        self
+    }
+    /// Queues `job` as the newest generation. Fails only when the thread cannot be started.
+    pub fn submit(&mut self, generation: u64, job: J) -> std::io::Result<()> {
+        self.mailbox.latest.store(generation, Ordering::SeqCst);
+        let mut waiting = self
+            .mailbox
+            .job
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        *waiting = Some((generation, job));
+        drop(waiting);
+        self.mailbox.wake.notify_one();
+        if self.running() {
+            return self.unstick();
+        }
+        self.spawn()
+    }
+    /// Called on every event loop turn. When a job waits behind one that has run for
+    /// [`STUCK_AFTER`], the stuck job is left to its thread, which ends if its read ever returns,
+    /// and the waiting job starts on a new thread with a new mailbox. Fails only when that thread
+    /// cannot be started; the waiting job is then the newest generation.
+    pub fn unstick(&mut self) -> std::io::Result<()> {
+        if !self.running() || !self.mailbox.stuck(self.stuck_after) {
+            return Ok(());
+        }
+        let waiting = self
+            .mailbox
+            .job
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .take();
+        let Some(waiting) = waiting else {
+            return Ok(());
+        };
+        // From here on the stuck job is stale: it sends nothing if it ever finishes.
+        self.mailbox.close();
+        self.mailbox = Arc::new(Mailbox::new(waiting.0, Some(waiting)));
+        self.spawn()
+    }
+    fn spawn(&mut self) -> std::io::Result<()> {
+        // Without a thread after a failed start, the next submit starts one.
+        self.thread = None;
+        let mailbox = self.mailbox.clone();
+        let run = self.run.clone();
+        let panicked = self.panicked.clone();
+        self.thread = Some(
+            std::thread::Builder::new()
+                .name("emaki-wallpaper".into())
+                .spawn(move || work(&mailbox, &run, &panicked))?,
+        );
+        #[cfg(test)]
+        {
+            self.started += 1;
+        }
+        Ok(())
+    }
+    pub(super) fn running(&self) -> bool {
+        self.thread
+            .as_ref()
+            .is_some_and(|thread| !thread.is_finished())
+    }
+    #[cfg(test)]
+    pub(crate) fn threads_started(&self) -> usize {
+        self.started
+    }
+}
+impl<J> Drop for Decoder<J> {
+    fn drop(&mut self) {
+        // Not joined: a running stage ends at its next boundary, then the thread exits.
+        self.mailbox.close();
+    }
+}
+fn work<J>(mailbox: &Mailbox<J>, run: &Run<J>, panicked: &Panicked) {
+    loop {
+        let (generation, job) = {
+            let mut job = mailbox.job.lock().unwrap_or_else(PoisonError::into_inner);
+            loop {
+                if mailbox.closed.load(Ordering::SeqCst) {
+                    return;
+                }
+                if let Some(job) = job.take() {
+                    break job;
+                }
+                job = mailbox
+                    .wake
+                    .wait(job)
+                    .unwrap_or_else(PoisonError::into_inner);
+            }
+        };
+        let running_since = || {
+            mailbox
+                .running_since
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+        };
+        *running_since() = Some(Instant::now());
+        let current = || {
+            !mailbox.closed.load(Ordering::SeqCst)
+                && mailbox.latest.load(Ordering::SeqCst) == generation
+        };
+        // A panic ends this job, not the thread: `submit` sees a thread that is still running its
+        // panic hook or unwinding as alive, so a job submitted then would wait in the mailbox of
+        // a dying thread for good. The job shares nothing with the loop that it could leave
+        // half-updated; the mailbox lock is not held while it runs.
+        let ran = panic::catch_unwind(AssertUnwindSafe(|| run(generation, job, &current)));
+        *running_since() = None;
+        if let Err(payload) = ran {
+            if current() {
+                panicked(generation, panic_message(&*payload));
+            }
+        }
+    }
+}
+fn panic_message(payload: &(dyn Any + Send)) -> String {
+    if let Some(message) = payload.downcast_ref::<&str>() {
+        (*message).to_owned()
+    } else if let Some(message) = payload.downcast_ref::<String>() {
+        message.clone()
+    } else {
+        "unknown panic".to_owned()
+    }
+}
