+#[test]
+fn emaki_wallpaper_decoder_thread_survives_a_panic_and_runs_the_next_job() {
+    use std::sync::mpsc;
+
+    let wait = Duration::from_secs(10);
+    let (done, done_rx) = mpsc::channel();
+    let (failed, failed_rx) = mpsc::channel();
+    let mut decoder = assets::Decoder::new(move |generation, (): (), _current| {
+        assert_ne!(generation, 1, "decoder panic (expected by this test)");
+        done.send(generation).unwrap();
+    })
+    .on_panic(move |generation, message| failed.send((generation, message)).unwrap());
+    decoder.submit(1, ()).unwrap();
+    let (generation, message) = failed_rx.recv_timeout(wait).unwrap();
+    assert_eq!(generation, 1);
+    assert!(message.contains("expected by this test"), "{message}");
+    assert!(decoder.running(), "the thread ended with the panic");
+    decoder.submit(2, ()).unwrap();
+    assert_eq!(done_rx.recv_timeout(wait), Ok(2));
+    assert_eq!(decoder.threads_started(), 1);
+    assert!(failed_rx.try_recv().is_err());
+}
+
+/// A job submitted while a panicking job still unwinds: the thread is not finished, so
+/// `submit` starts no new one, and the job must still run.
+#[test]
+fn emaki_wallpaper_decoder_runs_a_job_submitted_while_a_panic_unwinds() {
+    use std::sync::mpsc;
+
+    struct SlowUnwind;
+    impl Drop for SlowUnwind {
+        fn drop(&mut self) {
+            if std::thread::panicking() {
+                std::thread::sleep(Duration::from_millis(500));
+            }
+        }
+    }
+    let (done, done_rx) = mpsc::channel();
+    let (panicking, panicking_rx) = mpsc::channel();
+    let mut decoder = assets::Decoder::new(move |generation, (): (), _current| {
+        if generation == 1 {
+            let _unwinding = SlowUnwind;
+            panicking.send(()).unwrap();
+            panic!("decoder panic (expected by this test)");
+        }
+        done.send(generation).unwrap();
+    });
+    decoder.submit(1, ()).unwrap();
+    panicking_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+    std::thread::sleep(Duration::from_millis(50));
+    decoder.submit(2, ()).unwrap();
+    assert_eq!(
+        done_rx.recv_timeout(Duration::from_secs(10)),
+        Ok(2),
+        "the job submitted during the unwinding never ran"
+    );
+    assert_eq!(decoder.threads_started(), 1);
+}
+
+/// A job that never returns (a read from a file on a hung network mount): a newer job must not
+/// wait behind it for good.
+#[test]
+fn emaki_wallpaper_decoder_leaves_a_stuck_job_to_its_thread() {
+    use std::sync::mpsc;
+    use std::sync::{Arc, Barrier};
+
+    let (done, done_rx) = mpsc::channel();
+    let (started, started_rx) = mpsc::channel();
+    let hung = Arc::new(Barrier::new(2));
+    let read = hung.clone();
+    let mut decoder = assets::Decoder::new(move |generation, (): (), current| {
+        started.send(generation).unwrap();
+        if generation == 1 {
+            // The blocking read; released only when the test ends.
+            read.wait();
+        }
+        done.send((generation, current())).unwrap();
+    })
+    .stuck_after(Duration::from_millis(300));
+    decoder.submit(1, ()).unwrap();
+    assert_eq!(started_rx.recv_timeout(Duration::from_secs(10)), Ok(1));
+    decoder.submit(2, ()).unwrap();
+    // Not stuck yet: job 2 waits for the same thread.
+    decoder.unstick().unwrap();
+    assert_eq!(decoder.threads_started(), 1);
+    // The event loop turns while job 2 waits.
+    let deadline = std::time::Instant::now() + Duration::from_secs(3);
+    let finished = loop {
+        decoder.unstick().unwrap();
+        if let Ok(finished) = done_rx.recv_timeout(Duration::from_millis(20)) {
+            break Some(finished);
+        }
+        if std::time::Instant::now() > deadline {
+            break None;
+        }
+    };
+    assert_eq!(
+        finished,
+        Some((2, true)),
+        "job 2 waited behind the stuck job"
+    );
+    assert_eq!(decoder.threads_started(), 2);
+    // Later jobs go to the new thread.
+    decoder.submit(3, ()).unwrap();
+    assert_eq!(done_rx.recv_timeout(Duration::from_secs(10)), Ok((3, true)));
+    assert_eq!(decoder.threads_started(), 2);
+    // The read returns at last: the abandoned job is stale and its thread ends.
+    hung.wait();
+    assert_eq!(
+        done_rx.recv_timeout(Duration::from_secs(10)),
+        Ok((1, false))
+    );
+}
