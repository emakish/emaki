+/// Fixed ring dimensions installed with the Emaki wallpaper assets.
+pub const WALLPAPER_RING_WIDTH: f64 = 19396.;
+pub const WALLPAPER_RING_HEIGHT: f64 = 1200.;
+
+/// Circular distance in ring texels.
+pub(super) fn wallpaper_distance(a: f64, b: f64) -> f64 {
+    let distance = (a - b).rem_euclid(WALLPAPER_RING_WIDTH);
+    distance.min(WALLPAPER_RING_WIDTH - distance)
+}
+
+pub(super) fn choose_wallpaper_start(
+    rng: &mut fastrand::Rng,
+    neighbors: &[f64],
+    separation: f64,
+) -> f64 {
+    // The largest empty arc's midpoint maximizes distance to the neighbors. This also
+    // bounds rejection sampling for physically impossible requests (e.g. an ultrawide
+    // output showing more than a quarter of the ring with two opposite neighbors).
+    let mut sorted = neighbors.to_vec();
+    sorted.sort_by(f64::total_cmp);
+    let farthest = sorted
+        .iter()
+        .enumerate()
+        .map(|(idx, &left)| {
+            let right = sorted
+                .get(idx + 1)
+                .copied()
+                .unwrap_or(sorted[0] + WALLPAPER_RING_WIDTH);
+            (
+                (right - left) / 2.,
+                ((left + right) / 2.).rem_euclid(WALLPAPER_RING_WIDTH),
+            )
+        })
+        .max_by(|a, b| a.0.total_cmp(&b.0));
+    if let Some((distance, candidate)) = farthest {
+        if distance <= separation {
+            return candidate;
+        }
+    }
+    for _ in 0..1024 {
+        let candidate = rng.f64() * WALLPAPER_RING_WIDTH;
+        if neighbors
+            .iter()
+            .all(|&other| wallpaper_distance(candidate, other) >= separation)
+        {
+            return candidate;
+        }
+    }
+    // An extremely narrow allowed arc should never block the compositor event loop.
+    farthest.map_or(0., |(_, candidate)| candidate)
+}
