+#[test]
+fn emaki_wallpaper_decoder_runs_only_the_latest_waiting_job() {
+    use std::sync::mpsc;
+    use std::sync::{Arc, Barrier};
+
+    let wait = Duration::from_secs(10);
+    let (started, started_rx) = mpsc::channel();
+    let (finished, finished_rx) = mpsc::channel();
+    let release = Arc::new(Barrier::new(2));
+    let blocker = release.clone();
+    let mut decoder = assets::Decoder::new(move |generation, job: u64, current| {
+        assert_eq!(generation, job);
+        started.send(generation).unwrap();
+        if generation == 1 {
+            blocker.wait();
+        }
+        // The stage boundary after the blocked stage.
+        finished.send((generation, current())).unwrap();
+    });
+    decoder.submit(1, 1).unwrap();
+    assert_eq!(started_rx.recv_timeout(wait), Ok(1));
+    decoder.submit(2, 2).unwrap();
+    decoder.submit(3, 3).unwrap();
+    release.wait();
+    // g1 learns at its next boundary that it is stale; g3 replaced the waiting g2.
+    assert_eq!(finished_rx.recv_timeout(wait), Ok((1, false)));
+    assert_eq!(started_rx.recv_timeout(wait), Ok(3));
+    assert_eq!(finished_rx.recv_timeout(wait), Ok((3, true)));
+    assert!(started_rx.recv_timeout(Duration::from_millis(200)).is_err());
+    assert_eq!(decoder.threads_started(), 1);
+}
