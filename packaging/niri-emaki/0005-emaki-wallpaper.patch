+//! Per-workspace indexed ring wallpaper. The compositor owns timing and geometry;
+//! wpaperd remains underneath whenever this engine has no complete valid scene.
+pub mod assets;
+mod train;
+
+use std::collections::{HashMap, HashSet};
+use std::rc::Rc;
+use std::time::Duration;
+
+use niri_config::{EmakiWallpaper, EmakiWallpaperMode};
+use smithay::backend::renderer::element::{Element, Kind};
+use smithay::backend::renderer::gles::{GlesRenderer, GlesTexture, Uniform};
+use smithay::backend::renderer::Texture;
+use smithay::utils::{Logical, Rectangle, Size};
+
+use self::assets::{GpuArt, Prepared, TrainArt, RAIL_Y, RING_HEIGHT, RING_WIDTH};
+use self::train::{screen_x, Schedule};
+use super::shader_element::ShaderRenderElement;
+use super::shaders::{ProgramType, Shaders};
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct View {
+    pub id: u64,
+    pub origin: f64,
+    pub size: Size<f64, Logical>,
+    pub scale: f64,
+    pub geo: Rectangle<f64, Logical>,
+    pub zoom: f64,
+    pub occluders: Vec<Rectangle<f64, Logical>>,
+}
+impl View {
+    pub fn art_scale(&self) -> f64 {
+        (self.size.h * self.scale / RING_HEIGHT as f64).max(1.)
+    }
+    pub fn width(&self) -> f64 {
+        self.size.w * self.scale / self.art_scale()
+    }
+    fn y_offset(&self) -> f64 {
+        (RING_HEIGHT as f64 - self.size.h * self.scale / self.art_scale()).max(0.)
+    }
+    fn rect(&self, x: f64, y: f64, w: f64, h: f64) -> Rectangle<f64, Logical> {
+        // Compute shared absolute art edges before converting to logical units.
+        // Multiplying a separately rounded location/width loses pixels at 1.2x.
+        let edge = |v: f64| (v * self.art_scale() * self.zoom).round() / (self.scale * self.zoom);
+        let left = edge(x);
+        let top = edge(y - self.y_offset());
+        Rectangle::new(
+            (left, top).into(),
+            (edge(x + w) - left, edge(y - self.y_offset() + h) - top).into(),
+        )
+    }
+    fn visible(&self, rect: Rectangle<f64, Logical>) -> bool {
+        let Some(rect) = rect.intersection(Rectangle::from_size(self.size)) else {
+            return false;
+        };
+        let placed = Rectangle::new(
+            rect.loc.upscale(self.zoom) + self.geo.loc,
+            rect.size.upscale(self.zoom),
+        );
+        placed
+            .intersection(Rectangle::from_size(self.size))
+            .is_some_and(|rect| {
+                !rect
+                    .subtract_rects(self.occluders.iter().copied())
+                    .is_empty()
+            })
+    }
+}
+
+#[derive(Default)]
+struct SceneCache {
+    signature: Option<[u64; 6]>,
+    ring: Vec<ShaderRenderElement>,
+    front: Vec<ShaderRenderElement>,
+    dynamic: HashMap<(u64, u32, u8), Dynamic>,
+}
+/// A vehicle or puff element with the inputs of its last update. Train positions are
+/// quantised to art pixels, so on a 120 Hz output every other frame repeats them; an
+/// element with unchanged inputs keeps its commit and leaves no damage. A move alone
+/// needs no commit: the damage tracker compares geometry itself. Textures change only
+/// with `Wallpaper::gpu`, which drops every scene cache.
+struct Dynamic {
+    element: ShaderRenderElement,
+    size: Size<f64, Logical>,
+    scale: f32,
+    uniforms: Rc<[Uniform<'static>]>,
+}
+impl Dynamic {
+    fn new(program: ProgramType) -> Self {
+        Self {
+            element: ShaderRenderElement::empty(program, Kind::Unspecified).with_nearest_sampling(),
+            size: Size::default(),
+            scale: 0.,
+            uniforms: Rc::new([]),
+        }
+    }
+    fn update(
+        &mut self,
+        size: Size<f64, Logical>,
+        scale: f32,
+        uniforms: Rc<[Uniform<'static>]>,
+        textures: impl FnOnce() -> HashMap<String, GlesTexture>,
+    ) {
+        if self.size == size && self.scale == scale && *self.uniforms == *uniforms {
+            return;
+        }
+        self.size = size;
+        self.scale = scale;
+        self.uniforms = uniforms.clone();
+        self.element
+            .update(size, None, scale, 1., uniforms, textures());
+    }
+}
+struct OutputScene {
+    schedule: Schedule,
+    views: Vec<View>,
+    active: View,
+    animated: bool,
+    deadline: Option<f64>,
+    now: f64,
+    prediction: Option<VisibilityPrediction>,
+}
+
+struct VisibilityPrediction {
+    views: Vec<View>,
+    trains: Vec<train::Train>,
+    checked_at: f64,
+    entry: Option<f64>,
+}
+
+#[derive(Default)]
+pub struct Wallpaper {
+    pub settings: Option<EmakiWallpaper>,
+    pub generation: u64,
+    pub load_state: &'static str,
+    pub error: Option<String>,
+    decoded: Option<Prepared>,
+    gpu: Option<GpuArt>,
+    pub upload_limit: Option<usize>,
+    reload_requested: bool,
+    art: Option<TrainArt>,
+    outputs: HashMap<String, OutputScene>,
+    scenes: HashMap<u64, SceneCache>,
+    rng: fastrand::Rng,
+    now: f64,
+    sample_now: Option<f64>,
+    last_clock: Option<Duration>,
+    paused: bool,
+}
+impl Wallpaper {
+    /// Called only on a successful config reload, never by frame refresh.
+    pub fn retry_failed(&mut self) {
+        if self.load_state == "failed" {
+            self.settings = None;
+        }
+    }
+    /// Returns a new worker generation only when asset configuration changes.
+    pub fn configure(&mut self, settings: &EmakiWallpaper) -> Option<u64> {
+        if self.reload_requested && settings.mode != EmakiWallpaperMode::Image {
+            self.reload_requested = false;
+            self.generation = self.generation.wrapping_add(1);
+            self.load_state = "loading";
+            return Some(self.generation);
+        }
+        if self.settings.as_ref() == Some(settings) {
+            return None;
+        }
+        let reload = self.settings.as_ref().is_none_or(|old| {
+            old.mode != settings.mode
+                || old.ring != settings.ring
+                || old.front != settings.front
+                || old.train_frames != settings.train_frames
+                || old.train != settings.train
+        });
+        self.reload_requested = false;
+        self.settings = Some(settings.clone());
+        self.outputs.clear();
+        if !reload {
+            return None;
+        }
+        self.generation = self.generation.wrapping_add(1);
+        self.decoded = None;
+        self.gpu = None;
+        self.art = None;
+        self.scenes.clear();
+        self.error = None;
+        if settings.mode == EmakiWallpaperMode::Image {
+            self.load_state = "image";
+            None
+        } else {
+            self.load_state = "loading";
+            Some(self.generation)
+        }
+    }
+    pub fn loaded(&mut self, generation: u64, decoded: anyhow::Result<Prepared>) {
+        if generation != self.generation {
+            return;
+        }
+        match decoded {
+            Ok(decoded) => {
+                self.art = Some(decoded.train.clone());
+                self.decoded = Some(decoded);
+            }
+            Err(err) => self.fail(err),
+        }
+    }
+    fn fail(&mut self, err: anyhow::Error) {
+        warn!("Emaki wallpaper unavailable; showing background layer: {err:#}");
+        self.load_state = "failed";
+        self.error = Some(format!("{err:#}"));
+        self.decoded = None;
+        self.gpu = None;
+        self.art = None;
+        self.outputs.clear();
+        self.scenes.clear();
+    }
+    pub fn clock(&mut self, time: Duration, paused: bool) {
+        if let Some(previous) = self.last_clock {
+            if !self.paused && !paused {
+                self.now += time.saturating_sub(previous).as_secs_f64();
+            }
+        }
+        self.last_clock = Some(self.last_clock.map_or(time, |old| old.max(time)));
+        // The scheduler retains a high-water mark, but each output renders at its
+        // own presentation timestamp. A slow display must not quantize a fast one.
+        self.sample_now =
+            Some((self.now - self.last_clock.unwrap().saturating_sub(time).as_secs_f64()).max(0.));
+        self.paused = paused;
+        if paused {
+            for output in self.outputs.values_mut() {
+                output.animated = false;
+                output.deadline = None;
+            }
+        }
+    }
+    pub fn retain(&mut self, outputs: &HashSet<String>, workspaces: &HashSet<u64>) {
+        self.outputs.retain(|name, _| outputs.contains(name));
+        self.scenes
+            .retain(|id, _| workspaces.contains(&(id & !(1 << 63))));
+    }
+    pub fn update_output(&mut self, name: String, active: View, views: Vec<View>) {
+        if self.paused || self.art.is_none() {
+            return;
+        }
+        let art = self.art.as_ref().unwrap();
+        let settings = self.settings.as_ref().unwrap();
+        let scene = self.outputs.entry(name).or_insert_with(|| OutputScene {
+            schedule: Schedule::default(),
+            views: Vec::new(),
+            active: active.clone(),
+            animated: false,
+            deadline: None,
+            now: self.sample_now.unwrap_or(self.now),
+            prediction: None,
+        });
+        scene.now = scene.now.max(self.sample_now.unwrap_or(self.now));
+        let now = scene.now;
+        scene.active = active;
+        let mut views = views;
+        for view in &mut views {
+            if let Some(old) = scene.views.iter().find(|old| old.id == view.id) {
+                view.occluders.clone_from(&old.occluders);
+            }
+        }
+        scene.views = views;
+        if !settings.trains {
+            scene.schedule = Schedule::default();
+            scene.animated = false;
+            scene.deadline = None;
+            return;
+        }
+        scene.schedule.update(
+            now,
+            scene.active.origin,
+            scene.active.width(),
+            &scene
+                .views
+                .iter()
+                .map(|v| (v.origin, v.width()))
+                .collect::<Vec<_>>(),
+            art,
+            settings.train_gap,
+            &mut self.rng,
+        );
+        refresh_visibility(scene, art, now);
+    }
+
+    /// Capture the opaque regions above each workspace wallpaper from the real
+    /// front-to-back output list. Captures never overwrite display visibility.
+    pub fn record_occlusion<E: Element>(&mut self, output: &str, scale: f64, elements: &[E]) {
+        let Some(scene) = self.outputs.get_mut(output) else {
+            return;
+        };
+        let Some(art) = &self.art else {
+            return;
+        };
+        let markers = scene
+            .views
+            .iter()
+            .flat_map(|v| {
+                self.scenes.get(&v.id).into_iter().flat_map(move |cache| {
+                    cache
+                        .front
+                        .iter()
+                        .map(move |element| (element.id().clone(), v.id))
+                })
+            })
+            .collect::<HashMap<_, _>>();
+        let mut opaque = Vec::new();
+        for element in elements {
+            if let Some(id) = markers.get(element.id()) {
+                if let Some(view) = scene.views.iter_mut().find(|v| v.id == *id) {
+                    view.occluders.clone_from(&opaque);
+                }
+            }
+            let location = element.geometry(scale.into()).loc;
+            for mut region in element.opaque_regions(scale.into()) {
+                region.loc += location;
+                opaque.push(region.to_f64().to_logical(scale));
+            }
+        }
+        refresh_visibility(scene, art, scene.now);
+    }
+    pub fn animated(&self, output: &str) -> bool {
+        !self.paused && self.outputs.get(output).is_some_and(|s| s.animated)
+    }
+    pub fn wake_after(&self) -> Option<Duration> {
+        if self.paused {
+            return None;
+        }
+        self.outputs
+            .values()
+            .filter_map(|s| s.deadline)
+            .min_by(f64::total_cmp)
+            .and_then(|t| Duration::try_from_secs_f64((t - self.now).max(0.001)).ok())
+    }
+    pub fn output_status(&self, name: &str) -> Vec<niri_ipc::EmakiWallpaperTrain> {
+        if self.paused {
+            return vec![];
+        }
+        let (Some(scene), Some(art)) = (self.outputs.get(name), self.art.as_ref()) else {
+            return vec![];
+        };
+        scene
+            .schedule
+            .trains
+            .iter()
+            .filter(|t| {
+                scene.views.iter().any(|v| {
+                    v.visible(v.rect(
+                        screen_x(t.x(scene.now), v.origin),
+                        RAIL_Y - art.height as f64,
+                        art.length(t.carriages),
+                        art.height as f64 + 1.,
+                    ))
+                })
+            })
+            .map(|t| niri_ipc::EmakiWallpaperTrain {
+                x: t.x(scene.now).rem_euclid(RING_WIDTH as f64),
+                travelled: t.travelled(scene.now),
+                carriages: t.carriages,
+                frame: art.frame(t.travelled(scene.now)),
+            })
+            .collect()
+    }
+    pub fn render_static(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        view: &View,
+    ) -> Vec<ShaderRenderElement> {
+        let mut view = view.clone();
+        view.id |= 1 << 63;
+        view.zoom = 1.;
+        self.render(renderer, "", &view)
+    }
+    pub fn render(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        output: &str,
+        view: &View,
+    ) -> Vec<ShaderRenderElement> {
+        if self.paused {
+            return vec![];
+        }
+        if self
+            .gpu
+            .as_ref()
+            .is_some_and(|gpu| !Rc::ptr_eq(&gpu.context, &assets::context_token(renderer)))
+        {
+            self.gpu = None;
+            self.decoded = None;
+            self.scenes.clear();
+            self.reload_requested = true;
+            self.load_state = "loading";
+        }
+        if self.gpu.is_none() {
+            if let Some(decoded) = self.decoded.take() {
+                let limit = match assets::texture_limit(renderer) {
+                    Ok(limit) => limit,
+                    Err(err) => {
+                        self.fail(err);
+                        return vec![];
+                    }
+                };
+                self.upload_limit = Some(limit);
+                if limit < decoded.max_size {
+                    self.reload_requested = true;
+                    return vec![];
+                }
+                if Shaders::get(renderer).emaki_wallpaper.is_none()
+                    || Shaders::get(renderer).emaki_puff.is_none()
+                {
+                    self.fail(anyhow::anyhow!("wallpaper shader unavailable"));
+                    return vec![];
+                }
+                match GpuArt::upload(renderer, &decoded) {
+                    Ok(gpu) => {
+                        // Retained elements compare their inputs, not their textures.
+                        self.scenes.clear();
+                        self.gpu = Some(gpu);
+                        self.load_state = "ready";
+                    }
+                    Err(err) => {
+                        self.fail(err);
+                        return vec![];
+                    }
+                }
+            }
+        }
+        let Some(gpu) = &self.gpu else {
+            return vec![];
+        };
+        let now = self.sample_now.unwrap_or(self.now);
+        let cache = self.scenes.entry(view.id).or_default();
+        let signature = [
+            view.origin.to_bits(),
+            view.size.w.to_bits(),
+            view.size.h.to_bits(),
+            view.scale.to_bits(),
+            view.art_scale().to_bits(),
+            view.zoom.to_bits(),
+        ];
+        if cache.signature != Some(signature) {
+            // Keep identities for unchanged geometry; camera motion damages the ring,
+            // train-only frames never touch these retained static elements.
+            update_ring(&mut cache.ring, &gpu.ring, gpu, view, true);
+            update_ring(&mut cache.front, &gpu.front, gpu, view, false);
+            cache.signature = Some(signature);
+        }
+        let mut result = cache.front.clone();
+        let mut train_elements = Vec::new();
+        let mut keys = HashSet::new();
+        if let Some(scene) = self.outputs.get(output) {
+            let art = &gpu.train;
+            for train in &scene.schedule.trains {
+                for p in train.puffs(now, art) {
+                    let (x, y, size, radius) = p.geometry(now);
+                    let rect = view.rect(screen_x(x, view.origin), y, size, size);
+                    if !view.visible(rect) {
+                        continue;
+                    }
+                    let key = (train.id, p.chuff, if p.steam { 5 } else { 4 });
+                    keys.insert(key);
+                    let uniforms = Rc::from(vec![
+                        Uniform::new("puff", [size as f32, radius as f32, p.fade(now), p.dither]),
+                        Uniform::new("lobes", p.lobes),
+                        Uniform::new(
+                            "tones",
+                            if p.steam {
+                                [63., 63., 60., 0.]
+                            } else {
+                                [63., 60., 49., 0.]
+                            },
+                        ),
+                    ]);
+                    let elem = cache
+                        .dynamic
+                        .entry(key)
+                        .or_insert_with(|| Dynamic::new(ProgramType::EmakiPuff));
+                    elem.update(rect.size, view.scale as f32, uniforms, || {
+                        HashMap::from([("palette_tex".into(), gpu.palette.clone())])
+                    });
+                    result.push(elem.element.clone().with_location(rect.loc));
+                }
+                let frame = art.frame(train.travelled(now));
+                let first = art.first(train.carriages);
+                let x = screen_x(train.x(now), view.origin).round();
+                for (vehicle, &[a, b]) in art
+                    .vehicles
+                    .iter()
+                    .enumerate()
+                    .skip(3 - train.carriages as usize)
+                {
+                    let rect = view.rect(
+                        x + (a - first) as f64,
+                        RAIL_Y - art.height as f64 + train.dip(now, first, a, b),
+                        (b - a) as f64,
+                        art.height as f64,
+                    );
+                    if !view.visible(rect) {
+                        continue;
+                    }
+                    let key = (train.id, 0, vehicle as u8);
+                    keys.insert(key);
+                    let elem = cache
+                        .dynamic
+                        .entry(key)
+                        .or_insert_with(|| Dynamic::new(ProgramType::EmakiWallpaper));
+                    let source = [
+                        a as f64,
+                        (frame as usize * art.height) as f64,
+                        (b - a) as f64,
+                        art.height as f64,
+                    ];
+                    elem.update(
+                        rect.size,
+                        view.scale as f32,
+                        indexed_uniforms(source, &gpu.frames, view, 0),
+                        || indexed_textures(&gpu.frames, &gpu.palette),
+                    );
+                    train_elements.push(elem.element.clone().with_location(rect.loc));
+                }
+            }
+        }
+        cache.dynamic.retain(|key, _| keys.contains(key));
+        result.extend(train_elements);
+        result.extend(cache.ring.iter().cloned());
+        result
+            .into_iter()
+            .map(|e| e.with_physical_edges(view.scale, view.zoom))
+            .collect()
+    }
+}
+fn refresh_visibility(scene: &mut OutputScene, art: &TrainArt, now: f64) {
+    // Time advances analytically. Unchanged hidden scenes need no puff work until
+    // the cached entry deadline; a camera/occlusion/train change invalidates it.
+    let cached = scene.prediction.as_ref().is_some_and(|p| {
+        p.views == scene.views
+            && p.trains == scene.schedule.trains
+            && now >= p.checked_at
+            && p.entry.is_none_or(|entry| now < entry)
+    });
+    if cached {
+        scene.animated = false;
+    } else {
+        scene.animated = scene.views.iter().any(|view| {
+            scene.schedule.trains.iter().any(|train| {
+                let x = screen_x(train.x(now), view.origin).round();
+                if x < -art.length(train.carriages) - 32. || x > view.width() + 350. {
+                    return false;
+                }
+                view.visible(view.rect(
+                    x,
+                    RAIL_Y - art.height as f64,
+                    art.length(train.carriages),
+                    art.height as f64 + 1.,
+                )) || train.puffs(now, art).iter().any(|p| {
+                    let (x, y, size, _) = p.geometry(now);
+                    view.visible(view.rect(screen_x(x, view.origin), y, size, size))
+                })
+            })
+        });
+    }
+    let origins = scene.views.iter().map(|v| v.origin).collect::<Vec<_>>();
+    scene.deadline = scene.schedule.deadline(
+        now,
+        scene.active.origin,
+        scene.active.width(),
+        &origins,
+        art,
+    );
+    if scene.animated {
+        scene.prediction = None;
+    } else {
+        if !cached {
+            let entry = [
+                next_uncovered_entry(now, scene, art),
+                next_puff_entry(now, scene, art),
+            ]
+            .into_iter()
+            .flatten()
+            .min_by(f64::total_cmp);
+            scene.prediction = Some(VisibilityPrediction {
+                views: scene.views.clone(),
+                trains: scene.schedule.trains.clone(),
+                checked_at: now,
+                entry,
+            });
+        }
+        if let Some(entry) = scene.prediction.as_ref().and_then(|p| p.entry) {
+            scene.deadline = Some(scene.deadline.map_or(entry, |deadline| deadline.min(entry)));
+        }
+    }
+}
+
+fn next_uncovered_entry(now: f64, scene: &OutputScene, art: &TrainArt) -> Option<f64> {
+    let mut next: Option<f64> = None;
+    for view in &scene.views {
+        let Some(area) = view.geo.intersection(Rectangle::from_size(view.size)) else {
+            continue;
+        };
+        if view.zoom <= 0. {
+            continue;
+        }
+        for open in area.subtract_rects(view.occluders.iter().copied()) {
+            let unit = view.scale / view.art_scale() / view.zoom;
+            let left = (open.loc.x - view.geo.loc.x) * unit;
+            let top = (open.loc.y - view.geo.loc.y) * unit + view.y_offset();
+            let bottom = top + open.size.h * unit;
+            if top > RAIL_Y + 1. || bottom < 690. {
+                continue;
+            }
+            for train in &scene.schedule.trains {
+                let x = screen_x(train.x(now), view.origin);
+                // The train's leading edge, plus the bounded forward smoke carry.
+                for margin in [0., 32.] {
+                    if margin == 0. && (top > RAIL_Y + 1. || bottom < RAIL_Y - art.height as f64) {
+                        continue;
+                    }
+                    let ahead = x + art.length(train.carriages) + margin;
+                    if ahead <= left {
+                        let time = now + (left - ahead + 0.5) / train::SPEED;
+                        next = Some(next.map_or(time, |old| old.min(time)));
+                    }
+                }
+            }
+        }
+    }
+    next
+}
+
+fn next_puff_entry(now: f64, scene: &OutputScene, art: &TrainArt) -> Option<f64> {
+    let candidates = scene
+        .views
+        .iter()
+        .filter(|view| view.visible(view.rect(0., 690., view.width(), RAIL_Y - 690.)))
+        .collect::<Vec<_>>();
+    if candidates.is_empty() || scene.schedule.trains.is_empty() {
+        return None;
+    }
+    // Jump over empty horizontal ranges analytically, including a possible wrap.
+    // The generous envelope covers the entire 4.025 s smoke trail and rounding.
+    let mut intervals = Vec::new();
+    for (index, train) in scene.schedule.trains.iter().enumerate() {
+        let death = train.born + RING_WIDTH as f64 / train::SPEED;
+        for view in &candidates {
+            let x = screen_x(train.x(now), view.origin);
+            for lap in [0., RING_WIDTH as f64] {
+                let start = now + (-art.length(train.carriages) - 32. - x + lap) / train::SPEED;
+                let end = (now + (view.width() + 350. - x + lap) / train::SPEED).min(death);
+                if end > now && start < end {
+                    intervals.push((start.max(now), end, index));
+                }
+            }
+        }
+    }
+    intervals.sort_by(|a, b| a.0.total_cmp(&b.0));
+    let mut merged: Vec<(f64, f64)> = Vec::new();
+    for (start, end, _) in intervals {
+        if let Some(last) = merged.last_mut().filter(|last| start <= last.1) {
+            last.1 = last.1.max(end);
+        } else {
+            merged.push((start, end));
+        }
+    }
+    let mut evaluations = 0;
+    for (start, end) in merged {
+        let mut time = start + 1. / 120.;
+        while time <= end {
+            for train in &scene.schedule.trains {
+                if time >= train.born + RING_WIDTH as f64 / train::SPEED {
+                    continue;
+                }
+                let in_range = |view: &&View| {
+                    let x = screen_x(train.x(time), view.origin);
+                    x >= -art.length(train.carriages) - 32. && x <= view.width() + 350.
+                };
+                if !candidates.iter().any(in_range) {
+                    continue;
+                }
+                // Conservative wake before unexamined visibility. Cache it between
+                // deadlines: even pathological occlusion cannot stall a frame.
+                if evaluations == 512 {
+                    return Some(time);
+                }
+                evaluations += 1;
+                let puffs = train.puffs(time, art);
+                if candidates.iter().filter(|view| in_range(view)).any(|view| {
+                    puffs.iter().any(|p| {
+                        let (x, y, size, _) = p.geometry(time);
+                        view.visible(view.rect(screen_x(x, view.origin), y, size, size))
+                    })
+                }) {
+                    return Some(time);
+                }
+            }
+            time += 1. / 120.;
+        }
+    }
+    None
+}
+
+fn indexed_uniforms(
+    source: [f64; 4],
+    texture: &GlesTexture,
+    view: &View,
+    atlas_stride: usize,
+) -> Rc<[Uniform<'static>]> {
+    let tex = texture.size();
+    let footprint = (1. / (view.art_scale() * view.zoom)) as f32;
+    Rc::from(vec![
+        Uniform::new("tex_size", [tex.w as f32, tex.h as f32]),
+        Uniform::new("source_rect", source.map(|v| v as f32)),
+        Uniform::new("footprint", [footprint, footprint]),
+        Uniform::new("atlas_stride", atlas_stride as f32),
+    ])
+}
+fn indexed_textures(texture: &GlesTexture, palette: &GlesTexture) -> HashMap<String, GlesTexture> {
+    HashMap::from([
+        ("indices".into(), texture.clone()),
+        ("palette_tex".into(), palette.clone()),
+    ])
+}
+fn update_indexed(
+    element: &mut ShaderRenderElement,
+    rect: Rectangle<f64, Logical>,
+    source: [f64; 4],
+    texture: &GlesTexture,
+    palette: &GlesTexture,
+    view: &View,
+    atlas_stride: usize,
+    opaque: bool,
+) {
+    element.update(
+        rect.size,
+        opaque.then(|| vec![Rectangle::from_size(rect.size)]),
+        view.scale as f32,
+        1.,
+        indexed_uniforms(source, texture, view, atlas_stride),
+        indexed_textures(texture, palette),
+    );
+}
+fn ring_origin(origin: f64, art_scale: f64) -> f64 {
+    let origin = if art_scale == 1. {
+        origin.round()
+    } else {
+        origin
+    };
+    let wrapped = origin.rem_euclid(RING_WIDTH as f64);
+    if wrapped >= RING_WIDTH as f64 {
+        0.
+    } else {
+        wrapped
+    }
+}
+fn update_ring(
+    elements: &mut Vec<ShaderRenderElement>,
+    tiles: &[assets::Tile],
+    gpu: &GpuArt,
+    view: &View,
+    opaque: bool,
+) {
+    let origin = ring_origin(view.origin, view.art_scale());
+    if let Some(tile) = tiles.first().filter(|t| t.atlas_stride != 0) {
+        elements.truncate(1);
+        if elements.is_empty() {
+            elements.push(
+                ShaderRenderElement::empty(ProgramType::EmakiWallpaper, Kind::Unspecified)
+                    .with_nearest_sampling(),
+            );
+        }
+        update_indexed(
+            &mut elements[0],
+            Rectangle::from_size(view.size),
+            [
+                origin,
+                view.y_offset(),
+                view.width(),
+                RING_HEIGHT as f64 - view.y_offset(),
+            ],
+            &tile.texture,
+            &gpu.palette,
+            view,
+            tile.atlas_stride,
+            opaque,
+        );
+        return;
+    }
+    let width = view.width();
+    let mut x = 0.;
+    let mut index = 0;
+    while x < width - 0.00001 {
+        let world = ring_origin(origin + x, 2.);
+        let Some(tile) = tiles
+            .iter()
+            .find(|t| world >= t.start as f64 && world < (t.start + t.width) as f64)
+        else {
+            break;
+        };
+        let count = (width - x).min((tile.start + tile.width) as f64 - world);
+        let px = (x * view.art_scale() * view.zoom).round() / view.zoom;
+        let end = ((x + count) * view.art_scale() * view.zoom).round() / view.zoom;
+        let source_x = world - tile.start as f64 + 1. + px / view.art_scale() - x;
+        let source_width = (end - px) / view.art_scale();
+        let rect = Rectangle::new(
+            (px / view.scale, 0.).into(),
+            ((end - px) / view.scale, view.size.h).into(),
+        );
+        if index == elements.len() {
+            elements.push(
+                ShaderRenderElement::empty(ProgramType::EmakiWallpaper, Kind::Unspecified)
+                    .with_nearest_sampling(),
+            );
+        }
+        update_indexed(
+            &mut elements[index],
+            rect,
+            [
+                source_x,
+                view.y_offset(),
+                source_width,
+                RING_HEIGHT as f64 - view.y_offset(),
+            ],
+            &tile.texture,
+            &gpu.palette,
+            view,
+            0,
+            opaque,
+        );
+        elements[index] = elements[index].clone().with_location(rect.loc);
+        index += 1;
+        x += count;
+    }
+    elements.truncate(index);
+}
