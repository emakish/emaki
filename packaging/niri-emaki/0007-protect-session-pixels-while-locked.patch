+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Session pixels must not enter output rendering or captures while locked.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+use niri_config::Config;
+use smithay::backend::allocator::Fourcc;
+use smithay::desktop::layer_map_for_output;
+use smithay::input::pointer::{CursorImageStatus, CursorImageSurfaceData};
+use smithay::reexports::wayland_protocols::ext::session_lock::v1::client::{
+    ext_session_lock_manager_v1::ExtSessionLockManagerV1,
+    ext_session_lock_surface_v1::{self, ExtSessionLockSurfaceV1},
+    ext_session_lock_v1::{self, ExtSessionLockV1},
+};
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::{
+    zwlr_layer_shell_v1::Layer, zwlr_layer_surface_v1::Anchor,
+};
+use smithay::utils::{Scale, Transform};
+use smithay::wayland::compositor::with_states;
+use wayland_client::protocol::wl_registry::WlRegistry;
+use wayland_client::protocol::wl_surface::WlSurface;
+use wayland_client::{Connection, Dispatch, Proxy as _, QueueHandle};
+
+use super::client::{self, ClientId, LayerConfigureProps};
+use super::Fixture;
+use crate::niri::{DndIcon, LockState};
+use crate::render_helpers::{render_to_vec, RenderCtx, RenderTarget};
+
+const SIZE: (u16, u16) = (32, 24);
+const SESSION_PIXEL: [u8; 4] = [255, 0, 0, 255];
+const LOCK_PIXEL: [u8; 4] = [0, 0, 255, 255];
+const TARGETS: [RenderTarget; 3] = [
+    RenderTarget::Output,
+    RenderTarget::ScreenCapture,
+    RenderTarget::Screencast,
+];
+
+struct LockRegistry;
+
+struct Lock {
+    client: ClientId,
+    lock: ExtSessionLockV1,
+    lock_surface: ExtSessionLockSurfaceV1,
+    surface: WlSurface,
+}
+
+fn fixture() -> Fixture {
+    let config = Config::parse_mem("hotkey-overlay { skip-at-startup; }").unwrap();
+    let mut f = Fixture::with_config(config);
+    f.niri_state().backend.headless().add_renderer().unwrap();
+    f.add_output(1, SIZE);
+    let id = f.add_client();
+    let layer = f.client(id).create_layer(None, Layer::Overlay, "session");
+    let surface = layer.surface.clone();
+    layer.set_configure_props(LayerConfigureProps {
+        anchor: Some(Anchor::Top | Anchor::Left),
+        size: Some((u32::from(SIZE.0), u32::from(SIZE.1))),
+        ..Default::default()
+    });
+    layer.commit();
+    f.roundtrip(id);
+    let layer = f.client(id).layer(&surface);
+    let buffer = layer
+        .spbm
+        .create_u32_rgba_buffer(u32::MAX, 0, 0, u32::MAX, &layer.qh, ());
+    layer.surface.attach(Some(&buffer), 0, 0);
+    layer.set_size(SIZE.0, SIZE.1);
+    layer.ack_last_and_commit();
+    f.double_roundtrip(id);
+    f
+}
+
+fn lock(f: &mut Fixture) -> Lock {
+    let id = f.add_client();
+    f.roundtrip(id);
+    let client = f.client(id);
+    let registry = client.display.get_registry(&client.qh, LockRegistry);
+    let global = client
+        .state
+        .globals
+        .iter()
+        .find(|g| g.interface == ExtSessionLockManagerV1::interface().name)
+        .unwrap();
+    let manager: ExtSessionLockManagerV1 = registry.bind(global.name, 1, &client.qh, ());
+    let locked = Arc::new(AtomicBool::new(false));
+    let lock = manager.lock(&client.qh, locked.clone());
+    let surface = client
+        .state
+        .compositor
+        .as_ref()
+        .unwrap()
+        .create_surface(&client.qh, ());
+    let lock_surface =
+        lock.get_lock_surface(&surface, &client.output("headless-1"), &client.qh, ());
+    let viewport = client
+        .state
+        .viewporter
+        .as_ref()
+        .unwrap()
+        .get_viewport(&surface, &client.qh, ());
+    f.roundtrip(id);
+    let client = f.client(id);
+    let buffer = client.state.spbm.as_ref().unwrap().create_u32_rgba_buffer(
+        0,
+        0,
+        u32::MAX,
+        u32::MAX,
+        &client.qh,
+        (),
+    );
+    viewport.set_destination(i32::from(SIZE.0), i32::from(SIZE.1));
+    surface.attach(Some(&buffer), 0, 0);
+    surface.commit();
+    f.double_roundtrip(id);
+    assert!(f.niri().is_locked());
+    assert!(locked.load(Ordering::Relaxed), "lock was not acknowledged");
+    Lock {
+        client: id,
+        lock,
+        lock_surface,
+        surface,
+    }
+}
+
+fn pixels(f: &mut Fixture, target: RenderTarget) -> Vec<u8> {
+    let output = f.niri_output(1);
+    let state = f.niri_state();
+    state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let elements = state.niri.render_to_vec(
+                RenderCtx {
+                    renderer,
+                    target,
+                    xray: None,
+                    capture_client: None,
+                },
+                &output,
+                false,
+            );
+            render_to_vec(
+                renderer,
+                output.current_mode().unwrap().size,
+                Scale::from(1.),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap()
+        })
+        .unwrap()
+}
+
+fn pointer_element_count(f: &mut Fixture) -> usize {
+    let output = f.niri_output(1);
+    let state = f.niri_state();
+    state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let mut count = 0;
+            state
+                .niri
+                .render_pointer(renderer, &output, &mut |_| count += 1);
+            count
+        })
+        .unwrap()
+}
+
+#[test]
+fn egl_lock_without_client_hides_session_elements() {
+    use smithay::reexports::wayland_protocols::ext::session_lock::v1::server::ext_session_lock_v1::ExtSessionLockV1;
+    use smithay::reexports::wayland_server::{backend::ObjectId, Resource as _};
+
+    let config = Config::parse_mem(
+        r##"hotkey-overlay { skip-at-startup; }
+layout { background-color "#ff0000"; }"##,
+    )
+    .unwrap();
+    let mut f = Fixture::with_config(config);
+    f.niri_state().backend.headless().add_renderer().unwrap();
+    f.add_output(1, SIZE);
+    let session = SESSION_PIXEL.repeat(usize::from(SIZE.0) * usize::from(SIZE.1));
+    for target in TARGETS {
+        assert_eq!(pixels(&mut f, target), session);
+    }
+
+    // A dead resource represents a locked session after its locker has disconnected.
+    // No client connection is needed to exercise the shared rendering path.
+    let lock = ExtSessionLockV1::from_id(&f.niri().display_handle, ObjectId::null()).unwrap();
+    f.niri().lock_state = LockState::Locked(lock.clone());
+    let background = pixels(&mut f, RenderTarget::Output);
+    assert!(background.chunks_exact(4).all(|px| px == &background[..4]));
+    assert_ne!(&background[..4], SESSION_PIXEL);
+
+    f.niri().lock_state = LockState::Unlocked;
+    let state = f.niri_state();
+    state.backend.with_primary_renderer(|renderer| {
+        state.niri.do_screen_transition(renderer, Some(u16::MAX));
+    });
+    f.niri().lock_state = LockState::Locked(lock.clone());
+    for target in TARGETS {
+        assert_eq!(
+            pixels(&mut f, target),
+            background,
+            "cached session transition leaked into {target:?}"
+        );
+    }
+
+    f.niri().config_error_notification.show();
+    f.niri_complete_animations();
+    for target in TARGETS {
+        assert_eq!(
+            pixels(&mut f, target),
+            background,
+            "session notification leaked into {target:?}"
+        );
+    }
+
+    // An exit dialog opened before locking retains focus and must remain visible.
+    f.niri().lock_state = LockState::Unlocked;
+    assert!(f.niri().exit_confirm_dialog.show());
+    f.niri_complete_animations();
+    f.niri().lock_state = LockState::Locked(lock);
+    for target in TARGETS {
+        assert_ne!(
+            pixels(&mut f, target),
+            background,
+            "exit dialog hidden in {target:?}"
+        );
+    }
+}
+
+#[test]
+fn egl_lock_excludes_cached_screen_transition() {
+    let mut f = fixture();
+    let session = SESSION_PIXEL.repeat(usize::from(SIZE.0) * usize::from(SIZE.1));
+    for target in TARGETS {
+        assert_eq!(pixels(&mut f, target), session);
+    }
+    let state = f.niri_state();
+    state.backend.with_primary_renderer(|renderer| {
+        state.niri.do_screen_transition(renderer, Some(u16::MAX));
+    });
+    let lock = lock(&mut f);
+    for target in TARGETS {
+        assert_eq!(
+            pixels(&mut f, target),
+            LOCK_PIXEL.repeat(usize::from(SIZE.0) * usize::from(SIZE.1)),
+            "session transition leaked into {target:?}"
+        );
+    }
+    lock.lock.unlock_and_destroy();
+    f.double_roundtrip(lock.client);
+    assert!(!f.niri().is_locked());
+    for target in TARGETS {
+        assert_eq!(pixels(&mut f, target), session);
+    }
+}
+
+#[test]
+fn egl_lock_without_surface_excludes_session_ui() {
+    let mut f = fixture();
+    let lock = lock(&mut f);
+    lock.lock_surface.destroy();
+    lock.surface.destroy();
+    f.double_roundtrip(lock.client);
+    assert!(f.niri().is_locked());
+    let background = pixels(&mut f, RenderTarget::Output);
+    assert!(background.chunks_exact(4).all(|px| px == &background[..4]));
+    assert_ne!(&background[..4], SESSION_PIXEL);
+    assert_ne!(&background[..4], LOCK_PIXEL);
+    f.niri().config_error_notification.show();
+    f.niri_complete_animations();
+    for target in TARGETS {
+        assert_eq!(pixels(&mut f, target), background);
+    }
+
+    // Quit can also open the dialog after locking; its keyboard focus must be visible.
+    assert!(f.niri().exit_confirm_dialog.show());
+    f.niri_complete_animations();
+    for target in TARGETS {
+        assert_ne!(
+            pixels(&mut f, target),
+            background,
+            "exit dialog hidden in {target:?}"
+        );
+    }
+}
+
+#[test]
+fn egl_lock_excludes_session_pointer_surfaces() {
+    let mut f = fixture();
+    let output = f.niri_output(1);
+    let surface = layer_map_for_output(&output)
+        .layers()
+        .next()
+        .unwrap()
+        .wl_surface()
+        .clone();
+    f.niri()
+        .cursor_manager
+        .set_cursor_image(CursorImageStatus::Hidden);
+    f.niri().dnd_icon = Some(DndIcon {
+        surface: surface.clone(),
+        offset: (0, 0).into(),
+    });
+    assert!(pointer_element_count(&mut f) > 0);
+    let _lock = lock(&mut f);
+    f.niri()
+        .cursor_manager
+        .set_cursor_image(CursorImageStatus::Hidden);
+    assert_eq!(pointer_element_count(&mut f), 0);
+    // A session client may still try to update its cursor after the lock starts.
+    f.niri().dnd_icon = None;
+    with_states(&surface, |states| {
+        states
+            .data_map
+            .insert_if_missing(CursorImageSurfaceData::default);
+    });
+    f.niri()
+        .cursor_manager
+        .set_cursor_image(CursorImageStatus::Surface(surface));
+    assert_eq!(pointer_element_count(&mut f), 0);
+}
+
+wayland_client::delegate_noop!(client::State: ignore ExtSessionLockManagerV1);
+
+impl Dispatch<WlRegistry, LockRegistry> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &WlRegistry,
+        _event: <WlRegistry as wayland_client::Proxy>::Event,
+        _data: &LockRegistry,
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ExtSessionLockV1, Arc<AtomicBool>> for client::State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &ExtSessionLockV1,
+        event: ext_session_lock_v1::Event,
+        data: &Arc<AtomicBool>,
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        match event {
+            ext_session_lock_v1::Event::Locked => data.store(true, Ordering::Relaxed),
+            ext_session_lock_v1::Event::Finished => panic!("session lock refused"),
+            _ => (),
+        }
+    }
+}
+
+impl Dispatch<ExtSessionLockSurfaceV1, ()> for client::State {
+    fn event(
+        _state: &mut Self,
+        proxy: &ExtSessionLockSurfaceV1,
+        event: ext_session_lock_surface_v1::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        if let ext_session_lock_surface_v1::Event::Configure { serial, .. } = event {
+            proxy.ack_configure(serial);
+        }
+    }
+}
