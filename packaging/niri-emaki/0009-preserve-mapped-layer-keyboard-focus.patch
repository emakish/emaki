From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emaki contributors <emaki@localhost>
Date: Thu, 8 Oct 2026 04:00:00 +0000
Subject: [PATCH 9/9] Preserve acquired layer focus when relaxing to on-demand

Copyright (C) 2026 Artur Yakymenko
SPDX-License-Identifier: GPL-3.0-or-later

A mapped layer can request Exclusive focus without a remap. After keyboard
enter, retain its focus when it commits OnDemand so normal outside focus
actions can leave it. Require the Exclusive transition and current ownership;
a plain OnDemand commit must not activate or reacquire an unfocused surface.
Keep lock and fullscreen arbitration in the existing focus policy. Exercise
persistent surfaces, stable application size, focus return and priority rules.

---
diff --git a/src/handlers/layer_shell.rs b/src/handlers/layer_shell.rs
--- a/src/handlers/layer_shell.rs
+++ b/src/handlers/layer_shell.rs
@@ -146,6 +146,19 @@
             } else {
                 // The surface remains mapped.
                 if let Some(mapped) = self.niri.mapped_layer_surfaces.get_mut(layer) {
+                    // A persistent surface can request focus with Exclusive, then relax to
+                    // OnDemand after receiving keyboard enter. Keep its acquired focus so the
+                    // user can now leave it normally, without a null-buffer commit or remap.
+                    // Merely changing None to OnDemand is not an activation request.
+                    let previous = mapped.update_keyboard_interactivity();
+                    if previous == wlr_layer::KeyboardInteractivity::Exclusive
+                        && layer.cached_state().keyboard_interactivity
+                            == wlr_layer::KeyboardInteractivity::OnDemand
+                        && self.niri.keyboard_focus.surface() == Some(surface)
+                    {
+                        self.niri.layer_shell_on_demand_focus = Some(layer.clone());
+                    }
+
                     // Check if the layer changed.
                     if mapped.take_recompute_rules_on_commit() {
                         let config = self.niri.config.borrow();
