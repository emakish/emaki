+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use super::*;
+use crate::layout::scrolling::{ColumnWidth, ScrollingSpace};
+
+// A 1920 x 1080 view with a 52 px bar zone on top, three half-width columns.
+fn setup(scale: f64) -> (ScrollingSpace<TestWindow>, Vec<TestWindow>, Clock) {
+    let view = Size::from((1920., 1080.));
+    let working_area = Rectangle::new(Point::from((0., 52.)), Size::from((1920., 1028.)));
+    let options = Rc::new(Options::default());
+    let mut clock = Clock::with_time(Duration::ZERO);
+    clock.set_complete_instantly(true);
+    let mut space = ScrollingSpace::new(
+        view,
+        working_area,
+        0.,
+        scale,
+        clock.clone(),
+        options.clone(),
+    );
+    let mut windows = Vec::new();
+    for id in 1..=3 {
+        let window = TestWindow::new(TestWindowParams::new(id));
+        let tile = Tile::new(window.clone(), view, scale, clock.clone(), options.clone());
+        space.add_tile(None, tile, true, ColumnWidth::Proportion(0.5), false, None);
+        windows.push(window);
+    }
+    settle(&mut space, &windows);
+    (space, windows, clock)
+}
+
+fn settle(space: &mut ScrollingSpace<TestWindow>, windows: &[TestWindow]) {
+    for window in windows {
+        window.communicate();
+        space.update_window(window.id(), None);
+    }
+    space.advance_animations();
+}
+
+// Once the view rests, the IPC position of every tile is where it is drawn; upstream's own
+// field stays empty for tiled windows.
+fn assert_positions_match_render(space: &ScrollingSpace<TestWindow>) {
+    let drawn: Vec<_> = space
+        .tiles_with_render_positions()
+        .map(|(tile, pos, _)| (tile.window().id().clone(), pos))
+        .collect();
+    let reported: Vec<_> = space.tiles_with_ipc_layouts().collect();
+    assert_eq!(drawn.len(), reported.len());
+    for (tile, layout) in reported {
+        let (_, pos) = drawn
+            .iter()
+            .find(|(id, _)| id == tile.window().id())
+            .unwrap();
+        assert_eq!(layout.emaki_tile_pos_in_view, Some((pos.x, pos.y)));
+        assert_eq!(layout.tile_pos_in_workspace_view, None);
+    }
+}
+
+#[test]
+fn emaki_tile_positions_follow_the_view() {
+    for scale in [1., 1.25, 2.] {
+        let (mut space, windows, _clock) = setup(scale);
+        assert_positions_match_render(&space);
+        space.focus_left();
+        space.focus_left();
+        settle(&mut space, &windows);
+        assert_positions_match_render(&space);
+        space.focus_right();
+        settle(&mut space, &windows);
+        assert_positions_match_render(&space);
+        // The bar zone is below the view's top: tiled windows start under it.
+        for (_, layout) in space.tiles_with_ipc_layouts() {
+            assert!(layout.emaki_tile_pos_in_view.unwrap().1 >= 52.);
+        }
+    }
+}
+
+#[test]
+fn emaki_tile_positions_ignore_the_scroll_animation() {
+    let (mut space, windows, mut clock) = setup(1.);
+    let before: Vec<_> = space
+        .tiles_with_ipc_layouts()
+        .map(|(_, layout)| layout.emaki_tile_pos_in_view)
+        .collect();
+    clock.set_complete_instantly(false);
+    space.focus_left();
+    space.focus_left();
+    // Mid-animation: the target, not the frame being drawn.
+    let moving: Vec<_> = space
+        .tiles_with_ipc_layouts()
+        .map(|(_, layout)| layout.emaki_tile_pos_in_view)
+        .collect();
+    assert_ne!(before, moving);
+    clock.set_complete_instantly(true);
+    settle(&mut space, &windows);
+    let settled: Vec<_> = space
+        .tiles_with_ipc_layouts()
+        .map(|(_, layout)| layout.emaki_tile_pos_in_view)
+        .collect();
+    assert_eq!(moving, settled);
+}
+
+#[test]
+fn emaki_tile_position_round_trips_and_stays_optional() {
+    let (space, _windows, _clock) = setup(1.);
+    let (_, layout) = space.tiles_with_ipc_layouts().next().unwrap();
+    let json = serde_json::to_string(&layout).unwrap();
+    assert!(json.contains("\"emaki_tile_pos_in_view\":["));
+    assert_eq!(
+        serde_json::from_str::<niri_ipc::WindowLayout>(&json).unwrap(),
+        layout
+    );
+    // Upstream's JSON (no field) still reads; an absent position is not written.
+    let mut upstream = layout.clone();
+    upstream.emaki_tile_pos_in_view = None;
+    let plain = serde_json::to_string(&upstream).unwrap();
+    assert!(!plain.contains("emaki_tile_pos_in_view"));
+    assert_eq!(
+        serde_json::from_str::<niri_ipc::WindowLayout>(&plain).unwrap(),
+        upstream
+    );
+}
+
+// The public layout enumeration must veto crops throughout both camera transitions.
+// Inspect JSON so this regression also compiles against the older additive IPC layout.
+#[test]
+fn emaki_capture_safety_tracks_scroll_and_workspace_transitions() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(3),
+        },
+        Op::SetForcedSize {
+            id: 1,
+            size: Some(Size::from((900, 600))),
+        },
+        Op::SetForcedSize {
+            id: 2,
+            size: Some(Size::from((900, 600))),
+        },
+        Op::SetForcedSize {
+            id: 3,
+            size: Some(Size::from((900, 600))),
+        },
+        Op::Communicate(1),
+        Op::Communicate(2),
+        Op::Communicate(3),
+        Op::CompleteAnimations,
+    ]);
+    let assert_safe = |layout: &Layout<TestWindow>, expected: bool| {
+        let mut count = 0;
+        layout.with_windows(|_, _, _, ipc| {
+            count += 1;
+            let value = serde_json::to_value(ipc).unwrap();
+            assert_eq!(
+                value.get("emaki_capture_safe"),
+                Some(&serde_json::json!(expected))
+            );
+        });
+        assert_eq!(count, 3);
+    };
+    assert_safe(&layout, true);
+    Op::FocusColumnLeft.apply(&mut layout);
+    Op::FocusColumnLeft.apply(&mut layout);
+    assert_safe(&layout, false);
+    Op::CompleteAnimations.apply(&mut layout);
+    assert_safe(&layout, true);
+    Op::FocusWorkspaceDown.apply(&mut layout);
+    assert_safe(&layout, false);
+    Op::CompleteAnimations.apply(&mut layout);
+    assert_safe(&layout, true);
+    let output = layout.outputs().next().unwrap().clone();
+    layout.workspace_switch_gesture_begin(&output, true);
+    assert_safe(&layout, false);
+}
