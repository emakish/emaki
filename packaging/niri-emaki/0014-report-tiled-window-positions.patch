@@ -0,0 +1,180 @@
+// Copyright (C) 2026 Artur Yakymenko
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::FilterResult;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_shell_v1::Layer;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_surface_v1::{
+    Anchor, KeyboardInteractivity,
+};
+use smithay::utils::SERIAL_COUNTER;
+use wayland_client::protocol::{wl_keyboard, wl_surface::WlSurface};
+
+use super::*;
+use crate::niri::KeyboardFocus;
+use crate::tests::client::{ClientId, LayerConfigureProps};
+
+fn map_window(f: &mut Fixture, id: ClientId) {
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(100, 100);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+}
+
+fn commit_keyboard(
+    f: &mut Fixture,
+    id: ClientId,
+    surface: &WlSurface,
+    mode: KeyboardInteractivity,
+) {
+    let layer = f.client(id).layer(surface);
+    layer.layer_surface.set_keyboard_interactivity(mode);
+    layer.commit();
+    f.double_roundtrip(id);
+}
+
+// Exercise actual wl_keyboard delivery, including the interval before the event loop refresh.
+// This is ordinary text input, with no binding filter or compositor shortcut involved.
+fn type_key(f: &mut Fixture, clients: [ClientId; 3], expected: usize) {
+    for id in clients {
+        f.client(id).state.keyboard_keys.clear();
+    }
+    for pressed in [true, false] {
+        let state = f.niri_state();
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        keyboard.input::<(), _>(
+            state,
+            38u32.into(), // evdev KEY_A (30), plus the XKB offset.
+            if pressed {
+                KeyState::Pressed
+            } else {
+                KeyState::Released
+            },
+            SERIAL_COUNTER.next_serial(),
+            1,
+            |_, _, _| FilterResult::Forward,
+        );
+    }
+    for (index, id) in clients.into_iter().enumerate() {
+        f.double_roundtrip(id);
+        let wanted = if index == expected {
+            vec![
+                (30, wl_keyboard::KeyState::Pressed),
+                (30, wl_keyboard::KeyState::Released),
+            ]
+        } else {
+            vec![]
+        };
+        assert_eq!(
+            f.client(id).state.keyboard_keys,
+            wanted,
+            "keyboard recipient {index}"
+        );
+    }
+}
+
+fn handover(previous: bool, release_first: bool, exclusive: bool, missing_target: bool) {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let app_a = f.add_client();
+    let app_b = f.add_client();
+    let shell = f.add_client();
+    let clients = [app_a, app_b, shell];
+    map_window(&mut f, app_a);
+    let a = f.niri().layout.windows().next().unwrap().1.id().get();
+    map_window(&mut f, app_b);
+    let b = f
+        .niri()
+        .layout
+        .windows()
+        .map(|(_, w)| w.id().get())
+        .find(|id| *id != a)
+        .unwrap();
+    f.niri_state()
+        .do_action(niri_config::Action::FocusWindow(b), false);
+    f.double_roundtrip(shell);
+    f.niri_state()
+        .do_action(niri_config::Action::FocusWindow(a), false);
+    f.double_roundtrip(shell);
+    type_key(&mut f, clients, 0);
+
+    let layer = f
+        .client(shell)
+        .create_layer(None, Layer::Overlay, "emaki-switcher");
+    let surface = layer.surface.clone();
+    layer.set_configure_props(LayerConfigureProps {
+        anchor: Some(Anchor::Top | Anchor::Bottom | Anchor::Left | Anchor::Right),
+        size: Some((0, 0)),
+        kb_interactivity: Some(KeyboardInteractivity::None),
+        ..Default::default()
+    });
+    layer.commit();
+    f.roundtrip(shell);
+    let layer = f.client(shell).layer(&surface);
+    layer.attach_new_buffer();
+    layer.set_size(1920, 1080);
+    layer.ack_last_and_commit();
+    f.double_roundtrip(shell);
+    commit_keyboard(&mut f, shell, &surface, KeyboardInteractivity::Exclusive);
+    if !exclusive {
+        commit_keyboard(&mut f, shell, &surface, KeyboardInteractivity::OnDemand);
+    }
+    assert!(matches!(
+        f.niri().keyboard_focus,
+        KeyboardFocus::LayerShell { .. }
+    ));
+    type_key(&mut f, clients, 2);
+
+    if release_first {
+        commit_keyboard(&mut f, shell, &surface, KeyboardInteractivity::None);
+        // An early release necessarily returns input to A: no request has identified B yet.
+        // The shell must keep OnDemand until B is confirmed, never use this old ordering.
+        type_key(&mut f, clients, 0);
+    }
+    let action = if previous {
+        niri_config::Action::FocusWindowPrevious
+    } else {
+        niri_config::Action::FocusWindow(if missing_target { u64::MAX } else { b })
+    };
+    f.niri_state().do_action(action, false);
+    // Deliberately no roundtrip: even the next input callback in this dispatch must go to B.
+    type_key(
+        &mut f,
+        clients,
+        if exclusive || missing_target { 2 } else { 1 },
+    );
+    if !release_first {
+        commit_keyboard(&mut f, shell, &surface, KeyboardInteractivity::None);
+    }
+    type_key(&mut f, clients, if missing_target { 0 } else { 1 });
+}
+
+#[test]
+fn focus_window_before_overlay_release() {
+    handover(false, false, false, false);
+}
+#[test]
+fn focus_previous_before_overlay_release() {
+    handover(true, false, false, false);
+}
+#[test]
+fn focus_window_after_overlay_release() {
+    handover(false, true, false, false);
+}
