# SPDX-License-Identifier: GPL-3.0-or-later
# shellcheck shell=bash
# makepkg consumes metadata and supplies build directories.
# shellcheck disable=SC2034,SC2154
# Build from the local checkout; no source downloads or disk access in check().
pkgname=emaki-installer
pkgver=0.2.0
pkgrel=1
pkgdesc='Emaki live ISO installation worker and protocol CLI'
arch=('any')
url='https://github.com/emakish/emaki'
license=('GPL-3.0-or-later' 'ODbL-1.0' 'Bitstream-Vera')
depends=(python archinstall=4.5-1 arch-install-scripts btrfs-progs dosfstools
         e2fsprogs grub efibootmgr
         ntfs-3g ntfsprogs gptfdisk parted util-linux os-prober quickshell-emaki emaki-config
         gparted hicolor-icon-theme)
makedepends=('git')
source=()
sha256sums=()

# Ignore stale private exports from an earlier build shell; opt in explicitly to
# a source override. Resolve again whenever makepkg loads this recipe.
if [[ -f $startdir/SOURCE-COMMIT ]]; then
    _emaki_commit=$(<"$startdir/SOURCE-COMMIT")
    [[ $_emaki_commit =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ -z ${EMAKI_SOURCE_COMMIT:-} || $EMAKI_SOURCE_COMMIT == "$_emaki_commit" ]] || return 1
else
    _emaki_commit=$(git -C "$startdir/../.." rev-parse --verify "${EMAKI_SOURCE_COMMIT:-HEAD}^{commit}")
fi
export _emaki_commit

# This explicit list is also the installed Python-file manifest. Bytecode is
# generated by Python at runtime; the package does not contain host-version pyc.
_modules=(__init__ constants errors planner render grub_screen latin_layouts runtime inventory arch_backend
          timezones worker protocol daemon cli)

prepare() {
    mkdir -p "$srcdir/emaki-installer"
    git -C "$startdir/../.." archive --format=tar \
        --output="$srcdir/emaki-installer.tar" "$_emaki_commit" installer LICENSE \
        packaging/emaki-installer/PKGBUILD
    tar -xf "$srcdir/emaki-installer.tar" -C "$srcdir/emaki-installer"
}

check() {
    cd "$srcdir/emaki-installer" || return
    PYTHONPATH=installer python -m unittest discover -s installer/tests -v
    python -m compileall -q installer/emaki_installer installer/tests
}

package() {
    cd "$srcdir/emaki-installer" || return
    local site module fixture
    site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
    for module in "${_modules[@]}"; do
        install -Dm644 "installer/emaki_installer/$module.py" \
            "$pkgdir$site/emaki_installer/$module.py"
    done
    install -Dm755 installer/bin/emaki-installerd "$pkgdir/usr/bin/emaki-installerd"
    install -Dm755 installer/bin/emaki-install-cli "$pkgdir/usr/bin/emaki-install-cli"
    install -Dm644 installer/systemd/emaki-installerd.service \
        "$pkgdir/usr/lib/systemd/system/emaki-installerd.service"
    install -Dm644 installer/sysusers.d/emaki-installer.conf \
        "$pkgdir/usr/lib/sysusers.d/emaki-installer.conf"
    install -Dm644 installer/tmpfiles.d/emaki-installer.conf \
        "$pkgdir/usr/lib/tmpfiles.d/emaki-installer.conf"
    for fixture in plan-erase-btrfs plan-erase-ext4 plan-manual; do
        install -Dm644 "installer/fixtures/$fixture.json" \
            "$pkgdir/usr/share/emaki-installer/fixtures/$fixture.json"
    done
    install -Dm644 installer/README.md "$pkgdir/usr/share/doc/emaki-installer/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/emaki-installer/LICENSE"
    # --- GRUB unlock screen of encrypted installs ---
    install -Dm644 installer/assets/grub/unlock-24.pf2 \
        "$pkgdir/usr/share/emaki-installer/grub/unlock-24.pf2"
    install -Dm644 installer/assets/grub/LICENSE-DejaVu.txt \
        "$pkgdir/usr/share/licenses/emaki-installer/LICENSE-DejaVu.txt"
    local picture variant
    for variant in A B C; do
        for picture in installer/emaki_installer/grub_artwork/"$variant"/*.png; do
            install -Dm644 "$picture" "$pkgdir$site/emaki_installer/grub_artwork/$variant/${picture##*/}"
        done
    done
    # --- installer window ---
    local ui_file
    for ui_file in shell.qml InstallerController.qml InstallerView.qml GlassPane.qml TimezoneMap.qml Protocol.js Timezones.js ui-helper.py; do
        install -Dm644 "installer/ui/$ui_file" "$pkgdir/usr/share/emaki-installer/ui/$ui_file"
    done
    for ui_file in timezone-map.png ZoneData.js README.md ODbL-1.0.txt generate-timezones.py; do
        install -Dm644 "installer/ui/assets/$ui_file" "$pkgdir/usr/share/emaki-installer/ui/assets/$ui_file"
    done
    install -Dm755 installer/ui/emaki-install "$pkgdir/usr/bin/emaki-install"
    install -Dm644 installer/ui/emaki-install.desktop "$pkgdir/usr/share/applications/emaki-install.desktop"
    install -Dm644 installer/ui/emaki-install.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/emaki-install.svg"
    ln -s /usr/share/emaki/shell/shaders "$pkgdir/usr/share/emaki-installer/ui/shaders"
    # --- end installer window ---
}
