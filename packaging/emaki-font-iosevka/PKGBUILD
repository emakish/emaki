package() {
    local style notice
    # A separate directory lets a person's full upstream font package coexist.
    for style in Regular Bold Italic BoldItalic; do
        install -Dm644 "$srcdir/IosevkaNerdFontMono-$style.ttf" \
            "$pkgdir/usr/share/fonts/emaki-iosevka/IosevkaNerdFontMono-$style.ttf"
    done
    # Preserve the original licence/copyright and the patched fonts' icon-set notices.
    install -Dm644 "$srcdir/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/licenses/$pkgname/README.md"
    for notice in "${source[@]:1}"; do
        notice=${notice%%::*}
        install -Dm644 "$srcdir/$notice" "$pkgdir/usr/share/licenses/$pkgname/$notice"
    done
}
