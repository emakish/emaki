# Keep the KWallet API for KDE applications, backed by the login keyring.
[KSecretD]
Enabled=false

# The login service enables one bounded migration attempt in a private overlay.
# Ordinary daemon starts do not repeat an attempt after cancellation.
[Migration]
MigrateTo3rdParty=false
