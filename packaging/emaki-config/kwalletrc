# Native KWallet provides KDE passwords, Secret Service and the Secret portal.
[Wallet]
Enabled=true

[KSecretD]
Enabled=true

[org.freedesktop.secrets]
apiEnabled=true

# Never export existing KDE wallets into a third-party service at login.
[Migration]
MigrateTo3rdParty=false
