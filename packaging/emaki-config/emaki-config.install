# shellcheck shell=bash
# Removing the package deletes the wallpaper copies published for the greeter; its
# state and private directories stay. Before removal the provisioner is still
# installed; it is called by its packaged path because scriptlets inherit whatever
# PATH pacman was started with. pacman calls no remove function on an upgrade, but
# does when another package replaces this one. A failed purge is named and never
# stops the removal.
pre_remove() {
    /usr/bin/emaki-greeter-provision --root / --purge-published ||
        echo 'emaki-config: published wallpaper copies remain in /var/lib/emaki-greeter; an administrator can remove them' >&2
}

post_install() {
    /usr/share/libalpm/scripts/emaki-initramfs-refresh --install-hooks
    /usr/share/libalpm/scripts/emaki-system-migrate --mark-fresh
}

post_upgrade() {
    /usr/share/libalpm/scripts/emaki-initramfs-refresh --install-hooks
    /usr/bin/python3 -I /usr/bin/emaki-migrate-installer-config
}

pre_upgrade() {
    # Preserve the enabled vendor timer while moving it to ordinary enable/disable.
    if [[ -L /usr/lib/systemd/system/timers.target.wants/paccache.timer ]] &&
       [[ $(systemctl --root=/ is-enabled paccache.timer 2>/dev/null) != masked ]]; then
        install -d -m755 /var/lib/emaki/migrations
        touch /var/lib/emaki/migrations/paccache-enabled
    fi
}
