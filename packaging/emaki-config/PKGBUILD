# shellcheck shell=bash
# makepkg supplies build paths and consumes package metadata.
# shellcheck disable=SC2034,SC2154
pkgname=emaki-config
pkgver=1.0.0
pkgrel=2
pkgdesc='Emaki shell, CLI, system defaults, session, greeter and themes'
arch=('x86_64')
url='https://github.com/emakish/emaki'
license=('GPL-3.0-or-later' 'Bitstream-Vera' 'OFL-1.1' 'GPL-2.0-or-later')  # GPL-2.0-or-later: Plymouth's prompt pictures
depends=(
    'pacman' 'pacman-contrib' 'fakeroot' 'reflector' 'polkit'
    'glibc' 'libgcc' 'icu' 'libicui18n.so=78-64' 'libicuuc.so=78-64' 'bash' 'coreutils' 'dbus' 'procps-ng' 'systemd>=256' 'util-linux' 'sudo' 'pam' 'qt6-declarative>=6.12' 'qt6-base>=6.12.0' 'qt6-base<6.13'
    'niri-emaki=26.04-30' 'quickshell-emaki>=0.3.1-14'
    'python' 'python-gobject' 'python-pillow' 'gtk3' 'libnotify'
    'appstream' 'archlinux-appstream-data' 'kimageformats' 'libjxl'
    'wpaperd' 'wl-clipboard' 'cliphist' 'udiskie'
    'tesseract' 'tesseract-data-eng' 'tesseract-data-spa' 'tesseract-data-por'
    'tesseract-data-deu' 'tesseract-data-fra' 'tesseract-data-rus' 'zbar'
    'grim' 'gstreamer' 'gst-plugin-pipewire' 'gst-plugins-base'
    'gst-plugins-base-libs' 'gst-plugins-good' 'gst-plugins-bad' 'libglvnd' 'ffmpeg'
    'kitty' 'fastfetch>=2.68.1' 'imagemagick' 'hyprlock' 'playerctl' 'fuzzel' 'qt6ct' 'noto-fonts' 'breeze-icons' 'adwaita-icon-theme'
    'emaki-font-iosevka'  # the terminal's font, Iosevka Nerd Font Mono (kitty/theme.conf, 2026-10-15)
    'terminus-font'
    'xdg-desktop-portal-gnome' 'xdg-desktop-portal-gtk'  # Upstream name; see emaki-desktop.
    'brightnessctl' 'power-profiles-daemon' 'networkmanager' 'upower' 'blueman' 'bluez'
    'pipewire' 'wireplumber' 'pipewire-pulse' 'rtkit' 'wlsunset'
    'greetd' 'greetd-regreet' 'kwallet-pam' 'kwallet>=6.30'
    'accountsservice'  # Settings › Users: accounts and their polkit actions
    'ntfs-3g'  # Windows shutdown check before writing an EFI partition shared with Windows
    'plymouth'  # the startup logo: boot/plymouth
    'zsh' 'zsh-autosuggestions' 'zsh-syntax-highlighting'  # the default shell for new accounts: zsh/
)
makedepends=('git' 'make' 'python' 'rust' 'qt6-shadertools' 'qt6-tools' 'gettext' 'cmake' 'gcc' 'pkgconf')
checkdepends=('niri' 'nodejs')  # nodejs: shell JavaScript tests in make check
optdepends=('swayidle: optional emaki-idle policy'
            'python-yaml: validate optional AppStream YAML catalogs')
conflicts=('emaki-core')
# The translation plugin uses Qt private symbols: build() refuses any other Qt, and
# emaki-qt-check compares this record with the installed qt6-base.
_qtver=6.12.0
provides=("emaki-i18n-qt-build=$_qtver")
backup=('etc/pam.d/emaki-sudo' 'etc/sudoers.d/10-emaki-wheel'
        'etc/niri/config.kdl' 'etc/xdg/hypr/hyprlock.conf' 'etc/xdg/fastfetch/config.jsonc'
        'etc/xdg/kwalletrc' 'etc/xdg/mimeapps.list' 'etc/xdg/kdeglobals' 'etc/xdg/dolphinrc' 'etc/xdg/qt6ct/qt6ct.conf'
        'etc/xdg/menus/emaki-applications.menu' 'etc/xdg/xdg-desktop-portal/niri-portals.conf'
        'etc/mkinitcpio.conf.d/50-emaki-splash.conf' 'etc/default/grub.d/50-emaki-splash.cfg'
        'etc/zsh/emaki.zsh' 'etc/zsh/zshenv')
options=('!debug' '!lto')
install=emaki-config.install
source=()

# Recompute on each invocation; ignore stale exported private variables. Use
# EMAKI_SOURCE_COMMIT explicitly to rebuild a chosen commit (detached HEAD works).
if [[ -f $startdir/SOURCE-COMMIT ]]; then
    _emaki_commit=$(<"$startdir/SOURCE-COMMIT")
    [[ $_emaki_commit =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ -z ${EMAKI_SOURCE_COMMIT:-} || $EMAKI_SOURCE_COMMIT == "$_emaki_commit" ]] || return 1
else
    _emaki_commit=$(git -C "$startdir/../.." rev-parse --verify "${EMAKI_SOURCE_COMMIT:-HEAD}^{commit}")
fi
export _emaki_commit

_emaki_source() {
    cd "$srcdir/emaki" || return
    _emaki_commit=$(<"$srcdir/emaki-source-commit")
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$PWD/.cache/target"
    export TMPDIR="$PWD/.cache/tmp"
    mkdir -p "$CARGO_HOME" "$TMPDIR"
}

_emaki_make() {
    make "$@" PREFIX=/usr EMAKI_COMMIT="$_emaki_commit" \
        EMAKI_PREFIX=/usr EMAKI_DATADIR=/usr/share/emaki \
        EMAKI_LIBEXECDIR=/usr/libexec/emaki EMAKI_SYSCONFDIR=/etc \
        EMAKI_BUSCTL=busctl EMAKI_PW_CLI=pw-cli EMAKI_NIRI=niri
}

prepare() {
    rm -rf "$srcdir/emaki"
    python "$startdir/../source_archive.py" checkout --repo "$startdir/../.." \
        --output "$srcdir/emaki" --commit "$_emaki_commit"
    printf '%s\n' "$_emaki_commit" > "$srcdir/emaki-source-commit"
    _emaki_source
    # Refuse an old commit with new recipe metadata, before fetching anything.
    python -c 'import sys,tomllib; assert tomllib.load(open("Cargo.toml", "rb"))["workspace"]["package"]["version"] == sys.argv[1], "archive version differs from pkgver"' "$pkgver"
    test -f packaging/emaki-config/expected-files.list || return 1
    _emaki_make prepare-core || return 1
    cargo metadata --locked --offline --filter-platform "$(rustc --print host-tuple)" \
        --format-version 1 > "$srcdir/rust-metadata.json" || return 1
    python packaging/rust_notices.py --lock Cargo.lock --metadata "$srcdir/rust-metadata.json" \
        --project "$PWD" --output "$srcdir/THIRD-PARTY-NOTICES" || return 1
    rm -f -- "$srcdir/rust-metadata.json"
}

build() {
    _emaki_source
    _emaki_make build || return
    local qt_build_version
    qt_build_version=$(pkg-config --modversion Qt6Core) || return
    if [[ $qt_build_version != "$_qtver" ]]; then
        printf 'The translation plugin must be built with Qt %s (found %s).\n' "$_qtver" "$qt_build_version" >&2
        return 1
    fi
}

check() {
    _emaki_source
    _emaki_make check
}

package() {
    _emaki_source
    _emaki_make install install-niri-emaki DESTDIR="$pkgdir" INSTALL_SUDO_TURN_INTEGRATION=0
    python scripts/core-package.py verify-build-paths --binary "$pkgdir/usr/bin/emaki"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/THIRD-PARTY-NOTICES" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
    # Review changes to the committed contract; never generate it in package().
    find "$pkgdir" \( -type f -o -type l \) -printf '/%P\n' | LC_ALL=C sort > "$srcdir/actual-files.list"
    diff -u packaging/emaki-config/expected-files.list "$srcdir/actual-files.list"
}
