# Reverse package-file removal deletes the vendor PAM service before /etc files.
# Stop selecting it before that can happen, even when the local override is absent.
[Trigger]
Type = Package
Operation = Remove
Target = emaki-config

[Action]
When = PreTransaction
Exec = /usr/bin/rm -f /etc/sudoers.d/20-emaki-pam
AbortOnFail
