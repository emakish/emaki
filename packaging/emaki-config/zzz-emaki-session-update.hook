[Trigger]
Operation = Upgrade
Type = Package
Target = emaki-config
Target = niri
Target = niri-emaki
Target = quickshell-emaki
Target = qt6-*

[Action]
Description = Recording the desktop update [Emaki].
When = PostTransaction
Exec = /usr/bin/emaki-session-update
