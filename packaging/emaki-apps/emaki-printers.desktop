[Desktop Entry]
Type=Application
Name=Printers
Name[es]=Impresoras
Name[pt_BR]=Impressoras
Name[de]=Drucker
Name[fr]=Imprimantes
Name[ru]=Принтеры
Comment=Add and manage printers
Comment[es]=Agrega y administra impresoras
Comment[pt_BR]=Adicione e gerencie impressoras
Comment[de]=Drucker hinzufügen und verwalten
Comment[fr]=Ajoutez et gérez des imprimantes
Comment[ru]=Добавление и настройка принтеров
Exec=kcmshell6 kcm_printer_manager
TryExec=kcmshell6
Icon=printer
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=Printer;Printing;CUPS;
Keywords[es]=impresora;imprimir;CUPS;
Keywords[pt_BR]=impressora;imprimir;CUPS;
Keywords[de]=Drucker;Drucken;CUPS;
Keywords[fr]=imprimante;imprimer;CUPS;
Keywords[ru]=принтер;печать;CUPS;
