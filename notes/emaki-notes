set -eu
umask 077
ulimit -c 0
paths_file="$(dirname -- "$(readlink -f -- "$0")")/../scripts/paths"
if [[ ! -f $paths_file ]]; then
    paths_file='@EMAKI_LIBEXECDIR@/paths'
fi
source "$paths_file"

translate() {
    local translated message="$1" argument index=0
    shift
    if translated=$("$EMAKI_PYTHON" -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from emaki_i18n import translation; print(translation(sys.argv[2]).gettext(sys.argv[3]).format(*sys.argv[4:]))' "$(dirname -- "$paths_file")" notes "$message" "$@" 2>/dev/null); then
        printf '%s\n' "$translated"
    else
        for argument in "$@"; do
            message=${message//\{$index\}/"$argument"}
            ((index += 1))
        done
        printf '%s\n' "$message"
    fi
}
export EMAKI_NOTES_ID=''
if (( $# )); then
    if (( $# == 2 )) && [[ $1 == --note ]]; then
        export EMAKI_NOTES_ID="$2"
    else
        translate 'Usage: emaki-notes [--note ID]' >&2
        exit 2
    fi
fi
if (( EUID == 0 )); then
    translate 'Open Emaki Notes as a regular user.' >&2
    exit 1
fi
: "${XDG_RUNTIME_DIR:?$(translate 'Emaki Notes needs a user runtime directory')}"
config="$EMAKI_PREFIX/share/emaki-notes/ui/shell.qml"
exec 9>"$XDG_RUNTIME_DIR/emaki-notes.lock"
if ! flock -n 9; then
    for _ in {1..50}; do
        if reply=$(qs ipc -p "$config" call notes present "$EMAKI_NOTES_ID" 2>&1) && [[ ${reply##*$'\n'} == presented ]]; then exit 0; fi
        sleep 0.1
    done
    translate 'The Emaki Notes window could not be shown.' >&2
    exit 1
fi
export QS_DISABLE_CRASH_HANDLER=1
export EMAKI_SHELL_SHADER_DIR="$EMAKI_DATADIR/shell/shaders"
qs -p "$config" 9>&-
